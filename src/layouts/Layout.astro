---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  canonicalUrl?: string;
}

const siteUrl = "https://zhar-difa.my.id";

const {
  title = "Undangan Pernikahan Zharkasi & Difa",
  description = "Sabtu, 26 Desember 2026 · Padang, Sumatera Barat. “Dua insan, satu jiwa, melangkah bersama menuju keabadian cinta.” Buka undangan resmi pernikahan Zharkasi & Difa.",
  ogImage = `${siteUrl}/assets/og.jpg`,
  canonicalUrl = siteUrl
} = Astro.props;

// Ensure ogImage is always an absolute URL for WhatsApp / Telegram / Twitter
const absoluteOgImage = ogImage.startsWith('http') ? ogImage : `${siteUrl}${ogImage.startsWith('/') ? '' : '/'}${ogImage}`;
---

<!DOCTYPE html>
<html lang="id" class="is-locked">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#FAF8F5" />
  
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalUrl} />

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <!-- Open Graph / WhatsApp Preview (Anti-Slop Luxury Typography) -->
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="The Wedding of Zharkasi & Difa" />
  <meta property="og:locale" content="id_ID" />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={absoluteOgImage} />
  <meta property="og:image:secure_url" content={absoluteOgImage} />
  <meta property="og:image:type" content="image/jpeg" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="Undangan Pernikahan Zharkasi & Difa — 26 Desember 2026" />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:url" content={canonicalUrl} />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={absoluteOgImage} />

  <!-- Preconnect Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
</head>
<body class="is-locked">
  <slot />

  <!-- Core Scripts: Lenis Smooth Scroll & GSAP -->
  <script>
    import Lenis from 'lenis';
    import gsap from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';

    gsap.registerPlugin(ScrollTrigger);

    // Prevent browser auto-scroll restoration on reload
    if ('scrollRestoration' in history) {
      history.scrollRestoration = 'manual';
    }
    window.scrollTo(0, 0);

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (!prefersReducedMotion) {
      const isTouch = window.matchMedia('(pointer: coarse)').matches || 'ontouchstart' in window;

      const lenis = new Lenis({
        duration: isTouch ? 0.85 : 1.2,
        easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
        orientation: 'vertical',
        smoothWheel: true,
        wheelMultiplier: 0.95,
        touchMultiplier: 1.0,
        syncTouch: true,
      });

      // Keep Lenis stopped & pinned at top while splash screen / envelope is locked
      if (document.body.classList.contains('is-locked')) {
        lenis.stop();
        lenis.scrollTo(0, { immediate: true });
      }

      // Update ScrollTrigger on scroll
      lenis.on('scroll', () => {
        ScrollTrigger.update();
      });

      gsap.ticker.add((time) => {
        lenis.raf(time * 1000);
      });
      // Standard lag smoothing: gracefully absorbs micro-delays without sudden jumps
      gsap.ticker.lagSmoothing(500, 33);

      // Expose globally for components (e.g. ProgressBar)
      (window as any).__lenis = lenis;

      // Subtle continuous parallax on background monograms
      gsap.utils.toArray('.ornament-parallax').forEach((el: any) => {
        gsap.to(el, {
          y: isTouch ? 25 : 50,
          ease: 'none',
          scrollTrigger: {
            trigger: el.parentElement || el,
            start: 'top bottom',
            end: 'bottom top',
            scrub: isTouch ? 0.35 : 0.85
          }
        });
      });

      // 3D Upward Roll & Kinetic Mask Reveal on Section Headings
      gsap.utils.toArray('.kinetic-heading-line').forEach((heading: any) => {
        gsap.fromTo(
          heading,
          { yPercent: 120, rotateX: 30, opacity: 0 },
          {
            yPercent: 0,
            rotateX: 0,
            opacity: 1,
            duration: 1.0,
            ease: 'power3.out',
            scrollTrigger: {
              trigger: heading,
              start: 'top 88%',
              once: true
            }
          }
        );
      });

      // Cleanly resume scroll & recalculate triggers after splashscreen is unlocked
      window.addEventListener('invitationOpened', () => {
        window.scrollTo(0, 0);
        if (lenis) {
          lenis.scrollTo(0, { immediate: true });
          lenis.start();
        }
        setTimeout(() => {
          ScrollTrigger.refresh();
        }, 120);
      });
    }
  </script>
</body>
</html>
