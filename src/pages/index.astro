---
import Layout from '../layouts/Layout.astro';
import SplashScreen from '../components/SplashScreen.astro';
import Cinematic3DTunnel from '../components/cinematic/Cinematic3DTunnel.astro';
import UnifiedEvent from '../components/UnifiedEvent.astro';
import Countdown from '../components/Countdown.astro';
import LoveStory from '../components/LoveStory.astro';
import DigitalGift from '../components/DigitalGift.astro';
import Wishes from '../components/Wishes.astro';
import Closing from '../components/Closing.astro';
import AudioPlayer from '../components/AudioPlayer.astro';
import ProgressBar from '../components/ProgressBar.astro';
import Toast from '../components/Toast.astro';
import InteractiveCanvas from '../components/InteractiveCanvas.astro';
import content from '../data/content.json';
---

<Layout
  title={content.meta.title}
  description={content.meta.description}
  ogImage={content.meta.ogImage}
>
  <!-- Background Layer: Ultra-light Organic Linen Paper Texture Overlay -->
  <div class="film-grain-overlay" aria-hidden="true"></div>

  <!-- Interactive Ambient Magnetic Golden Sparkles Aura -->
  <InteractiveCanvas />

  <!-- Luxury Wedding Envelope Reveal -->
  <SplashScreen />
  
  <!-- Main Editorial Content Flow -->
  <main id="main-content" class="relative z-10">
    <!-- Phase 1: Pinned 3D Camera Z-Space Fly-Through (Hero -> Ayat Suci -> Kedua Mempelai) -->
    <Cinematic3DTunnel />

    <!-- Phase 2: Grounded Interactive 3D Stage (Jadwal, Countdown, Kisah, Hadiah, & RSVP) -->
    <div id="interactive-stage" class="relative z-20">
      <UnifiedEvent />
      <Countdown />
      <LoveStory />
      <DigitalGift />
      <Wishes />
      <Closing />
    </div>
  </main>

  <!-- Minimalist Champagne Gold Reading Progress Bar -->
  <ProgressBar />

  <!-- Minimalist Floating Audio Control -->
  <AudioPlayer />

  <!-- Luxury Global Toast Feedback -->
  <Toast />

  <!-- Global Interactive Foil Sheen & Particle Burst Engine -->
  <script>
    import '../utils/interactiveFoil';
    import '../utils/confetti';
  </script>
</Layout>
