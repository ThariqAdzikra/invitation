---
import Layout from '../layouts/Layout.astro';
import Cover from '../components/Cover.astro';
import Hero from '../components/Hero.astro';
import Opening from '../components/Opening.astro';
import Couple from '../components/Couple.astro';
import UnifiedEvent from '../components/UnifiedEvent.astro';
import Countdown from '../components/Countdown.astro';
import LoveStory from '../components/LoveStory.astro';
import Closing from '../components/Closing.astro';
import AudioPlayer from '../components/AudioPlayer.astro';
import ProgressBar from '../components/ProgressBar.astro';
import OrnateFrame from '../components/OrnateFrame.astro';
import ClickSpark from '../components/reactbits/ClickSpark';
import CelestialCanvas from '../components/reactbits/CelestialCanvas';
import content from '../data/content.json';
---

<Layout
  title={content.meta.title}
  description={content.meta.description}
  ogImage={content.meta.ogImage}
>
  <!-- Background Layer 1: Ambient Glowing Sapphire & Gold Nebula Orbs -->
  <div class="nebula-glow-1" aria-hidden="true"></div>
  <div class="nebula-glow-2" aria-hidden="true"></div>

  <!-- Background Layer 2: Celestial Stardust & Twinkling Starfield Canvas -->
  <CelestialCanvas client:load />

  <!-- Background Layer 3: Luxury Fine-Art Linen / Film Grain Texture Overlay -->
  <div class="film-grain-overlay" aria-hidden="true"></div>

  <!-- Foreground Layer: Royal Gold Filigree Corner Frames & Border -->
  <OrnateFrame />

  <!-- React Bits: Interactive Starlight Gold Click Spark Burst -->
  <ClickSpark client:load sparkColor="#E2C98A" sparkSize={10} sparkRadius={22} sparkCount={8} />

  <!-- Cover Gate / 3D Wax Seal Unboxing -->
  <Cover />
  
  <!-- Main Editorial Content -->
  <main id="main-content" class="relative z-10">
    <Hero />
    <Opening />
    <Couple />
    <UnifiedEvent />
    <Countdown />
    <LoveStory />
    <Closing />
  </main>

  <!-- Starlight Gold Reading Progress Bar -->
  <ProgressBar />

  <!-- Floating Audio Control -->
  <AudioPlayer />
</Layout>
