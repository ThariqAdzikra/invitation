---
import Layout from '../layouts/Layout.astro';
import SplashScreen from '../components/SplashScreen.astro';
import Hero from '../components/Hero.astro';
import Opening from '../components/Opening.astro';
import Couple from '../components/Couple.astro';
import UnifiedEvent from '../components/UnifiedEvent.astro';
import Countdown from '../components/Countdown.astro';
import LoveStory from '../components/LoveStory.astro';
import Wishes from '../components/Wishes.astro';
import Closing from '../components/Closing.astro';
import AudioPlayer from '../components/AudioPlayer.astro';
import ProgressBar from '../components/ProgressBar.astro';
import content from '../data/content.json';
---

<Layout
  title={content.meta.title}
  description={content.meta.description}
  ogImage={content.meta.ogImage}
>
  <!-- Background Layer: Ultra-light 35mm Film Grain Overlay -->
  <div class="film-grain-overlay" aria-hidden="true"></div>

  <!-- Modern Cinematic SplashScreen -->
  <SplashScreen />
  
  <!-- Main Editorial Content Flow -->
  <main id="main-content" class="relative z-10 overflow-hidden">
    <Hero />
    <Opening />
    <Couple />
    <UnifiedEvent />
    <Countdown />
    <LoveStory />
    <Wishes />
    <Closing />
  </main>

  <!-- Minimalist Champagne Gold Reading Progress Bar -->
  <ProgressBar />

  <!-- Minimalist Floating Audio Control -->
  <AudioPlayer />
</Layout>
