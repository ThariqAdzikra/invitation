---
import content from '../data/content.json';
---

<section id="couple" class="deck-section tone-couple section-flow relative px-4 overflow-hidden z-30" aria-label="Profil Kedua Mempelai">
  <div class="max-w-4xl mx-auto w-full">
    
    <!-- Section Header -->
    <div class="text-center mb-8 md:mb-12 couple-header">
      <div class="editorial-badge">
        <span>THE PROTAGONISTS</span>
      </div>
      <p class="text-overline tracking-[0.25em]">
        KEDUA MEMPELAI
      </p>
      <h2 class="font-display text-2xl sm:text-3xl md:text-4xl text-pearl font-normal mt-1.5">
        Mempelai Pria &amp; Wanita
      </h2>
      <p class="text-xs text-pearl-muted font-light mt-1.5 tracking-wider">
        Ketuk kartu untuk melihat kutipan &amp; pesan personal
      </p>
    </div>

    <!-- 3D Flip Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-10">
      
      <!-- Kartu Mempelai Pria -->
      <div id="card-groom-container" class="couple-flip-container">
        <div id="card-groom" class="couple-flip-card" role="button" tabindex="0" aria-label="Kartu Profil Mempelai Pria. Ketuk untuk membalik.">
          
          <!-- Sisi Depan (Front) -->
          <div class="couple-card-front">
            <div class="my-auto flex flex-col items-center">
              <div class="w-14 h-14 rounded-full border border-gold/30 flex items-center justify-center mb-4 text-gold font-display text-xl">
                {content.couple.groom.nickname[0]}
              </div>
              <p class="text-overline text-gold mb-1">Mempelai Pria</p>
              <h3 class="font-display text-2xl text-pearl font-normal mb-2">
                {content.couple.groom.fullName}
              </h3>
              <p class="text-xs md:text-sm text-pearl-muted font-light max-w-xs leading-relaxed">
                {content.couple.groom.parents}
              </p>
            </div>

            <div class="flip-hint-pill">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"/>
              </svg>
              <span>Ketuk untuk Membalik</span>
            </div>
          </div>

          <!-- Sisi Belakang (Back) -->
          <div class="couple-card-back">
            <div class="my-auto flex flex-col items-center px-2">
              <span class="font-display italic text-3xl text-gold/60 mb-2">&ldquo;</span>
              <p class="font-display italic text-base md:text-lg text-pearl font-normal leading-relaxed mb-6 max-w-xs">
                {content.couple.groom.quote}
              </p>
              <a href={`https://instagram.com/${content.couple.groom.instagram.replace('@', '')}`} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 text-xs text-gold hover:underline tracking-widest uppercase">
                <span>{content.couple.groom.instagram}</span>
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6M15 3h6v6M10 14L21 3"/>
                </svg>
              </a>
            </div>

            <div class="flip-hint-pill">
              <span>Kembali</span>
            </div>
          </div>

        </div>
      </div>

      <!-- Kartu Mempelai Wanita -->
      <div id="card-bride-container" class="couple-flip-container">
        <div id="card-bride" class="couple-flip-card" role="button" tabindex="0" aria-label="Kartu Profil Mempelai Wanita. Ketuk untuk membalik.">
          
          <!-- Sisi Depan (Front) -->
          <div class="couple-card-front">
            <div class="my-auto flex flex-col items-center">
              <div class="w-14 h-14 rounded-full border border-gold/30 flex items-center justify-center mb-4 text-gold font-display text-xl">
                {content.couple.bride.nickname[0]}
              </div>
              <p class="text-overline text-gold mb-1">Mempelai Wanita</p>
              <h3 class="font-display text-2xl text-pearl font-normal mb-2">
                {content.couple.bride.fullName}
              </h3>
              <p class="text-xs md:text-sm text-pearl-muted font-light max-w-xs leading-relaxed">
                {content.couple.bride.parents}
              </p>
            </div>

            <div class="flip-hint-pill">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"/>
              </svg>
              <span>Ketuk untuk Membalik</span>
            </div>
          </div>

          <!-- Sisi Belakang (Back) -->
          <div class="couple-card-back">
            <div class="my-auto flex flex-col items-center px-2">
              <span class="font-display italic text-3xl text-gold/60 mb-2">&ldquo;</span>
              <p class="font-display italic text-base md:text-lg text-pearl font-normal leading-relaxed mb-6 max-w-xs">
                {content.couple.bride.quote}
              </p>
              <a href={`https://instagram.com/${content.couple.bride.instagram.replace('@', '')}`} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 text-xs text-gold hover:underline tracking-widest uppercase">
                <span>{content.couple.bride.instagram}</span>
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6M15 3h6v6M10 14L21 3"/>
                </svg>
              </a>
            </div>

            <div class="flip-hint-pill">
              <span>Kembali</span>
            </div>
          </div>

        </div>
      </div>

    </div>

  </div>
</section>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { playCardFlipSound } from './reactbits/SoundEffects';

  gsap.registerPlugin(ScrollTrigger);

  function initCouple() {
    const cardGroom = document.getElementById('card-groom');
    const cardBride = document.getElementById('card-bride');

    function setupFlip(card: HTMLElement | null) {
      if (!card) return;
      
      const toggle = (e: Event) => {
        const target = e.target as HTMLElement;
        if (target.closest('a')) return;
        
        card.classList.toggle('is-flipped');
        playCardFlipSound();
      };

      card.addEventListener('click', toggle);
      card.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          toggle(e);
        }
      });
    }

    setupFlip(cardGroom);
    setupFlip(cardBride);

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!prefersReducedMotion) {
      gsap.fromTo(
        '.couple-header',
        { opacity: 0, y: 30 },
        {
          opacity: 1,
          y: 0,
          duration: 0.9,
          ease: 'power3.out',
          scrollTrigger: {
            trigger: '#couple',
            start: 'top 80%',
            once: true
          }
        }
      );

      gsap.fromTo(
        '#card-groom-container',
        { opacity: 0, x: -35 },
        {
          opacity: 1,
          x: 0,
          duration: 1.0,
          ease: 'power3.out',
          scrollTrigger: {
            trigger: '#couple',
            start: 'top 75%',
            once: true
          }
        }
      );

      gsap.fromTo(
        '#card-bride-container',
        { opacity: 0, x: 35 },
        {
          opacity: 1,
          x: 0,
          duration: 1.0,
          ease: 'power3.out',
          scrollTrigger: {
            trigger: '#couple',
            start: 'top 75%',
            once: true
          }
        }
      );
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCouple);
  } else {
    initCouple();
  }
</script>
