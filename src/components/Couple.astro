---
// Couple.astro — Editorial Dual Profile of Groom & Bride (100% Free of Human Avatars)
import content from '../data/content.json';
import FloralFlourish from './botanical/FloralFlourish.astro';
import FloralMonogramMedallion from './botanical/FloralMonogramMedallion.astro';
---

<section id="couple" class="deck-section section-flow relative px-4 overflow-hidden z-30 pt-20 pb-24" aria-label="Profil Kedua Mempelai">
  
  <div class="max-w-4xl mx-auto w-full">
    
    <!-- Section Header -->
    <div class="text-center mb-10 md:mb-14 couple-header">
      <p class="text-overline tracking-[0.28em]">
        KEDUA MEMPELAI
      </p>
      <h2 class="font-display text-3xl sm:text-4xl text-[#2A3426] font-normal mt-1.5">
        Mempelai Pria &amp; Wanita
      </h2>
      <div class="my-2 flex justify-center opacity-70">
        <FloralFlourish width={160} height={24} />
      </div>
      <p class="text-xs text-[#566A4E] font-light tracking-wider">
        Dengan memohon rahmat &amp; rida Allah SWT
      </p>
    </div>

    <!-- Editorial Profiles Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-10">
      
      <!-- Profil Mempelai Pria (Zharkasi) -->
      <article class="couple-profile-card bg-white/95 border border-[#566A4E]/20 rounded-2xl p-6 sm:p-8 flex flex-col items-center text-center shadow-[0_12px_35px_rgba(42,52,38,0.06)] relative overflow-hidden interactive-foil-card" data-foil="true">
        <div class="absolute top-0 left-0 right-0 h-[2px] bg-gradient-to-r from-transparent via-[#B89352] to-transparent"></div>

        <!-- Groom Royal Botanical Monogram Medallion -->
        <div class="mb-4">
          <FloralMonogramMedallion
            initial="Z"
            role="groom"
            fullName={content.couple.groom.fullName}
            parents={content.couple.groom.parents}
            instagram={content.couple.groom.instagram}
            quote={content.couple.groom.quote}
            size={120}
          />
        </div>
      </article>

      <!-- Profil Mempelai Wanita (Difa) -->
      <article class="couple-profile-card bg-white/95 border border-[#566A4E]/20 rounded-2xl p-6 sm:p-8 flex flex-col items-center text-center shadow-[0_12px_35px_rgba(42,52,38,0.06)] relative overflow-hidden interactive-foil-card" data-foil="true">
        <div class="absolute top-0 left-0 right-0 h-[2px] bg-gradient-to-r from-transparent via-[#B89352] to-transparent"></div>

        <!-- Bride Royal Botanical Monogram Medallion -->
        <div class="mb-4">
          <FloralMonogramMedallion
            initial="D"
            role="bride"
            fullName={content.couple.bride.fullName}
            parents={content.couple.bride.parents}
            instagram={content.couple.bride.instagram}
            quote={content.couple.bride.quote}
            size={120}
          />
        </div>
      </article>

    </div>

  </div>
</section>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  function initCoupleSection() {
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReducedMotion) return;

    gsap.fromTo(
      '.couple-profile-card',
      { opacity: 0, y: 30 },
      {
        opacity: 1,
        y: 0,
        duration: 0.9,
        stagger: 0.15,
        ease: 'power3.out',
        scrollTrigger: {
          trigger: '#couple',
          start: 'top 78%',
          once: true
        }
      }
    );
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCoupleSection);
  } else {
    initCoupleSection();
  }
</script>
