---
import content from '../data/content.json';
---

<div class="fixed bottom-5 right-5 sm:bottom-6 sm:right-6 z-[900] flex items-center gap-2 select-none">
  
  <!-- Floating Tooltip Pill (Song Info & Play State) -->
  <span 
    id="audio-status-pill" 
    class="inline-flex items-center gap-1.5 text-[0.62rem] sm:text-[0.68rem] tracking-wider uppercase px-3 py-1.5 rounded-full bg-white/95 backdrop-blur-md border border-[#566A4E]/30 text-[#2A3426] shadow-md pointer-events-none transition-all duration-300 opacity-0 font-medium max-w-[220px] truncate"
  >
    🎵 Adera – Muara
  </span>

  <!-- Floating Audio Button -->
  <button
    id="audio-toggle"
    class="relative w-11 h-11 sm:w-12 sm:h-12 rounded-full bg-white/95 backdrop-blur-md border border-[#566A4E]/35 text-[#566A4E] flex items-center justify-center shadow-[0_6px_20px_rgba(42,52,38,0.14)] hover:border-[#B89352] hover:bg-[#FAF8F5] active:scale-95 transition-all duration-300 cursor-pointer overflow-hidden group"
    type="button"
    aria-label="Nyalakan Musik Latar"
  >
    <div id="audio-glow-ring" class="absolute inset-0 rounded-full border border-[#B89352]/40 opacity-0 group-hover:opacity-100 transition-opacity"></div>

    <!-- Animated Equalizer Bars (Active State) -->
    <div id="audio-equalizer" class="hidden flex items-end gap-[3px] h-4">
      <span class="w-[2.5px] bg-[#566A4E] rounded-full h-full animate-[soundWave_0.8s_ease-in-out_infinite_alternate]"></span>
      <span class="w-[2.5px] bg-[#B89352] rounded-full h-3 animate-[soundWave_0.6s_ease-in-out_infinite_alternate_0.2s]"></span>
      <span class="w-[2.5px] bg-[#566A4E] rounded-full h-4 animate-[soundWave_0.9s_ease-in-out_infinite_alternate_0.1s]"></span>
      <span class="w-[2.5px] bg-[#B89352] rounded-full h-2 animate-[soundWave_0.7s_ease-in-out_infinite_alternate_0.3s]"></span>
    </div>

    <!-- Speaker Off Icon (Muted State) -->
    <svg id="icon-speaker-off" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
      <line x1="23" y1="9" x2="17" y2="15"></line>
      <line x1="17" y1="9" x2="23" y2="15"></line>
    </svg>
  </button>

</div>

<audio id="bg-audio" preload="auto" loop>
  <source src={content.music.file} type="audio/mpeg" />
</audio>

<style>
  @keyframes soundWave {
    0% { height: 20%; }
    100% { height: 100%; }
  }
</style>

<script>
  import gsap from 'gsap';
  import { playChimeSound } from './reactbits/SoundEffects';

  function initAudioPlayer() {
    const btn = document.getElementById('audio-toggle');
    const audio = document.getElementById('bg-audio') as HTMLAudioElement | null;
    const iconOff = document.getElementById('icon-speaker-off');
    const equalizer = document.getElementById('audio-equalizer');
    const pill = document.getElementById('audio-status-pill');

    if (!btn || !audio) return;

    let isPlaying = false;
    let pillTimer: any = null;

    function showPill(text: string, duration = 3500) {
      if (!pill) return;
      if (pillTimer) clearTimeout(pillTimer);
      pill.textContent = text;
      pill.style.opacity = '1';
      pillTimer = setTimeout(() => {
        if (pill) pill.style.opacity = '0';
      }, duration);
    }

    function setAudioState(playing: boolean) {
      isPlaying = playing;
      if (playing) {
        btn?.setAttribute('aria-label', 'Matikan Musik');
        if (iconOff) iconOff.classList.add('hidden');
        if (equalizer) equalizer.classList.remove('hidden');
        showPill('🎵 Adera – Muara', 3500);
      } else {
        btn?.setAttribute('aria-label', 'Nyalakan Musik');
        if (iconOff) iconOff.classList.remove('hidden');
        if (equalizer) equalizer.classList.add('hidden');
        showPill('Musik: Dijeda', 2000);
      }
    }

    function play(fadeIn = false) {
      if (!audio) return;
      
      // Ensure exact start at 0:00 intro if stopped
      if (audio.paused && audio.currentTime === 0) {
        audio.currentTime = 0;
      }

      if (fadeIn) {
        audio.volume = 0;
        audio.play().then(() => {
          setAudioState(true);
          gsap.to(audio, { volume: 0.70, duration: 2.5, ease: 'power1.out' });
        }).catch((e) => {
          console.warn('Audio autoplay restricted:', e);
          setAudioState(false);
        });
      } else {
        audio.play().then(() => {
          setAudioState(true);
          gsap.to(audio, { volume: 0.70, duration: 0.8, ease: 'power1.out' });
        }).catch(() => setAudioState(false));
      }
    }

    function pause() {
      if (!audio) return;
      gsap.to(audio, {
        volume: 0,
        duration: 0.6,
        ease: 'power1.in',
        onComplete: () => {
          audio.pause();
          setAudioState(false);
        }
      });
    }

    btn.addEventListener('click', () => {
      playChimeSound();
      if (isPlaying) {
        pause();
      } else {
        play(false);
      }
    });

    // Auto-play cleanly from 0:00 when invitation envelope opens
    window.addEventListener('invitationOpening', () => {
      play(true);
    });

    window.addEventListener('invitationOpened', () => {
      if (!isPlaying) {
        play(true);
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAudioPlayer);
  } else {
    initAudioPlayer();
  }
</script>
