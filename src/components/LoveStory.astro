---
import content from '../data/content.json';
---

<section id="love-story" class="deck-section tone-story relative w-full h-screen overflow-hidden z-60" aria-label="Kisah Perjalanan Mempelai">
  
  <!-- Subtle Ambient Glow -->
  <div class="absolute inset-0 pointer-events-none bg-gradient-to-r from-black/40 via-transparent to-black/40" aria-hidden="true"></div>

  <!-- Pinned Header in Viewport -->
  <div class="absolute top-8 left-6 sm:left-12 md:left-16 z-20 pointer-events-none">
    <div class="editorial-badge">
      <span>THE MEMOIR</span>
    </div>
    <h2 class="font-display text-2xl sm:text-3xl md:text-4xl text-pearl font-normal mt-0.5">
      Sebuah Awal Cerita
    </h2>
    <div class="flex items-center gap-2 mt-2 text-gold/80 text-[0.62rem] sm:text-xs tracking-[0.25em] uppercase font-light">
      <span>GULIR UNTUK MENYELAMI KISAH</span>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-gold animate-pulse">
        <path d="M5 12h14M12 5l7 7-7 7"/>
      </svg>
    </div>
  </div>

  <!-- Pinned Mini Progress & Step Counter at Bottom -->
  <div class="absolute bottom-8 left-6 sm:left-12 md:left-16 z-20 flex items-center gap-3.5 text-[0.65rem] sm:text-xs tracking-widest text-pearl-muted font-mono pointer-events-none">
    <span id="story-counter" class="text-gold font-medium">01 / 04</span>
    <div class="w-24 sm:w-36 h-[2px] bg-gold/20 rounded-full overflow-hidden">
      <div id="story-mini-progress" class="h-full bg-gold rounded-full w-1/4 transition-all duration-200"></div>
    </div>
  </div>

  <!-- Horizontal Pinned Scroll Track Container -->
  <div id="story-track" class="h-full flex items-center pl-8 sm:pl-24 md:pl-32 pr-24 sm:pr-48 w-max relative select-none">
    
    <!-- Sinuous Curving SVG Golden Ribbon Wave -->
    <svg id="story-ribbon-svg" class="absolute left-0 top-1/2 -translate-y-1/2 pointer-events-none" width="2800" height="340" viewBox="0 0 2800 340" fill="none">
      <path
        id="story-ribbon-path"
        d="M 60 170 C 320 30, 520 310, 800 170 C 1080 30, 1280 310, 1560 170 C 1840 30, 2040 310, 2320 170 L 2750 170"
        stroke="var(--color-accent-gold)"
        stroke-width="1.8"
        stroke-dasharray="3200"
        stroke-dashoffset="3200"
        opacity="0.65"
      />
    </svg>

    <!-- Alternating Floating Milestones along the Curving Wave -->
    {content.loveStory.map((item, idx) => {
      const isAbove = idx % 2 === 0;
      return (
        <div class={`story-item relative flex flex-col items-center w-[290px] sm:w-[350px] md:w-[390px] mx-8 sm:mx-16 md:mx-20 ${isAbove ? '-translate-y-14 sm:-translate-y-20' : 'translate-y-14 sm:translate-y-20'}`}>
          
          <!-- Node Dot on Ribbon -->
          <div class={`w-4 h-4 rounded-full border border-gold bg-[#0E1729] flex items-center justify-center my-2 shadow-[0_0_10px_rgba(212,179,118,0.5)] ${isAbove ? 'order-last mt-4' : 'order-first mb-4'}`}>
            <div class="w-1.5 h-1.5 rounded-full bg-gold"></div>
          </div>

          <!-- Editorial Milestone Card -->
          <article class="w-full bg-[#0A101D]/90 border border-gold/25 p-6 sm:p-7 rounded shadow-2xl hover:border-gold/50 transition-colors duration-300">
            <span class="text-[0.65rem] tracking-[0.25em] text-gold uppercase font-mono block mb-1">
              CHAPTER 0{idx + 1}
            </span>
            <div class="font-display text-2xl sm:text-3xl text-gold-bright mb-2">
              {item.year}
            </div>
            <h3 class="font-display text-lg sm:text-xl text-pearl font-normal mb-2 leading-snug">
              {item.title}
            </h3>
            <p class="text-xs sm:text-sm text-pearl-muted font-light leading-relaxed">
              {item.text}
            </p>
          </article>

        </div>
      );
    })}

  </div>

</section>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  function initHorizontalStory() {
    const section = document.getElementById('love-story');
    const track = document.getElementById('story-track');
    const ribbon = document.getElementById('story-ribbon-path');
    const counter = document.getElementById('story-counter');
    const miniProg = document.getElementById('story-mini-progress');
    if (!section || !track) return;

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReducedMotion) return;

    const getScrollDist = () => Math.max(0, track.scrollWidth - window.innerWidth);

    const storyTl = gsap.timeline();

    // 1. Move horizontal track
    storyTl.to(track, {
      x: () => -getScrollDist(),
      ease: 'none'
    });

    // 2. Draw sinuous golden ribbon concurrently
    if (ribbon) {
      storyTl.to(ribbon, {
        strokeDashoffset: 0,
        ease: 'none'
      }, 0);
    }

    // Pinned ScrollTrigger for Love Story
    ScrollTrigger.create({
      trigger: section,
      start: 'top top',
      end: () => `+=${getScrollDist() + window.innerHeight * 0.6}`,
      pin: true,
      animation: storyTl,
      scrub: 1,
      invalidateOnRefresh: true,
      onUpdate: (self) => {
        const step = Math.min(4, Math.floor(self.progress * 4) + 1);
        if (counter) counter.textContent = `0${step} / 04`;
        if (miniProg) miniProg.style.width = `${Math.max(25, self.progress * 100)}%`;
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHorizontalStory);
  } else {
    initHorizontalStory();
  }
</script>
