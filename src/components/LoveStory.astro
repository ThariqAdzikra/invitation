---
import content from '../data/content.json';
---

<section id="love-story" class="section-slide relative px-4" aria-label="Kisah Perjalanan Mempelai">
  <div class="max-w-3xl mx-auto w-full my-auto">
    
    <!-- Section Header -->
    <div class="text-center md:text-left mb-10 love-story-reveal">
      <p class="text-overline">Perjalanan Kami</p>
      <h2 class="font-display text-2xl sm:text-3xl md:text-4xl text-pearl font-normal mt-1.5">
        Sebuah Awal Cerita
      </h2>
    </div>

    <!-- Timeline Container -->
    <div class="relative pl-6 md:pl-0">
      
      <!-- Vertical SVG Scroll-Drawn Track -->
      <div class="absolute top-2 bottom-4 left-3 md:left-[28%] w-[2px] h-full pointer-events-none" aria-hidden="true">
        <svg width="2" height="100%" viewBox="0 0 2 800" preserveAspectRatio="none" fill="none">
          <line class="timeline-svg-track" x1="1" y1="0" x2="1" y2="800" stroke="var(--color-accent-gold)" stroke-width="2"/>
        </svg>
      </div>

      <!-- Timeline Items -->
      <div class="flex flex-col gap-12 md:gap-14">
        {content.loveStory.map((item) => (
          <div class="relative flex flex-col md:grid md:grid-cols-[24%_8%_1fr] items-start love-story-reveal">
            
            <!-- Year -->
            <div class="text-left md:text-right font-display text-2xl md:text-3xl text-gold-bright">
              {item.year}
            </div>

            <!-- Dot Indicator -->
            <div class="absolute -left-[19px] md:static w-3 h-3 rounded-full bg-gold mx-auto mt-2 border-2 border-navy-base shadow-gold-glow"></div>

            <!-- Content Card -->
            <div class="bg-navy-surface border border-navy-border border-l-2 border-l-gold p-5 rounded mt-2 md:mt-0 shadow-lg w-full">
              <h3 class="font-display text-xl text-pearl font-normal mb-1">
                {item.title}
              </h3>
              <p class="text-sm text-pearl-muted font-light leading-relaxed">
                {item.text}
              </p>
            </div>

          </div>
        ))}
      </div>

    </div>

  </div>

  <!-- Scroll Prompt -->
  <a href="#closing" class="scroll-prompt" aria-label="Gulir ke bagian penutup">
    <span>Penutup</span>
    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M7 13l5 5 5-5M7 6l5 5 5-5"/>
    </svg>
  </a>
</section>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  function initLoveStory() {
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReducedMotion) {
      const track = document.querySelector('.timeline-svg-track');
      if (track) track.classList.add('is-drawn');
      return;
    }

    // Draw SVG track on scroll
    ScrollTrigger.create({
      trigger: '#love-story',
      start: 'top 75%',
      once: true,
      onEnter: () => {
        const track = document.querySelector('.timeline-svg-track');
        if (track) track.classList.add('is-drawn');
      }
    });

    // Stagger reveal cards
    gsap.fromTo(
      '.love-story-reveal',
      { opacity: 0, y: 24 },
      {
        opacity: 1,
        y: 0,
        duration: 0.85,
        stagger: 0.16,
        ease: 'power3.out',
        scrollTrigger: {
          trigger: '#love-story',
          start: 'top 78%',
          once: true
        }
      }
    );
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initLoveStory);
  } else {
    initLoveStory();
  }
</script>
