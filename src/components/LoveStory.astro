---
import content from '../data/content.json';
---

<section id="love-story" class="section-flow relative px-4 overflow-hidden" aria-label="Kisah Perjalanan Mempelai">
  <div class="max-w-3xl mx-auto w-full">
    
    <!-- Section Header -->
    <div class="text-center md:text-left mb-12 love-story-header">
      <div class="editorial-badge">
        <span>THE MEMOIR</span>
      </div>
      <p class="text-overline tracking-[0.25em]">
        PERJALANAN KAMI
      </p>
      <h2 class="font-display text-2xl sm:text-3xl md:text-4xl text-pearl font-normal mt-1.5">
        Sebuah Awal Cerita
      </h2>
    </div>

    <!-- Timeline Container -->
    <div id="timeline-container" class="relative pl-6 md:pl-0">
      
      <!-- Vertical SVG Scroll-Drawn Golden Line Track -->
      <div class="absolute top-2 bottom-4 left-3 md:left-[28%] w-[2px] h-full pointer-events-none" aria-hidden="true">
        <svg width="2" height="100%" viewBox="0 0 2 800" preserveAspectRatio="none" fill="none">
          <line id="golden-thread-line" x1="1" y1="0" x2="1" y2="800" stroke="var(--color-accent-gold)" stroke-width="1.5" stroke-dasharray="800" stroke-dashoffset="800" opacity="0.6"/>
        </svg>
      </div>

      <!-- Timeline Items -->
      <div class="flex flex-col gap-10 md:gap-12">
        {content.loveStory.map((item, idx) => (
          <div class="timeline-row relative flex flex-col md:grid md:grid-cols-[24%_8%_1fr] items-start">
            
            <!-- Year -->
            <div class="timeline-year text-left md:text-right font-display text-2xl md:text-3xl text-gold-bright tracking-wider">
              {item.year}
            </div>

            <!-- Minimalist Dot Indicator -->
            <div class="timeline-dot absolute -left-[18px] md:static w-3 h-3 rounded-full bg-gold mx-auto mt-2.5 border border-navy-base"></div>

            <!-- Content Card -->
            <div class="timeline-card bg-navy-surface border border-gold/20 p-6 rounded mt-2 md:mt-0 hover:border-gold/40 transition-colors duration-300 w-full shadow-md">
              <h3 class="font-display text-xl text-pearl font-normal mb-1.5">
                {item.title}
              </h3>
              <p class="text-xs sm:text-sm text-pearl-muted font-light leading-relaxed">
                {item.text}
              </p>
            </div>

          </div>
        ))}
      </div>

    </div>

  </div>
</section>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  function initLoveStory() {
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReducedMotion) return;

    // Header reveal
    gsap.fromTo(
      '.love-story-header',
      { opacity: 0, y: 30 },
      {
        opacity: 1,
        y: 0,
        duration: 0.9,
        ease: 'power3.out',
        scrollTrigger: {
          trigger: '#love-story',
          start: 'top 80%',
          once: true
        }
      }
    );

    // Parallax draw golden line
    const threadLine = document.getElementById('golden-thread-line');
    if (threadLine) {
      gsap.to(threadLine, {
        strokeDashoffset: 0,
        ease: 'none',
        scrollTrigger: {
          trigger: '#timeline-container',
          start: 'top 70%',
          end: 'bottom 75%',
          scrub: 0.8
        }
      });
    }

    // Rows entrance
    const rows = gsap.utils.toArray('.timeline-row');
    rows.forEach((row: any) => {
      gsap.fromTo(
        row,
        { opacity: 0, y: 30 },
        {
          opacity: 1,
          y: 0,
          duration: 0.85,
          ease: 'power3.out',
          scrollTrigger: {
            trigger: row,
            start: 'top 82%',
            once: true
          }
        }
      );
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initLoveStory);
  } else {
    initLoveStory();
  }
</script>
