---
import content from '../data/content.json';
import FloralCorner from './botanical/FloralCorner.astro';
import FloralDivider from './botanical/FloralDivider.astro';
import FloralBouquet from './botanical/FloralBouquet.astro';
import FloralFlourish from './botanical/FloralFlourish.astro';
import TwinkleSparkles from './botanical/TwinkleSparkles.astro';
---

<section id="love-story" class="deck-section tone-story relative w-full h-screen overflow-hidden z-60" aria-label="Kisah Perjalanan Mempelai">
  
  <TwinkleSparkles />

  <!-- Subtle Ambient Glow -->
  <div class="absolute inset-0 pointer-events-none bg-gradient-to-r from-[#566A4E]/5 via-transparent to-[#566A4E]/5" aria-hidden="true"></div>

  <!-- Pinned Header in Viewport with Crown Bouquet -->
  <div class="absolute top-6 left-6 sm:left-12 md:left-16 z-20 pointer-events-none">
    <div class="mb-1 scale-80 origin-left">
      <FloralBouquet width={200} height={50} />
    </div>
    <div class="editorial-badge">
      <span>THE MEMOIR</span>
    </div>
    <h2 class="font-display text-2xl sm:text-3xl md:text-4xl text-[#2A3426] font-normal mt-0.5">
      Sebuah Awal Cerita
    </h2>
    <div class="my-1 scale-90 origin-left">
      <FloralFlourish width={160} height={26} />
    </div>
    <div class="flex items-center gap-2 mt-1 text-[#566A4E] text-[0.62rem] sm:text-xs tracking-[0.25em] uppercase font-medium">
      <span>GULIR UNTUK MENYELAMI KISAH</span>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="animate-pulse">
        <path d="M5 12h14M12 5l7 7-7 7"/>
      </svg>
    </div>
  </div>

  <!-- Pinned Mini Progress & Step Counter at Bottom -->
  <div class="absolute bottom-8 left-6 sm:left-12 md:left-16 z-20 flex items-center gap-3.5 text-[0.65rem] sm:text-xs tracking-widest text-[#566A4E] font-mono pointer-events-none">
    <span id="story-counter" class="text-[#2A3426] font-bold">01 / 04</span>
    <div class="w-24 sm:w-36 h-[2.5px] bg-[#566A4E]/20 rounded-full overflow-hidden">
      <div id="story-mini-progress" class="h-full bg-[#566A4E] rounded-full w-1/4 transition-all duration-200"></div>
    </div>
  </div>

  <!-- Horizontal Pinned Scroll Track Container -->
  <div id="story-track" class="h-full flex items-center pl-8 sm:pl-24 md:pl-32 pr-24 sm:pr-48 w-max relative select-none">
    
    <!-- Sinuous Curving SVG Olive Vine Ribbon -->
    <svg id="story-ribbon-svg" class="absolute left-0 top-1/2 -translate-y-1/2 pointer-events-none" width="2800" height="340" viewBox="0 0 2800 340" fill="none">
      <path
        id="story-ribbon-path"
        d="M 60 170 C 320 30, 520 310, 800 170 C 1080 30, 1280 310, 1560 170 C 1840 30, 2040 310, 2320 170 L 2750 170"
        stroke="#566A4E"
        stroke-width="2"
        stroke-dasharray="3200"
        stroke-dashoffset="3200"
        opacity="0.75"
      />
    </svg>

    <!-- Alternating Floating Milestones along the Curving Wave -->
    {content.loveStory.map((item, idx) => {
      const isAbove = idx % 2 === 0;
      return (
        <div class={`story-item relative flex flex-col items-center w-[290px] sm:w-[350px] md:w-[390px] mx-8 sm:mx-16 md:mx-20 ${isAbove ? '-translate-y-14 sm:-translate-y-20' : 'translate-y-14 sm:translate-y-20'}`}>
          
          <!-- Node Dot on Ribbon (Botanical Olive Bud with Gold Core) -->
          <div class={`w-6 h-6 rounded-full border-2 border-[#566A4E] bg-[#FFFFFF] flex items-center justify-center my-2 shadow-[0_4px_12px_rgba(86,106,78,0.35)] ${isAbove ? 'order-last mt-4' : 'order-first mb-4'}`}>
            <div class="w-2.5 h-2.5 rounded-full bg-[#B89352] animate-pulse"></div>
          </div>

          <!-- Editorial Milestone Card with 4 Botanical Flourishes & Inset Frame -->
          <article class="w-full bg-[#FFFFFF]/95 border border-[#566A4E]/25 p-6 sm:p-7 rounded-xl shadow-[0_16px_40px_rgba(42,52,38,0.08)] hover:border-[#566A4E] transition-colors duration-300 relative overflow-hidden">
            <!-- Inset Gold Hairline Frame -->
            <div class="absolute inset-2.5 border border-[#B89352]/25 rounded-lg pointer-events-none"></div>

            <!-- 4 Floral Corner Flourishes -->
            <div class="absolute top-1.5 left-1.5 pointer-events-none">
              <FloralCorner position="top-left" size={48} />
            </div>
            <div class="absolute top-1.5 right-1.5 pointer-events-none">
              <FloralCorner position="top-right" size={48} />
            </div>
            <div class="absolute bottom-1.5 left-1.5 pointer-events-none">
              <FloralCorner position="bottom-left" size={48} />
            </div>
            <div class="absolute bottom-1.5 right-1.5 pointer-events-none">
              <FloralCorner position="bottom-right" size={48} />
            </div>
            
            <div class="relative z-10">
              <span class="text-[0.65rem] tracking-[0.25em] text-[#B89352] uppercase font-mono block mb-1 font-semibold">
                CHAPTER 0{idx + 1}
              </span>
              <div class="font-display text-2xl sm:text-3xl text-[#2A3426] mb-1 font-normal">
                {item.year}
              </div>
              <h3 class="font-display text-lg sm:text-xl text-[#3E4C38] font-normal mb-2 leading-snug">
                {item.title}
              </h3>
              <p class="text-xs sm:text-sm text-[#566A4E] font-light leading-relaxed">
                {item.text}
              </p>
            </div>
          </article>

        </div>
      );
    })}

  </div>

</section>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  function initHorizontalStory() {
    const section = document.getElementById('love-story');
    const track = document.getElementById('story-track');
    const ribbonPath = document.getElementById('story-ribbon-path');
    const counterEl = document.getElementById('story-counter');
    const progressBar = document.getElementById('story-mini-progress');

    if (!section || !track) return;

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReducedMotion) return;

    const totalWidth = track.scrollWidth;
    const windowWidth = window.innerWidth;
    const scrollDistance = totalWidth - windowWidth;

    if (scrollDistance <= 0) return;

    const storyTimeline = gsap.timeline({
      scrollTrigger: {
        trigger: section,
        pin: true,
        scrub: 1.2,
        start: 'top top',
        end: () => `+=${scrollDistance}`,
        invalidateOnRefresh: true,
        onUpdate: (self) => {
          const progress = self.progress;
          if (progressBar) {
            progressBar.style.width = `${Math.max(20, progress * 100)}%`;
          }
          if (counterEl) {
            const step = Math.min(4, Math.floor(progress * 4) + 1);
            counterEl.textContent = `0${step} / 04`;
          }
        }
      }
    });

    storyTimeline.to(track, {
      x: () => -scrollDistance,
      ease: 'none'
    }, 0);

    if (ribbonPath) {
      storyTimeline.to(ribbonPath, {
        strokeDashoffset: 0,
        ease: 'none'
      }, 0);
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHorizontalStory);
  } else {
    initHorizontalStory();
  }
</script>