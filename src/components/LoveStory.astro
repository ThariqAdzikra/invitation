---
// LoveStory.astro — Vertical Editorial Timeline of the Couple's Journey
import content from '../data/content.json';
import FloralFlourish from './botanical/FloralFlourish.astro';
---

<section id="love-story" class="deck-section section-flow relative px-4 overflow-hidden z-60 pt-20 pb-24" aria-label="Kisah Perjalanan Mempelai">
  
  <div class="max-w-3xl mx-auto w-full relative z-10">
    
    <!-- Section Header -->
    <div class="text-center mb-12 md:mb-16 story-header">
      <p class="text-overline tracking-[0.28em]">
        KISAH KAMI
      </p>
      <h2 class="font-display text-3xl sm:text-4xl text-[#2A3426] font-normal mt-1.5">
        Sebuah Awal Cerita
      </h2>
      <div class="my-2 flex justify-center opacity-70">
        <FloralFlourish width={160} height={24} />
      </div>
      <p class="text-xs text-[#566A4E] font-light tracking-wider">
        Setiap babak perjalanan yang mengantarkan kami hingga hari ini
      </p>
    </div>

    <!-- Vertical Timeline Container -->
    <div class="relative max-w-2xl mx-auto">
      
      <!-- Central Vertical Line -->
      <div class="absolute left-4 md:left-1/2 top-4 bottom-4 w-[1.5px] bg-[#566A4E]/20 -translate-x-1/2"></div>

      <!-- Timeline Items -->
      <div class="flex flex-col gap-8 md:gap-12">
        {content.loveStory.map((item, idx) => {
          const isEven = idx % 2 === 0;
          return (
            <div class={`story-item relative flex flex-col md:flex-row items-start ${isEven ? 'md:flex-row-reverse' : ''} gap-6 md:gap-10 pl-10 md:pl-0`}>
              
              <!-- Timeline Dot Node -->
              <div class="absolute left-4 md:left-1/2 top-5 -translate-x-1/2 w-4 h-4 rounded-full border-2 border-[#566A4E] bg-white flex items-center justify-center shadow-sm z-10">
                <div class="w-1.5 h-1.5 rounded-full bg-[#B89352]"></div>
              </div>

              <!-- Card Content -->
              <article class={`w-full md:w-[calc(50%-2rem)] bg-white/95 border border-[#566A4E]/20 p-5 sm:p-7 rounded-2xl shadow-[0_10px_30px_rgba(42,52,38,0.05)] relative overflow-hidden interactive-foil-card ${isEven ? 'md:text-right' : 'md:text-left'}`} data-foil="true">
                <div class="absolute top-0 left-0 right-0 h-[2px] bg-gradient-to-r from-transparent via-[#B89352] to-transparent"></div>
                
                <span class="text-[0.62rem] tracking-[0.25em] text-[#B89352] uppercase font-semibold block mb-1">
                  CHAPTER 0{idx + 1}
                </span>
                
                <div class="font-display text-2xl sm:text-3xl text-[#2A3426] font-normal mb-1">
                  {item.year}
                </div>
                
                <h3 class="font-display text-base sm:text-lg text-[#3E4C38] font-normal mb-2 leading-snug">
                  {item.title}
                </h3>
                
                <p class="text-xs sm:text-sm text-[#566A4E] font-light leading-relaxed">
                  {item.text}
                </p>
              </article>

            </div>
          );
        })}
      </div>

    </div>

  </div>
</section>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  function initTimeline() {
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReducedMotion) return;

    gsap.utils.toArray<HTMLElement>('.story-item').forEach((item) => {
      gsap.fromTo(
        item,
        { opacity: 0, y: 25 },
        {
          opacity: 1,
          y: 0,
          duration: 0.8,
          ease: 'power3.out',
          scrollTrigger: {
            trigger: item,
            start: 'top 85%',
            once: true
          }
        }
      );
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initTimeline);
  } else {
    initTimeline();
  }
</script>
