---
// DigitalGift.astro — Amplop Digital & Tanda Kasih with Interactive QRIS Modal
import content from '../data/content.json';
import FloralFlourish from './botanical/FloralFlourish.astro';
---

<section id="gift" class="stacked-deck-card deck-section section-flow relative px-4 overflow-hidden z-[34] pt-24 sm:pt-28 pb-20 sm:pb-24 -mt-8 sm:-mt-12" aria-label="Tanda Kasih dan Amplop Digital">
  
  <div class="max-w-2xl mx-auto w-full relative z-10 text-center">
    
    <!-- Section Header -->
    <div class="mb-10 gift-header">
      <p class="text-overline tracking-[0.28em]">
        TANDA KASIH
      </p>
      <div class="kinetic-heading-mask my-1">
        <h2 class="font-display text-3xl sm:text-4xl text-[#2A3426] font-normal kinetic-heading-line">
          Amplop Digital
        </h2>
      </div>
      <div class="flex justify-center my-2 opacity-70">
        <FloralFlourish width={160} height={24} />
      </div>
      <p class="text-xs sm:text-sm text-[#566A4E] font-light leading-relaxed max-w-md mx-auto mt-2">
        Doa restu Anda merupakan karunia terindah bagi kami. Namun apabila Anda bermaksud memberikan tanda kasih, kami menyediakan tautan amplop digital di bawah ini:
      </p>
    </div>

    <!-- Bank Accounts Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-5 max-w-xl mx-auto mb-6">
      {content.gift.accounts.map((acc) => (
        <div class="gift-card bg-white/95 border border-[#566A4E]/20 rounded-2xl p-6 flex flex-col items-center shadow-[0_10px_30px_rgba(42,52,38,0.05)] relative overflow-hidden text-center interactive-foil-card" data-foil="true">
          <div class="absolute top-0 left-0 right-0 h-[2px] bg-gradient-to-r from-transparent via-[#B89352] to-transparent"></div>
          
          <span class="text-[0.62rem] tracking-[0.25em] text-[#B89352] uppercase font-semibold mb-1">
            {acc.bank}
          </span>
          
          <div class="font-mono text-lg sm:text-xl text-[#2A3426] font-semibold tracking-wider my-2.5 select-all">
            {acc.accountNumber}
          </div>
          
          <p class="text-xs text-[#566A4E] font-light mb-4">
            a.n. {acc.holder}
          </p>

          <button
            type="button"
            class="btn-copy-account inline-flex items-center gap-1.5 px-4 py-2 rounded-full border border-[#566A4E]/25 text-[0.68rem] tracking-widest uppercase font-semibold text-[#4A5D43] bg-[#FAF8F5] hover:bg-white hover:border-[#4A5D43] transition-all cursor-pointer shadow-sm active:scale-95"
            data-number={acc.accountNumber}
            data-bank={acc.code}
          >
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
              <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
            </svg>
            <span>Salin Nomor</span>
          </button>
        </div>
      ))}
    </div>

    <!-- QRIS Instant Action Button -->
    <div class="mb-8 flex justify-center">
      <button
        type="button"
        id="btn-open-qris"
        class="inline-flex items-center gap-2 px-6 py-3 rounded-full border border-[#B89352]/40 bg-gradient-to-r from-[#FAF8F5] via-white to-[#F5EFE4] text-xs font-semibold tracking-widest uppercase text-[#2A3426] shadow-[0_6px_20px_rgba(184,147,82,0.15)] hover:border-[#B89352] hover:bg-white active:scale-98 transition-all cursor-pointer group"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-[#B89352]">
          <rect x="3" y="3" width="7" height="7"></rect>
          <rect x="14" y="3" width="7" height="7"></rect>
          <rect x="14" y="14" width="7" height="7"></rect>
          <rect x="3" y="14" width="7" height="7"></rect>
        </svg>
        <span>Tampilkan QRIS Pembayaran</span>
        <span class="w-1.5 h-1.5 rounded-full bg-[#B89352] animate-ping"></span>
      </button>
    </div>

    <!-- Physical Gift Address Card -->
    <div class="gift-card bg-white/95 border border-[#566A4E]/20 rounded-2xl p-6 sm:p-8 max-w-xl mx-auto shadow-[0_10px_30px_rgba(42,52,38,0.05)] relative overflow-hidden text-center interactive-foil-card" data-foil="true">
      <div class="absolute top-0 left-0 right-0 h-[2px] bg-gradient-to-r from-transparent via-[#B89352] to-transparent"></div>

      <div class="w-10 h-10 rounded-full border border-[#B89352]/35 bg-[#FAF8F5] flex items-center justify-center text-[#B89352] mx-auto mb-3">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="20 12 20 22 4 22 4 12"></polyline>
          <rect x="2" y="7" width="20" height="5"></rect>
          <line x1="12" y1="22" x2="12" y2="7"></line>
          <path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z"></path>
          <path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"></path>
        </svg>
      </div>

      <h3 class="font-display text-base sm:text-lg text-[#2A3426] font-normal mb-1">
        Kirim Kado Fisik
      </h3>
      <p class="text-xs text-[#566A4E] font-medium mb-1">
        Penerima: {content.gift.shipping.recipient} ({content.gift.shipping.phone})
      </p>
      <p class="text-xs text-[#7E8F77] font-light max-w-md mx-auto leading-relaxed mb-4">
        {content.gift.shipping.address}
      </p>

      <button
        type="button"
        id="btn-copy-address"
        class="inline-flex items-center gap-1.5 px-4 py-2 rounded-full border border-[#566A4E]/25 text-[0.68rem] tracking-widest uppercase font-semibold text-[#4A5D43] bg-[#FAF8F5] hover:bg-white hover:border-[#4A5D43] transition-all cursor-pointer shadow-sm active:scale-95"
        data-address={`${content.gift.shipping.recipient} - ${content.gift.shipping.phone} - ${content.gift.shipping.address}`}
      >
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
          <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
        </svg>
        <span>Salin Alamat Lengkap</span>
      </button>
    </div>

  </div>

  <!-- =========================================================================
       LUXURY QRIS MODAL
       ========================================================================= -->
  <div 
    id="qris-modal" 
    class="fixed inset-0 z-[9999] flex items-center justify-center p-4 bg-black/50 backdrop-blur-sm opacity-0 pointer-events-none transition-all duration-300"
    role="dialog"
    aria-modal="true"
    aria-label="QRIS Pembayaran Digital"
  >
    <div 
      id="qris-modal-content"
      class="bg-[#FAF8F5] rounded-3xl border border-[#B89352]/40 p-6 sm:p-8 max-w-sm w-full mx-auto text-center shadow-2xl relative transform scale-90 transition-transform duration-300"
    >
      <!-- Close Button -->
      <button 
        type="button" 
        id="btn-close-qris" 
        class="absolute top-4 right-4 w-8 h-8 rounded-full bg-white border border-[#566A4E]/20 text-[#566A4E] hover:text-[#2A3426] flex items-center justify-center text-sm font-semibold transition-colors cursor-pointer"
        aria-label="Tutup"
      >
        &times;
      </button>

      <!-- QRIS Brand Header -->
      <div class="flex items-center justify-center gap-2 mb-3">
        <span class="text-xs font-black tracking-widest text-[#2A3426] uppercase">QRIS</span>
        <span class="text-[0.62rem] text-[#7E8F77]">Standar Pembayaran Nasional</span>
      </div>

      <!-- Wedding Header -->
      <p class="text-[0.65rem] tracking-[0.25em] text-[#B89352] uppercase font-semibold">
        THE WEDDING OF ARYA &amp; DIAN
      </p>
      <p class="text-xs text-[#566A4E] font-medium mt-0.5 mb-4">
        NMID: ID1020261212001 &bull; A&amp;D Wedding
      </p>

      <!-- Bespoke QR Code Box -->
      <div class="relative w-56 h-56 mx-auto bg-white p-3.5 rounded-2xl border-2 border-[#B89352]/40 shadow-inner flex items-center justify-center">
        <!-- SVG Generated QR Grid -->
        <svg viewBox="0 0 100 100" class="w-full h-full text-[#2A3426]">
          <!-- Top Left Finder -->
          <rect x="5" y="5" width="26" height="26" fill="none" stroke="currentColor" stroke-width="4" rx="2" />
          <rect x="11" y="11" width="14" height="14" fill="currentColor" rx="1" />
          <!-- Top Right Finder -->
          <rect x="69" y="5" width="26" height="26" fill="none" stroke="currentColor" stroke-width="4" rx="2" />
          <rect x="75" y="11" width="14" height="14" fill="currentColor" rx="1" />
          <!-- Bottom Left Finder -->
          <rect x="5" y="69" width="26" height="26" fill="none" stroke="currentColor" stroke-width="4" rx="2" />
          <rect x="11" y="75" width="14" height="14" fill="currentColor" rx="1" />
          
          <!-- Decorative Data Nodes -->
          <rect x="36" y="8" width="6" height="6" fill="currentColor" />
          <rect x="46" y="8" width="6" height="6" fill="currentColor" />
          <rect x="56" y="8" width="6" height="6" fill="currentColor" />
          <rect x="36" y="24" width="6" height="6" fill="currentColor" />
          <rect x="46" y="18" width="8" height="8" fill="currentColor" />
          <rect x="56" y="24" width="6" height="6" fill="currentColor" />

          <rect x="8" y="38" width="6" height="6" fill="currentColor" />
          <rect x="8" y="48" width="6" height="6" fill="currentColor" />
          <rect x="8" y="58" width="6" height="6" fill="currentColor" />
          <rect x="22" y="38" width="8" height="6" fill="currentColor" />
          <rect x="18" y="50" width="6" height="6" fill="currentColor" />

          <!-- Center Monogram Emblem -->
          <circle cx="50" cy="50" r="14" fill="#FAF8F5" stroke="#B89352" stroke-width="2" />
          <text x="50" y="54" font-family="'DM Serif Display', Georgia, serif" font-size="10" fill="#2A3426" text-anchor="middle" font-style="italic">AD</text>

          <rect x="72" y="38" width="6" height="6" fill="currentColor" />
          <rect x="84" y="44" width="8" height="6" fill="currentColor" />
          <rect x="70" y="52" width="6" height="8" fill="currentColor" />
          <rect x="86" y="58" width="6" height="6" fill="currentColor" />

          <rect x="38" y="72" width="6" height="6" fill="currentColor" />
          <rect x="48" y="78" width="8" height="8" fill="currentColor" />
          <rect x="60" y="72" width="6" height="6" fill="currentColor" />
          <rect x="38" y="86" width="6" height="6" fill="currentColor" />
          <rect x="52" y="88" width="8" height="6" fill="currentColor" />
          <rect x="70" y="80" width="8" height="8" fill="currentColor" />
          <rect x="84" y="84" width="6" height="6" fill="currentColor" />
        </svg>
      </div>

      <p class="text-[0.65rem] text-[#7E8F77] mt-3">
        Dapat dipindai melalui BCA, Mandiri, BSI, GoPay, OVO, ShopeePay, &amp; DANA
      </p>

      <button
        type="button"
        id="btn-copy-qris-info"
        class="mt-4 w-full py-2.5 rounded-full bg-[#4A5D43] text-white text-xs uppercase tracking-widest font-semibold hover:bg-[#384833] transition-colors cursor-pointer shadow-sm active:scale-98"
      >
        Salin Info Rekening
      </button>
    </div>
  </div>
</section>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { playChimeSound } from './reactbits/SoundEffects';

  gsap.registerPlugin(ScrollTrigger);

  function initDigitalGift() {
    const copyAccountButtons = document.querySelectorAll<HTMLButtonElement>('.btn-copy-account');
    const copyAddressBtn = document.getElementById('btn-copy-address') as HTMLButtonElement | null;
    
    const qrisModal = document.getElementById('qris-modal');
    const qrisModalContent = document.getElementById('qris-modal-content');
    const openQrisBtn = document.getElementById('btn-open-qris');
    const closeQrisBtn = document.getElementById('btn-close-qris');
    const copyQrisInfoBtn = document.getElementById('btn-copy-qris-info');

    // Copy Bank Account Number
    copyAccountButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        playChimeSound();
        const num = btn.dataset.number;
        const bank = btn.dataset.bank;
        if (num) {
          navigator.clipboard.writeText(num).then(() => {
            const originalText = btn.innerHTML;
            btn.innerHTML = `<span>✓ Tersalin!</span>`;
            setTimeout(() => {
              btn.innerHTML = originalText;
            }, 2000);

            if (typeof (window as any).showLuxuryToast === 'function') {
              (window as any).showLuxuryToast(`Nomor rekening ${bank} (${num}) berhasil disalin!`);
            }

            if (typeof (window as any).triggerLuxuryConfetti === 'function') {
              const rect = btn.getBoundingClientRect();
              (window as any).triggerLuxuryConfetti(rect.left + rect.width / 2, rect.top);
            }
          });
        }
      });
    });

    // Copy Physical Gift Address
    if (copyAddressBtn) {
      copyAddressBtn.addEventListener('click', () => {
        playChimeSound();
        const addr = copyAddressBtn.dataset.address;
        if (addr) {
          navigator.clipboard.writeText(addr).then(() => {
            if (typeof (window as any).showLuxuryToast === 'function') {
              (window as any).showLuxuryToast('Alamat kirim kado berhasil disalin!');
            }
            if (typeof (window as any).triggerLuxuryConfetti === 'function') {
              const rect = copyAddressBtn.getBoundingClientRect();
              (window as any).triggerLuxuryConfetti(rect.left + rect.width / 2, rect.top);
            }
          });
        }
      });
    }

    // Open QRIS Modal
    function openQRIS() {
      if (!qrisModal || !qrisModalContent) return;
      playChimeSound();
      qrisModal.classList.remove('opacity-0', 'pointer-events-none');
      qrisModal.classList.add('opacity-100', 'pointer-events-auto');
      qrisModalContent.classList.remove('scale-90');
      qrisModalContent.classList.add('scale-100');

      if (typeof (window as any).triggerLuxuryConfetti === 'function') {
        (window as any).triggerLuxuryConfetti(window.innerWidth / 2, window.innerHeight / 2 - 50);
      }
    }

    function closeQRIS() {
      if (!qrisModal || !qrisModalContent) return;
      qrisModal.classList.remove('opacity-100', 'pointer-events-auto');
      qrisModal.classList.add('opacity-0', 'pointer-events-none');
      qrisModalContent.classList.remove('scale-100');
      qrisModalContent.classList.add('scale-90');
    }

    if (openQrisBtn) openQrisBtn.addEventListener('click', openQRIS);
    if (closeQrisBtn) closeQrisBtn.addEventListener('click', closeQRIS);
    if (qrisModal) {
      qrisModal.addEventListener('click', (e) => {
        if (e.target === qrisModal) closeQRIS();
      });
    }

    if (copyQrisInfoBtn) {
      copyQrisInfoBtn.addEventListener('click', () => {
        playChimeSound();
        const text = 'Arya Wirayudha & Dian Paramitha (BSI: 7189201928 / BCA: 0439182910)';
        navigator.clipboard.writeText(text).then(() => {
          closeQRIS();
          if (typeof (window as any).showLuxuryToast === 'function') {
            (window as any).showLuxuryToast('Informasi rekening digital berhasil disalin!');
          }
        });
      });
    }

    // Scroll reveal animation
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!prefersReducedMotion) {
      gsap.fromTo(
        '.gift-card',
        { opacity: 0, y: 30 },
        {
          opacity: 1,
          y: 0,
          duration: 0.85,
          stagger: 0.12,
          ease: 'power3.out',
          scrollTrigger: {
            trigger: '#gift',
            start: 'top 80%',
            once: true
          }
        }
      );
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initDigitalGift);
  } else {
    initDigitalGift();
  }
</script>
