---
// IslamicSanctuaryOrnaments.astro — Sacred Moroccan Arabesque Filigree & Glowing Qandil Lanterns
// Created exclusively for Scene 2 (Ayat Suci QS Ar-Rum: 21)
// Conveys divine peace, sacred elegance, and reverence — completely distinct from garden flowers!
---

<div class="verse-thematic-sanctuary absolute inset-0 pointer-events-none z-0 overflow-hidden select-none" aria-hidden="true">
  
  <!-- =========================================================================
       1. FOUR SACRED GEOMETRIC ARABESQUE CORNER BRACKETS (Moroccan Arch Tracery)
       ========================================================================= -->
  <!-- Top-Left Arabesque Bracket -->
  <div class="absolute top-2 left-2 sm:top-4 sm:left-4 opacity-75">
    <svg width="110" height="110" viewBox="0 0 120 120" fill="none" class="w-20 sm:w-28 md:w-32 h-auto text-[#B89352]">
      <!-- Outer Border Arc -->
      <path d="M 4 116 L 4 4 L 116 4" stroke="#B89352" stroke-width="1.2" opacity="0.5" />
      <path d="M 12 108 L 12 12 L 108 12" stroke="#B89352" stroke-width="0.8" stroke-dasharray="3 3" opacity="0.4" />
      
      <!-- Central 8-Pointed Star (Khatam) -->
      <g transform="translate(32, 32)">
        <rect x="-8" y="-8" width="16" height="16" fill="none" stroke="#B89352" stroke-width="1.2" />
        <rect x="-8" y="-8" width="16" height="16" fill="none" stroke="#B89352" stroke-width="1.2" transform="rotate(45)" />
        <circle cx="0" cy="0" r="2.5" fill="#B89352" />
      </g>
      
      <!-- Moroccan Trefoil Cusped Arch Lines -->
      <path d="M 4 60 C 20 60, 35 45, 35 30 C 35 20, 25 12, 12 12" stroke="#B89352" stroke-width="1.2" />
      <path d="M 60 4 C 60 20, 45 35, 30 35 C 20 35, 12 25, 12 12" stroke="#B89352" stroke-width="1.2" />
      <path d="M 32 32 C 45 45, 60 55, 80 60 C 95 64, 110 65, 116 65" stroke="#B89352" stroke-width="1" opacity="0.6" />
      <path d="M 32 32 C 45 45, 55 60, 60 80 C 64 95, 65 110, 65 116" stroke="#B89352" stroke-width="1" opacity="0.6" />
      
      <!-- Gilded Starburst Accent -->
      <circle cx="108" cy="12" r="2" fill="#D4AF37" />
      <circle cx="12" cy="108" r="2" fill="#D4AF37" />
    </svg>
  </div>

  <!-- Top-Right Arabesque Bracket (Mirrored) -->
  <div class="absolute top-2 right-2 sm:top-4 sm:right-4 opacity-75">
    <svg width="110" height="110" viewBox="0 0 120 120" fill="none" class="w-20 sm:w-28 md:w-32 h-auto text-[#B89352] scale-x-[-1]">
      <path d="M 4 116 L 4 4 L 116 4" stroke="#B89352" stroke-width="1.2" opacity="0.5" />
      <path d="M 12 108 L 12 12 L 108 12" stroke="#B89352" stroke-width="0.8" stroke-dasharray="3 3" opacity="0.4" />
      <g transform="translate(32, 32)">
        <rect x="-8" y="-8" width="16" height="16" fill="none" stroke="#B89352" stroke-width="1.2" />
        <rect x="-8" y="-8" width="16" height="16" fill="none" stroke="#B89352" stroke-width="1.2" transform="rotate(45)" />
        <circle cx="0" cy="0" r="2.5" fill="#B89352" />
      </g>
      <path d="M 4 60 C 20 60, 35 45, 35 30 C 35 20, 25 12, 12 12" stroke="#B89352" stroke-width="1.2" />
      <path d="M 60 4 C 60 20, 45 35, 30 35 C 20 35, 12 25, 12 12" stroke="#B89352" stroke-width="1.2" />
      <path d="M 32 32 C 45 45, 60 55, 80 60 C 95 64, 110 65, 116 65" stroke="#B89352" stroke-width="1" opacity="0.6" />
      <path d="M 32 32 C 45 45, 55 60, 60 80 C 64 95, 65 110, 65 116" stroke="#B89352" stroke-width="1" opacity="0.6" />
      <circle cx="108" cy="12" r="2" fill="#D4AF37" />
      <circle cx="12" cy="108" r="2" fill="#D4AF37" />
    </svg>
  </div>

  <!-- Bottom-Left Arabesque Bracket -->
  <div class="absolute bottom-2 left-2 sm:bottom-4 sm:left-4 opacity-70">
    <svg width="110" height="110" viewBox="0 0 120 120" fill="none" class="w-18 sm:w-26 md:w-30 h-auto text-[#B89352] scale-y-[-1]">
      <path d="M 4 116 L 4 4 L 116 4" stroke="#B89352" stroke-width="1.2" opacity="0.5" />
      <path d="M 12 108 L 12 12 L 108 12" stroke="#B89352" stroke-width="0.8" stroke-dasharray="3 3" opacity="0.4" />
      <g transform="translate(32, 32)">
        <rect x="-8" y="-8" width="16" height="16" fill="none" stroke="#B89352" stroke-width="1.2" />
        <rect x="-8" y="-8" width="16" height="16" fill="none" stroke="#B89352" stroke-width="1.2" transform="rotate(45)" />
        <circle cx="0" cy="0" r="2.5" fill="#B89352" />
      </g>
      <circle cx="108" cy="12" r="2" fill="#D4AF37" />
    </svg>
  </div>

  <!-- Bottom-Right Arabesque Bracket -->
  <div class="absolute bottom-2 right-2 sm:bottom-4 sm:right-4 opacity-70">
    <svg width="110" height="110" viewBox="0 0 120 120" fill="none" class="w-18 sm:w-26 md:w-30 h-auto text-[#B89352] scale-[-1]">
      <path d="M 4 116 L 4 4 L 116 4" stroke="#B89352" stroke-width="1.2" opacity="0.5" />
      <path d="M 12 108 L 12 12 L 108 12" stroke="#B89352" stroke-width="0.8" stroke-dasharray="3 3" opacity="0.4" />
      <g transform="translate(32, 32)">
        <rect x="-8" y="-8" width="16" height="16" fill="none" stroke="#B89352" stroke-width="1.2" />
        <rect x="-8" y="-8" width="16" height="16" fill="none" stroke="#B89352" stroke-width="1.2" transform="rotate(45)" />
        <circle cx="0" cy="0" r="2.5" fill="#B89352" />
      </g>
      <circle cx="108" cy="12" r="2" fill="#D4AF37" />
    </svg>
  </div>

  <!-- =========================================================================
       2. TWO GILDED HANGING QANDIL LANTERNS (Left & Right Flanks)
       ========================================================================= -->
  <!-- Left Hanging Lantern (Visible on tablet & desktop) -->
  <div class="absolute top-0 left-4 sm:left-10 md:left-16 lg:left-24 hidden sm:flex flex-col items-center">
    <!-- Slender Gilded Suspension Chain -->
    <div class="w-[1px] h-20 md:h-28 bg-gradient-to-b from-[#B89352]/10 via-[#B89352]/50 to-[#B89352]"></div>
    
    <!-- Moroccan Qandil Lantern Silhouette with Warm Light -->
    <div class="relative flex items-center justify-center">
      <!-- Ambient Golden Light Halo -->
      <div class="absolute -inset-4 rounded-full bg-[radial-gradient(circle,rgba(255,214,120,0.45)_0%,rgba(212,175,55,0.15)_50%,transparent_75%)] blur-md animate-pulse"></div>
      
      <svg width="48" height="72" viewBox="0 0 48 72" fill="none" class="relative z-10 text-[#B89352] drop-shadow-md">
        <!-- Top Dome & Finial -->
        <circle cx="24" cy="4" r="2.5" fill="#D4AF37" />
        <path d="M 24 6 C 20 12, 16 16, 12 20 L 36 20 C 32 16, 28 12, 24 6 Z" fill="#B89352" />
        <!-- Lantern Glass Body -->
        <polygon points="12,20 8,46 16,56 32,56 40,46 36,20" fill="rgba(255, 246, 220, 0.45)" stroke="#B89352" stroke-width="1.2" />
        <line x1="24" y1="20" x2="24" y2="56" stroke="#B89352" stroke-width="0.9" stroke-dasharray="2 2" />
        <!-- Inner Glowing Candle Flame -->
        <circle cx="24" cy="38" r="4.5" fill="#FFF2CE" />
        <circle cx="24" cy="38" r="2.5" fill="#FFC83B" />
        <!-- Bottom Finial & Tassel Drop -->
        <polygon points="16,56 24,66 32,56" fill="#B89352" />
        <circle cx="24" cy="69" r="1.8" fill="#D4AF37" />
      </svg>
    </div>
  </div>

  <!-- Right Hanging Lantern (Mirrored Flank) -->
  <div class="absolute top-0 right-4 sm:right-10 md:right-16 lg:right-24 hidden sm:flex flex-col items-center">
    <div class="w-[1px] h-28 md:h-36 bg-gradient-to-b from-[#B89352]/10 via-[#B89352]/50 to-[#B89352]"></div>
    <div class="relative flex items-center justify-center">
      <div class="absolute -inset-4 rounded-full bg-[radial-gradient(circle,rgba(255,214,120,0.45)_0%,rgba(212,175,55,0.15)_50%,transparent_75%)] blur-md animate-pulse"></div>
      <svg width="48" height="72" viewBox="0 0 48 72" fill="none" class="relative z-10 text-[#B89352] drop-shadow-md">
        <circle cx="24" cy="4" r="2.5" fill="#D4AF37" />
        <path d="M 24 6 C 20 12, 16 16, 12 20 L 36 20 C 32 16, 28 12, 24 6 Z" fill="#B89352" />
        <polygon points="12,20 8,46 16,56 32,56 40,46 36,20" fill="rgba(255, 246, 220, 0.45)" stroke="#B89352" stroke-width="1.2" />
        <line x1="24" y1="20" x2="24" y2="56" stroke="#B89352" stroke-width="0.9" stroke-dasharray="2 2" />
        <circle cx="24" cy="38" r="4.5" fill="#FFF2CE" />
        <circle cx="24" cy="38" r="2.5" fill="#FFC83B" />
        <polygon points="16,56 24,66 32,56" fill="#B89352" />
        <circle cx="24" cy="69" r="1.8" fill="#D4AF37" />
      </svg>
    </div>
  </div>

</div>
