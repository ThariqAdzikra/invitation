---
// MinangkabauCornerAccents.astro — Authentic Minangkabau Songket Golden Filigree
// Created for UnifiedEvent (Akad & Resepsi di Padang, Sumatera Barat)
// Honors the rich cultural heritage of Ranah Minang with luxury hairline gold Pucuk Rebung motifs
---

<div class="minang-thematic-corners absolute inset-0 pointer-events-none z-0 overflow-hidden select-none" aria-hidden="true">
  
  <!-- Top-Left Pucuk Rebung Filigree Bracket -->
  <div class="absolute top-2 left-2 sm:top-4 sm:left-4 opacity-70">
    <svg width="120" height="120" viewBox="0 0 120 120" fill="none" class="w-20 sm:w-28 md:w-32 h-auto text-[#B89352]">
      <!-- Double Hairline Boundary -->
      <path d="M 6 114 L 6 6 L 114 6" stroke="#B89352" stroke-width="1.2" opacity="0.45" />
      <path d="M 12 108 L 12 12 L 108 12" stroke="#B89352" stroke-width="0.8" stroke-dasharray="2 3" opacity="0.35" />
      
      <!-- Authentic Pucuk Rebung (Triangular Bamboo Shoot Motif) -->
      <polygon points="12,12 28,4 44,12" fill="none" stroke="#B89352" stroke-width="1.1" />
      <polygon points="20,12 28,7 36,12" fill="#B89352" opacity="0.3" />
      <polygon points="12,12 4,28 12,44" fill="none" stroke="#B89352" stroke-width="1.1" />
      <polygon points="12,20 7,28 12,36" fill="#B89352" opacity="0.3" />
      
      <!-- Diamond Songket Floret (Bungo Melati) -->
      <polygon points="34,34 42,26 50,34 42,42" fill="none" stroke="#B89352" stroke-width="1.2" />
      <circle cx="42" cy="34" r="2.2" fill="#D4AF37" />
      
      <!-- Diagonal Traditional Connecting Filigree Arc -->
      <path d="M 44 12 C 55 18, 68 28, 80 44 C 92 60, 102 75, 108 92" stroke="#B89352" stroke-width="1" opacity="0.5" />
      <path d="M 12 44 C 18 55, 28 68, 44 80 C 60 92, 75 102, 92 108" stroke="#B89352" stroke-width="1" opacity="0.5" />
      
      <!-- Gilded Beads -->
      <circle cx="108" cy="12" r="2.2" fill="#D4AF37" />
      <circle cx="12" cy="108" r="2.2" fill="#D4AF37" />
    </svg>
  </div>

  <!-- Top-Right Pucuk Rebung Filigree Bracket (Mirrored) -->
  <div class="absolute top-2 right-2 sm:top-4 sm:right-4 opacity-70">
    <svg width="120" height="120" viewBox="0 0 120 120" fill="none" class="w-20 sm:w-28 md:w-32 h-auto text-[#B89352] scale-x-[-1]">
      <path d="M 6 114 L 6 6 L 114 6" stroke="#B89352" stroke-width="1.2" opacity="0.45" />
      <path d="M 12 108 L 12 12 L 108 12" stroke="#B89352" stroke-width="0.8" stroke-dasharray="2 3" opacity="0.35" />
      <polygon points="12,12 28,4 44,12" fill="none" stroke="#B89352" stroke-width="1.1" />
      <polygon points="20,12 28,7 36,12" fill="#B89352" opacity="0.3" />
      <polygon points="12,12 4,28 12,44" fill="none" stroke="#B89352" stroke-width="1.1" />
      <polygon points="12,20 7,28 12,36" fill="#B89352" opacity="0.3" />
      <polygon points="34,34 42,26 50,34 42,42" fill="none" stroke="#B89352" stroke-width="1.2" />
      <circle cx="42" cy="34" r="2.2" fill="#D4AF37" />
      <path d="M 44 12 C 55 18, 68 28, 80 44 C 92 60, 102 75, 108 92" stroke="#B89352" stroke-width="1" opacity="0.5" />
      <path d="M 12 44 C 18 55, 28 68, 44 80 C 60 92, 75 102, 92 108" stroke="#B89352" stroke-width="1" opacity="0.5" />
      <circle cx="108" cy="12" r="2.2" fill="#D4AF37" />
      <circle cx="12" cy="108" r="2.2" fill="#D4AF37" />
    </svg>
  </div>

  <!-- Bottom-Left Pucuk Rebung Filigree Bracket -->
  <div class="absolute bottom-2 left-2 sm:bottom-4 sm:left-4 opacity-60">
    <svg width="120" height="120" viewBox="0 0 120 120" fill="none" class="w-18 sm:w-26 md:w-28 h-auto text-[#B89352] scale-y-[-1]">
      <path d="M 6 114 L 6 6 L 114 6" stroke="#B89352" stroke-width="1.2" opacity="0.45" />
      <polygon points="12,12 28,4 44,12" fill="none" stroke="#B89352" stroke-width="1.1" />
      <polygon points="34,34 42,26 50,34 42,42" fill="none" stroke="#B89352" stroke-width="1.2" />
      <circle cx="42" cy="34" r="2.2" fill="#D4AF37" />
    </svg>
  </div>

  <!-- Bottom-Right Pucuk Rebung Filigree Bracket -->
  <div class="absolute bottom-2 right-2 sm:bottom-4 sm:right-4 opacity-60">
    <svg width="120" height="120" viewBox="0 0 120 120" fill="none" class="w-18 sm:w-26 md:w-28 h-auto text-[#B89352] scale-[-1]">
      <path d="M 6 114 L 6 6 L 114 6" stroke="#B89352" stroke-width="1.2" opacity="0.45" />
      <polygon points="12,12 28,4 44,12" fill="none" stroke="#B89352" stroke-width="1.1" />
      <polygon points="34,34 42,26 50,34 42,42" fill="none" stroke="#B89352" stroke-width="1.2" />
      <circle cx="42" cy="34" r="2.2" fill="#D4AF37" />
    </svg>
  </div>

</div>
