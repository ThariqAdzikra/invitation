---
interface Props {
  monogram?: string;
  size?: number;
  className?: string;
}

const { monogram = "AD", size = 76, className = "" } = Astro.props;
---

<div class={`inline-flex items-center justify-center relative text-gold ${className}`} style={`width: ${size}px; height: ${size}px;`}>
  <svg viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full h-full drop-shadow-[0_4px_16px_rgba(197,160,89,0.3)]">
    <!-- Fine Monoline Botanical Laurel Wreath -->
    <path d="M50 90C30 90 16 74 16 50C16 30 28 16 50 10" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
    <path d="M50 90C70 90 84 74 84 50C84 30 72 16 50 10" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
    
    <!-- Botanical Olive Leaves (Left) -->
    <path d="M20 72C12 70 10 62 16 58C20 62 22 68 20 72Z" stroke="currentColor" stroke-width="1" fill="rgba(197,160,89,0.12)"/>
    <path d="M16 52C8 48 8 40 14 38C18 42 18 48 16 52Z" stroke="currentColor" stroke-width="1" fill="rgba(197,160,89,0.12)"/>
    <path d="M24 34C18 28 20 20 26 20C28 26 28 30 24 34Z" stroke="currentColor" stroke-width="1" fill="rgba(197,160,89,0.12)"/>
    <path d="M38 20C34 14 38 8 44 10C44 16 42 20 38 20Z" stroke="currentColor" stroke-width="1" fill="rgba(197,160,89,0.12)"/>

    <!-- Botanical Olive Leaves (Right) -->
    <path d="M80 72C88 70 90 62 84 58C80 62 78 68 80 72Z" stroke="currentColor" stroke-width="1" fill="rgba(197,160,89,0.12)"/>
    <path d="M84 52C92 48 92 40 86 38C82 42 82 48 84 52Z" stroke="currentColor" stroke-width="1" fill="rgba(197,160,89,0.12)"/>
    <path d="M76 34C82 28 80 20 74 20C72 26 72 30 76 34Z" stroke="currentColor" stroke-width="1" fill="rgba(197,160,89,0.12)"/>
    <path d="M62 20C66 14 62 8 56 10C56 16 58 20 62 20Z" stroke="currentColor" stroke-width="1" fill="rgba(197,160,89,0.12)"/>

    <!-- Inner Hairline Ring -->
    <circle cx="50" cy="50" r="28" stroke="currentColor" stroke-width="0.8" stroke-dasharray="3 2" opacity="0.6"/>

    <!-- Central Monogram Glyphs -->
    <text x="50" y="58" text-anchor="middle" font-family="var(--font-display)" font-size="22" font-style="italic" fill="var(--color-accent-gold-bright)" letter-spacing="1">
      {monogram}
    </text>
  </svg>
</div>
