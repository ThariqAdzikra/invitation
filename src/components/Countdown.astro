---
import content from '../data/content.json';
import FloralDivider from './botanical/FloralDivider.astro';
import FloralBouquet from './botanical/FloralBouquet.astro';
import FloralFlourish from './botanical/FloralFlourish.astro';
import TwinkleSparkles from './botanical/TwinkleSparkles.astro';
import SceneTitleCard from './cinematic/SceneTitleCard.astro';
---

<section id="countdown" class="deck-section tone-countdown section-flow relative px-4 overflow-hidden z-50 pt-16 pb-20" aria-label="Hitung Mundur Acara"
         data-date={content.event.date} data-time={content.event.akad.time.split(' ')[0]} data-timezone={content.event.timezone}>
  
  <TwinkleSparkles />

  <div class="max-w-xl mx-auto text-center w-full relative z-10">
    
    <div class="countdown-header mb-6">
      <div class="mb-2 scale-90">
        <FloralBouquet width={220} height={55} />
      </div>
      
      <!-- Cinematic Scene Indicator Badge -->
      <div class="mb-3">
        <SceneTitleCard act="ACT V" title="THE CHRONOMETER" scene="SCENE 05" />
      </div>

      <p class="text-overline tracking-[0.25em]">
        MENGHITUNG HARI
      </p>
      <h2 class="font-display text-2xl sm:text-3xl md:text-4xl text-[#2A3426] font-normal mt-1.5 mb-2">
        Menuju Janji Suci
      </h2>
      <div class="flex justify-center my-1.5">
        <FloralFlourish width={180} height={30} />
      </div>
      <p class="text-xs text-[#566A4E] font-light italic max-w-sm mx-auto mt-1">
        Menanti detik demi detik menuju ikrar suci yang kami nanti
      </p>
    </div>

    <!-- Countdown Grid with Gold Corner Accents -->
    <div id="countdown-grid" class="grid grid-cols-4 gap-3 sm:gap-4 max-w-md mx-auto">
      
      <!-- Hari -->
      <div class="countdown-box bg-white/95 border border-[#566A4E]/25 rounded-xl p-3 sm:p-5 flex flex-col items-center shadow-[0_8px_25px_rgba(42,52,38,0.06)] hover:border-[#B89352] transition-colors duration-300 relative overflow-hidden">
        <div class="absolute top-0 left-0 right-0 h-[2px] bg-gradient-to-r from-transparent via-[#B89352] to-transparent"></div>
        <span id="countdown-days" class="font-display text-2xl sm:text-4xl md:text-5xl text-[#2A3426] font-normal tabular-nums">
          00
        </span>
        <span class="text-[0.62rem] sm:text-xs text-[#566A4E] uppercase tracking-widest mt-1.5 font-medium">Hari</span>
      </div>

      <!-- Jam -->
      <div class="countdown-box bg-white/95 border border-[#566A4E]/25 rounded-xl p-3 sm:p-5 flex flex-col items-center shadow-[0_8px_25px_rgba(42,52,38,0.06)] hover:border-[#B89352] transition-colors duration-300 relative overflow-hidden">
        <div class="absolute top-0 left-0 right-0 h-[2px] bg-gradient-to-r from-transparent via-[#B89352] to-transparent"></div>
        <span id="countdown-hours" class="font-display text-2xl sm:text-4xl md:text-5xl text-[#2A3426] font-normal tabular-nums">
          00
        </span>
        <span class="text-[0.62rem] sm:text-xs text-[#566A4E] uppercase tracking-widest mt-1.5 font-medium">Jam</span>
      </div>

      <!-- Menit -->
      <div class="countdown-box bg-white/95 border border-[#566A4E]/25 rounded-xl p-3 sm:p-5 flex flex-col items-center shadow-[0_8px_25px_rgba(42,52,38,0.06)] hover:border-[#B89352] transition-colors duration-300 relative overflow-hidden">
        <div class="absolute top-0 left-0 right-0 h-[2px] bg-gradient-to-r from-transparent via-[#B89352] to-transparent"></div>
        <span id="countdown-minutes" class="font-display text-2xl sm:text-4xl md:text-5xl text-[#2A3426] font-normal tabular-nums">
          00
        </span>
        <span class="text-[0.62rem] sm:text-xs text-[#566A4E] uppercase tracking-widest mt-1.5 font-medium">Menit</span>
      </div>

      <!-- Detik -->
      <div class="countdown-box bg-white/95 border border-[#566A4E]/25 rounded-xl p-3 sm:p-5 flex flex-col items-center shadow-[0_8px_25px_rgba(42,52,38,0.06)] hover:border-[#B89352] transition-colors duration-300 relative overflow-hidden">
        <div class="absolute top-0 left-0 right-0 h-[2px] bg-gradient-to-r from-transparent via-[#B89352] to-transparent"></div>
        <span id="countdown-seconds" class="font-display text-2xl sm:text-4xl md:text-5xl text-[#2A3426] font-normal tabular-nums">
          00
        </span>
        <span class="text-[0.62rem] sm:text-xs text-[#566A4E] uppercase tracking-widest mt-1.5 font-medium">Detik</span>
      </div>

    </div>

    <!-- Bottom Botanical Divider -->
    <div class="flex justify-center mt-6">
      <FloralDivider width={200} height={26} />
    </div>

    <!-- Passed Message -->
    <div id="countdown-passed" class="hidden text-[#2A3426] font-display text-xl my-4">
      Acara Telah Berlangsung
    </div>

  </div>
</section>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  function initCountdown() {
    const section = document.getElementById('countdown');
    if (!section) return;

    const dateStr = section.dataset.date;
    const timeStr = section.dataset.time || '08:00';
    if (!dateStr) return;

    const targetDate = new Date(`${dateStr}T${timeStr}:00+07:00`).getTime();

    const daysEl = document.getElementById('countdown-days');
    const hoursEl = document.getElementById('countdown-hours');
    const minutesEl = document.getElementById('countdown-minutes');
    const secondsEl = document.getElementById('countdown-seconds');
    const gridEl = document.getElementById('countdown-grid');
    const passedEl = document.getElementById('countdown-passed');

    function update() {
      const now = new Date().getTime();
      const diff = targetDate - now;

      if (diff <= 0) {
        if (gridEl) gridEl.classList.add('hidden');
        if (passedEl) passedEl.classList.remove('hidden');
        return;
      }

      const d = Math.floor(diff / (1000 * 60 * 60 * 24));
      const h = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
      const m = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
      const s = Math.floor((diff % (1000 * 60)) / 1000);

      if (daysEl) daysEl.textContent = String(d).padStart(2, '0');
      if (hoursEl) hoursEl.textContent = String(h).padStart(2, '0');
      if (minutesEl) minutesEl.textContent = String(m).padStart(2, '0');
      if (secondsEl) secondsEl.textContent = String(s).padStart(2, '0');
    }

    update();
    setInterval(update, 1000);

    // Scroll reveal animation
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!prefersReducedMotion) {
      gsap.fromTo(
        '.countdown-box',
        { opacity: 0, y: 30 },
        {
          opacity: 1,
          y: 0,
          duration: 0.8,
          stagger: 0.12,
          ease: 'power3.out',
          scrollTrigger: {
            trigger: '#countdown',
            start: 'top 80%',
            once: true
          }
        }
      );
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCountdown);
  } else {
    initCountdown();
  }
</script>