---
import content from '../data/content.json';
import ShinyText from './reactbits/ShinyText';
---

<section id="countdown" class="section-flow relative px-4 overflow-hidden" aria-label="Hitung Mundur Acara"
         data-date={content.event.date} data-time={content.event.akad.time.split(' ')[0]} data-timezone={content.event.timezone}>
  <div class="max-w-xl mx-auto text-center w-full relative z-10">
    
    <div class="countdown-header mb-8">
      <p class="text-overline tracking-[0.25em]">
        <ShinyText client:visible text="MENGHITUNG HARI" speed={4} />
      </p>
      <h2 class="font-display text-2xl sm:text-3xl md:text-4xl text-pearl font-normal mt-2">
        Menuju Janji Suci
      </h2>
    </div>

    <!-- Countdown Grid -->
    <div id="countdown-grid" class="grid grid-cols-4 gap-2.5 sm:gap-4 max-w-md mx-auto">
      
      <!-- Hari -->
      <div class="countdown-box bg-navy-surface border border-gold/30 rounded-xl p-3 sm:p-5 flex flex-col items-center shadow-[0_8px_24px_rgba(0,0,0,0.4)] hover:border-gold transition-colors duration-300">
        <span id="countdown-days" class="font-display text-2xl sm:text-4xl md:text-5xl text-gold-bright font-normal tabular-nums drop-shadow-[0_0_10px_rgba(226,201,138,0.4)]">
          00
        </span>
        <span class="text-[0.62rem] sm:text-xs text-pearl-muted uppercase tracking-widest mt-1.5 font-light">Hari</span>
      </div>

      <!-- Jam -->
      <div class="countdown-box bg-navy-surface border border-gold/30 rounded-xl p-3 sm:p-5 flex flex-col items-center shadow-[0_8px_24px_rgba(0,0,0,0.4)] hover:border-gold transition-colors duration-300">
        <span id="countdown-hours" class="font-display text-2xl sm:text-4xl md:text-5xl text-gold-bright font-normal tabular-nums drop-shadow-[0_0_10px_rgba(226,201,138,0.4)]">
          00
        </span>
        <span class="text-[0.62rem] sm:text-xs text-pearl-muted uppercase tracking-widest mt-1.5 font-light">Jam</span>
      </div>

      <!-- Menit -->
      <div class="countdown-box bg-navy-surface border border-gold/30 rounded-xl p-3 sm:p-5 flex flex-col items-center shadow-[0_8px_24px_rgba(0,0,0,0.4)] hover:border-gold transition-colors duration-300">
        <span id="countdown-minutes" class="font-display text-2xl sm:text-4xl md:text-5xl text-gold-bright font-normal tabular-nums drop-shadow-[0_0_10px_rgba(226,201,138,0.4)]">
          00
        </span>
        <span class="text-[0.62rem] sm:text-xs text-pearl-muted uppercase tracking-widest mt-1.5 font-light">Menit</span>
      </div>

      <!-- Detik -->
      <div class="countdown-box bg-navy-surface border border-gold/30 rounded-xl p-3 sm:p-5 flex flex-col items-center shadow-[0_8px_24px_rgba(0,0,0,0.4)] hover:border-gold transition-colors duration-300">
        <span id="countdown-seconds" class="font-display text-2xl sm:text-4xl md:text-5xl text-gold-bright font-normal tabular-nums drop-shadow-[0_0_10px_rgba(226,201,138,0.4)]">
          00
        </span>
        <span class="text-[0.62rem] sm:text-xs text-pearl-muted uppercase tracking-widest mt-1.5 font-light">Detik</span>
      </div>

    </div>

    <!-- Passed Message -->
    <div id="countdown-passed" class="hidden text-gold-bright font-display text-xl my-4">
      Hari Bahagia Telah Tiba &bull; Terima kasih atas doa restu Anda
    </div>

  </div>
</section>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  function initCountdown() {
    const section = document.getElementById('countdown');
    if (!section) return;

    const daysEl = document.getElementById('countdown-days');
    const hoursEl = document.getElementById('countdown-hours');
    const minutesEl = document.getElementById('countdown-minutes');
    const secondsEl = document.getElementById('countdown-seconds');
    const gridEl = document.getElementById('countdown-grid');
    const passedEl = document.getElementById('countdown-passed');

    const dateStr = section.getAttribute('data-date') || '2026-12-12';
    const timeStr = section.getAttribute('data-time') || '08:00';
    const tzStr = section.getAttribute('data-timezone') || 'WIB';

    const tzOffsets: Record<string, string> = { WIB: '+07:00', WITA: '+08:00', WIT: '+09:00' };
    const offset = tzOffsets[tzStr] || '+07:00';

    let cleanTime = timeStr.length === 5 ? `${timeStr}:00` : timeStr;
    const isoString = `${dateStr}T${cleanTime}${offset}`;
    let targetTime = new Date(isoString).getTime();

    if (isNaN(targetTime)) {
      targetTime = new Date(Date.now() + 30 * 24 * 60 * 60 * 1000).getTime();
    }

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function updateDigit(el: HTMLElement | null, val: string) {
      if (!el || el.textContent === val) return;
      el.textContent = val;

      if (!prefersReducedMotion) {
        gsap.fromTo(el, { scale: 1.1, opacity: 0.7 }, { scale: 1, opacity: 1, duration: 0.35, ease: 'power2.out' });
      }
    }

    function tick() {
      const diff = targetTime - Date.now();
      if (diff <= 0) {
        if (gridEl) gridEl.classList.add('hidden');
        if (passedEl) passedEl.classList.remove('hidden');
        return;
      }

      const days = Math.floor(diff / (1000 * 60 * 60 * 24));
      const hours = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
      const minutes = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
      const seconds = Math.floor((diff % (1000 * 60)) / 1000);

      updateDigit(daysEl, String(days).padStart(2, '0'));
      updateDigit(hoursEl, String(hours).padStart(2, '0'));
      updateDigit(minutesEl, String(minutes).padStart(2, '0'));
      updateDigit(secondsEl, String(seconds).padStart(2, '0'));
    }

    tick();
    setInterval(tick, 1000);

    // Celestial Time Pulse: Elastic Pop-In
    if (!prefersReducedMotion) {
      const tl = gsap.timeline({
        scrollTrigger: {
          trigger: '#countdown',
          start: 'top 80%',
          once: true
        }
      });

      tl.fromTo(
        '.countdown-header',
        { opacity: 0, y: 25 },
        { opacity: 1, y: 0, duration: 0.8, ease: 'power3.out' }
      );

      tl.fromTo(
        '.countdown-box',
        { opacity: 0, scale: 0.75, y: 30 },
        { opacity: 1, scale: 1, y: 0, duration: 0.9, stagger: 0.1, ease: 'back.out(1.6)' },
        '-=0.4'
      );
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCountdown);
  } else {
    initCountdown();
  }
</script>
