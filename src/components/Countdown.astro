---
// Countdown.astro — Section 2: Lokasi & Tempat Acara (Dedicated Venue Sanctuary Stele, Alamat & Navigasi Maps)
import content from '../data/content.json';
import FloralFlourish from './botanical/FloralFlourish.astro';
---

<section 
  id="location" 
  class="deck-section relative px-4 overflow-hidden z-30 pt-16 sm:pt-24 pb-24 sm:pb-32 min-h-[100vh] flex flex-col items-center justify-center" 
  aria-label="Lokasi dan Tempat Acara"
>
  
  <div id="venue-sanctuary-stele" class="max-w-xl mx-auto text-center w-full relative z-10 will-change-transform">
    
    <!-- Architectural Arched Venue Sanctuary Card -->
    <div 
      class="relative w-full max-w-lg mx-auto pt-8 sm:pt-10 pb-8 sm:pb-10 px-6 sm:px-10 rounded-t-[140px] sm:rounded-t-[160px] rounded-b-3xl border border-[#B89352]/35 bg-gradient-to-b from-[#FAF8F5]/96 via-[#FAF8F5]/92 to-[#FAF8F5]/96 backdrop-blur-md shadow-[0_12px_40px_rgba(42,52,38,0.07)]"
    >
      <!-- Inset Classical Dashed Arch Hairline -->
      <div class="absolute inset-2 sm:inset-3 rounded-t-[130px] sm:rounded-t-[150px] rounded-b-2xl border border-dashed border-[#B89352]/30 pointer-events-none"></div>

      <!-- Arch Crown: Compass / Location Pin with Gold Halo -->
      <div class="relative z-10 flex flex-col items-center justify-center mb-3">
        <div class="w-12 h-12 sm:w-14 sm:h-14 rounded-full border border-[#B89352]/50 bg-white/90 backdrop-blur-xs flex items-center justify-center text-[#B89352] shadow-[0_4px_16px_rgba(184,147,82,0.16)]">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
            <circle cx="12" cy="10" r="3"></circle>
          </svg>
        </div>
      </div>

      <!-- Overline & Section Title -->
      <div class="location-header mb-3 relative z-10">
        <p class="text-overline tracking-[0.32em] text-[0.62rem] sm:text-xs text-[#B89352] font-semibold uppercase mb-1">
          LOKASI &amp; TEMPAT
        </p>
        <h2 class="font-display text-3xl sm:text-4xl md:text-5xl text-[#2A3426] font-normal tracking-tight">
          {content.event.venue.name}
        </h2>
        <div class="flex justify-center my-2.5 opacity-70">
          <FloralFlourish width={130} height={16} />
        </div>
      </div>

      <!-- Full Venue Address -->
      <div class="relative z-10 max-w-md mx-auto mb-6 sm:mb-8">
        <p class="text-xs sm:text-sm text-[#4A5D43] font-light leading-relaxed">
          {content.event.venue.address}
        </p>
      </div>

      <!-- Action Navigation Buttons: Buka Google Maps & Salin Alamat -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-3 relative z-10 max-w-md mx-auto mb-7 sm:mb-8">
        <a 
          href={content.event.venue.mapsUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-7 py-3 rounded-full text-xs uppercase tracking-widest font-semibold bg-[#4A5D43] text-white hover:bg-[#384833] transition-all shadow-[0_4px_14px_rgba(74,93,67,0.22)] active:scale-95 group"
        >
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="group-hover:scale-110 transition-transform">
            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
            <circle cx="12" cy="10" r="3"></circle>
          </svg>
          <span>Buka Google Maps</span>
        </a>

        <button
          type="button"
          id="btn-copy-venue-address"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-1.5 px-6 py-3 rounded-full border border-[#566A4E]/30 text-xs tracking-wider uppercase font-semibold text-[#566A4E] bg-white/80 hover:bg-white hover:border-[#B89352] hover:text-[#B89352] transition-all cursor-pointer shadow-xs active:scale-95"
          data-address={content.event.venue.address}
        >
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
            <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
          </svg>
          <span>Salin Alamat</span>
        </button>
      </div>

      <!-- Venue Etiquette / Guidance Footer Badges -->
      <div class="pt-4 border-t border-[#B89352]/20 relative z-10 flex flex-col sm:flex-row items-center justify-center gap-3 sm:gap-4 text-center">
        <div class="inline-flex items-center gap-1.5 text-[0.68rem] sm:text-xs text-[#7E8F77]">
          <span class="w-1.5 h-1.5 rounded-full bg-[#B89352]"></span>
          <span>Area Parkir Tersedia</span>
        </div>
        <span class="hidden sm:inline text-[#B89352]/40 text-xs">•</span>
        <div class="inline-flex items-center gap-1.5 text-[0.68rem] sm:text-xs text-[#7E8F77]">
          <span class="w-1.5 h-1.5 rounded-full bg-[#B89352]"></span>
          <span>Akses Roda 2 &amp; Roda 4</span>
        </div>
        <span class="hidden sm:inline text-[#B89352]/40 text-xs">•</span>
        <div class="inline-flex items-center gap-1.5 text-[0.68rem] sm:text-xs text-[#7E8F77]">
          <span class="w-1.5 h-1.5 rounded-full bg-[#B89352]"></span>
          <span>Padang, Sumatera Barat</span>
        </div>
      </div>

    </div>

  </div>

</section>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  function initLocationSection() {
    const copyVenueBtn = document.getElementById('btn-copy-venue-address') as HTMLButtonElement | null;
    if (copyVenueBtn) {
      copyVenueBtn.addEventListener('click', () => {
        const addr = copyVenueBtn.dataset.address;
        if (addr) {
          navigator.clipboard.writeText(addr).then(() => {
            if ((window as any).showLuxuryToast) {
              (window as any).showLuxuryToast('Alamat venue berhasil disalin!');
            }
          });
        }
      });
    }

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReducedMotion) return;

    // Animate Venue Sanctuary Stele Entrance
    gsap.fromTo(
      '#venue-sanctuary-stele',
      { opacity: 0, y: 35, scale: 0.97 },
      {
        opacity: 1,
        y: 0,
        scale: 1,
        duration: 0.9,
        ease: 'power3.out',
        scrollTrigger: {
          trigger: '#location',
          start: 'top 80%',
          once: true
        }
      }
    );
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initLocationSection);
  } else {
    initLocationSection();
  }
</script>
