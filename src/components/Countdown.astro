---
import content from '../data/content.json';
---

<section id="countdown" class="deck-section tone-countdown section-flow relative px-4 overflow-hidden z-50" aria-label="Hitung Mundur Acara"
         data-date={content.event.date} data-time={content.event.akad.time.split(' ')[0]} data-timezone={content.event.timezone}>
  <div class="max-w-xl mx-auto text-center w-full relative z-10">
    
    <div class="countdown-header mb-8">
      <div class="editorial-badge">
        <span>THE CHRONOMETER</span>
      </div>
      <p class="text-overline tracking-[0.25em]">
        MENGHITUNG HARI
      </p>
      <h2 class="font-display text-2xl sm:text-3xl md:text-4xl text-pearl font-normal mt-2">
        Menuju Janji Suci
      </h2>
    </div>

    <!-- Countdown Grid -->
    <div id="countdown-grid" class="grid grid-cols-4 gap-3 sm:gap-4 max-w-md mx-auto">
      
      <!-- Hari -->
      <div class="countdown-box bg-navy-surface border border-gold/20 rounded p-3 sm:p-5 flex flex-col items-center hover:border-gold/50 transition-colors duration-300">
        <span id="countdown-days" class="font-display text-2xl sm:text-4xl md:text-5xl text-gold-bright font-normal tabular-nums">
          00
        </span>
        <span class="text-[0.62rem] sm:text-xs text-pearl-muted uppercase tracking-widest mt-1.5 font-light">Hari</span>
      </div>

      <!-- Jam -->
      <div class="countdown-box bg-navy-surface border border-gold/20 rounded p-3 sm:p-5 flex flex-col items-center hover:border-gold/50 transition-colors duration-300">
        <span id="countdown-hours" class="font-display text-2xl sm:text-4xl md:text-5xl text-gold-bright font-normal tabular-nums">
          00
        </span>
        <span class="text-[0.62rem] sm:text-xs text-pearl-muted uppercase tracking-widest mt-1.5 font-light">Jam</span>
      </div>

      <!-- Menit -->
      <div class="countdown-box bg-navy-surface border border-gold/20 rounded p-3 sm:p-5 flex flex-col items-center hover:border-gold/50 transition-colors duration-300">
        <span id="countdown-minutes" class="font-display text-2xl sm:text-4xl md:text-5xl text-gold-bright font-normal tabular-nums">
          00
        </span>
        <span class="text-[0.62rem] sm:text-xs text-pearl-muted uppercase tracking-widest mt-1.5 font-light">Menit</span>
      </div>

      <!-- Detik -->
      <div class="countdown-box bg-navy-surface border border-gold/20 rounded p-3 sm:p-5 flex flex-col items-center hover:border-gold/50 transition-colors duration-300">
        <span id="countdown-seconds" class="font-display text-2xl sm:text-4xl md:text-5xl text-gold-bright font-normal tabular-nums">
          00
        </span>
        <span class="text-[0.62rem] sm:text-xs text-pearl-muted uppercase tracking-widest mt-1.5 font-light">Detik</span>
      </div>

    </div>

    <!-- Passed Message -->
    <div id="countdown-passed" class="hidden text-gold-bright font-display text-xl my-4">
      Acara Telah Berlangsung
    </div>

  </div>
</section>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  function initCountdown() {
    const section = document.getElementById('countdown');
    if (!section) return;

    const targetDateStr = section.dataset.date;
    const targetTimeStr = section.dataset.time || '08:30';
    
    // Parse target date (UTC+7 for WIB)
    const targetDate = new Date(`${targetDateStr}T${targetTimeStr}:00+07:00`).getTime();

    const daysEl = document.getElementById('countdown-days');
    const hoursEl = document.getElementById('countdown-hours');
    const minutesEl = document.getElementById('countdown-minutes');
    const secondsEl = document.getElementById('countdown-seconds');
    const gridEl = document.getElementById('countdown-grid');
    const passedEl = document.getElementById('countdown-passed');

    function update() {
      const now = new Date().getTime();
      const distance = targetDate - now;

      if (distance < 0) {
        if (gridEl) gridEl.classList.add('hidden');
        if (passedEl) passedEl.classList.remove('hidden');
        return;
      }

      const days = Math.floor(distance / (1000 * 60 * 60 * 24));
      const hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
      const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
      const seconds = Math.floor((distance % (1000 * 60)) / 1000);

      if (daysEl) daysEl.textContent = String(days).padStart(2, '0');
      if (hoursEl) hoursEl.textContent = String(hours).padStart(2, '0');
      if (minutesEl) minutesEl.textContent = String(minutes).padStart(2, '0');
      if (secondsEl) secondsEl.textContent = String(seconds).padStart(2, '0');
    }

    update();
    const interval = setInterval(update, 1000);

    // Scroll Animation
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!prefersReducedMotion) {
      gsap.fromTo(
        '.countdown-header',
        { opacity: 0, y: 30 },
        {
          opacity: 1,
          y: 0,
          duration: 0.9,
          ease: 'power3.out',
          scrollTrigger: {
            trigger: '#countdown',
            start: 'top 80%',
            once: true
          }
        }
      );

      gsap.fromTo(
        '.countdown-box',
        { opacity: 0, y: 25, scale: 0.94 },
        {
          opacity: 1,
          y: 0,
          scale: 1,
          duration: 0.8,
          stagger: 0.08,
          ease: 'power3.out',
          scrollTrigger: {
            trigger: '#countdown-grid',
            start: 'top 85%',
            once: true
          }
        }
      );
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCountdown);
  } else {
    initCountdown();
  }
</script>
