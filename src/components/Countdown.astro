---
// Countdown.astro — Section 2: Lokasi & Tempat Acara (Dedicated Venue Sanctuary Stele, Alamat & Navigasi Maps)
import content from '../data/content.json';
import FloralFlourish from './botanical/FloralFlourish.astro';
import FloralCorner from './botanical/FloralCorner.astro';
---

<section 
  id="location" 
  class="deck-section relative px-4 z-30 pt-20 sm:pt-28 pb-24 sm:pb-32 min-h-[100vh] flex flex-col items-center justify-center" 
  aria-label="Lokasi dan Tempat Acara"
>
  
  <div id="venue-sanctuary-stele" class="max-w-xl mx-auto text-center w-full relative z-10 will-change-transform">
    
    <!-- Flanking Botanical Laurels (Desktop & Tablet Framing) -->
    <div class="hidden xl:block absolute -left-12 top-1/2 -translate-y-1/2 pointer-events-none select-none opacity-55">
      <svg width="40" height="200" viewBox="0 0 40 200" fill="none">
        <path d="M32 10 C 14 50, 10 120, 28 190" stroke="#B89352" stroke-width="1.2" stroke-dasharray="2 3" />
        <path d="M26 40 C 8 36, 6 25, 18 27 C 24 29, 26 36, 26 40 Z" fill="#4A5D43" opacity="0.7" />
        <path d="M28 80 C 10 76, 8 65, 20 67 C 26 69, 28 76, 28 80 Z" fill="#5E7455" opacity="0.65" />
        <path d="M24 125 C 6 121, 4 110, 16 112 C 22 114, 24 121, 24 125 Z" fill="#4A5D43" opacity="0.7" />
        <circle cx="18" cy="30" r="1.8" fill="#D4AF37" />
        <circle cx="22" cy="70" r="1.8" fill="#D4AF37" />
      </svg>
    </div>

    <div class="hidden xl:block absolute -right-12 top-1/2 -translate-y-1/2 pointer-events-none select-none opacity-55 scale-x-[-1]">
      <svg width="40" height="200" viewBox="0 0 40 200" fill="none">
        <path d="M32 10 C 14 50, 10 120, 28 190" stroke="#B89352" stroke-width="1.2" stroke-dasharray="2 3" />
        <path d="M26 40 C 8 36, 6 25, 18 27 C 24 29, 26 36, 26 40 Z" fill="#4A5D43" opacity="0.7" />
        <path d="M28 80 C 10 76, 8 65, 20 67 C 26 69, 28 76, 28 80 Z" fill="#5E7455" opacity="0.65" />
        <path d="M24 125 C 6 121, 4 110, 16 112 C 22 114, 24 121, 24 125 Z" fill="#4A5D43" opacity="0.7" />
        <circle cx="18" cy="30" r="1.8" fill="#D4AF37" />
        <circle cx="22" cy="70" r="1.8" fill="#D4AF37" />
      </svg>
    </div>

    <!-- Architectural Arched Venue Sanctuary Card -->
    <div 
      class="relative w-full max-w-lg mx-auto pt-8 sm:pt-10 pb-8 sm:pb-10 px-6 sm:px-10 rounded-t-[100px] sm:rounded-t-[120px] rounded-b-2xl border border-[#B89352]/35 bg-gradient-to-b from-[#FFFDF9] via-[#FAF8F5] to-[#F7F3EC] shadow-[0_20px_50px_rgba(42,52,38,0.10),0_4px_16px_rgba(184,147,82,0.10)]"
    >
      <!-- Inset Classical Dashed Arch Hairline -->
      <div class="absolute inset-2 sm:inset-3 rounded-t-[92px] sm:rounded-t-[112px] rounded-b-xl border border-dashed border-[#B89352]/30 pointer-events-none"></div>

      <!-- Authentic Watercolor Botanical Bottom Framing (Ranunculus, Blush Roses & Gold Foliage) -->
      <div class="absolute -bottom-4 -left-4 sm:-bottom-5 sm:-left-5 w-20 sm:w-24 pointer-events-none select-none z-20">
        <img src="/assets/floral-corner-bottom.png" alt="" class="w-full h-auto drop-shadow-sm opacity-90" loading="lazy" decoding="async" />
      </div>
      <div class="absolute -bottom-4 -right-4 sm:-bottom-5 sm:-right-5 w-20 sm:w-24 pointer-events-none select-none z-20 scale-x-[-1]">
        <img src="/assets/floral-corner-bottom.png" alt="" class="w-full h-auto drop-shadow-sm opacity-90" loading="lazy" decoding="async" />
      </div>

      <!-- Arch Crown: Astrolabe Celestial Compass & Location Sanctuary Medallion -->
      <div class="relative z-10 flex flex-col items-center justify-center mb-3">
        <div class="relative flex items-center justify-center">
          <!-- Astrolabe Celestial Orbital Compass Ring -->
          <svg width="84" height="84" viewBox="0 0 84 84" fill="none" class="absolute pointer-events-none select-none">
            <!-- Outer Dashed Orbital Ring -->
            <circle cx="42" cy="42" r="38" stroke="#B89352" stroke-width="0.8" stroke-dasharray="2 3" opacity="0.6" />
            <!-- Inner Degree Ring -->
            <circle cx="42" cy="42" r="32" stroke="#B89352" stroke-width="0.6" opacity="0.4" />
            <!-- Cardinal Star Coordinates -->
            <text x="42" y="10" text-anchor="middle" font-family="serif" font-size="7" fill="#B89352" font-weight="600">N</text>
            <text x="76" y="44" text-anchor="middle" font-family="serif" font-size="7" fill="#B89352" font-weight="600">E</text>
            <text x="42" y="79" text-anchor="middle" font-family="serif" font-size="7" fill="#B89352" font-weight="600">S</text>
            <text x="8" y="44" text-anchor="middle" font-family="serif" font-size="7" fill="#B89352" font-weight="600">W</text>
            <!-- 4 Cardinal Star Points -->
            <circle cx="42" cy="14" r="1.5" fill="#D4AF37" />
            <circle cx="70" cy="42" r="1.5" fill="#D4AF37" />
            <circle cx="42" cy="70" r="1.5" fill="#D4AF37" />
            <circle cx="14" cy="42" r="1.5" fill="#D4AF37" />
          </svg>

          <!-- Location Pin Medallion -->
          <div class="w-12 h-12 sm:w-14 sm:h-14 rounded-full border border-[#B89352]/50 bg-white/95 backdrop-blur-xs flex items-center justify-center text-[#B89352] shadow-[0_4px_16px_rgba(184,147,82,0.18)] relative z-10">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
              <circle cx="12" cy="10" r="3"></circle>
            </svg>
          </div>
        </div>
      </div>

      <!-- Overline & Section Title -->
      <div class="location-header mb-3 relative z-10">
        <p class="text-overline tracking-[0.32em] text-[0.62rem] sm:text-xs text-[#B89352] font-semibold uppercase mb-1">
          LOKASI &amp; TEMPAT
        </p>
        <h2 class="font-display text-3xl sm:text-4xl md:text-5xl text-[#2A3426] font-normal tracking-tight">
          {content.event.venue.name}
        </h2>
        <div class="flex justify-center my-2.5 opacity-70">
          <FloralFlourish width={130} height={16} />
        </div>
      </div>

      <!-- Full Venue Address -->
      <div class="relative z-10 max-w-md mx-auto mb-6 sm:mb-8">
        <p class="text-xs sm:text-sm text-[#4A5D43] font-light leading-relaxed">
          {content.event.venue.address}
        </p>
      </div>

      <!-- Action Navigation Buttons: Buka Google Maps & Salin Alamat (Tailored Rounded-XL, Non-White) -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-3 relative z-10 max-w-md mx-auto">
        <!-- Buka Google Maps (Forest Green) -->
        <a 
          href={content.event.venue.mapsUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-2.5 sm:px-7 sm:py-3 rounded-xl text-xs uppercase tracking-widest font-semibold bg-[#4A5D43] text-[#FAF8F5] hover:bg-[#384833] transition-all shadow-[0_4px_14px_rgba(74,93,67,0.22)] active:scale-95 group border border-[#4A5D43]"
        >
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="group-hover:scale-110 transition-transform">
            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
            <circle cx="12" cy="10" r="3"></circle>
          </svg>
          <span>Buka Google Maps</span>
        </a>

        <!-- Salin Alamat (Warm Antique Gold / Champagne Tint — No Stark White!) -->
        <button
          type="button"
          id="btn-copy-venue-address"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-2.5 sm:px-7 sm:py-3 rounded-xl text-xs tracking-wider uppercase font-semibold text-[#2A3426] bg-[#B89352]/20 hover:bg-[#B89352] hover:text-white border border-[#B89352]/70 transition-all cursor-pointer shadow-[0_4px_14px_rgba(184,147,82,0.12)] active:scale-95 group"
          data-address={content.event.venue.address}
        >
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-[#B89352] group-hover:text-white transition-colors">
            <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
            <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
          </svg>
          <span>Salin Alamat</span>
        </button>
      </div>

    </div>

  </div>

</section>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  function initLocationSection() {
    const copyVenueBtn = document.getElementById('btn-copy-venue-address') as HTMLButtonElement | null;
    if (copyVenueBtn) {
      copyVenueBtn.addEventListener('click', () => {
        const addr = copyVenueBtn.dataset.address;
        if (addr) {
          navigator.clipboard.writeText(addr).then(() => {
            if ((window as any).showLuxuryToast) {
              (window as any).showLuxuryToast('Alamat venue berhasil disalin!');
            }
          });
        }
      });
    }

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReducedMotion) return;

    // Animate Venue Sanctuary Stele Entrance
    gsap.fromTo(
      '#venue-sanctuary-stele',
      { opacity: 0, y: 35, scale: 0.97 },
      {
        opacity: 1,
        y: 0,
        scale: 1,
        duration: 0.9,
        ease: 'power3.out',
        scrollTrigger: {
          trigger: '#location',
          start: 'top 80%',
          once: true
        }
      }
    );
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initLocationSection);
  } else {
    initLocationSection();
  }
</script>
