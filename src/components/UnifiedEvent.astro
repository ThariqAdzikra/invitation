---
import content from '../data/content.json';
import FloralDivider from './botanical/FloralDivider.astro';
import FloralCorner from './botanical/FloralCorner.astro';
import FloralBouquet from './botanical/FloralBouquet.astro';
import FloralFlourish from './botanical/FloralFlourish.astro';
import TwinkleSparkles from './botanical/TwinkleSparkles.astro';
import SceneTitleCard from './cinematic/SceneTitleCard.astro';
---

<section id="events" class="deck-section tone-events section-flow relative px-4 overflow-hidden z-40 pt-16 pb-20" aria-label="Rangkaian Acara Pernikahan">
  
  <TwinkleSparkles />

  <div class="max-w-3xl mx-auto w-full relative z-10">
    
    <!-- Section Header with Crown Bouquet -->
    <div class="text-center mb-8 md:mb-12 event-header">
      <div class="mb-2 scale-90">
        <FloralBouquet width={240} height={60} />
      </div>
      
      <!-- Cinematic Scene Indicator Badge -->
      <div class="mb-3">
        <SceneTitleCard act="ACT IV" title="THE CEREMONY" scene="SCENE 04" />
      </div>

      <p class="text-overline tracking-[0.25em]">
        RANGKAIAN ACARA
      </p>
      <h2 class="font-display text-2xl sm:text-3xl md:text-4xl text-[#2A3426] font-normal mt-1.5">
        Waktu &amp; Tempat
      </h2>
      <div class="my-1.5">
        <FloralFlourish width={180} height={30} />
      </div>
    </div>

    <!-- Modern Botanical Event Card -->
    <article id="master-event-card" class="event-card-modern relative overflow-hidden bg-white/95 rounded-2xl border border-[#566A4E]/25 p-8 sm:p-12 text-center shadow-[0_16px_45px_rgba(42,52,38,0.08)]">
      
      <!-- Inset Gold Hairline Frame -->
      <div class="absolute inset-3 border border-[#B89352]/30 rounded-xl pointer-events-none"></div>

      <!-- 4 Botanical Corner Flourishes -->
      <div class="absolute top-3 left-3 pointer-events-none">
        <FloralCorner position="top-left" size={75} />
      </div>
      <div class="absolute top-3 right-3 pointer-events-none">
        <FloralCorner position="top-right" size={75} />
      </div>
      <div class="absolute bottom-3 left-3 pointer-events-none">
        <FloralCorner position="bottom-left" size={75} />
      </div>
      <div class="absolute bottom-3 right-3 pointer-events-none">
        <FloralCorner position="bottom-right" size={75} />
      </div>

      <!-- Intertwined Gold & Olive Wedding Rings Emblem -->
      <div class="w-14 h-14 rounded-full border border-[#B89352]/40 mx-auto flex items-center justify-center text-[#B89352] mb-5 bg-[#FAF8F3] shadow-sm relative">
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="9" cy="12" r="5.5"></circle>
          <circle cx="15" cy="12" r="5.5"></circle>
        </svg>
      </div>

      <!-- Tanggal Utama -->
      <p class="text-[0.68rem] tracking-[0.28em] text-[#B89352] uppercase font-semibold">
        HARI &amp; TANGGAL
      </p>
      <h3 class="font-display text-3xl sm:text-4xl md:text-5xl text-[#2A3426] font-normal mt-2 mb-3 tracking-tight">
        {content.event.dateFormatted}
      </h3>

      <div class="flex justify-center mb-6">
        <FloralDivider width={220} height={28} />
      </div>

      <!-- Dual Session Symmetrical Grid (Akad & Resepsi) -->
      <div class="grid grid-cols-1 md:grid-cols-[1fr_auto_1fr] items-center gap-6 my-6 py-6 border-y border-[#566A4E]/15">
        
        <!-- Sesi 1: Akad Nikah -->
        <div class="flex flex-col items-center">
          <span class="text-[0.68rem] tracking-widest text-[#B89352] uppercase font-semibold mb-1">{content.event.akad.title}</span>
          <p class="font-display text-xl sm:text-2xl text-[#2A3426] font-normal">
            Pukul {content.event.akad.time}
          </p>
        </div>

        <!-- Vertical Divider (Desktop) / Horizontal Divider (Mobile) -->
        <div class="hidden md:block w-[1px] h-12 bg-[#566A4E]/20 mx-2"></div>
        <div class="block md:hidden w-16 h-[1px] bg-[#566A4E]/20 mx-auto"></div>

        <!-- Sesi 2: Resepsi Pernikahan -->
        <div class="flex flex-col items-center">
          <span class="text-[0.68rem] tracking-widest text-[#B89352] uppercase font-semibold mb-1">{content.event.resepsi.title}</span>
          <p class="font-display text-xl sm:text-2xl text-[#2A3426] font-normal">
            Pukul {content.event.resepsi.time}
          </p>
        </div>

      </div>

      <!-- Lokasi & Venue Terpusat -->
      <div class="my-6">
        <p class="text-[0.68rem] text-[#566A4E] uppercase tracking-wider mb-1 font-medium">Bertempat di</p>
        <h4 class="font-display text-2xl md:text-3xl text-[#2A3426] font-normal mb-2">
          {content.event.venue.name}
        </h4>
        <p class="text-sm md:text-base text-[#566A4E] font-light max-w-md mx-auto leading-relaxed">
          {content.event.venue.address}
        </p>
      </div>

      <div class="my-3 flex justify-center">
        <FloralFlourish width={160} height={28} />
      </div>

      <!-- Tombol Aksi Minimalis Botanical -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mt-6">
        <a 
          href={content.event.mapsUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-olive-solid w-full sm:w-auto inline-flex items-center justify-center gap-2 px-7 py-3 rounded-xl text-xs uppercase tracking-widest font-semibold transition-all duration-300 shadow-sm"
        >
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
            <circle cx="12" cy="10" r="3"></circle>
          </svg>
          <span>Buka Google Maps</span>
        </a>

        <a 
          href={content.event.calendarUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-olive-outline w-full sm:w-auto inline-flex items-center justify-center gap-2 px-7 py-3 rounded-xl text-xs uppercase tracking-widest font-semibold transition-all duration-300"
        >
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
            <line x1="16" y1="2" x2="16" y2="6"></line>
            <line x1="8" y1="2" x2="8" y2="6"></line>
            <line x1="3" y1="10" x2="21" y2="10"></line>
          </svg>
          <span>Simpan ke Kalender</span>
        </a>
      </div>

    </article>

  </div>
</section>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  function initEventAnimation() {
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReducedMotion) return;

    gsap.fromTo(
      '#master-event-card',
      { opacity: 0, y: 35 },
      {
        opacity: 1,
        y: 0,
        duration: 1.0,
        ease: 'power3.out',
        scrollTrigger: {
          trigger: '#events',
          start: 'top 80%',
          once: true
        }
      }
    );
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initEventAnimation);
  } else {
    initEventAnimation();
  }
</script>