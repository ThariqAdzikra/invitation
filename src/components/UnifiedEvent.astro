---
// UnifiedEvent.astro — Open Classical Architectural Pavilion (Ceremony & Reception)
import content from '../data/content.json';
import FloralFlourish from './botanical/FloralFlourish.astro';
---

<section id="events" class="deck-section section-flow relative px-4 overflow-hidden z-30 pt-16 sm:pt-20 pb-20 sm:pb-24" aria-label="Rangkaian Acara Pernikahan">
  
  <div class="max-w-2xl mx-auto w-full relative z-10 text-center">
    
    <!-- Architectural Pavilion Card -->
    <div 
      id="event-pavilion-frame" 
      class="relative w-full max-w-2xl mx-auto rounded-[28px] sm:rounded-[36px] bg-white/92 backdrop-blur-md border border-[#B89352]/35 shadow-[0_16px_48px_rgba(42,52,38,0.06)] pt-12 sm:pt-14 pb-9 sm:pb-10 px-5 sm:px-9 text-center will-change-transform"
    >
      <!-- Gilded Stitched Inset Border -->
      <div class="absolute inset-2 sm:inset-3 border border-dashed border-[#B89352]/25 rounded-[22px] sm:rounded-[28px] pointer-events-none"></div>

      <!-- Arch Apex Crest: Gilded Wedding Rings Medallion -->
      <div class="absolute -top-6 left-1/2 -translate-x-1/2 flex items-center justify-center z-10">
        <div class="w-13 h-13 sm:w-14 sm:h-14 rounded-full border border-[#B89352]/50 bg-[#FAF8F5] flex items-center justify-center text-[#B89352] shadow-[0_6px_20px_rgba(184,147,82,0.22)]">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="9" cy="12" r="5.5"></circle>
            <circle cx="15" cy="12" r="5.5"></circle>
          </svg>
        </div>
      </div>

      <!-- Overline & Section Title -->
      <div class="event-header mb-5 relative z-10">
        <p class="text-overline tracking-[0.28em] text-[0.62rem] sm:text-xs text-[#B89352] font-semibold uppercase mb-1">
          RANGKAIAN ACARA
        </p>
        <div class="kinetic-heading-mask my-1">
          <h2 class="font-display text-2xl sm:text-3xl md:text-4xl text-[#2A3426] font-normal kinetic-heading-line">
            Waktu &amp; Tempat
          </h2>
        </div>
        <div class="my-2 flex justify-center opacity-75">
          <FloralFlourish width={140} height={18} />
        </div>
      </div>

      <!-- Main Highlighted Date Plaque -->
      <div class="inline-flex flex-col items-center bg-[#FAF8F5] border border-[#B89352]/30 rounded-2xl py-2 px-6 sm:px-8 mb-6 relative z-10 shadow-xs max-w-full">
        <span class="text-[0.62rem] sm:text-[0.68rem] tracking-[0.26em] text-[#566A4E] uppercase font-semibold mb-0.5">
          HARI &amp; TANGGAL
        </span>
        <h3 class="font-display text-xl sm:text-2xl md:text-3xl text-[#2A3426] font-normal tracking-tight">
          {content.event.dateFormatted}
        </h3>
      </div>

      <!-- Dual Symmetrical Sessions: Akad Nikah & Resepsi Pernikahan -->
      <div class="grid grid-cols-1 md:grid-cols-[1fr_auto_1fr] gap-3.5 sm:gap-4 items-stretch mb-5 relative z-10">
        
        <!-- Akad Nikah Wing -->
        <div class="rounded-2xl border border-[#B89352]/25 bg-[#FAF8F5]/90 p-4 sm:p-5 flex flex-col items-center justify-center text-center shadow-xs">
          <span class="inline-flex items-center gap-1.5 text-[0.65rem] sm:text-[0.68rem] tracking-[0.22em] text-[#B89352] uppercase font-semibold mb-1">
            <span class="w-1.5 h-1.5 rounded-full bg-[#B89352]"></span>
            {content.event.akad.title}
          </span>
          <p class="font-display text-lg sm:text-xl text-[#2A3426] font-normal my-0.5 whitespace-nowrap">
            Pukul {content.event.akad.time}
          </p>
          <span class="text-[0.68rem] text-[#7E8F77] italic font-light">
            Khidmat &amp; Sakral
          </span>
        </div>

        <!-- Center Gilded Divider Desktop -->
        <div class="hidden md:flex flex-col items-center justify-center px-1">
          <div class="w-[1px] h-7 bg-gradient-to-b from-transparent to-[#B89352]/45"></div>
          <span class="text-[#B89352] text-xs my-1 select-none">♦</span>
          <div class="w-[1px] h-7 bg-gradient-to-t from-transparent to-[#B89352]/45"></div>
        </div>

        <!-- Resepsi Pernikahan Wing -->
        <div class="rounded-2xl border border-[#B89352]/25 bg-[#FAF8F5]/90 p-4 sm:p-5 flex flex-col items-center justify-center text-center shadow-xs">
          <span class="inline-flex items-center gap-1.5 text-[0.65rem] sm:text-[0.68rem] tracking-[0.22em] text-[#B89352] uppercase font-semibold mb-1">
            <span class="w-1.5 h-1.5 rounded-full bg-[#B89352]"></span>
            {content.event.resepsi.title}
          </span>
          <p class="font-display text-lg sm:text-xl text-[#2A3426] font-normal my-0.5 whitespace-nowrap">
            Pukul {content.event.resepsi.time}
          </p>
          <span class="text-[0.68rem] text-[#7E8F77] italic font-light">
            Syukuran &amp; Doa Bersama
          </span>
        </div>

      </div>

      <!-- Venue & Location Block -->
      <div class="rounded-2xl border border-[#566A4E]/20 bg-[#FAF8F5]/70 p-4 sm:p-5 mb-5 relative z-10 text-center">
        <span class="text-[0.62rem] sm:text-xs text-[#566A4E] uppercase tracking-[0.22em] font-semibold mb-1 block">
          BERTEMPAT DI
        </span>
        <h4 class="font-display text-xl sm:text-2xl text-[#2A3426] font-normal mb-1">
          {content.event.venue.name}
        </h4>
        <p class="text-xs sm:text-[0.82rem] text-[#566A4E] font-light max-w-md mx-auto leading-relaxed mb-3">
          {content.event.venue.address}
        </p>

        <!-- 1-Click Copy Address Pill -->
        <button
          type="button"
          id="btn-copy-venue-address"
          class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full border border-[#566A4E]/25 text-[0.65rem] tracking-wider uppercase font-semibold text-[#566A4E] bg-white hover:bg-[#FAF8F5] hover:border-[#B89352] hover:text-[#B89352] transition-all cursor-pointer shadow-xs active:scale-95"
          data-address={content.event.venue.address}
        >
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
            <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
          </svg>
          <span>Salin Alamat Venue</span>
        </button>
      </div>

      <!-- Luxury Cohesive Action Buttons -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-3 relative z-10">
        <a 
          href={content.event.venue.mapsUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-2.5 rounded-full text-xs uppercase tracking-widest font-semibold bg-[#4A5D43] text-white hover:bg-[#384833] transition-all shadow-[0_4px_14px_rgba(74,93,67,0.22)] active:scale-95"
        >
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
            <circle cx="12" cy="10" r="3"></circle>
          </svg>
          <span>Buka Google Maps</span>
        </a>

        <a 
          href={content.event.venue.calendarUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-2.5 rounded-full text-xs uppercase tracking-widest font-semibold border-1.5 border-[#B89352]/50 text-[#4A5D43] bg-white hover:bg-[#FAF8F5] hover:border-[#4A5D43] transition-all shadow-xs active:scale-95"
        >
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
            <line x1="16" y1="2" x2="16" y2="6"></line>
            <line x1="8" y1="2" x2="8" y2="6"></line>
            <line x1="3" y1="10" x2="21" y2="10"></line>
          </svg>
          <span>Simpan ke Kalender</span>
        </a>
      </div>

    </div>

  </div>
</section>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  function initEventSection() {
    const copyVenueBtn = document.getElementById('btn-copy-venue-address') as HTMLButtonElement | null;
    if (copyVenueBtn) {
      copyVenueBtn.addEventListener('click', () => {
        const addr = copyVenueBtn.dataset.address;
        if (addr) {
          navigator.clipboard.writeText(addr).then(() => {
            if ((window as any).showLuxuryToast) {
              (window as any).showLuxuryToast('Alamat venue berhasil disalin!');
            }
          });
        }
      });
    }

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReducedMotion) return;

    // Elegant Haute-Couture Cascading Scroll Entrance for Pavilion
    const eventTl = gsap.timeline({
      scrollTrigger: {
        trigger: '#events',
        start: 'top 75%',
        once: true
      }
    });

    eventTl.fromTo(
      '#event-pavilion-frame',
      { opacity: 0, y: 35, scale: 0.98 },
      {
        opacity: 1,
        y: 0,
        scale: 1,
        duration: 0.95,
        ease: 'power3.out'
      }
    );
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initEventSection);
  } else {
    initEventSection();
  }
</script>
