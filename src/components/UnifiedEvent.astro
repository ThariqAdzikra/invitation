---
import content from '../data/content.json';
---

<section id="events" class="section-flow relative px-4 overflow-hidden" aria-label="Rangkaian Acara Pernikahan">
  <div class="max-w-3xl mx-auto w-full relative z-10">
    
    <!-- Section Header -->
    <div class="text-center mb-8 md:mb-12 event-header">
      <div class="editorial-badge">
        <span>THE CEREMONY</span>
      </div>
      <p class="text-overline tracking-[0.25em]">
        RANGKAIAN ACARA
      </p>
      <h2 class="font-display text-2xl sm:text-3xl md:text-4xl text-pearl font-normal mt-1.5">
        Waktu &amp; Tempat
      </h2>
    </div>

    <!-- Modern Minimalist Event Card -->
    <article id="master-event-card" class="event-card-modern">
      
      <!-- Minimalist Rings Monoline Icon -->
      <div class="w-12 h-12 rounded-full border border-gold/30 mx-auto flex items-center justify-center text-gold mb-6 bg-navy-base/40">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="9" cy="12" r="5.5"></circle>
          <circle cx="15" cy="12" r="5.5"></circle>
        </svg>
      </div>

      <!-- Tanggal Utama -->
      <p class="text-overline text-gold tracking-[0.2em]">
        HARI &amp; TANGGAL
      </p>
      <h3 class="font-display text-3xl sm:text-4xl md:text-5xl text-pearl font-normal mt-2 mb-8 tracking-tight">
        {content.event.dateFormatted}
      </h3>

      <!-- Dual Session Symmetrical Grid (Akad & Resepsi) -->
      <div class="grid grid-cols-1 md:grid-cols-[1fr_auto_1fr] items-center gap-6 my-8 py-6 border-y border-gold/15">
        
        <!-- Sesi 1: Akad Nikah -->
        <div class="flex flex-col items-center">
          <span class="text-overline text-gold mb-1 tracking-widest">{content.event.akad.title}</span>
          <p class="font-display text-xl sm:text-2xl text-pearl font-normal">
            Pukul {content.event.akad.time}
          </p>
        </div>

        <!-- Vertical Divider (Desktop) / Horizontal Divider (Mobile) -->
        <div class="hidden md:block w-[1px] h-12 bg-gold/20 mx-2"></div>
        <div class="block md:hidden w-16 h-[1px] bg-gold/20 mx-auto"></div>

        <!-- Sesi 2: Resepsi Pernikahan -->
        <div class="flex flex-col items-center">
          <span class="text-overline text-gold mb-1 tracking-widest">{content.event.resepsi.title}</span>
          <p class="font-display text-xl sm:text-2xl text-pearl font-normal">
            Pukul {content.event.resepsi.time}
          </p>
        </div>

      </div>

      <!-- Lokasi & Venue Terpusat -->
      <div class="my-6">
        <p class="text-overline text-gold-soft mb-1 tracking-wider">Bertempat di</p>
        <h4 class="font-display text-2xl md:text-3xl text-pearl font-normal mb-2">
          {content.event.venue.name}
        </h4>
        <p class="text-sm md:text-base text-pearl-muted font-light max-w-md mx-auto leading-relaxed">
          {content.event.venue.address}
        </p>
      </div>

      <!-- Tombol Aksi Minimalis -->
      <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-4">
        
        <!-- Google Maps -->
        <a href={content.event.venue.mapsUrl} target="_blank" rel="noopener noreferrer" class="btn-gold-solid w-full sm:w-auto">
          <span>Buka Google Maps</span>
          <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M4 12L12 4M12 4H6M12 4V10"/>
          </svg>
        </a>

        <!-- Kalender -->
        <button id="btn-save-calendar" class="btn-gold-outline w-full sm:w-auto">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
            <line x1="16" y1="2" x2="16" y2="6"></line>
            <line x1="8" y1="2" x2="8" y2="6"></line>
            <line x1="3" y1="10" x2="21" y2="10"></line>
          </svg>
          <span>Simpan ke Kalender</span>
        </button>

      </div>

    </article>

  </div>
</section>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { playChimeSound } from './reactbits/SoundEffects';

  gsap.registerPlugin(ScrollTrigger);

  function initUnifiedEvent() {
    // 1. Calendar (.ics download)
    const btnCal = document.getElementById('btn-save-calendar');
    if (btnCal) {
      btnCal.addEventListener('click', () => {
        playChimeSound();
        const icsContent = [
          'BEGIN:VCALENDAR',
          'VERSION:2.0',
          'PRODID:-//Undangan Pernikahan Arya & Dian//ID',
          'CALSCALE:GREGORIAN',
          'METHOD:PUBLISH',
          'BEGIN:VEVENT',
          'SUMMARY:Pernikahan Arya Pratama & Dian Anggraini',
          'DESCRIPTION:Walimatul Urs Arya & Dian. Bertempat di Hermes Palace Hotel Banda Aceh.',
          'LOCATION:Hermes Palace Hotel, Jl. T. Panglima Nyak Makam, Banda Aceh',
          'DTSTART:20261212T013000Z',
          'DTEND:20261212T090000Z',
          'STATUS:CONFIRMED',
          'END:VEVENT',
          'END:VCALENDAR'
        ].join('\r\n');

        const blob = new Blob([icsContent], { type: 'text/calendar;charset=utf-8' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = 'Pernikahan-Arya-dan-Dian.ics';
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        URL.revokeObjectURL(url);
      });
    }

    // 2. Scroll Animation
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!prefersReducedMotion) {
      gsap.fromTo(
        '.event-header',
        { opacity: 0, y: 30 },
        {
          opacity: 1,
          y: 0,
          duration: 0.9,
          ease: 'power3.out',
          scrollTrigger: {
            trigger: '#events',
            start: 'top 80%',
            once: true
          }
        }
      );

      gsap.fromTo(
        '#master-event-card',
        { opacity: 0, y: 35, scale: 0.97 },
        {
          opacity: 1,
          y: 0,
          scale: 1,
          duration: 1.0,
          ease: 'power3.out',
          scrollTrigger: {
            trigger: '#events',
            start: 'top 75%',
            once: true
          }
        }
      );
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initUnifiedEvent);
  } else {
    initUnifiedEvent();
  }
</script>
