---
// UnifiedEvent.astro — Open Editorial Botanical Stele with 3D Parallax Falling & Zooming Leaves
import content from '../data/content.json';
import FloralFlourish from './botanical/FloralFlourish.astro';
---

<section 
  id="events" 
  class="deck-section relative px-4 overflow-hidden z-30 pt-20 sm:pt-28 pb-24 sm:pb-36 min-h-[125vh] flex flex-col items-center justify-center" 
  aria-label="Rangkaian Acara Pernikahan"
>
  
  <!-- =========================================================================
       OPEN EDITORIAL BOTANICAL STELE (NO BOX CARDS)
       Pure High-Fashion Wedding Typography Resting Cleanly on Cream Linen
       ========================================================================= -->
  <div id="event-editorial-stele" class="max-w-2xl mx-auto w-full relative z-10 text-center will-change-transform">
    
    <!-- Top Rings Crest: Intertwined Rings with Gold Halo -->
    <div class="flex items-center justify-center mb-4">
      <div class="w-13 h-13 sm:w-14 sm:h-14 rounded-full border border-[#B89352]/50 bg-white/80 backdrop-blur-xs flex items-center justify-center text-[#B89352] shadow-[0_4px_16px_rgba(184,147,82,0.16)]">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="9" cy="12" r="5.5"></circle>
          <circle cx="15" cy="12" r="5.5"></circle>
        </svg>
      </div>
    </div>

    <!-- Overline & Section Title -->
    <div class="event-header mb-6">
      <p class="text-overline tracking-[0.32em] text-[0.62rem] sm:text-xs text-[#B89352] font-semibold uppercase mb-1">
        RANGKAIAN ACARA
      </p>
      <h2 class="font-display text-3xl sm:text-4xl md:text-5xl text-[#2A3426] font-normal tracking-tight">
        Waktu &amp; Tempat
      </h2>
      <div class="my-2.5 flex justify-center opacity-75">
        <FloralFlourish width={140} height={18} />
      </div>
    </div>

    <!-- Main Highlighted Date (Clean Double Gold Hairline Rules) -->
    <div class="my-6 sm:my-8 py-3.5 border-y border-[#B89352]/25 max-w-lg mx-auto">
      <span class="text-[0.62rem] sm:text-[0.68rem] tracking-[0.28em] text-[#566A4E] uppercase font-semibold block mb-0.5">
        HARI &amp; TANGGAL
      </span>
      <h3 class="font-display text-2xl sm:text-3xl md:text-4xl text-[#2A3426] font-normal tracking-normal">
        {content.event.dateFormatted}
      </h3>
    </div>

    <!-- Dual Symmetrical Sessions: Akad Nikah & Resepsi Pernikahan -->
    <div class="grid grid-cols-1 md:grid-cols-[1fr_auto_1fr] gap-6 sm:gap-8 items-center max-w-xl mx-auto my-7 sm:my-9">
      
      <!-- Akad Nikah Wing -->
      <div class="flex flex-col items-center text-center py-1">
        <span class="inline-flex items-center gap-1.5 text-[0.68rem] sm:text-[0.72rem] tracking-[0.22em] text-[#B89352] uppercase font-semibold mb-1">
          <span class="w-1.5 h-1.5 rounded-full bg-[#B89352]"></span>
          {content.event.akad.title}
        </span>
        <p class="font-display text-xl sm:text-2xl text-[#2A3426] font-normal my-0.5 whitespace-nowrap">
          Pukul {content.event.akad.time}
        </p>
        <span class="text-[0.70rem] text-[#7E8F77] italic font-light">
          Khidmat &amp; Sakral
        </span>
      </div>

      <!-- Center Gilded Divider Desktop -->
      <div class="hidden md:flex flex-col items-center justify-center px-2">
        <div class="w-[1px] h-8 bg-gradient-to-b from-transparent to-[#B89352]/45"></div>
        <span class="text-[#B89352] text-xs my-1 select-none">♦</span>
        <div class="w-[1px] h-8 bg-gradient-to-t from-transparent to-[#B89352]/45"></div>
      </div>
      <!-- Center Gilded Divider Mobile -->
      <div class="block md:hidden w-24 h-[1px] bg-gradient-to-r from-transparent via-[#B89352]/35 to-transparent mx-auto"></div>

      <!-- Resepsi Pernikahan Wing -->
      <div class="flex flex-col items-center text-center py-1">
        <span class="inline-flex items-center gap-1.5 text-[0.68rem] sm:text-[0.72rem] tracking-[0.22em] text-[#B89352] uppercase font-semibold mb-1">
          <span class="w-1.5 h-1.5 rounded-full bg-[#B89352]"></span>
          {content.event.resepsi.title}
        </span>
        <p class="font-display text-xl sm:text-2xl text-[#2A3426] font-normal my-0.5 whitespace-nowrap">
          Pukul {content.event.resepsi.time}
        </p>
        <span class="text-[0.70rem] text-[#7E8F77] italic font-light">
          Syukuran &amp; Doa Bersama
        </span>
      </div>

    </div>

    <!-- Venue & Location Block -->
    <div class="my-7 sm:my-9 max-w-lg mx-auto">
      <span class="text-[0.62rem] sm:text-xs text-[#566A4E] uppercase tracking-[0.24em] font-semibold mb-1.5 block">
        BERTEMPAT DI
      </span>
      <h4 class="font-display text-2xl sm:text-3xl text-[#2A3426] font-normal mb-1.5">
        {content.event.venue.name}
      </h4>
      <p class="text-xs sm:text-sm text-[#566A4E] font-light max-w-md mx-auto leading-relaxed mb-4">
        {content.event.venue.address}
      </p>

      <!-- 1-Click Copy Address Pill -->
      <button
        type="button"
        id="btn-copy-venue-address"
        class="inline-flex items-center gap-1.5 px-4 py-1.5 rounded-full border border-[#566A4E]/25 text-[0.65rem] tracking-wider uppercase font-semibold text-[#566A4E] bg-white/80 hover:bg-white hover:border-[#B89352] hover:text-[#B89352] transition-all cursor-pointer shadow-xs active:scale-95"
        data-address={content.event.venue.address}
      >
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
          <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
        </svg>
        <span>Salin Alamat Venue</span>
      </button>
    </div>

    <!-- Luxury Cohesive Action Buttons -->
    <div class="flex flex-col sm:flex-row items-center justify-center gap-3.5 mt-8 max-w-md mx-auto">
      <a 
        href={content.event.venue.mapsUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-7 py-2.5 rounded-full text-xs uppercase tracking-widest font-semibold bg-[#4A5D43] text-white hover:bg-[#384833] transition-all shadow-[0_4px_14px_rgba(74,93,67,0.22)] active:scale-95"
      >
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
          <circle cx="12" cy="10" r="3"></circle>
        </svg>
        <span>Buka Google Maps</span>
      </a>

      <a 
        href={content.event.venue.calendarUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-7 py-2.5 rounded-full text-xs uppercase tracking-widest font-semibold border-1.5 border-[#B89352]/50 text-[#4A5D43] bg-white hover:bg-[#FAF8F5] hover:border-[#4A5D43] transition-all shadow-xs active:scale-95"
      >
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
          <line x1="16" y1="2" x2="16" y2="6"></line>
          <line x1="8" y1="2" x2="8" y2="6"></line>
          <line x1="3" y1="10" x2="21" y2="10"></line>
        </svg>
        <span>Simpan ke Kalender</span>
      </a>
    </div>

  </div>

</section>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  function initEventSection() {
    const copyVenueBtn = document.getElementById('btn-copy-venue-address') as HTMLButtonElement | null;
    if (copyVenueBtn) {
      copyVenueBtn.addEventListener('click', () => {
        const addr = copyVenueBtn.dataset.address;
        if (addr) {
          navigator.clipboard.writeText(addr).then(() => {
            if ((window as any).showLuxuryToast) {
              (window as any).showLuxuryToast('Alamat venue berhasil disalin!');
            }
          });
        }
      });
    }

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReducedMotion) return;

    // 1. Entrance Fade-in for Open Editorial Typography
    gsap.fromTo(
      '#event-editorial-stele',
      { opacity: 0, y: 40 },
      {
        opacity: 1,
        y: 0,
        duration: 0.9,
        ease: 'power3.out',
        scrollTrigger: {
          trigger: '#events',
          start: 'top 75%',
          once: true
        }
      }
    );
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initEventSection);
  } else {
    initEventSection();
  }
</script>
