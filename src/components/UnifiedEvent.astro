---
// UnifiedEvent.astro — Ceremony & Reception Schedule
import content from '../data/content.json';
import FloralFlourish from './botanical/FloralFlourish.astro';
---

<section id="events" class="deck-section section-flow relative px-4 overflow-hidden z-40 pt-20 pb-24" aria-label="Rangkaian Acara Pernikahan">
  
  <div class="max-w-3xl mx-auto w-full relative z-10">
    
    <!-- Section Header -->
    <div class="text-center mb-10 md:mb-14 event-header">
      <p class="text-overline tracking-[0.28em]">
        RANGKAIAN ACARA
      </p>
      <h2 class="font-display text-3xl sm:text-4xl text-[#2A3426] font-normal mt-1.5">
        Waktu &amp; Tempat
      </h2>
      <div class="my-2 flex justify-center opacity-70">
        <FloralFlourish width={160} height={24} />
      </div>
    </div>

    <!-- Master Event Card -->
    <article id="master-event-card" class="bg-white/95 rounded-2xl border border-[#566A4E]/20 p-6 sm:p-10 md:p-12 text-center shadow-[0_16px_45px_rgba(42,52,38,0.06)] relative overflow-hidden">
      <!-- Top Gold Line -->
      <div class="absolute top-0 left-0 right-0 h-[2px] bg-gradient-to-r from-transparent via-[#B89352] to-transparent"></div>

      <!-- Wedding Ring Icon -->
      <div class="w-12 h-12 rounded-full border border-[#B89352]/40 mx-auto flex items-center justify-center text-[#B89352] mb-4 bg-[#FAF8F5] shadow-sm">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="9" cy="12" r="5.5"></circle>
          <circle cx="15" cy="12" r="5.5"></circle>
        </svg>
      </div>

      <!-- Main Date -->
      <p class="text-[0.62rem] tracking-[0.28em] text-[#B89352] uppercase font-semibold">
        HARI &amp; TANGGAL
      </p>
      <h3 class="font-display text-2xl sm:text-4xl md:text-5xl text-[#2A3426] font-normal mt-1 mb-6 tracking-tight">
        {content.event.dateFormatted}
      </h3>

      <!-- Dual Session Symmetrical Grid (Akad & Resepsi) -->
      <div class="grid grid-cols-1 md:grid-cols-[1fr_auto_1fr] items-center gap-6 my-6 py-6 border-y border-[#566A4E]/15">
        
        <!-- Akad Nikah -->
        <div class="flex flex-col items-center">
          <span class="text-[0.65rem] tracking-widest text-[#B89352] uppercase font-semibold mb-1">{content.event.akad.title}</span>
          <p class="font-display text-xl sm:text-2xl text-[#2A3426] font-normal">
            Pukul {content.event.akad.time}
          </p>
        </div>

        <!-- Vertical Divider (Desktop) / Horizontal Divider (Mobile) -->
        <div class="hidden md:block w-[1px] h-12 bg-[#566A4E]/20 mx-2"></div>
        <div class="block md:hidden w-16 h-[1px] bg-[#566A4E]/20 mx-auto"></div>

        <!-- Resepsi Pernikahan -->
        <div class="flex flex-col items-center">
          <span class="text-[0.65rem] tracking-widest text-[#B89352] uppercase font-semibold mb-1">{content.event.resepsi.title}</span>
          <p class="font-display text-xl sm:text-2xl text-[#2A3426] font-normal">
            Pukul {content.event.resepsi.time}
          </p>
        </div>

      </div>

      <!-- Venue & Location -->
      <div class="my-5">
        <p class="text-[0.65rem] text-[#566A4E] uppercase tracking-wider mb-1 font-medium">Bertempat di</p>
        <h4 class="font-display text-xl sm:text-2xl md:text-3xl text-[#2A3426] font-normal mb-1">
          {content.event.venue.name}
        </h4>
        <p class="text-xs sm:text-sm text-[#566A4E] font-light max-w-md mx-auto leading-relaxed mb-3">
          {content.event.venue.address}
        </p>

        <!-- 1-Click Copy Address Pill -->
        <button
          type="button"
          id="btn-copy-venue-address"
          class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full border border-[#566A4E]/20 text-[0.65rem] tracking-wider uppercase font-semibold text-[#566A4E] bg-[#FAF8F5] hover:bg-white hover:border-[#4A5D43] transition-all cursor-pointer shadow-sm active:scale-95"
          data-address={content.event.venue.address}
        >
          <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
            <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
          </svg>
          <span>Salin Alamat Venue</span>
        </button>
      </div>

      <!-- Clean Action Buttons -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-3.5 mt-8">
        <a 
          href={content.event.venue.mapsUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-2.5 rounded-full text-xs uppercase tracking-widest font-semibold bg-[#4A5D43] text-white hover:bg-[#384833] transition-colors shadow-sm"
        >
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
            <circle cx="12" cy="10" r="3"></circle>
          </svg>
          <span>Buka Google Maps</span>
        </a>

        <a 
          href={content.event.venue.calendarUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-2.5 rounded-full text-xs uppercase tracking-widest font-semibold border border-[#566A4E]/30 text-[#4A5D43] hover:border-[#4A5D43] hover:bg-[#FAF8F5] transition-colors"
        >
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
            <line x1="16" y1="2" x2="16" y2="6"></line>
            <line x1="8" y1="2" x2="8" y2="6"></line>
            <line x1="3" y1="10" x2="21" y2="10"></line>
          </svg>
          <span>Simpan ke Kalender</span>
        </a>
      </div>

    </article>

  </div>
</section>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  function initEventSection() {
    const copyVenueBtn = document.getElementById('btn-copy-venue-address') as HTMLButtonElement | null;
    if (copyVenueBtn) {
      copyVenueBtn.addEventListener('click', () => {
        const addr = copyVenueBtn.dataset.address;
        if (addr) {
          navigator.clipboard.writeText(addr).then(() => {
            if ((window as any).showLuxuryToast) {
              (window as any).showLuxuryToast('Alamat venue berhasil disalin!');
            }
          });
        }
      });
    }

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReducedMotion) return;

    gsap.fromTo(
      '#master-event-card',
      { opacity: 0, y: 30 },
      {
        opacity: 1,
        y: 0,
        duration: 0.9,
        ease: 'power3.out',
        scrollTrigger: {
          trigger: '#events',
          start: 'top 78%',
          once: true
        }
      }
    );
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initEventSection);
  } else {
    initEventSection();
  }
</script>
