---
// CinemaLetterbox.astro — 21:9 Widescreen Film Framing & Metadata
---

<div id="cinema-bars" class="opacity-0 transition-opacity duration-1000">
  <!-- Top Letterbox Bar -->
  <aside class="cinema-letterbox-top" aria-hidden="true">
    <span class="text-[0.58rem] sm:text-[0.65rem] tracking-[0.25em] text-gold/70 uppercase font-mono">
      24 FPS &bull; 2.39:1 WIDESCREEN
    </span>
    <span class="text-[0.55rem] sm:text-[0.62rem] tracking-[0.3em] text-pearl-muted/70 uppercase font-light hidden sm:inline">
      A LOVE STORY PRESENTATION
    </span>
    <span class="text-[0.58rem] sm:text-[0.65rem] tracking-[0.25em] text-gold/70 uppercase font-mono">
      12.12.2026
    </span>
  </aside>

  <!-- Bottom Letterbox Bar -->
  <aside class="cinema-letterbox-bottom" aria-hidden="true">
    <span class="text-[0.58rem] sm:text-[0.65rem] tracking-[0.25em] text-pearl-muted/70 uppercase font-mono">
      ARYA &amp; DIAN
    </span>
    <span class="text-[0.55rem] sm:text-[0.62rem] tracking-[0.3em] text-gold/60 uppercase font-light hidden sm:inline">
      BANDA ACEH, INDONESIA
    </span>
    <span class="text-[0.58rem] sm:text-[0.65rem] tracking-[0.25em] text-pearl-muted/70 uppercase font-mono">
      35MM COLOR GRADE
    </span>
  </aside>
</div>

<script>
  function initCinemaBars() {
    const bars = document.getElementById('cinema-bars');
    if (!bars) return;

    window.addEventListener('invitationOpening', () => {
      bars.style.opacity = '1';
    });

    if (!document.body.classList.contains('is-locked')) {
      bars.style.opacity = '1';
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCinemaBars);
  } else {
    initCinemaBars();
  }
</script>
