---
// GroomVector.astro — Refined Minimalist Editorial Groom Portrait Vector (Arya)
interface Props {
  size?: number;
}

const { size = 160 } = Astro.props;
---

<div class="relative flex items-center justify-center">
  <svg
    width={size}
    height={size}
    viewBox="0 0 160 160"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    class="w-full h-auto select-none"
    aria-label="Ilustrasi Mempelai Pria (Arya)"
  >
    <defs>
      <linearGradient id="groomBg" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0%" stop-color="#FAF8F5" />
        <stop offset="100%" stop-color="#EFE9DC" />
      </linearGradient>

      <linearGradient id="groomSuit" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#3A4836" />
        <stop offset="100%" stop-color="#243120" />
      </linearGradient>

      <linearGradient id="goldRing" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0%" stop-color="#D4AF6E" />
        <stop offset="100%" stop-color="#B89352" />
      </linearGradient>

      <linearGradient id="groomSkin" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#F7EFE4" />
        <stop offset="100%" stop-color="#EFE2D1" />
      </linearGradient>

      <clipPath id="circleClip">
        <circle cx="80" cy="80" r="74" />
      </clipPath>
    </defs>

    <!-- Outer Circular Gold Bezel -->
    <circle cx="80" cy="80" r="78" stroke="url(#goldRing)" stroke-width="1.8" />
    <circle cx="80" cy="80" r="75" stroke="#566A4E" stroke-width="0.8" stroke-dasharray="3 3" />

    <!-- Clipped Portrait Illustration -->
    <g clip-path="url(#circleClip)">
      <!-- Background Tone -->
      <circle cx="80" cy="80" r="74" fill="url(#groomBg)" />

      <!-- Subtle Monogram 'A' in Background -->
      <text
        x="80"
        y="115"
        font-family="'DM Serif Display', serif"
        font-size="95"
        fill="#566A4E"
        opacity="0.08"
        text-anchor="middle"
        font-style="italic"
      >
        A
      </text>

      <!-- Groom Suit Body -->
      <path
        d="M 30 160 L 32 120 C 35 105, 52 95, 68 92 L 92 92 C 108 95, 125 105, 128 120 L 130 160 Z"
        fill="url(#groomSuit)"
        stroke="#243120"
        stroke-width="1.2"
      />

      <!-- Crisp White Shirt Collar -->
      <polygon points="70,90 90,90 85,125 75,125" fill="#FFFFFF" />
      <polygon points="78,95 82,95 84,125 80,132 76,125" fill="#4A5D43" />
      <line x1="77" y1="108" x2="83" y2="108" stroke="url(#goldRing)" stroke-width="1.5" />

      <!-- Suit Lapels -->
      <polygon points="55,95 72,128 65,130 50,105" fill="#243120" />
      <polygon points="105,95 88,128 95,130 110,105" fill="#243120" />

      <!-- Boutonnière -->
      <g transform="translate(54, 110)">
        <path d="M 0 0 C -4 -4, -6 -1, -2 3 Z" fill="#6E8564" />
        <path d="M 2 -2 C 6 -5, 8 -1, 4 3 Z" fill="#B89352" />
        <circle cx="1" cy="0" r="2.5" fill="#FFFFFF" stroke="#B89352" stroke-width="0.6" />
      </g>

      <!-- Neck -->
      <path d="M 72 70 L 72 92 L 88 92 L 88 70 Z" fill="url(#groomSkin)" />

      <!-- Head Oval -->
      <ellipse cx="80" cy="58" rx="16" ry="21" fill="url(#groomSkin)" />

      <!-- Ears -->
      <ellipse cx="64" cy="58" rx="2.5" ry="4.5" fill="#EFE2D1" />
      <ellipse cx="96" cy="58" rx="2.5" ry="4.5" fill="#EFE2D1" />

      <!-- Modern Tailored Hair -->
      <path
        d="M 64 54 C 62 38, 74 30, 88 32 C 98 33, 101 44, 100 53 C 94 48, 88 50, 80 47 C 72 45, 66 52, 64 54 Z"
        fill="#263322"
      />
    </g>
  </svg>
</div>
