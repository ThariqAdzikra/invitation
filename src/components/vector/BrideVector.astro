---
// BrideVector.astro — Refined Minimalist Editorial Bride Portrait Vector (Dian)
interface Props {
  size?: number;
}

const { size = 160 } = Astro.props;
---

<div class="relative flex items-center justify-center">
  <svg
    width={size}
    height={size}
    viewBox="0 0 160 160"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    class="w-full h-auto select-none"
    aria-label="Ilustrasi Mempelai Wanita (Dian)"
  >
    <defs>
      <linearGradient id="brideBg" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0%" stop-color="#FAF8F5" />
        <stop offset="100%" stop-color="#EFE9DC" />
      </linearGradient>

      <linearGradient id="brideDress" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#FFFFFF" />
        <stop offset="100%" stop-color="#F2ECE0" />
      </linearGradient>

      <linearGradient id="goldRingBride" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0%" stop-color="#D4AF6E" />
        <stop offset="100%" stop-color="#B89352" />
      </linearGradient>

      <linearGradient id="brideSkin" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#F7EFE4" />
        <stop offset="100%" stop-color="#EFE2D1" />
      </linearGradient>

      <linearGradient id="veilFlow" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#FFFFFF" stop-opacity="0.75" />
        <stop offset="100%" stop-color="#E5DEC9" stop-opacity="0.3" />
      </linearGradient>

      <clipPath id="circleClipBride">
        <circle cx="80" cy="80" r="74" />
      </clipPath>
    </defs>

    <!-- Outer Circular Gold Bezel -->
    <circle cx="80" cy="80" r="78" stroke="url(#goldRingBride)" stroke-width="1.8" />
    <circle cx="80" cy="80" r="75" stroke="#566A4E" stroke-width="0.8" stroke-dasharray="3 3" />

    <!-- Clipped Portrait Illustration -->
    <g clip-path="url(#circleClipBride)">
      <!-- Background Tone -->
      <circle cx="80" cy="80" r="74" fill="url(#brideBg)" />

      <!-- Subtle Monogram 'D' in Background -->
      <text
        x="80"
        y="115"
        font-family="'DM Serif Display', serif"
        font-size="95"
        fill="#566A4E"
        opacity="0.08"
        text-anchor="middle"
        font-style="italic"
      >
        D
      </text>

      <!-- Translucent Veil Draping Behind Body -->
      <path
        d="M 50 65 C 40 85, 30 120, 25 160 L 135 160 C 130 120, 120 85, 110 65 Z"
        fill="url(#veilFlow)"
        stroke="#D5CCBC"
        stroke-width="0.8"
      />

      <!-- Bride Wedding Gown (V-Neck & Slender Shoulders) -->
      <path
        d="M 38 160 L 42 125 C 46 108, 62 98, 70 96 L 90 96 C 98 98, 114 108, 118 125 L 122 160 Z"
        fill="url(#brideDress)"
        stroke="#D5CCBC"
        stroke-width="1"
      />

      <!-- V-Neck Lace Detail -->
      <polygon points="70,96 90,96 80,120" fill="url(#brideSkin)" />
      <path d="M 70 96 L 80 120 L 90 96" stroke="url(#goldRingBride)" stroke-width="1" fill="none" />

      <!-- Bride Slender Neck -->
      <path d="M 73 68 L 73 96 L 87 96 L 87 68 Z" fill="url(#brideSkin)" />

      <!-- Pearl Necklace -->
      <path d="M 74 88 C 78 94, 82 94, 86 88" stroke="url(#goldRingBride)" stroke-width="1.2" fill="none" />
      <circle cx="80" cy="92" r="1.5" fill="#FAF8F5" stroke="url(#goldRingBride)" stroke-width="0.6" />

      <!-- Bride Head Oval -->
      <ellipse cx="80" cy="56" rx="15" ry="19" fill="url(#brideSkin)" />

      <!-- Ears & Pearl Earring -->
      <ellipse cx="65" cy="56" rx="2.2" ry="4" fill="#EFE2D1" />
      <ellipse cx="95" cy="56" rx="2.2" ry="4" fill="#EFE2D1" />
      <circle cx="65" cy="62" r="1.2" fill="url(#goldRingBride)" />
      <circle cx="95" cy="62" r="1.2" fill="url(#goldRingBride)" />

      <!-- Bridal Hair (Soft Waves & Chignon) -->
      <path
        d="M 65 52 C 63 36, 75 28, 88 30 C 97 32, 98 42, 96 52 C 92 46, 86 48, 80 46 C 73 44, 68 50, 65 52 Z"
        fill="#2D231E"
      />
      <!-- Chignon Bun at Back -->
      <ellipse cx="94" cy="46" rx="7" ry="8" fill="#2D231E" />

      <!-- Botanical Gold Tiara / Floral Hairpins -->
      <g transform="translate(85, 38)" fill="url(#goldRingBride)">
        <circle cx="-10" cy="0" r="1.8" />
        <circle cx="-5" cy="-2.5" r="2.2" />
        <circle cx="0" cy="0" r="1.8" />
        <circle cx="5" cy="-2" r="1.5" />
        <path d="M -12 2 C -5 -1, 3 -1, 8 2" stroke="url(#goldRingBride)" stroke-width="0.8" fill="none" />
      </g>
    </g>
  </svg>
</div>
