---
// CoupleHeroVector.astro — Aesthetic Minimalist Wedding Vector Illustration (Arya & Dian)
// Refined editorial line art with soft watercolor tone washes & animated gold contours
interface Props {
  width?: number;
  height?: number;
  className?: string;
}

const { width = 300, height = 400, className = '' } = Astro.props;
---

<div class={`relative flex items-center justify-center ${className}`}>
  <svg
    id="hero-vector-svg"
    width={width}
    height={height}
    viewBox="0 0 300 400"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    class="w-full h-auto max-w-[320px] drop-shadow-sm select-none"
    aria-label="Ilustrasi Pasangan Mempelai Arya & Dian"
  >
    <defs>
      <!-- Subtle Golden Glow Filter -->
      <filter id="goldGleam" x="-10%" y="-10%" width="120%" height="120%">
        <feDropShadow dx="0" dy="2" stdDeviation="3" flood-color="#B89352" flood-opacity="0.25" />
      </filter>

      <!-- Soft Tone Gradients -->
      <linearGradient id="suitTone" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#3A4836" />
        <stop offset="100%" stop-color="#263322" />
      </linearGradient>

      <linearGradient id="dressTone" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#FFFFFF" />
        <stop offset="100%" stop-color="#F2ECE0" />
      </linearGradient>

      <linearGradient id="veilSheer" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#FFFFFF" stop-opacity="0.6" />
        <stop offset="100%" stop-color="#EAE3D2" stop-opacity="0.2" />
      </linearGradient>

      <linearGradient id="goldAccent" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0%" stop-color="#D4AF6E" />
        <stop offset="100%" stop-color="#B89352" />
      </linearGradient>

      <linearGradient id="skinTone" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#F7EFE4" />
        <stop offset="100%" stop-color="#EFE2D1" />
      </linearGradient>
    </defs>

    <!-- ARCHED BACKGROUND GLOW & RADIANCE -->
    <path
      d="M 50 150 C 50 70, 250 70, 250 150 L 250 370 C 250 380, 240 390, 230 390 L 70 390 C 60 390, 50 380, 50 370 Z"
      fill="#FAF8F5"
      stroke="#B89352"
      stroke-width="1.2"
      stroke-opacity="0.4"
      stroke-dasharray="4 4"
    />

    <!-- CELESTIAL STARS & SPARKLE ACCENTS -->
    <g class="vector-sparkles" fill="#B89352" opacity="0.65">
      <path d="M 68 85 Q 75 85, 75 78 Q 75 85, 82 85 Q 75 85, 75 92 Q 75 85, 68 85 Z" />
      <path d="M 225 110 Q 230 110, 230 105 Q 230 110, 235 110 Q 230 110, 230 115 Q 230 110, 225 110 Z" />
      <circle cx="95" cy="55" r="1.5" />
      <circle cx="205" cy="65" r="1.5" />
    </g>

    <!-- BRIDE'S ETHEREAL VEIL (Back Layer) -->
    <path
      d="M 175 95 C 195 115, 225 160, 220 280 C 218 330, 200 375, 185 385 C 175 385, 170 350, 168 310 Z"
      fill="url(#veilSheer)"
      stroke="#D5CCBC"
      stroke-width="0.8"
      stroke-opacity="0.6"
    />

    <!-- ============================================================ -->
    <!-- GROOM (Arya - Left Figure) -->
    <!-- ============================================================ -->
    <!-- Groom Body & Suit -->
    <path
      d="M 120 120 C 105 125, 85 145, 82 180 L 78 280 L 105 385 L 140 385 L 142 270 L 138 180 C 135 155, 130 135, 120 120 Z"
      fill="url(#suitTone)"
      class="vector-fill"
    />

    <!-- Groom Left Arm (Gently wrapping Dian) -->
    <path
      d="M 82 180 C 80 210, 88 250, 110 275 C 122 288, 145 285, 155 275 L 152 260 C 142 268, 125 268, 115 258 C 98 240, 92 210, 95 180 Z"
      fill="#323F2E"
    />

    <!-- Groom White Shirt & Tie -->
    <polygon points="112,128 128,128 123,175 117,175" fill="#FFFFFF" />
    <!-- Olive Silk Tie -->
    <polygon points="118,135 122,135 124,175 120,185 116,175" fill="#4A5D43" />
    <!-- Gold Tie Clip -->
    <line x1="117" y1="152" x2="123" y2="152" stroke="url(#goldAccent)" stroke-width="1.5" />

    <!-- Groom Suit Lapels -->
    <path
      d="M 100 130 L 115 178 L 108 180 L 95 145 Z"
      fill="#263322"
      stroke="#4A5D43"
      stroke-width="0.8"
    />
    <path
      d="M 135 130 L 123 178 L 128 180 L 140 145 Z"
      fill="#263322"
      stroke="#4A5D43"
      stroke-width="0.8"
    />

    <!-- Groom Boutonnière (Gold Leaf & Miniature Cream Rose) -->
    <g transform="translate(100, 150)">
      <path d="M 0 0 C -3 -5, -6 -2, -2 4 Z" fill="#6E8564" />
      <path d="M 2 -2 C 6 -6, 8 -2, 4 3 Z" fill="#B89352" />
      <circle cx="1" cy="0" r="2.5" fill="#FAF8F5" stroke="#B89352" stroke-width="0.6" />
    </g>

    <!-- Groom Head & Neck -->
    <path d="M 112 108 L 112 128 L 128 128 L 128 108 Z" fill="url(#skinTone)" />
    <!-- Groom Head Oval -->
    <ellipse cx="120" cy="95" rx="13" ry="17" fill="url(#skinTone)" />
    <!-- Groom Modern Hair Contour -->
    <path
      d="M 107 92 C 106 80, 115 72, 126 73 C 134 74, 137 82, 136 90 C 132 87, 128 88, 120 86 C 112 85, 108 90, 107 92 Z"
      fill="#263322"
    />
    <!-- Groom Ear -->
    <ellipse cx="107" cy="95" rx="2" ry="3.5" fill="#EFE2D1" />

    <!-- ============================================================ -->
    <!-- BRIDE (Dian - Right Figure) -->
    <!-- ============================================================ -->
    <!-- Bride Gown Body -->
    <path
      d="M 160 135 C 150 145, 142 165, 145 195 L 140 280 L 130 385 L 215 385 C 218 360, 215 310, 205 270 L 195 195 C 196 165, 185 145, 175 135 Z"
      fill="url(#dressTone)"
      class="vector-fill"
      stroke="#C8BEAA"
      stroke-width="0.7"
    />

    <!-- Bride Waistline & Corset Accent -->
    <path
      d="M 152 188 C 165 192, 175 192, 188 188 L 186 210 C 172 215, 162 215, 150 210 Z"
      fill="#F9F6F0"
      stroke="#B89352"
      stroke-width="0.6"
      stroke-dasharray="2 2"
    />

    <!-- Bride Neck & Shoulders -->
    <path d="M 162 115 L 160 135 L 176 135 L 174 115 Z" fill="url(#skinTone)" />
    <!-- Bride Head Oval -->
    <ellipse cx="168" cy="98" rx="12" ry="16" fill="url(#skinTone)" />

    <!-- Bride Elegant Updo Hair & Chignon -->
    <path
      d="M 156 96 C 155 83, 165 76, 177 78 C 185 80, 186 89, 184 96 C 180 92, 175 92, 168 91 C 160 91, 157 95, 156 96 Z"
      fill="#2D231E"
    />
    <!-- Hair Chignon (Bun at back) -->
    <ellipse cx="182" cy="92" rx="6" ry="7" fill="#2D231E" />

    <!-- Bride Floral Headpiece / Tiara (Gold & Pearls) -->
    <g transform="translate(172, 85)" fill="url(#goldAccent)">
      <circle cx="-6" cy="0" r="1.8" />
      <circle cx="-1" cy="-2" r="2.2" />
      <circle cx="4" cy="0" r="1.8" />
      <path d="M -8 2 C -3 -1, 3 -1, 8 2" stroke="url(#goldAccent)" stroke-width="0.8" fill="none" />
    </g>

    <!-- Bride Delicate Gold Necklace -->
    <path d="M 163 125 C 168 130, 172 130, 175 125" stroke="url(#goldAccent)" stroke-width="1" fill="none" />
    <circle cx="169" cy="128.5" r="1.2" fill="#D4AF6E" />

    <!-- BRIDAL BOUQUET (Cream Garden Roses & Olive Foliage) -->
    <g transform="translate(150, 215)" filter="url(#goldGleam)">
      <!-- Olive Sprigs -->
      <path d="M -8 10 C -15 0, -18 -8, -12 -12 C -6 -15, 2 -5, 0 5 Z" fill="#6E8564" />
      <path d="M 12 12 C 22 2, 25 -6, 18 -10 C 12 -12, 4 -2, 2 6 Z" fill="#566A4E" />
      <path d="M -2 15 C -4 -2, 8 -18, 12 -12 C 15 -6, 6 6, 2 12 Z" fill="#4A5D43" />
      
      <!-- Roses -->
      <circle cx="-5" cy="-2" r="7.5" fill="#FFFFFF" stroke="#D5CCBC" stroke-width="0.8" />
      <circle cx="6" cy="-4" r="8" fill="#FDFBF7" stroke="#D5CCBC" stroke-width="0.8" />
      <circle cx="1" cy="4" r="7" fill="#FAF5EB" stroke="#B89352" stroke-width="0.8" />
      
      <!-- Rose Inner Spiral Accents -->
      <path d="M -7 -3 C -5 -6, -2 -5, -4 -1" stroke="#B89352" stroke-width="0.7" fill="none" />
      <path d="M 4 -5 C 6 -8, 9 -7, 7 -3" stroke="#B89352" stroke-width="0.7" fill="none" />
      <path d="M 0 3 C 2 1, 4 3, 2 5" stroke="#B89352" stroke-width="0.7" fill="none" />

      <!-- Gold Silk Ribbon Streams -->
      <path d="M 0 8 C -4 20, -10 32, -6 45" stroke="url(#goldAccent)" stroke-width="1.5" fill="none" />
      <path d="M 2 8 C 6 22, 12 30, 8 48" stroke="url(#goldAccent)" stroke-width="1.5" fill="none" />
    </g>

    <!-- ============================================================ -->
    <!-- DYNAMIC VECTOR CONTOUR OUTLINES (Animatable with GSAP) -->
    <!-- ============================================================ -->
    <g class="vector-contour-lines" stroke="#263322" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" fill="none">
      <!-- Groom Contour -->
      <path
        class="animated-contour"
        d="M 112 108 L 112 128 L 82 180 L 78 280 L 105 385"
      />
      <path
        class="animated-contour"
        d="M 128 108 L 128 128 L 138 180 L 142 270 L 140 385"
      />

      <!-- Bride Contour -->
      <path
        class="animated-contour"
        d="M 160 135 L 145 195 L 140 280 L 130 385"
      />
      <path
        class="animated-contour"
        d="M 175 135 L 195 195 L 205 270 L 215 385"
      />

      <!-- Veil Flourish Contour -->
      <path
        class="animated-contour"
        stroke="#B89352"
        stroke-width="1"
        d="M 175 95 C 205 130, 230 190, 222 285 C 218 335, 200 375, 185 385"
      />
    </g>

    <!-- INSET ROMAN ARCH GOLD FRAME BORDER -->
    <path
      d="M 20 130 C 20 40, 280 40, 280 130 L 280 380 C 280 390, 270 395, 260 395 L 40 395 C 30 395, 20 390, 20 380 Z"
      fill="none"
      stroke="url(#goldAccent)"
      stroke-width="1.2"
      stroke-opacity="0.6"
    />
    <path
      d="M 26 132 C 26 48, 274 48, 274 132 L 274 376 C 274 384, 266 389, 258 389 L 42 389 C 34 389, 26 384, 26 376 Z"
      fill="none"
      stroke="#566A4E"
      stroke-width="0.7"
      stroke-opacity="0.3"
    />
  </svg>
</div>

<script>
  import gsap from 'gsap';

  function initVectorDrawing() {
    const paths = document.querySelectorAll<SVGPathElement>('.animated-contour');
    paths.forEach((path) => {
      const length = path.getTotalLength ? path.getTotalLength() : 300;
      gsap.set(path, {
        strokeDasharray: length,
        strokeDashoffset: length
      });
    });

    window.addEventListener('invitationOpened', () => {
      gsap.to('.animated-contour', {
        strokeDashoffset: 0,
        duration: 1.8,
        stagger: 0.15,
        ease: 'power2.out'
      });

      gsap.fromTo(
        '.vector-fill',
        { opacity: 0.4 },
        { opacity: 1, duration: 1.5, ease: 'power2.out', delay: 0.3 }
      );
    }, { once: true });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initVectorDrawing);
  } else {
    initVectorDrawing();
  }
</script>
