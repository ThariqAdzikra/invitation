---
// ClosingVector.astro — Romantic Finale Couple Vector (Arya & Dian Holding Hands)
interface Props {
  width?: number;
  height?: number;
  className?: string;
}

const { width = 280, height = 200, className = '' } = Astro.props;
---

<div class={`relative flex items-center justify-center ${className}`}>
  <svg
    width={width}
    height={height}
    viewBox="0 0 280 200"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    class="w-full h-auto select-none drop-shadow-sm"
    aria-label="Ilustrasi Penutup Mempelai Arya & Dian"
  >
    <defs>
      <linearGradient id="closeGold" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0%" stop-color="#D4AF6E" />
        <stop offset="100%" stop-color="#B89352" />
      </linearGradient>

      <linearGradient id="closeSuit" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#3A4836" />
        <stop offset="100%" stop-color="#243120" />
      </linearGradient>

      <linearGradient id="closeDress" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#FFFFFF" />
        <stop offset="100%" stop-color="#EFE8DB" />
      </linearGradient>

      <linearGradient id="closeVeil" x1="0" y1="0" x2="1" y2="0">
        <stop offset="0%" stop-color="#FFFFFF" stop-opacity="0.8" />
        <stop offset="100%" stop-color="#E5DEC9" stop-opacity="0.1" />
      </linearGradient>
    </defs>

    <!-- ARCHED BOTANICAL LAUREL WREATH (Background) -->
    <path
      d="M 40 180 C 40 50, 240 50, 240 180"
      stroke="#566A4E"
      stroke-width="1.2"
      stroke-dasharray="3 4"
      opacity="0.4"
      fill="none"
    />

    <!-- CELESTIAL STARS -->
    <g fill="#B89352" opacity="0.6">
      <circle cx="70" cy="80" r="1.5" />
      <circle cx="140" cy="45" r="2" />
      <circle cx="210" cy="80" r="1.5" />
      <path d="M 140 38 Q 142 38, 142 35 Q 142 38, 144 38 Q 142 38, 142 41 Q 142 38, 140 38 Z" />
    </g>

    <!-- FLOWING BRIDAL VEIL IN WIND -->
    <path
      d="M 160 85 C 190 85, 230 110, 255 130 C 240 145, 205 130, 168 115 Z"
      fill="url(#closeVeil)"
      stroke="#D5CCBC"
      stroke-width="0.8"
    />

    <!-- GROOM (Arya - Left) -->
    <!-- Head -->
    <ellipse cx="118" cy="72" rx="9" ry="12" fill="#F7EFE4" />
    <path d="M 109 70 C 108 60, 115 54, 122 55 C 128 56, 129 62, 129 68 C 125 65, 122 66, 117 65 Z" fill="#243120" />
    <!-- Suit Body -->
    <path
      d="M 118 84 L 105 105 L 102 165 L 120 165 L 126 125 L 132 165 L 142 165 L 132 105 Z"
      fill="url(#closeSuit)"
      stroke="#243120"
      stroke-width="1"
    />
    <!-- White Collar -->
    <polygon points="115,86 121,86 118,98" fill="#FFFFFF" />

    <!-- BRIDE (Dian - Right) -->
    <!-- Head -->
    <ellipse cx="152" cy="75" rx="8.5" ry="11.5" fill="#F7EFE4" />
    <path d="M 144 73 C 143 62, 151 57, 158 58 C 163 59, 164 66, 163 72 C 160 68, 156 69, 151 68 Z" fill="#2D231E" />
    <circle cx="160" cy="71" r="3" fill="#2D231E" />
    <circle cx="158" cy="67" r="1.5" fill="url(#closeGold)" />
    <!-- Gown Body -->
    <path
      d="M 152 86 L 140 108 L 135 165 L 175 165 C 178 150, 172 120, 165 108 Z"
      fill="url(#closeDress)"
      stroke="#D5CCBC"
      stroke-width="1"
    />

    <!-- INTERTWINED HANDS (Center - Symbol of Unity) -->
    <g transform="translate(133, 118)">
      <ellipse cx="2" cy="0" rx="4" ry="5" fill="#F7EFE4" stroke="#4A5D43" stroke-width="0.8" />
      <path d="M 0 -2 Q 2 2, 4 -2" stroke="url(#closeGold)" stroke-width="1" fill="none" />
      <!-- Heart/Sparkle over hands -->
      <circle cx="2" cy="-7" r="1.5" fill="url(#closeGold)" />
    </g>

    <!-- GROUND SHADOW & OLIVE BRANCHES -->
    <ellipse cx="140" cy="168" rx="60" ry="5" fill="#263322" opacity="0.1" />
    <path d="M 85 168 C 110 164, 170 164, 195 168" stroke="url(#closeGold)" stroke-width="1" stroke-dasharray="2 3" opacity="0.7" />
  </svg>
</div>
