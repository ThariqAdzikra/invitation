---
// GroomSilhouette.astro — Artistic Groom Portrait Silhouette in Roman Arched Frame
interface Props {
  size?: number;
  className?: string;
}

const { size = 180, className = "" } = Astro.props;
---

<div class={`relative flex items-center justify-center select-none ${className}`} aria-hidden="true">
  <svg
    width={size}
    height={size * 1.25}
    viewBox="0 0 160 200"
    fill="none"
    class="w-full h-auto max-w-[180px] drop-shadow-[0_8px_20px_rgba(42,52,38,0.1)]"
  >
    <defs>
      <radialGradient id="groom-glow" cx="50%" cy="45%" r="60%">
        <stop offset="0%" stop-color="#FFFDF7" stop-opacity="0.95" />
        <stop offset="60%" stop-color="#F4EFE3" stop-opacity="0.9" />
        <stop offset="100%" stop-color="#E8E0CE" stop-opacity="0.85" />
      </radialGradient>

      <linearGradient id="groom-sil" x1="0%" y1="0%" x2="0%" y2="100%">
        <stop offset="0%" stop-color="#2D3B29" />
        <stop offset="100%" stop-color="#1A2217" />
      </linearGradient>
    </defs>

    <!-- Arched Backplate Frame -->
    <path
      d="M 15 190 L 15 75 A 65 65 0 0 1 145 75 L 145 190 Z"
      fill="url(#groom-glow)"
      stroke="#D5CCA8"
      stroke-width="1.2"
    />
    <path
      d="M 22 186 L 22 76 A 58 58 0 0 1 138 76 L 138 186 Z"
      fill="none"
      stroke="#B89352"
      stroke-width="0.8"
      stroke-dasharray="3 2"
      opacity="0.75"
    />

    <!-- Groom Head / Hair -->
    <path
      d="M 72 58 C 66 50, 72 36, 84 34 C 94 33, 100 40, 99 50 C 98 58, 93 63, 87 64 C 88 70, 91 76, 95 80 C 84 80, 78 76, 75 70 C 70 67, 69 62, 72 58 Z"
      fill="url(#groom-sil)"
    />
    <!-- Groom Bow Tie / Collar Gold Accent -->
    <polygon points="84,82 88,80 87,90 85,90" fill="#B89352" />

    <!-- Groom Tuxedo Shoulders & Chest -->
    <path
      d="M 76 80 C 60 90, 42 112, 36 142 C 30 170, 28 185, 27 190 L 133 190 C 132 185, 130 170, 124 142 C 118 112, 100 90, 84 80 Z"
      fill="url(#groom-sil)"
    />

    <!-- Boutonnière Sprig on Lapel -->
    <circle cx="56" cy="116" r="3" fill="#FAF6EE" stroke="#B89352" stroke-width="0.8" />
    <path d="M 56 120 Q 53 130 50 135" stroke="#5E7455" stroke-width="1.2" />

    <!-- Olive Sprig Framing Bottom -->
    <path d="M 35 185 C 55 178, 105 178, 125 185" stroke="#566A4E" stroke-width="1.2" />
    <circle cx="80" cy="180" r="2" fill="#B89352" />
  </svg>
</div>