---
// KineticRibbon.astro — Bridging Kinetic Ticker Ribbon connecting 3D Tunnel to Stage
---

<div class="relative w-full overflow-hidden py-4 -my-4 z-30 pointer-events-none select-none">
  
  <!-- Rotated Ribbon Band -->
  <div class="w-[110%] -left-[5%] relative py-3 bg-gradient-to-r from-[#FAF8F5] via-[#FFFFFF] to-[#F5EFE4] border-y border-[#B89352]/40 shadow-[0_4px_20px_rgba(42,52,38,0.06)] transform -rotate-1 origin-center overflow-hidden">
    
    <!-- Top & Bottom Golden Accent Hairlines -->
    <div class="absolute top-0 left-0 right-0 h-[1px] bg-gradient-to-r from-transparent via-[#B89352]/70 to-transparent"></div>
    <div class="absolute bottom-0 left-0 right-0 h-[1px] bg-gradient-to-r from-transparent via-[#B89352]/70 to-transparent"></div>

    <!-- Ticker Track with Repeating Kinetic Typography -->
    <div class="flex items-center whitespace-nowrap will-change-transform kinetic-ticker-track">
      
      <!-- Repeated Track 1 -->
      <div class="flex items-center gap-6 shrink-0 text-xs sm:text-sm uppercase tracking-[0.28em] font-medium text-[#4A5D43] px-3">
        <span class="font-display italic text-[#B89352] text-sm sm:text-base">The Wedding of</span>
        <span class="font-bold text-[#2A3426]">Arya Wirayudha</span>
        <span class="text-[#B89352] font-serif">&amp;</span>
        <span class="font-bold text-[#2A3426]">Dian Paramitha</span>
        <span class="text-[#B89352] text-[0.65rem]">✦</span>
        <span>12 Desember 2026</span>
        <span class="text-[#B89352] text-[0.65rem]">✦</span>
        <span class="font-arabic text-sm text-[#566A4E]">وَمِنْ آيَاتِهِ</span>
        <span class="text-[#B89352] text-[0.65rem]">✦</span>
        <span>Banda Aceh Convention Hall</span>
        <span class="text-[#B89352] text-[0.65rem]">✦</span>
        <span class="italic font-display text-[#B89352]">Walimatul 'Urs</span>
        <span class="text-[#B89352] text-[0.65rem]">✦</span>
      </div>

      <!-- Repeated Track 2 for Seamless Infinite Loop -->
      <div class="flex items-center gap-6 shrink-0 text-xs sm:text-sm uppercase tracking-[0.28em] font-medium text-[#4A5D43] px-3" aria-hidden="true">
        <span class="font-display italic text-[#B89352] text-sm sm:text-base">The Wedding of</span>
        <span class="font-bold text-[#2A3426]">Arya Wirayudha</span>
        <span class="text-[#B89352] font-serif">&amp;</span>
        <span class="font-bold text-[#2A3426]">Dian Paramitha</span>
        <span class="text-[#B89352] text-[0.65rem]">✦</span>
        <span>12 Desember 2026</span>
        <span class="text-[#B89352] text-[0.65rem]">✦</span>
        <span class="font-arabic text-sm text-[#566A4E]">وَمِنْ آيَاتِهِ</span>
        <span class="text-[#B89352] text-[0.65rem]">✦</span>
        <span>Banda Aceh Convention Hall</span>
        <span class="text-[#B89352] text-[0.65rem]">✦</span>
        <span class="italic font-display text-[#B89352]">Walimatul 'Urs</span>
        <span class="text-[#B89352] text-[0.65rem]">✦</span>
      </div>

    </div>

  </div>

</div>
