---
// CelestialSunStage.astro — Soft-Blurred Dreamy Celestial Sun & Three-Phase Atmospheric Sky
---

<div id="celestial-stage" class="fixed inset-0 pointer-events-none z-[4] overflow-hidden" aria-hidden="true">
  
  <!-- =========================================================================
       ATMOSPHERIC SKY FILTERS (Three-Phase Ambient Lighting on Cream Linen)
       ========================================================================= -->
  
  <!-- Phase 1: Sunrise Sky (Rosy Peach & Morning Gold from lower-left horizon) -->
  <div 
    id="sky-sunrise" 
    class="absolute inset-0 opacity-0 transition-opacity duration-700 ease-out will-change-opacity"
    style="background: radial-gradient(circle at 22% 40%, rgba(247, 218, 198, 0.50) 0%, rgba(245, 230, 215, 0.25) 45%, transparent 75%);"
  ></div>

  <!-- Phase 2: Midday Sky (Radiant Champagne Sunlight & Pristine Daylight from Zenith) -->
  <div 
    id="sky-midday" 
    class="absolute inset-0 opacity-0 transition-opacity duration-700 ease-out will-change-opacity"
    style="background: radial-gradient(circle at 50% 12%, rgba(255, 248, 230, 0.48) 0%, rgba(245, 238, 222, 0.22) 45%, transparent 75%);"
  ></div>

  <!-- Phase 3: Sunset Sky (Rich Amber, Terracotta & Golden Hour Warmth) -->
  <div 
    id="sky-sunset" 
    class="absolute inset-0 opacity-0 transition-opacity duration-700 ease-out will-change-opacity"
    style="background: radial-gradient(ellipse at 50% 42%, rgba(238, 175, 115, 0.40) 0%, rgba(215, 140, 85, 0.18) 45%, rgba(184, 147, 82, 0.06) 70%, transparent 95%);"
  ></div>

  <!-- =========================================================================
       THE CELESTIAL RADIANT SUN (SINGLE UNIFIED LUMINOUS CELESTIAL BODY)
       Soft-Blurred, Natural Radial Gradient, Zero Stray Orbiting Balls
       Hidden at start (Hero & Verse), Rises in Kedua Mempelai (Sunrise)
       ========================================================================= -->
  <div 
    id="celestial-sun-wrapper" 
    class="fixed top-0 left-0 w-32 h-32 sm:w-44 sm:h-44 -translate-x-1/2 -translate-y-1/2 opacity-0 pointer-events-none z-[5] will-change-transform flex items-center justify-center"
  >
    <!-- 1. Ambient Volumetric Atmospheric Bloom (Wide, Soft, Blurred seamlessly into air) -->
    <div 
      id="sun-outer-glow" 
      class="absolute -inset-16 sm:-inset-24 rounded-full transition-all duration-700 ease-out pointer-events-none filter blur-3xl opacity-80"
      style="background: radial-gradient(circle, rgba(255, 215, 110, 0.45) 0%, rgba(245, 160, 60, 0.18) 45%, rgba(230, 120, 35, 0.04) 70%, transparent 85%);"
    ></div>

    <!-- 2. The Single Celestial Sun Core (Soft Optical Blur, Natural Exponential Glow) -->
    <div 
      id="sun-sphere" 
      class="w-24 h-24 sm:w-32 sm:h-32 rounded-full relative transition-all duration-700 ease-out filter blur-[3px] sm:blur-[4px] pointer-events-none overflow-hidden"
      style="background: radial-gradient(circle at 50% 50%, #FFFFFF 0%, #FFFDF2 18%, rgba(255, 238, 175, 0.95) 36%, rgba(250, 192, 70, 0.85) 58%, rgba(235, 140, 40, 0.45) 78%, transparent 100%);"
    >
      <!-- Sunset Tint Overlay (Smoothly fades in during Sunset phase) -->
      <div 
        id="sun-sunset-overlay"
        class="absolute inset-0 rounded-full opacity-0 pointer-events-none transition-opacity duration-700"
        style="background: radial-gradient(circle at 50% 50%, #FFF4E5 0%, #FED7AA 22%, rgba(251, 146, 60, 0.95) 50%, rgba(234, 88, 12, 0.85) 75%, transparent 100%);"
      ></div>
    </div>
  </div>

</div>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  function initCelestialSun() {
    const sunWrapper = document.getElementById('celestial-sun-wrapper');
    const sunSphere = document.getElementById('sun-sphere');
    const sunGlow = document.getElementById('sun-outer-glow');
    const sunSunsetOverlay = document.getElementById('sun-sunset-overlay');
    const skySunrise = document.getElementById('sky-sunrise');
    const skyMidday = document.getElementById('sky-midday');
    const skySunset = document.getElementById('sky-sunset');

    if (!sunWrapper) return;

    // Check motion preference
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReducedMotion) return;

    function calculateCoordinates() {
      const windowW = window.innerWidth;
      const windowH = window.innerHeight;
      const isMobile = windowW < 640;

      // Phase 1: Sunrise (Appears in Kedua Mempelai: centered royal morning sunrise crown)
      const pSunrise = {
        x: windowW * 0.50,
        y: isMobile ? windowH * 0.12 : windowH * 0.14,
        scale: isMobile ? 0.85 : 0.95
      };

      // Phase 2: Midday (high-zenith, centered)
      const pMidday = {
        x: windowW * 0.50,
        y: isMobile ? windowH * 0.10 : windowH * 0.12,
        scale: isMobile ? 1.0 : 1.1
      };

      // Phase 3: Sunset (Centered behind Romantic Swans in Closing)
      const pSunset = {
        x: windowW * 0.50,
        y: isMobile ? windowH * 0.40 : windowH * 0.42,
        scale: isMobile ? 0.95 : 1.10
      };

      return { pSunrise, pMidday, pSunset, windowW, windowH };
    }

    let coords = calculateCoordinates();

    // STRICT REQUIREMENT 1: Sun is 100% HIDDEN at the beginning (Hero & Verse)!
    gsap.set(sunWrapper, {
      x: coords.pSunrise.x,
      y: coords.pSunrise.y, // Placed safely at top zenith
      scale: coords.pSunrise.scale,
      opacity: 0 // Zero opacity at start!
    });

    if (skySunrise) gsap.set(skySunrise, { opacity: 0 });
    if (skyMidday) gsap.set(skyMidday, { opacity: 0 });
    if (skySunset) gsap.set(skySunset, { opacity: 0 });
    if (sunSunsetOverlay) gsap.set(sunSunsetOverlay, { opacity: 0 });

    // =========================================================================
    // MASTER SCROLL-DRIVEN CELESTIAL TIMELINE (Synchronized to Narrative Flow)
    // 0.00 -> 0.24: Hero & Verse (Sun COMPLETELY HIDDEN, Opacity 0)
    // 0.25 -> 0.40: KEDUA MEMPELAI (Sunrise! Sun rises gracefully from horizon)
    // 0.40 -> 0.76: ASMARALOKA & WAKTU & JADWAL (Midday zenith, champagne golden daylight)
    // 0.76 -> 0.86: LOKASI ACARA (Golden Hour, afternoon sun begins gentle descent)
    // 0.86 -> 1.00: CLOSING FINALE (Sunset! Sinks behind romantic swans in rich terracotta dusk)
    // =========================================================================
    const sunTL = gsap.timeline({
      scrollTrigger: {
        trigger: document.body,
        start: 'top top',
        end: 'bottom bottom',
        scrub: 1.2
      }
    });

    // 1. Hero & Verse: Sun stays at opacity 0 (NO SUN AT START!)
    sunTL.to(sunWrapper, {
      opacity: 0,
      duration: 0.24
    }, 0);

    // 2. SUNRISE: Enters at Kedua Mempelai (0.25 -> 0.38)
    // Sun dawns gracefully at the top center with warm celestial aura
    sunTL.to(sunWrapper, {
      opacity: 0.85,
      x: () => calculateCoordinates().pSunrise.x,
      y: () => calculateCoordinates().pSunrise.y,
      scale: () => calculateCoordinates().pSunrise.scale,
      duration: 0.14,
      ease: 'power2.out'
    }, 0.25);

    // Soft Sunrise blush fades in at Kedua Mempelai
    if (skySunrise) {
      sunTL.to(skySunrise, {
        opacity: 0.85,
        duration: 0.14,
        ease: 'power2.out'
      }, 0.25);
    }

    // 3. MIDDAY: Asmaraloka & Waktu & Jadwal (0.40 -> 0.76)
    // Sun ascends to high noon at zenith with radiant daylight
    sunTL.to(sunWrapper, {
      x: () => calculateCoordinates().pMidday.x,
      y: () => calculateCoordinates().pMidday.y,
      scale: () => calculateCoordinates().pMidday.scale,
      duration: 0.32,
      ease: 'power1.inOut'
    }, 0.40);

    // Sunrise sky transitions to Midday champagne brightness
    if (skySunrise && skyMidday) {
      sunTL.to(skySunrise, { opacity: 0, duration: 0.16, ease: 'power1.inOut' }, 0.42);
      sunTL.to(skyMidday, { opacity: 0.80, duration: 0.20, ease: 'power1.inOut' }, 0.44);
    }

    // 4. GOLDEN HOUR & SUNSET: Lokasi -> Closing (0.76 -> 1.00)
    // Sun descends toward the lake horizon directly behind the romantic swans
    sunTL.to(sunWrapper, {
      x: () => calculateCoordinates().pSunset.x,
      y: () => calculateCoordinates().pSunset.y,
      scale: () => calculateCoordinates().pSunset.scale,
      duration: 0.24,
      ease: 'power1.inOut'
    }, 0.76);

    // Midday sky transitions to warm amber terracotta Sunset glow in Closing
    if (skyMidday && skySunset) {
      sunTL.to(skyMidday, { opacity: 0, duration: 0.12, ease: 'power1.inOut' }, 0.78);
      sunTL.to(skySunset, { opacity: 1, duration: 0.20, ease: 'power2.out' }, 0.80);
    }

    // Sunset color shift on sun sphere & outer bloom
    if (sunSunsetOverlay) {
      sunTL.to(sunSunsetOverlay, {
        opacity: 1,
        duration: 0.20,
        ease: 'power2.out'
      }, 0.80);
    }

    if (sunGlow) {
      sunTL.to(sunGlow, {
        scale: 1.25,
        opacity: 0.95,
        duration: 0.20,
        ease: 'power2.out'
      }, 0.80);
    }

    // Handle viewport resize gracefully
    window.addEventListener('resize', () => {
      coords = calculateCoordinates();
      ScrollTrigger.refresh();
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCelestialSun);
  } else {
    initCelestialSun();
  }
</script>
