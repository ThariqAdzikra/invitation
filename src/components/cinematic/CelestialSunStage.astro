---
// CelestialSunStage.astro — Soft-Blurred Dreamy Celestial Sun & Three-Phase Atmospheric Sky
---

<div id="celestial-stage" class="fixed inset-0 pointer-events-none z-[4] overflow-hidden" aria-hidden="true">
  
  <!-- =========================================================================
       ATMOSPHERIC SKY FILTERS (Three-Phase Ambient Lighting on Cream Linen)
       ========================================================================= -->
  
  <!-- Phase 1: Sunrise Sky (Rosy Peach & Morning Gold from lower-left horizon) -->
  <div 
    id="sky-sunrise" 
    class="absolute inset-0 opacity-0 transition-opacity duration-700 ease-out will-change-opacity"
    style="background: radial-gradient(circle at 22% 40%, rgba(247, 218, 198, 0.50) 0%, rgba(245, 230, 215, 0.25) 45%, transparent 75%);"
  ></div>

  <!-- Phase 2: Midday Sky (Radiant Champagne Sunlight & Pristine Daylight from Zenith) -->
  <div 
    id="sky-midday" 
    class="absolute inset-0 opacity-0 transition-opacity duration-700 ease-out will-change-opacity"
    style="background: radial-gradient(circle at 50% 12%, rgba(255, 248, 230, 0.48) 0%, rgba(245, 238, 222, 0.22) 45%, transparent 75%);"
  ></div>

  <!-- Phase 3: Sunset Sky (Rich Amber, Terracotta & Golden Hour Warmth) -->
  <div 
    id="sky-sunset" 
    class="absolute inset-0 opacity-0 transition-opacity duration-700 ease-out will-change-opacity"
    style="background: radial-gradient(ellipse at 50% 35%, rgba(238, 175, 115, 0.42) 0%, rgba(215, 140, 85, 0.20) 45%, rgba(184, 147, 82, 0.08) 70%, transparent 95%);"
  ></div>

  <!-- =========================================================================
       THE CELESTIAL RADIANT SUN (Soft-Blurred Luminous Core + Dreamy Bokeh Orbs)
       Hidden at start (Hero & Verse), Rises in Kedua Mempelai (Sunrise)
       ========================================================================= -->
  <div 
    id="celestial-sun-wrapper" 
    class="fixed top-0 left-0 w-36 h-36 sm:w-48 sm:h-48 -translate-x-1/2 -translate-y-1/2 opacity-0 pointer-events-none z-[5] will-change-transform flex items-center justify-center"
  >
    <!-- 1. Ambient Volumetric Atmospheric Bloom (Wide, Soft, Blurred) -->
    <div 
      id="sun-outer-glow" 
      class="absolute -inset-20 sm:-inset-28 rounded-full transition-all duration-700 ease-out pointer-events-none filter blur-2xl sm:blur-3xl"
      style="background: radial-gradient(circle, rgba(255, 215, 110, 0.45) 0%, rgba(245, 160, 60, 0.18) 45%, rgba(230, 120, 35, 0.05) 65%, transparent 80%);"
    ></div>

    <!-- 2. Mid Atmospheric Corona (Warm Diffused Aura, NO SHARP BORDERS) -->
    <div 
      class="absolute -inset-10 sm:-inset-14 rounded-full pointer-events-none filter blur-xl"
      style="background: radial-gradient(circle, rgba(255, 230, 140, 0.55) 0%, rgba(245, 175, 70, 0.22) 50%, transparent 75%);"
    ></div>

    <!-- 3. Soft Dreamy Bokeh Orbs ("Bulatan-Bulatan Bokeh Optik yang Lembut & Blur") -->
    <!-- Bokeh Orb 1: Upper-Right Floating Luminous Sphere (Soft Focus) -->
    <div 
      class="bokeh-orb absolute -top-10 -right-10 w-16 h-16 sm:w-20 sm:h-20 rounded-full pointer-events-none filter blur-[3px] animate-[floatSlow_8s_ease-in-out_infinite_alternate]"
      style="background: radial-gradient(circle, rgba(255, 255, 255, 0.5) 0%, rgba(255, 230, 160, 0.22) 45%, rgba(245, 180, 70, 0.08) 65%, transparent 80%);"
    ></div>

    <!-- Bokeh Orb 2: Lower-Left Amber Warm Glow Bubble (Soft Focus) -->
    <div 
      class="bokeh-orb absolute -bottom-8 -left-10 w-12 h-12 sm:w-16 sm:h-16 rounded-full pointer-events-none filter blur-[4px] animate-[floatSlow_6s_ease-in-out_infinite_alternate_1s]"
      style="background: radial-gradient(circle, rgba(255, 215, 120, 0.45) 0%, rgba(235, 145, 50, 0.18) 50%, transparent 75%);"
    ></div>

    <!-- Bokeh Orb 3: Micro Soft Light Flare (Dreamy Light Spec) -->
    <div 
      class="bokeh-orb absolute -top-14 left-6 w-6 h-6 rounded-full pointer-events-none filter blur-[2px] bg-white/75 animate-pulse"
    ></div>

    <!-- Bokeh Orb 4: Rose-Gold Secondary Sheen Bubble (Soft Focus) -->
    <div 
      class="bokeh-orb absolute bottom-4 -right-14 w-14 h-14 sm:w-18 sm:h-18 rounded-full pointer-events-none filter blur-[5px] animate-[floatSlow_7s_ease-in-out_infinite_alternate_2s]"
      style="background: radial-gradient(circle, rgba(255, 210, 140, 0.38) 0%, rgba(240, 160, 70, 0.12) 50%, transparent 75%);"
    ></div>

    <!-- 4. Luminous Soft-Blurred Sun Core (Dreamy Optical Glow, NO HARSH EDGES) -->
    <div 
      id="sun-sphere" 
      class="w-24 h-24 sm:w-32 sm:h-32 rounded-full relative transition-all duration-700 ease-out filter blur-[6px] sm:blur-[7px]"
      style="background: radial-gradient(circle at 45% 45%, #FFFFFF 0%, #FFF8E7 22%, #FFD685 48%, #F5A623 72%, rgba(230, 138, 46, 0) 100%);"
    >
      <!-- Intense Pure-White Solar Flare Center -->
      <div class="absolute inset-4 rounded-full bg-white/95 filter blur-[6px]"></div>
    </div>
  </div>

</div>

<style>
  @keyframes floatSlow {
    0% {
      transform: translate(0, 0) scale(1);
    }
    100% {
      transform: translate(8px, -10px) scale(1.08);
    }
  }
</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  function initCelestialSun() {
    const sunWrapper = document.getElementById('celestial-sun-wrapper');
    const sunSphere = document.getElementById('sun-sphere');
    const sunGlow = document.getElementById('sun-outer-glow');
    const skySunrise = document.getElementById('sky-sunrise');
    const skyMidday = document.getElementById('sky-midday');
    const skySunset = document.getElementById('sky-sunset');

    if (!sunWrapper) return;

    // Check motion preference
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReducedMotion) return;

    function calculateCoordinates() {
      const windowW = window.innerWidth;
      const windowH = window.innerHeight;

      // Phase 1: Sunrise (Appears in Kedua Mempelai: soft left-flank morning sunrise)
      const pSunrise = {
        x: windowW * 0.22,
        y: windowH * 0.40,
        scale: 0.90
      };

      // Phase 2: Midday (high-zenith, centered)
      const pMidday = {
        x: windowW * 0.50,
        y: windowH * 0.12,
        scale: 1.05
      };

      // Phase 3: Sunset (Centered on horizon behind rolling hills & couple)
      const pSunset = {
        x: windowW * 0.50,
        y: windowH * 0.36,
        scale: 1.45
      };

      return { pSunrise, pMidday, pSunset, windowW, windowH };
    }

    let coords = calculateCoordinates();

    // STRICT REQUIREMENT 1: Sun is 100% HIDDEN at the beginning (Hero & Verse)!
    gsap.set(sunWrapper, {
      x: coords.pSunrise.x,
      y: coords.windowH * 0.78, // waiting below horizon
      scale: 0.75,
      opacity: 0 // Zero opacity at start!
    });

    if (skySunrise) gsap.set(skySunrise, { opacity: 0 });
    if (skyMidday) gsap.set(skyMidday, { opacity: 0 });
    if (skySunset) gsap.set(skySunset, { opacity: 0 });

    // =========================================================================
    // MASTER SCROLL-DRIVEN CELESTIAL TIMELINE
    // 0.00 -> 0.24: Hero & Verse (Sun COMPLETELY HIDDEN, Opacity 0)
    // 0.25 -> 0.44: KEDUA MEMPELAI (Sunrise! Sun rises gracefully from horizon)
    // 0.45 -> 0.74: Acara, Countdown, LoveStory (Midday zenith, champagne golden light)
    // 0.75 -> 1.00: Wishes & Closing (Sunset! Sinks behind rolling hills and couple)
    // =========================================================================
    const sunTL = gsap.timeline({
      scrollTrigger: {
        trigger: document.body,
        start: 'top top',
        end: 'bottom bottom',
        scrub: 1.2
      }
    });

    // 1. Hero & Verse: Sun stays at opacity 0 (NO SUN AT START!)
    sunTL.to(sunWrapper, {
      opacity: 0,
      duration: 0.24
    }, 0);

    // 2. SUNRISE: Enters at Kedua Mempelai (0.25 -> 0.38)
    // Sun rises up from below horizon and fades in smoothly
    sunTL.to(sunWrapper, {
      opacity: 0.95,
      x: () => calculateCoordinates().pSunrise.x,
      y: () => calculateCoordinates().pSunrise.y,
      scale: () => calculateCoordinates().pSunrise.scale,
      duration: 0.14,
      ease: 'power2.out'
    }, 0.25);

    // Soft Sunrise blush fades in at Kedua Mempelai
    if (skySunrise) {
      sunTL.to(skySunrise, {
        opacity: 0.85,
        duration: 0.14,
        ease: 'power2.out'
      }, 0.25);
    }

    // 3. MIDDAY: Kedua Mempelai -> Acara & Countdown (0.42 -> 0.65)
    // Sun ascends to high noon at zenith
    sunTL.to(sunWrapper, {
      x: () => calculateCoordinates().pMidday.x,
      y: () => calculateCoordinates().pMidday.y,
      scale: () => calculateCoordinates().pMidday.scale,
      duration: 0.24,
      ease: 'power1.inOut'
    }, 0.42);

    // Sunrise sky transitions to Midday champagne brightness
    if (skySunrise && skyMidday) {
      sunTL.to(skySunrise, { opacity: 0, duration: 0.20, ease: 'power1.inOut' }, 0.44);
      sunTL.to(skyMidday, { opacity: 0.80, duration: 0.20, ease: 'power1.inOut' }, 0.46);
    }

    // 4. SUNSET: Wishes -> Closing (0.75 -> 1.00)
    // Sun descends toward the horizon behind the rolling hills and couple
    sunTL.to(sunWrapper, {
      x: () => calculateCoordinates().pSunset.x,
      y: () => calculateCoordinates().pSunset.y,
      scale: () => calculateCoordinates().pSunset.scale,
      duration: 0.25,
      ease: 'power1.inOut'
    }, 0.75);

    // Midday sky transitions to warm amber terracotta Sunset glow
    if (skyMidday && skySunset) {
      sunTL.to(skyMidday, { opacity: 0, duration: 0.15, ease: 'power1.inOut' }, 0.75);
      sunTL.to(skySunset, { opacity: 1, duration: 0.22, ease: 'power2.out' }, 0.78);
    }

    // Sunset glow bloom
    if (sunSphere && sunGlow) {
      sunTL.to(sunGlow, {
        scale: 1.5,
        opacity: 1,
        duration: 0.22,
        ease: 'power2.out'
      }, 0.78);
    }

    // Handle viewport resize gracefully
    window.addEventListener('resize', () => {
      ScrollTrigger.refresh();
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCelestialSun);
  } else {
    initCelestialSun();
  }
</script>
