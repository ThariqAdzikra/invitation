---
// CinematicCloudStage.astro — Ethereal Heavenly Clouds & Golden Dawn Mist
// 100% Responsive, GPU-accelerated atmospheric cloud transitions
// Features realistic painterly cloud banks with autonomous, continuous wind drift & stardust breathing.
// Pre-configured with distinct IDs for GSAP ScrollTrigger timeline choreography.
---

<div id="cinematic-cloud-stage" class="absolute inset-0 pointer-events-none z-10 overflow-hidden select-none" aria-hidden="true">

  <!-- 1. TOP-LEFT CELESTIAL CLOUD BANK (GSAP target: #cloud-bank-tl) -->
  <div 
    id="cloud-bank-tl" 
    class="absolute -top-[12vw] sm:-top-[8vw] lg:-top-[6vw] -left-[8vw] sm:-left-[5vw] w-[60vw] sm:w-[46vw] lg:w-[38vw] max-w-[640px] opacity-85 will-change-transform pointer-events-none"
  >
    <div class="cloud-drift-tl w-full h-full will-change-transform">
      <img 
        src="/assets/cloud-upper-left.webp" 
        alt="" 
        class="w-full h-auto object-contain object-left-top select-none pointer-events-none" 
        loading="eager"
        decoding="async"
      />
    </div>
  </div>

  <!-- 2. TOP-RIGHT CELESTIAL CLOUD BANK (GSAP target: #cloud-bank-tr) -->
  <div 
    id="cloud-bank-tr" 
    class="absolute -top-[12vw] sm:-top-[8vw] lg:-top-[6vw] -right-[8vw] sm:-right-[5vw] w-[60vw] sm:w-[46vw] lg:w-[38vw] max-w-[640px] opacity-85 will-change-transform pointer-events-none"
  >
    <div class="cloud-drift-tr w-full h-full will-change-transform">
      <img 
        src="/assets/cloud-upper-right.webp" 
        alt="" 
        class="w-full h-auto object-contain object-right-top select-none pointer-events-none" 
        loading="eager"
        decoding="async"
      />
    </div>
  </div>

  <!-- 3. BOTTOM-LEFT ROLLING CLOUD HORIZON (GSAP target: #cloud-bank-bl) -->
  <div 
    id="cloud-bank-bl" 
    class="absolute -bottom-[14vw] sm:-bottom-[10vw] lg:-bottom-[8vw] -left-[8vw] sm:-left-[5vw] w-[64vw] sm:w-[48vw] lg:w-[40vw] max-w-[680px] opacity-80 will-change-transform pointer-events-none"
  >
    <div class="cloud-drift-bl w-full h-full will-change-transform">
      <img 
        src="/assets/cloud-lower-left.webp" 
        alt="" 
        class="w-full h-auto object-contain object-left-bottom select-none pointer-events-none" 
        loading="eager"
        decoding="async"
      />
    </div>
  </div>

  <!-- 4. BOTTOM-RIGHT ROLLING CLOUD HORIZON (GSAP target: #cloud-bank-br) -->
  <div 
    id="cloud-bank-br" 
    class="absolute -bottom-[14vw] sm:-bottom-[10vw] lg:-bottom-[8vw] -right-[8vw] sm:-right-[5vw] w-[64vw] sm:w-[48vw] lg:w-[40vw] max-w-[680px] opacity-80 will-change-transform pointer-events-none"
  >
    <div class="cloud-drift-br w-full h-full will-change-transform">
      <img 
        src="/assets/cloud-lower-right.webp" 
        alt="" 
        class="w-full h-auto object-contain object-right-bottom select-none pointer-events-none" 
        loading="eager"
        decoding="async"
      />
    </div>
  </div>

  <!-- 5. FLOATING GOLDEN STARDUST & SUN MOTES (Autonomous Breathing & Twinkling) -->
  <div id="cloud-stardust-layer" class="absolute inset-0 pointer-events-none will-change-transform">
    <!-- Starburst Sparkle 1 (Upper Left) -->
    <div class="cloud-mote stardust-twinkle-a absolute top-[16%] left-[12%] sm:left-[16%]">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
        <path d="M12 0 Q12 12 0 12 Q12 12 12 24 Q12 12 24 12 Q12 12 12 0 Z" fill="#D4AF37" />
        <circle cx="12" cy="12" r="2.5" fill="#FFF8E7" />
      </svg>
    </div>

    <!-- Starburst Sparkle 2 (Upper Right) -->
    <div class="cloud-mote stardust-twinkle-b absolute top-[18%] right-[14%] sm:right-[18%]">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
        <path d="M12 0 Q12 12 0 12 Q12 12 12 24 Q12 12 24 12 Q12 12 12 0 Z" fill="#D4AF37" />
        <circle cx="12" cy="12" r="3" fill="#FFF8E7" />
      </svg>
    </div>

    <!-- Starburst Sparkle 3 (Mid Left Horizon) -->
    <div class="cloud-mote stardust-twinkle-b absolute top-[52%] left-[8%] sm:left-[12%]">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none">
        <path d="M12 0 Q12 12 0 12 Q12 12 12 24 Q12 12 24 12 Q12 12 12 0 Z" fill="#D4AF37" />
      </svg>
    </div>

    <!-- Starburst Sparkle 4 (Mid Right Horizon) -->
    <div class="cloud-mote stardust-twinkle-a absolute top-[54%] right-[10%] sm:right-[14%]">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
        <path d="M12 0 Q12 12 0 12 Q12 12 12 24 Q12 12 24 12 Q12 12 12 0 Z" fill="#D4AF37" />
        <circle cx="12" cy="12" r="2" fill="#FFF8E7" />
      </svg>
    </div>

    <!-- Starburst Sparkle 5 (Lower Left) -->
    <div class="cloud-mote stardust-twinkle-a absolute bottom-[14%] left-[15%] sm:left-[22%]">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
        <path d="M12 0 Q12 12 0 12 Q12 12 12 24 Q12 12 24 12 Q12 12 12 0 Z" fill="#D4AF37" />
      </svg>
    </div>

    <!-- Starburst Sparkle 6 (Lower Right) -->
    <div class="cloud-mote stardust-twinkle-b absolute bottom-[15%] right-[16%] sm:right-[24%]">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
        <path d="M12 0 Q12 12 0 12 Q12 12 12 24 Q12 12 24 12 Q12 12 12 0 Z" fill="#D4AF37" />
        <circle cx="12" cy="12" r="2.5" fill="#FFF8E7" />
      </svg>
    </div>

    <!-- Golden Dust Particles (Ambient Motes with Subtle Pulse) -->
    <div class="stardust-twinkle-a absolute top-[32%] left-[22%] w-1.5 h-1.5 rounded-full bg-[#E8C97A] shadow-[0_0_8px_#D4AF37]"></div>
    <div class="stardust-twinkle-b absolute top-[38%] right-[20%] w-2 h-2 rounded-full bg-[#E8C97A] shadow-[0_0_10px_#D4AF37]"></div>
    <div class="stardust-twinkle-b absolute top-[65%] left-[26%] w-1.5 h-1.5 rounded-full bg-[#E8C97A] shadow-[0_0_8px_#D4AF37]"></div>
    <div class="stardust-twinkle-a absolute top-[70%] right-[24%] w-2 h-2 rounded-full bg-[#E8C97A] shadow-[0_0_10px_#D4AF37]"></div>
  </div>

</div>

<style>
  /* Decoupled Continuous Living Cloud Motion (Autonomous Ambient Wind Drift) */
  .cloud-drift-tl {
    animation: cloudFloatTL 16s ease-in-out infinite alternate;
  }
  .cloud-drift-tr {
    animation: cloudFloatTR 19s ease-in-out infinite alternate;
  }
  .cloud-drift-bl {
    animation: cloudFloatBL 15s ease-in-out infinite alternate;
  }
  .cloud-drift-br {
    animation: cloudFloatBR 18s ease-in-out infinite alternate;
  }

  @keyframes cloudFloatTL {
    0% {
      transform: translate3d(0, 0, 0) rotate(0deg) scale(1);
    }
    50% {
      transform: translate3d(14px, 10px, 0) rotate(1.2deg) scale(1.025);
    }
    100% {
      transform: translate3d(-8px, -6px, 0) rotate(-0.8deg) scale(0.985);
    }
  }

  @keyframes cloudFloatTR {
    0% {
      transform: translate3d(0, 0, 0) rotate(0deg) scale(1);
    }
    50% {
      transform: translate3d(-16px, 11px, 0) rotate(-1.3deg) scale(1.03);
    }
    100% {
      transform: translate3d(10px, -6px, 0) rotate(1deg) scale(0.98);
    }
  }

  @keyframes cloudFloatBL {
    0% {
      transform: translate3d(0, 0, 0) rotate(0deg) scale(1);
    }
    50% {
      transform: translate3d(16px, -9px, 0) rotate(0.9deg) scale(1.02);
    }
    100% {
      transform: translate3d(-10px, 7px, 0) rotate(-0.8deg) scale(0.99);
    }
  }

  @keyframes cloudFloatBR {
    0% {
      transform: translate3d(0, 0, 0) rotate(0deg) scale(1);
    }
    50% {
      transform: translate3d(-15px, -11px, 0) rotate(-1.1deg) scale(1.025);
    }
    100% {
      transform: translate3d(9px, 6px, 0) rotate(0.9deg) scale(0.985);
    }
  }

  /* Celestial Stardust Twinkling & Breathing */
  .stardust-twinkle-a {
    animation: stardustTwinkleA 6s ease-in-out infinite alternate;
  }
  .stardust-twinkle-b {
    animation: stardustTwinkleB 8s ease-in-out infinite alternate;
  }

  @keyframes stardustTwinkleA {
    0%, 100% {
      transform: translate3d(0, 0, 0) scale(0.95);
      opacity: 0.45;
    }
    50% {
      transform: translate3d(4px, -5px, 0) scale(1.25);
      opacity: 0.95;
      filter: drop-shadow(0 0 8px rgba(212, 175, 55, 0.9));
    }
  }

  @keyframes stardustTwinkleB {
    0%, 100% {
      transform: translate3d(0, 0, 0) scale(1.2);
      opacity: 0.90;
      filter: drop-shadow(0 0 7px rgba(212, 175, 55, 0.85));
    }
    50% {
      transform: translate3d(-5px, 4px, 0) scale(0.85);
      opacity: 0.35;
      filter: drop-shadow(0 0 2px rgba(212, 175, 55, 0.3));
    }
  }

  /* Accessibility Respect */
  @media (prefers-reduced-motion: reduce) {
    .cloud-drift-tl,
    .cloud-drift-tr,
    .cloud-drift-bl,
    .cloud-drift-br,
    .stardust-twinkle-a,
    .stardust-twinkle-b {
      animation: none !important;
    }
  }
</style>
