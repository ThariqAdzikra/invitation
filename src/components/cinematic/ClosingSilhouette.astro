---
// ClosingSilhouette.astro — Romantic Finale Silhouette (Couple Holding Hands under Stars)
interface Props {
  size?: number;
  className?: string;
}

const { size = 260, className = "" } = Astro.props;
---

<div class={`relative flex items-center justify-center select-none ${className}`} aria-hidden="true">
  <!-- Warm Golden Halo Glow -->
  <div class="absolute inset-0 rounded-full bg-[#B89352]/15 blur-xl pointer-events-none transform scale-90"></div>

  <svg
    width={size}
    height={size * 0.9}
    viewBox="0 0 260 230"
    fill="none"
    class="w-full h-auto max-w-[280px] drop-shadow-[0_8px_24px_rgba(42,52,38,0.12)]"
  >
    <defs>
      <radialGradient id="closing-halo" cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="#FFFDF7" stop-opacity="0.95" />
        <stop offset="65%" stop-color="#F4EFE3" stop-opacity="0.85" />
        <stop offset="100%" stop-color="#E8E0CE" stop-opacity="0.7" />
      </radialGradient>

      <linearGradient id="closing-sil" x1="0%" y1="0%" x2="0%" y2="100%">
        <stop offset="0%" stop-color="#2D3B29" />
        <stop offset="100%" stop-color="#1A2217" />
      </linearGradient>
    </defs>

    <!-- Circular Frame with Golden Dashed Rim -->
    <circle cx="130" cy="115" r="95" fill="url(#closing-halo)" stroke="#D5CCA8" stroke-width="1.2" />
    <circle cx="130" cy="115" r="88" fill="none" stroke="#B89352" stroke-width="0.8" stroke-dasharray="3 2" opacity="0.75" />

    <!-- Romantic Night Sky Stars & Sparkles in Halo -->
    <text x="75" y="65" font-size="8" fill="#B89352" opacity="0.8">✦</text>
    <text x="180" y="60" font-size="10" fill="#D4AF37" opacity="0.85">✦</text>
    <text x="130" y="45" font-size="9" fill="#B89352" opacity="0.75">✦</text>
    <text x="55" y="100" font-size="6" fill="#B89352" opacity="0.6">✦</text>
    <text x="205" y="105" font-size="7" fill="#B89352" opacity="0.6">✦</text>

    <!-- SILHOUETTE COUPLE HOLDING HANDS -->
    <!-- Groom (Left) -->
    <path
      d="M 98 100 C 95 92, 100 82, 110 80 C 118 79, 122 85, 121 95 C 120 102, 117 106, 112 108 C 113 114, 115 120, 118 124 C 109 124, 103 120, 101 114 C 97 112, 96 106, 98 100 Z"
      fill="url(#closing-sil)"
    />
    <path
      d="M 104 124 C 92 132, 80 150, 75 180 C 72 200, 71 210, 70 210 L 125 210 C 124 185, 122 155, 118 135 Z"
      fill="url(#closing-sil)"
    />

    <!-- Bride (Right) with Veil -->
    <path
      d="M 148 88 C 160 92, 178 115, 185 160 C 188 190, 188 205, 190 210 L 140 210 C 155 185, 160 145, 155 110 Z"
      fill="rgba(255,255,255,0.7)"
      stroke="rgba(255,255,255,0.5)"
      stroke-width="0.6"
    />
    <path
      d="M 142 102 C 145 94, 155 94, 158 102 C 160 110, 157 117, 150 120 C 148 125, 146 128, 140 130 C 137 127, 136 120, 138 114 C 135 110, 135 105, 142 102 Z"
      fill="url(#closing-sil)"
    />
    <path
      d="M 140 130 C 132 140, 126 160, 126 190 C 126 200, 125 208, 124 210 L 175 210 C 174 185, 170 155, 158 135 Z"
      fill="url(#closing-sil)"
    />

    <!-- Intertwined Hands at Center -->
    <path
      d="M 115 155 Q 130 162 142 158"
      stroke="url(#closing-sil)"
      stroke-width="6"
      stroke-linecap="round"
    />
    <circle cx="129" cy="160" r="2.5" fill="#B89352" />

    <!-- Bottom Botanical Laurel Base -->
    <path d="M 60 205 C 100 195, 160 195, 200 205" stroke="#566A4E" stroke-width="1.4" />
    <circle cx="130" cy="198" r="2.5" fill="#B89352" />
  </svg>
</div>