---
// Cinematic3DTunnel.astro — Pinned 3D Camera Z-Space Fly-Through Journey
import content from '../../data/content.json';
import FloralWreath from '../botanical/FloralWreath.astro';
import FloralFlourish from '../botanical/FloralFlourish.astro';
---

<div id="cinematic-tunnel-container" class="relative w-full min-h-[350vh] z-20">
  
  <!-- Pinned 3D Viewport Rig -->
  <div 
    id="cinematic-viewport" 
    class="sticky top-0 h-[100svh] w-full overflow-hidden flex items-center justify-center pointer-events-auto"
    style="perspective: 1100px; perspective-origin: 50% 50%; transform-style: preserve-3d;"
  >

    <!-- 3D Camera Rig & World Container -->
    <div 
      id="cinematic-camera-rig" 
      class="relative w-full h-full flex items-center justify-center will-change-transform"
      style="transform-style: preserve-3d;"
    >
      
      <!-- ===================================================================
           ATMOSPHERIC 3D FLYING PORTALS & BOTANICAL DEPTH LAYERS
           =================================================================== -->
      
      <!-- 3D Roman Arch Portal 1 (Enclosing Hero) -->
      <div 
        id="portal-arch-1" 
        class="absolute pointer-events-none rounded-t-full border border-[#B89352]/25 will-change-transform"
        style="width: min(85vw, 420px); height: min(78vh, 600px); transform: translate3d(0, 0, -100px); transform-style: preserve-3d;"
      >
        <div class="absolute -top-3 left-1/2 -translate-x-1/2 w-6 h-6 rounded-full border border-[#B89352]/40 bg-[#FAF8F5] flex items-center justify-center">
          <span class="w-2 h-2 rounded-full bg-[#B89352]"></span>
        </div>
      </div>

      <!-- 3D Roman Arch Portal 2 (Between Hero & Verse) -->
      <div 
        id="portal-arch-2" 
        class="absolute pointer-events-none rounded-t-full border-2 border-dashed border-[#566A4E]/20 will-change-transform opacity-60"
        style="width: min(90vw, 520px); height: min(85vh, 720px); transform: translate3d(0, 0, -600px); transform-style: preserve-3d;"
      ></div>

      <!-- 3D Floating Botanical Leaves Sprigs (Flying past camera) -->
      <div 
        id="flying-leaf-left" 
        class="absolute pointer-events-none will-change-transform opacity-70"
        style="left: 4vw; top: 18vh; transform: translate3d(0, 0, -200px);"
      >
        <svg width="68" height="68" viewBox="0 0 100 100" fill="none" class="text-[#566A4E] transform -rotate-45">
          <path d="M50 95 C30 70 15 45 20 15 C50 20 75 35 95 50 C70 55 55 70 50 95 Z" fill="currentColor" fill-opacity="0.25" stroke="#4A5D43" stroke-width="1.5" />
          <path d="M20 15 Q50 50 95 50" stroke="#B89352" stroke-width="1.2" stroke-dasharray="2 3" />
        </svg>
      </div>

      <div 
        id="flying-leaf-right" 
        class="absolute pointer-events-none will-change-transform opacity-70"
        style="right: 5vw; bottom: 20vh; transform: translate3d(0, 0, -350px);"
      >
        <svg width="74" height="74" viewBox="0 0 100 100" fill="none" class="text-[#566A4E] transform rotate-135">
          <path d="M50 95 C30 70 15 45 20 15 C50 20 75 35 95 50 C70 55 55 70 50 95 Z" fill="currentColor" fill-opacity="0.25" stroke="#4A5D43" stroke-width="1.5" />
          <path d="M20 15 Q50 50 95 50" stroke="#B89352" stroke-width="1.2" stroke-dasharray="2 3" />
        </svg>
      </div>

      <div 
        id="flying-petals-cluster" 
        class="absolute pointer-events-none will-change-transform opacity-50"
        style="left: 48%; top: 45%; transform: translate3d(0, 0, -450px);"
      >
        <div class="w-3 h-3 rounded-full bg-[#B89352] blur-[1px] transform translate-x-16 -translate-y-24"></div>
        <div class="w-4 h-4 rounded-full bg-[#D4AF6E] blur-[1px] transform -translate-x-28 translate-y-32"></div>
        <div class="w-2.5 h-2.5 rounded-full bg-[#566A4E] blur-[1px] transform translate-x-32 translate-y-12"></div>
      </div>

      <!-- ===================================================================
           SCENE 1: THE ROYAL ENTRANCE & HERO (Z: 0 -> Zoom past camera)
           =================================================================== -->
      <section 
        id="scene-hero" 
        class="scene-3d absolute inset-0 flex flex-col items-center justify-center p-4 text-center will-change-transform"
        style="transform: translate3d(0, 0, 0px); transform-style: preserve-3d;"
        aria-label="Cover Undangan"
      >
        <div class="max-w-xl w-full mx-auto flex flex-col items-center justify-center my-auto">
          
          <!-- Monogram Crest -->
          <div class="mb-2 transform hover:scale-105 transition-transform duration-500">
            <FloralWreath monogram="AD" size={68} />
          </div>

          <!-- Overline -->
          <p class="text-[0.62rem] sm:text-xs tracking-[0.32em] text-[#B89352] uppercase font-semibold mb-1">
            WALIMATUL 'URS
          </p>

          <!-- Names -->
          <h1 class="font-display text-4xl sm:text-5xl md:text-6xl text-[#2A3426] font-normal tracking-tight leading-tight my-1">
            {content.couple.groom.nickname} <span class="font-display italic text-[#B89352] font-normal px-1">&amp;</span> {content.couple.bride.nickname}
          </h1>

          <div class="my-1.5 opacity-80">
            <FloralFlourish width={140} height={20} />
          </div>

          <!-- Haute-Couture Vector Illustration in Roman Arch Frame -->
          <div class="my-2 relative group cursor-pointer">
            <div 
              class="relative w-48 sm:w-56 aspect-[3/4] mx-auto rounded-t-full border-2 border-[#B89352]/40 p-1.5 bg-gradient-to-b from-[#FAF8F5] via-[#FFFFFF] to-[#F3EEE5] shadow-[0_12px_35px_rgba(42,52,38,0.12)] interactive-foil-card overflow-hidden"
              data-foil="true"
            >
              <div class="w-full h-full rounded-t-full overflow-hidden border border-[#566A4E]/20 relative bg-[#FAF8F5]">
                <img 
                  src="/assets/vector-hero.jpg" 
                  alt="Ilustrasi Mempelai Arya & Dian" 
                  class="w-full h-full object-cover transform group-hover:scale-105 transition-transform duration-700 ease-out"
                  loading="eager"
                  fetchpriority="high"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-[#2A3426]/15 via-transparent to-transparent pointer-events-none"></div>
              </div>
            </div>
            <div class="w-36 h-2 bg-[#263322]/10 rounded-full blur-sm mx-auto -mt-1 pointer-events-none"></div>
          </div>

          <!-- Date & Venue -->
          <div class="mt-2 flex flex-col items-center gap-0.5">
            <p class="text-[0.68rem] sm:text-xs text-[#4A5D43] tracking-[0.24em] uppercase font-semibold">
              {content.event.dateFormatted} &bull; {content.event.timezone}
            </p>
            <p class="text-[0.65rem] text-[#7E8F77] font-light tracking-wider">
              {content.event.venue.name} &bull; Banda Aceh
            </p>
          </div>

          <!-- Guest Welcoming Pill -->
          <div class="mt-3 py-2 px-5 rounded-full border border-[#566A4E]/20 bg-white/90 shadow-sm flex items-center gap-2">
            <span class="text-[0.55rem] tracking-[0.2em] uppercase text-[#7E8F77] font-semibold">Tamu Terhormat:</span>
            <span id="hero-guest-name" class="font-display text-xs sm:text-sm text-[#2A3426] font-normal">Tamu Undangan</span>
          </div>

        </div>
      </section>

      <!-- ===================================================================
           SCENE 2: THE SACRED VERSE (QS AR-RUM: 21) (Z: -900 -> 0 -> Zoom past)
           =================================================================== -->
      <section 
        id="scene-verse" 
        class="scene-3d absolute inset-0 flex flex-col items-center justify-center p-4 text-center will-change-transform opacity-0 pointer-events-none"
        style="transform: translate3d(0, 0, -900px); transform-style: preserve-3d;"
        aria-label="Ayat Suci Al-Qur'an"
      >
        <div class="max-w-xl w-full mx-auto flex flex-col items-center justify-center my-auto">
          
          <!-- Sacred Bismillah -->
          <p class="font-arabic text-2xl sm:text-3xl text-[#3E4C38] mb-3 drop-shadow-sm" dir="rtl" lang="ar">
            {content.opening.bismillah}
          </p>

          <!-- Ayat Suci Card -->
          <div 
            class="w-full bg-white/95 border border-[#566A4E]/25 rounded-2xl p-5 sm:p-8 shadow-[0_16px_40px_rgba(42,52,38,0.08)] relative overflow-hidden my-2 interactive-foil-card"
            data-foil="true"
          >
            <div class="absolute top-0 left-0 right-0 h-[2.5px] bg-gradient-to-r from-transparent via-[#B89352] to-transparent"></div>

            <blockquote lang="ar" dir="rtl" class="font-arabic text-lg sm:text-2xl text-[#2A3426] leading-loose max-w-lg mx-auto relative z-10">
              {content.opening.verse}
            </blockquote>

            <p class="text-[0.72rem] sm:text-xs text-[#566A4E] font-light leading-relaxed my-3 max-w-md mx-auto italic relative z-10">
              &ldquo;{content.opening.translation}&rdquo;
            </p>

            <div class="my-1.5 relative z-10 opacity-70 flex justify-center">
              <FloralFlourish width={130} height={20} />
            </div>

            <p class="text-[0.62rem] tracking-[0.25em] text-[#B89352] uppercase font-semibold mt-1 relative z-10">
              {content.opening.source}
            </p>
          </div>

          <p class="text-xs text-[#4A5D43] mt-3 font-normal max-w-md leading-relaxed">
            {content.opening.greeting}
          </p>

        </div>
      </section>

      <!-- ===================================================================
           SCENE 3: KEDUA MEMPELAI (ARYA & DIAN) (Z: -900 -> 0 Crisp landing)
           =================================================================== -->
      <section 
        id="scene-couple" 
        class="scene-3d absolute inset-0 flex flex-col items-center justify-center p-4 text-center will-change-transform opacity-0 pointer-events-none"
        style="transform: translate3d(0, 0, -900px); transform-style: preserve-3d;"
        aria-label="Profil Kedua Mempelai"
      >
        <div class="max-w-3xl w-full mx-auto flex flex-col items-center justify-center my-auto">
          
          <p class="text-overline tracking-[0.28em] text-[0.62rem] mb-0.5">
            KEDUA MEMPELAI
          </p>
          <h2 class="font-display text-2xl sm:text-3xl md:text-4xl text-[#2A3426] font-normal mb-1">
            Mempelai Pria &amp; Wanita
          </h2>
          <div class="my-1 flex justify-center opacity-70">
            <FloralFlourish width={140} height={20} />
          </div>

          <!-- Dual Profiles Grid -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 sm:gap-6 w-full mt-2">
            
            <!-- Arya (Groom) -->
            <article 
              class="couple-profile-card bg-white/95 border border-[#566A4E]/20 rounded-2xl p-4 sm:p-6 flex flex-col items-center text-center shadow-[0_12px_35px_rgba(42,52,38,0.06)] relative overflow-hidden interactive-foil-card"
              data-foil="true"
            >
              <div class="absolute top-0 left-0 right-0 h-[2px] bg-gradient-to-r from-transparent via-[#B89352] to-transparent"></div>

              <div class="mb-3 relative group">
                <div class="w-24 h-24 sm:w-28 sm:h-28 rounded-full p-1 border-2 border-[#B89352]/40 bg-gradient-to-tr from-[#FAF8F5] via-[#FFFFFF] to-[#F3EEE5] shadow-md relative overflow-hidden">
                  <img 
                    src="/assets/vector-groom.jpg" 
                    alt={content.couple.groom.fullName} 
                    class="w-full h-full object-cover rounded-full transform group-hover:scale-105 transition-transform duration-500 ease-out"
                    loading="lazy"
                  />
                </div>
              </div>

              <p class="text-[0.55rem] tracking-[0.25em] text-[#B89352] uppercase font-semibold mb-0.5">Mempelai Pria</p>
              <h3 class="font-display text-lg sm:text-xl text-[#2A3426] font-normal">
                {content.couple.groom.fullName}
              </h3>
              <p class="text-[0.65rem] text-[#566A4E] font-light max-w-xs leading-relaxed mt-0.5 mb-2">
                {content.couple.groom.parents}
              </p>

              <div class="py-2 px-3 rounded-lg bg-[#FAF8F5] border border-[#566A4E]/10 w-full mb-3">
                <p class="font-display italic text-[0.68rem] sm:text-xs text-[#3E4C38] leading-relaxed">
                  &ldquo;{content.couple.groom.quote}&rdquo;
                </p>
              </div>

              <a 
                href={`https://instagram.com/${content.couple.groom.instagram.replace('@', '')}`} 
                target="_blank" 
                rel="noopener noreferrer" 
                class="inline-flex items-center gap-1.5 text-[0.6rem] text-[#566A4E] hover:text-[#2A3426] tracking-widest uppercase font-semibold px-3 py-1 rounded-full border border-[#566A4E]/20 bg-white hover:border-[#B89352] transition-colors"
              >
                <span>{content.couple.groom.instagram}</span>
                <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6M15 3h6v6M10 14L21 3"/>
                </svg>
              </a>
            </article>

            <!-- Dian (Bride) -->
            <article 
              class="couple-profile-card bg-white/95 border border-[#566A4E]/20 rounded-2xl p-4 sm:p-6 flex flex-col items-center text-center shadow-[0_12px_35px_rgba(42,52,38,0.06)] relative overflow-hidden interactive-foil-card"
              data-foil="true"
            >
              <div class="absolute top-0 left-0 right-0 h-[2px] bg-gradient-to-r from-transparent via-[#B89352] to-transparent"></div>

              <div class="mb-3 relative group">
                <div class="w-24 h-24 sm:w-28 sm:h-28 rounded-full p-1 border-2 border-[#B89352]/40 bg-gradient-to-tr from-[#FAF8F5] via-[#FFFFFF] to-[#F3EEE5] shadow-md relative overflow-hidden">
                  <img 
                    src="/assets/vector-bride.jpg" 
                    alt={content.couple.bride.fullName} 
                    class="w-full h-full object-cover rounded-full transform group-hover:scale-105 transition-transform duration-500 ease-out"
                    loading="lazy"
                  />
                </div>
              </div>

              <p class="text-[0.55rem] tracking-[0.25em] text-[#B89352] uppercase font-semibold mb-0.5">Mempelai Wanita</p>
              <h3 class="font-display text-lg sm:text-xl text-[#2A3426] font-normal">
                {content.couple.bride.fullName}
              </h3>
              <p class="text-[0.65rem] text-[#566A4E] font-light max-w-xs leading-relaxed mt-0.5 mb-2">
                {content.couple.bride.parents}
              </p>

              <div class="py-2 px-3 rounded-lg bg-[#FAF8F5] border border-[#566A4E]/10 w-full mb-3">
                <p class="font-display italic text-[0.68rem] sm:text-xs text-[#3E4C38] leading-relaxed">
                  &ldquo;{content.couple.bride.quote}&rdquo;
                </p>
              </div>

              <a 
                href={`https://instagram.com/${content.couple.bride.instagram.replace('@', '')}`} 
                target="_blank" 
                rel="noopener noreferrer" 
                class="inline-flex items-center gap-1.5 text-[0.6rem] text-[#566A4E] hover:text-[#2A3426] tracking-widest uppercase font-semibold px-3 py-1 rounded-full border border-[#566A4E]/20 bg-white hover:border-[#B89352] transition-colors"
              >
                <span>{content.couple.bride.instagram}</span>
                <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6M15 3h6v6M10 14L21 3"/>
                </svg>
              </a>
            </article>

          </div>

        </div>
      </section>

    </div>

    <!-- Minimalist Scroll Cue Pill -->
    <div id="scroll-fly-cue" class="absolute bottom-5 left-1/2 -translate-x-1/2 flex items-center gap-2 px-4 py-1.5 rounded-full bg-white/85 border border-[#566A4E]/25 text-[#4A5D43] text-[0.6rem] tracking-[0.25em] uppercase font-semibold shadow-sm pointer-events-none transition-opacity duration-300">
      <span>Scroll untuk Menjelajah</span>
      <span class="w-1.5 h-1.5 rounded-full bg-[#B89352] animate-ping"></span>
    </div>

  </div>

</div>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  function init3DTunnel() {
    const container = document.getElementById('cinematic-tunnel-container');
    const viewport = document.getElementById('cinematic-viewport');
    const cameraRig = document.getElementById('cinematic-camera-rig');

    const sceneHero = document.getElementById('scene-hero');
    const sceneVerse = document.getElementById('scene-verse');
    const sceneCouple = document.getElementById('scene-couple');

    const portal1 = document.getElementById('portal-arch-1');
    const portal2 = document.getElementById('portal-arch-2');
    const leafLeft = document.getElementById('flying-leaf-left');
    const leafRight = document.getElementById('flying-leaf-right');
    const petals = document.getElementById('flying-petals-cluster');
    const scrollCue = document.getElementById('scroll-fly-cue');

    // Pre-fill name from URL parameter
    const urlParams = new URLSearchParams(window.location.search);
    const rawTo = urlParams.get('to');
    if (rawTo) {
      try {
        const decoded = decodeURIComponent(rawTo.replace(/\+/g, ' ')).replace(/<[^>]*>/g, '').trim().substring(0, 50);
        const heroGuest = document.getElementById('hero-guest-name');
        if (heroGuest && decoded) heroGuest.textContent = decoded;
      } catch (e) {}
    }

    if (!container || !viewport || !sceneHero || !sceneVerse || !sceneCouple) return;

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReducedMotion) {
      // Fallback for reduced motion: display scenes normally without 3D translation
      if (sceneVerse) {
        sceneVerse.style.opacity = '1';
        sceneVerse.style.transform = 'none';
        sceneVerse.style.position = 'relative';
        sceneVerse.style.pointerEvents = 'auto';
      }
      if (sceneCouple) {
        sceneCouple.style.opacity = '1';
        sceneCouple.style.transform = 'none';
        sceneCouple.style.position = 'relative';
        sceneCouple.style.pointerEvents = 'auto';
      }
      return;
    }

    // Set initial 3D transforms via GSAP
    gsap.set(sceneHero, { z: 0, scale: 1, opacity: 1, filter: 'blur(0px)', pointerEvents: 'auto' });
    gsap.set(sceneVerse, { z: -850, scale: 0.55, opacity: 0, filter: 'blur(10px)', pointerEvents: 'none' });
    gsap.set(sceneCouple, { z: -850, scale: 0.55, opacity: 0, filter: 'blur(10px)', pointerEvents: 'none' });

    // GSAP Pinned Timeline
    const tl = gsap.timeline({
      scrollTrigger: {
        trigger: container,
        pin: viewport,
        start: 'top top',
        end: 'bottom bottom',
        scrub: 1.2,
        anticipatePin: 1,
        onUpdate: (self) => {
          // Hide scroll cue when user has started scrolling into the 3D tunnel
          if (scrollCue) {
            scrollCue.style.opacity = self.progress > 0.85 ? '0' : '1';
          }
        }
      }
    });

    // =========================================================================
    // 3D TIMELINE SEGMENTS (0.00 -> 1.00 normalized time)
    // =========================================================================

    // STEP 1: Hero Scene zooms forward past camera & Portal 1 expands (0.00 -> 0.35)
    tl.to(sceneHero, {
      z: 650,
      scale: 1.35,
      opacity: 0,
      filter: 'blur(8px)',
      duration: 0.35,
      ease: 'power1.inOut',
      onComplete: () => {
        if (sceneHero) sceneHero.style.pointerEvents = 'none';
      },
      onReverseComplete: () => {
        if (sceneHero) sceneHero.style.pointerEvents = 'auto';
      }
    }, 0);

    if (portal1) {
      tl.to(portal1, { z: 750, scale: 1.6, opacity: 0, duration: 0.32, ease: 'power1.in' }, 0);
    }
    if (leafLeft) {
      tl.to(leafLeft, { z: 700, x: -120, y: 80, duration: 0.38, ease: 'power1.out' }, 0);
    }
    if (leafRight) {
      tl.to(leafRight, { z: 650, x: 100, y: -60, duration: 0.38, ease: 'power1.out' }, 0);
    }
    if (petals) {
      tl.to(petals, { z: 800, scale: 2, duration: 0.45, ease: 'power1.out' }, 0);
    }

    // STEP 2: Verse Scene zooms in from depth into crisp focus (0.22 -> 0.52)
    tl.to(sceneVerse, {
      z: 0,
      scale: 1,
      opacity: 1,
      filter: 'blur(0px)',
      duration: 0.30,
      ease: 'power2.out',
      onStart: () => {
        if (sceneVerse) sceneVerse.style.pointerEvents = 'auto';
      }
    }, 0.22);

    if (portal2) {
      tl.to(portal2, { z: 0, opacity: 1, duration: 0.28, ease: 'power2.out' }, 0.22);
    }

    // STEP 3: Verse Scene zooms forward past camera (0.52 -> 0.72)
    tl.to(sceneVerse, {
      z: 650,
      scale: 1.35,
      opacity: 0,
      filter: 'blur(8px)',
      duration: 0.22,
      ease: 'power1.in',
      onComplete: () => {
        if (sceneVerse) sceneVerse.style.pointerEvents = 'none';
      }
    }, 0.54);

    if (portal2) {
      tl.to(portal2, { z: 700, scale: 1.5, opacity: 0, duration: 0.22, ease: 'power1.in' }, 0.54);
    }

    // STEP 4: Couple Scene zooms in from depth into full crisp view (0.58 -> 0.88)
    tl.to(sceneCouple, {
      z: 0,
      scale: 1,
      opacity: 1,
      filter: 'blur(0px)',
      duration: 0.30,
      ease: 'power2.out',
      onStart: () => {
        if (sceneCouple) sceneCouple.style.pointerEvents = 'auto';
      }
    }, 0.58);

    // Couple Scene rests comfortably in crisp focus until the unpin transition
    tl.to(sceneCouple, {
      z: 0,
      scale: 1,
      duration: 0.12
    }, 0.88);

    // Mouse & Touch Parallax in 3D Rig
    window.addEventListener('mousemove', (e) => {
      const xNorm = (e.clientX / window.innerWidth - 0.5) * 2;
      const yNorm = (e.clientY / window.innerHeight - 0.5) * 2;
      gsap.to(cameraRig, {
        rotateY: xNorm * 4,
        rotateX: -yNorm * 3,
        duration: 1.2,
        ease: 'power2.out'
      });
    });

    window.addEventListener('touchmove', (e) => {
      if (e.touches && e.touches[0]) {
        const touch = e.touches[0];
        const xNorm = (touch.clientX / window.innerWidth - 0.5) * 2;
        const yNorm = (touch.clientY / window.innerHeight - 0.5) * 2;
        gsap.to(cameraRig, {
          rotateY: xNorm * 3,
          rotateX: -yNorm * 2.5,
          duration: 1.0,
          ease: 'power2.out'
        });
      }
    }, { passive: true });

    // Ensure ScrollTrigger recalculates after invitation envelope is unboxed
    window.addEventListener('invitationOpened', () => {
      setTimeout(() => {
        ScrollTrigger.refresh();
      }, 150);
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init3DTunnel);
  } else {
    init3DTunnel();
  }
</script>
