---
// Cinematic3DTunnel.astro — Elegant Symmetrical 3D Z-Space Journey (Clean & Non-Colliding)
import content from '../../data/content.json';
import FloralWreath from '../botanical/FloralWreath.astro';
import FloralFlourish from '../botanical/FloralFlourish.astro';
import FlyingDoves from '../botanical/FlyingDoves.astro';
import FloralCorner from '../botanical/FloralCorner.astro';
---

<div id="cinematic-tunnel-container" class="relative w-full min-h-[620vh] z-20">
  
  <!-- Pinned 3D Viewport Rig (Stationary Camera Perspective) -->
  <div 
    id="cinematic-viewport" 
    class="sticky top-0 h-[100svh] w-full overflow-hidden flex items-center justify-center pointer-events-auto"
    style="perspective: 1100px; perspective-origin: 50% 50%; transform-style: preserve-3d;"
  >

    <!-- Minimalist Haute-Couture 3D Story Chapter Rail (Right Side) -->
    <nav 
      id="tunnel-chapter-rail"
      class="absolute right-3 sm:right-6 top-1/2 -translate-y-1/2 z-50 flex flex-col items-center gap-2 pointer-events-none transition-all duration-500 opacity-90 select-none"
      aria-label="Indikator Bab 3D"
    >
      <div id="pip-1" class="chapter-pip flex items-center gap-1.5 transition-all duration-300">
        <span class="text-[0.52rem] font-mono tracking-widest text-[#B89352] font-semibold pip-label">01</span>
        <div class="w-2 h-2 rounded-full bg-[#B89352] shadow-[0_0_8px_rgba(184,147,82,0.6)] pip-dot scale-110"></div>
      </div>
      <div class="w-[1px] h-2.5 bg-[#B89352]/25"></div>
      <div id="pip-2" class="chapter-pip flex items-center gap-1.5 transition-all duration-300 opacity-35">
        <span class="text-[0.52rem] font-mono tracking-widest text-[#7E8F77] pip-label">02</span>
        <div class="w-1.5 h-1.5 rounded-full bg-[#7E8F77] pip-dot scale-100"></div>
      </div>
      <div class="w-[1px] h-2.5 bg-[#B89352]/25"></div>
      <div id="pip-3" class="chapter-pip flex items-center gap-1.5 transition-all duration-300 opacity-35">
        <span class="text-[0.52rem] font-mono tracking-widest text-[#7E8F77] pip-label">03</span>
        <div class="w-1.5 h-1.5 rounded-full bg-[#7E8F77] pip-dot scale-100"></div>
      </div>
      <div class="w-[1px] h-2.5 bg-[#B89352]/25"></div>
      <div id="pip-4" class="chapter-pip flex items-center gap-1.5 transition-all duration-300 opacity-35">
        <span class="text-[0.52rem] font-mono tracking-widest text-[#7E8F77] pip-label">04</span>
        <div class="w-1.5 h-1.5 rounded-full bg-[#7E8F77] pip-dot scale-100"></div>
      </div>
    </nav>

    <!-- 3D Camera Rig: Anchored & Centered (No mouse tracking) -->
    <div 
      id="cinematic-camera-rig" 
      class="relative w-full h-full flex items-center justify-center will-change-transform"
      style="transform-style: preserve-3d;"
    >

      <!-- ===================================================================
           SCENE 1: THE ROYAL ENTRANCE & HERO (Z: 0 -> Zoom past camera)
           Spacious Classical Haute-Couture Symmetrical Layout
           =================================================================== -->
      <section 
        id="scene-hero" 
        class="scene-3d absolute inset-0 flex flex-col items-center justify-center px-4 py-6 text-center will-change-transform"
        style="transform: translate3d(0, 0, 0px); transform-style: preserve-3d;"
        aria-label="Cover Undangan Pernikahan"
      >
        <div class="max-w-lg w-full mx-auto flex flex-col items-center justify-between h-[84svh] max-h-[720px] my-auto relative z-10">
          
          <!-- TOP BLOCK: Crest, Tagline, & Symmetrical Headline -->
          <div id="hero-top-block" class="flex flex-col items-center pt-2 sm:pt-3 will-change-transform">
            <!-- Monogram Crest with Soft Gold Aura -->
            <div class="mb-2 relative">
              <div class="absolute -inset-2 rounded-full bg-[radial-gradient(circle,rgba(212,175,55,0.2)_0%,transparent_70%)] blur-sm pointer-events-none"></div>
              <FloralWreath monogram="ZD" size={54} />
            </div>

            <!-- Overline -->
            <p class="text-[0.62rem] sm:text-xs tracking-[0.38em] text-[#B89352] uppercase font-semibold mb-1">
              WALIMATUL 'URS
            </p>

            <!-- Names with spacious breathing room -->
            <h1 class="font-display text-4xl sm:text-5xl md:text-6xl text-[#2A3426] font-normal tracking-tight leading-none my-1">
              {content.couple.groom.nickname} <span class="font-display italic text-[#B89352] font-normal px-1">&amp;</span> {content.couple.bride.nickname}
            </h1>

            <!-- Whispered Minimalist Hairline Divider -->
            <div class="mt-2 mb-1 flex items-center justify-center gap-2.5 opacity-70">
              <span class="w-10 sm:w-16 h-[1px] bg-gradient-to-r from-transparent to-[#B89352]/50"></span>
              <span class="text-[0.55rem] text-[#B89352]">✦</span>
              <span class="w-10 sm:w-16 h-[1px] bg-gradient-to-l from-transparent to-[#B89352]/50"></span>
            </div>
          </div>

          <!-- CENTER BLOCK: Royal Floral Gate with Ethereal Golden Glow -->
          <div id="hero-arch-block" class="my-auto py-2 relative will-change-transform flex flex-col items-center justify-center">
            <!-- Ethereal Sunrise Golden Aura Blooming Naturally Behind Art -->
            <div class="absolute -inset-10 sm:-inset-16 bg-[radial-gradient(ellipse_at_center,rgba(212,175,55,0.28)_0%,rgba(184,147,82,0.15)_40%,rgba(74,93,67,0.03)_65%,transparent_80%)] blur-2xl pointer-events-none -z-10"></div>

            <!-- Floral Gate Artwork (Direct Arch Gate, 100% Seamlessly Integrated into Canvas) -->
            <div class="relative w-52 sm:w-60 aspect-[3/4] mx-auto flex items-center justify-center pointer-events-none select-none">
              <img 
                src="/assets/vector-hero-gate.png" 
                alt={`Ilustrasi Mempelai ${content.couple.groom.nickname} & ${content.couple.bride.nickname}`} 
                class="w-full h-full object-contain pointer-events-none select-none"
                loading="eager"
                fetchpriority="high"
              />
            </div>
          </div>

          <!-- BOTTOM BLOCK: Minimalist Editorial Date, Venue & Guest Welcoming -->
          <div id="hero-bottom-block" class="flex flex-col items-center gap-1 pb-2 sm:pb-3 w-full will-change-transform">
            <!-- Event Meta -->
            <div class="flex items-center justify-center gap-2 text-[0.62rem] sm:text-[0.7rem] text-[#4A5D43] tracking-[0.24em] uppercase font-semibold">
              <span>{content.event.dateFormatted}</span>
              <span class="text-[#B89352] text-[0.55rem]">&bull;</span>
              <span>Padang</span>
            </div>
            
            <p class="text-[0.58rem] sm:text-[0.62rem] text-[#7E8F77] font-light tracking-wider">
              {content.event.venue.name}
            </p>

            <!-- Minimalist Editorial Guest Welcoming Line (Clean, No Bulky Card) -->
            <div class="mt-2.5 flex flex-col items-center">
              <span class="text-[0.52rem] tracking-[0.3em] uppercase text-[#7E8F77] font-semibold mb-0.5">
                Kepada Yth. Bapak/Ibu/Saudara/i:
              </span>
              <div class="relative inline-flex items-center justify-center px-4 py-0.5">
                <span class="absolute left-0 top-1/2 -translate-y-1/2 w-3 h-[1px] bg-[#B89352]/40"></span>
                <span id="hero-guest-name" class="font-display italic text-sm sm:text-base text-[#2A3426] font-normal px-2 truncate max-w-[240px] sm:max-w-[320px]">
                  Tamu Undangan Terhormat
                </span>
                <span class="absolute right-0 top-1/2 -translate-y-1/2 w-3 h-[1px] bg-[#B89352]/40"></span>
              </div>
            </div>
          </div>

        </div>
      </section>

      <!-- ===================================================================
           SCENE 2: THE SACRED VERSE (QS AR-RUM: 21) (Z: -850 -> 0 -> Zoom past)
           ROYAL SACRED ARCH PORTAL (LENGKUNG MIHRAB KUBAH SUCI)
           =================================================================== -->
      <section 
        id="scene-verse" 
        class="scene-3d absolute inset-0 flex flex-col items-center justify-center px-4 py-6 text-center will-change-transform opacity-0 pointer-events-none"
        style="transform: translate3d(0, 0, -850px); transform-style: preserve-3d;"
        aria-label="Ayat Suci Al-Qur'an"
      >
        <div class="max-w-xl w-full mx-auto flex flex-col items-center justify-center my-auto relative">
          
          <!-- Ethereal Volumetric Golden Halo Blooming Behind the Arch -->
          <div class="absolute -inset-10 sm:-inset-16 bg-[radial-gradient(ellipse_at_center,rgba(212,175,55,0.25)_0%,rgba(184,147,82,0.12)_45%,rgba(74,93,67,0.02)_70%,transparent_85%)] blur-2xl pointer-events-none -z-10"></div>
          
          <!-- Royal Mihrab Cathedral Archway Container -->
          <div 
            id="verse-arch-card" 
            class="relative w-full max-w-md sm:max-w-lg rounded-t-[140px] sm:rounded-t-[180px] rounded-b-3xl border border-[#B89352]/35 bg-gradient-to-b from-[#FAF8F5]/94 via-[#FAF8F5]/90 to-[#FAF8F5]/96 backdrop-blur-md shadow-[0_16px_48px_rgba(42,52,38,0.07)] p-6 sm:p-8 pt-8 sm:pt-10 flex flex-col items-center text-center will-change-transform overflow-hidden"
          >
            <!-- Inner Concentric Gilded Arch Inset Line -->
            <div class="absolute inset-1.5 sm:inset-2 rounded-t-[132px] sm:rounded-t-[172px] rounded-b-[20px] border border-[#B89352]/20 pointer-events-none"></div>

            <!-- Arch Apex Finial Star & Whispered Rays -->
            <div class="flex items-center justify-center gap-2 mb-2 sm:mb-3 opacity-80">
              <span class="w-8 sm:w-12 h-[1px] bg-gradient-to-r from-transparent to-[#B89352]/60"></span>
              <span class="text-[0.65rem] text-[#B89352]">✦</span>
              <span class="w-8 sm:w-12 h-[1px] bg-gradient-to-l from-transparent to-[#B89352]/60"></span>
            </div>

            <!-- Sacred Bismillah -->
            <p id="verse-bismillah" class="font-arabic text-2xl sm:text-3xl text-[#3E4C38] mb-3 drop-shadow-xs will-change-transform" dir="rtl" lang="ar">
              {content.opening.bismillah}
            </p>

            <!-- Sacred Arabic Verse -->
            <div id="verse-content-block" class="w-full flex flex-col items-center text-center px-2 sm:px-4 will-change-transform">
              <blockquote lang="ar" dir="rtl" class="font-arabic text-xl sm:text-2xl sm:leading-[2.5] text-[#242F21] leading-loose max-w-lg mx-auto drop-shadow-xs selection:bg-[#B89352]/20">
                {content.opening.verse}
              </blockquote>

              <!-- Whispered Floral Flourish Divider -->
              <div class="my-3.5 sm:my-4 flex items-center justify-center opacity-70">
                <FloralFlourish width={130} height={16} />
              </div>

              <!-- Indonesian Translation -->
              <p class="text-xs sm:text-[0.82rem] text-[#4A5D43] font-light leading-relaxed max-w-md mx-auto italic font-serif">
                &ldquo;{content.opening.translation}&rdquo;
              </p>

              <!-- Classical Surah Citation Badge -->
              <div class="inline-flex items-center gap-1.5 px-3.5 py-0.5 rounded-full border border-[#B89352]/35 bg-[#B89352]/8 text-[0.58rem] sm:text-[0.64rem] tracking-[0.28em] text-[#B89352] uppercase font-semibold mt-3">
                <span>{content.opening.source}</span>
              </div>
            </div>

          </div>

          <!-- Editorial Greeting Sentence (Positioned as Pedestal Foundation) -->
          <p id="verse-greeting" class="text-[0.68rem] sm:text-[0.74rem] text-[#7E8F77] mt-4 font-light max-w-md leading-relaxed will-change-transform">
            {content.opening.greeting}
          </p>

        </div>
      </section>

      <!-- ===================================================================
           SCENE 3: KEDUA MEMPELAI (DIFA & ZHARKASI) (Z: -850 -> 0 Crisp landing)
           =================================================================== -->
      <section 
        id="scene-couple" 
        class="scene-3d absolute inset-0 flex flex-col items-center justify-center px-4 py-6 text-center will-change-transform opacity-0 pointer-events-none"
        style="transform: translate3d(0, 0, -850px); transform-style: preserve-3d;"
        aria-label="Profil Kedua Mempelai"
      >
        <div class="max-w-2xl md:max-w-4xl lg:max-w-5xl w-full mx-auto flex flex-col items-center justify-center my-auto relative">
          
          <!-- Header -->
          <div id="couple-header-block" class="flex flex-col items-center will-change-transform mb-1 sm:mb-2">
            <p class="text-overline tracking-[0.28em] text-[0.6rem] sm:text-xs mb-0.5">
              IKRAR SUCI DUA INSAN
            </p>
            <h2 class="font-display text-2xl sm:text-3xl md:text-4xl text-[#2A3426] font-normal mb-1">
              Kedua Mempelai
            </h2>
            <div class="my-1 flex justify-center opacity-70">
              <FloralFlourish width={140} height={18} />
            </div>
          </div>

          <!-- Frameless Organic Couple Feature & Asmaraloka Poetry -->
          <div id="couple-profiles-wrap" class="w-full flex flex-col items-center mt-1 relative z-10 will-change-transform">
            
            <!-- Dual Floating Portraits with Central Ampersand Flourish -->
            <div id="couple-cards-container" class="flex items-center justify-center gap-3 sm:gap-8 md:gap-12 w-full max-w-lg mx-auto relative">
              
              <!-- Golden Fusion Spark Element (activates when avatars touch) -->
              <div 
                id="couple-merge-spark" 
                class="absolute left-1/2 top-10 sm:top-12 -translate-x-1/2 -translate-y-1/2 w-28 h-28 sm:w-36 sm:h-36 rounded-full bg-[radial-gradient(circle,rgba(216,186,122,0.7)_0%,rgba(184,147,82,0.3)_45%,transparent_70%)] blur-md pointer-events-none opacity-0 will-change-transform z-20"
              ></div>

              <!-- Zharkasi (Groom) -->
              <div id="couple-groom-profile" class="flex flex-col items-center text-center will-change-transform flex-1 max-w-[200px]">
                <div id="couple-groom-avatar" class="relative mb-1.5 sm:mb-2 group will-change-transform">
                  <div class="absolute -inset-2.5 rounded-full bg-[radial-gradient(circle,rgba(184,147,82,0.22)_0%,transparent_70%)] blur-md pointer-events-none"></div>
                  <div class="w-20 h-20 sm:w-24 sm:h-24 rounded-full p-1 border-2 border-[#B89352]/50 bg-gradient-to-tr from-[#FAF8F5] via-[#FFFFFF] to-[#F3EEE5] shadow-[0_6px_18px_rgba(42,52,38,0.08)] relative overflow-hidden">
                    <img 
                      src="/assets/vector-groom.jpg" 
                      alt={content.couple.groom.fullName} 
                      class="w-full h-full object-cover rounded-full"
                      loading="lazy"
                    />
                  </div>
                </div>

                <div id="couple-groom-details" class="flex flex-col items-center text-center will-change-transform">
                  <p class="text-[0.52rem] sm:text-[0.62rem] tracking-[0.26em] text-[#B89352] uppercase font-semibold mb-0.5">
                    Mempelai Pria
                  </p>
                  <h3 class="font-display text-xs sm:text-base md:text-lg text-[#2A3426] font-normal leading-snug">
                    {content.couple.groom.fullName}
                  </h3>
                  <p class="text-[0.55rem] sm:text-[0.65rem] text-[#566A4E] font-light mt-0.5 italic">
                    {content.couple.groom.parents}
                  </p>

                  <p class="font-display italic text-[0.65rem] sm:text-xs text-[#4A5D43] leading-relaxed mt-1.5 px-1 max-w-[200px]">
                    &ldquo;Bagi saya, mencintaimu adalah ketenangan paling tulus yang dianugerahkan semesta.&rdquo;
                  </p>

                  <a 
                    href={`https://instagram.com/${content.couple.groom.instagram.replace('@', '')}`} 
                    target="_blank" 
                    rel="noopener noreferrer" 
                    class="inline-flex items-center gap-1 text-[0.5rem] sm:text-[0.58rem] text-[#7E8F77] hover:text-[#B89352] tracking-wider uppercase font-medium mt-1.5 transition-colors"
                  >
                    <span>{content.couple.groom.instagram}</span>
                    <svg width="8" height="8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6M15 3h6v6M10 14L21 3"/>
                    </svg>
                  </a>
                </div>
              </div>

              <!-- Center Calligraphic Link -->
              <div id="couple-center-link" class="flex flex-col items-center justify-center px-1 opacity-80 select-none will-change-transform">
                <span class="h-4 sm:h-6 w-[1px] bg-[#B89352]/40 mb-1"></span>
                <span class="font-display italic text-xl sm:text-3xl text-[#B89352]">&amp;</span>
                <span class="h-4 sm:h-6 w-[1px] bg-[#B89352]/40 mt-1"></span>
              </div>

              <!-- Difa (Bride) -->
              <div id="couple-bride-profile" class="flex flex-col items-center text-center will-change-transform flex-1 max-w-[200px]">
                <div id="couple-bride-avatar" class="relative mb-1.5 sm:mb-2 group will-change-transform">
                  <div class="absolute -inset-2.5 rounded-full bg-[radial-gradient(circle,rgba(184,147,82,0.22)_0%,transparent_70%)] blur-md pointer-events-none"></div>
                  <div class="w-20 h-20 sm:w-24 sm:h-24 rounded-full p-1 border-2 border-[#B89352]/50 bg-gradient-to-tr from-[#FAF8F5] via-[#FFFFFF] to-[#F3EEE5] shadow-[0_6px_18px_rgba(42,52,38,0.08)] relative overflow-hidden">
                    <img 
                      src="/assets/vector-bride.jpg" 
                      alt={content.couple.bride.fullName} 
                      class="w-full h-full object-cover rounded-full"
                      loading="lazy"
                    />
                  </div>
                </div>

                <div id="couple-bride-details" class="flex flex-col items-center text-center will-change-transform">
                  <p class="text-[0.52rem] sm:text-[0.62rem] tracking-[0.26em] text-[#B89352] uppercase font-semibold mb-0.5">
                    Mempelai Wanita
                  </p>
                  <h3 class="font-display text-xs sm:text-base md:text-lg text-[#2A3426] font-normal leading-snug">
                    {content.couple.bride.fullName}
                  </h3>
                  <p class="text-[0.55rem] sm:text-[0.65rem] text-[#566A4E] font-light mt-0.5 italic">
                    {content.couple.bride.parents}
                  </p>

                  <p class="font-display italic text-[0.65rem] sm:text-xs text-[#4A5D43] leading-relaxed mt-1.5 px-1 max-w-[200px]">
                    &ldquo;Menemukanmu adalah jawaban dari setiap doa yang kupanjatkan dalam hening.&rdquo;
                  </p>

                  <a 
                    href={`https://instagram.com/${content.couple.bride.instagram.replace('@', '')}`} 
                    target="_blank" 
                    rel="noopener noreferrer" 
                    class="inline-flex items-center gap-1 text-[0.5rem] sm:text-[0.58rem] text-[#7E8F77] hover:text-[#B89352] tracking-wider uppercase font-medium mt-1.5 transition-colors"
                  >
                    <span>{content.couple.bride.instagram}</span>
                    <svg width="8" height="8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6M15 3h6v6M10 14L21 3"/>
                    </svg>
                  </a>
                </div>
              </div>

            </div>

          </div>

          <!-- THE MERGED STYLIZED CALLIGRAPHIC BOTANICAL LOVE HEART OVERLAY -->
          <div 
            id="couple-love-fusion" 
            class="absolute inset-0 flex flex-col items-center justify-center pointer-events-none opacity-0 will-change-transform z-30"
          >
            <!-- Stylized Heart Emblem Container (Responsive Proportions) -->
            <div class="relative flex items-center justify-center w-[310px] h-[290px] sm:w-[410px] sm:h-[385px]">
              
              <!-- Soft Subtle Warm Ambient Glow -->
              <div class="absolute -inset-8 bg-[radial-gradient(circle,rgba(184,147,82,0.18)_0%,transparent_65%)] blur-2xl pointer-events-none"></div>

              <!-- Stylized Haute-Couture Calligraphic Ribbon Heart SVG -->
              <svg 
                id="love-heart-svg"
                class="w-full h-full drop-shadow-[0_4px_22px_rgba(184,147,82,0.25)] select-none" 
                viewBox="0 0 200 190" 
                fill="none" 
                xmlns="http://www.w3.org/2000/svg"
              >
                <defs>
                  <!-- Antique Gold Gradient for Calligraphic Stems -->
                  <linearGradient id="heart-gold-couture" x1="0%" y1="0%" x2="100%" y2="100%">
                    <stop offset="0%" stop-color="#E2CA92" />
                    <stop offset="25%" stop-color="#D4AF37" />
                    <stop offset="55%" stop-color="#B89352" />
                    <stop offset="85%" stop-color="#C5A059" />
                    <stop offset="100%" stop-color="#9A7836" />
                  </linearGradient>

                  <filter id="heart-stem-shadow" x="-10%" y="-10%" width="120%" height="120%">
                    <feDropShadow dx="0" dy="2" stdDeviation="2.5" flood-color="#2A3426" flood-opacity="0.08" />
                  </filter>
                </defs>

                <!-- 1. Inner Concentric Gilded Dotted Filigree Echo (Jewelry / Fine Stationery) -->
                <path 
                  id="love-heart-inner-echo"
                  d="M 100 44 
                     C 86 28, 58 24, 40 40 
                     C 22 56, 22 84, 38 110 
                     C 54 134, 82 150, 100 160 
                     C 118 150, 146 134, 162 110 
                     C 178 84, 178 56, 160 40 
                     C 142 24, 114 28, 100 44 Z" 
                  stroke="#B89352" 
                  stroke-width="0.85" 
                  stroke-dasharray="2.5 3.5" 
                  opacity="0.45" 
                  fill="none" 
                />

                <!-- 2. Main Calligraphic Left Stem & Flourish Swash -->
                <path 
                  id="love-heart-path-left"
                  d="M 100 34 
                     C 82 14, 46 10, 26 32 
                     C 4 54, 6 88, 26 120 
                     C 46 148, 80 166, 100 172 
                     C 107 174, 115 174, 122 171" 
                  stroke="url(#heart-gold-couture)" 
                  stroke-width="1.8" 
                  stroke-linecap="round" 
                  fill="none" 
                  filter="url(#heart-stem-shadow)"
                />

                <!-- 3. Main Calligraphic Right Stem & Flourish Swash -->
                <path 
                  id="love-heart-path-right"
                  d="M 100 34 
                     C 118 14, 154 10, 174 32 
                     C 196 54, 194 88, 174 120 
                     C 154 148, 120 166, 100 172 
                     C 93 174, 85 174, 78 171" 
                  stroke="url(#heart-gold-couture)" 
                  stroke-width="1.8" 
                  stroke-linecap="round" 
                  fill="none" 
                  filter="url(#heart-stem-shadow)"
                />

                <!-- 4. Top Cleft Royal Star Accent (✦) -->
                <path 
                  d="M 100 22 Q 100 27 96 27 Q 100 27 100 32 Q 100 27 104 27 Q 100 27 100 22 Z" 
                  fill="#B89352" 
                />
                <circle cx="100" cy="27" r="1.1" fill="#FAF8F5" />

                <!-- 5. Delicate Bottom Ribbon End Droplets -->
                <circle cx="122" cy="171" r="1.6" fill="#B89352" />
                <circle cx="78" cy="171" r="1.6" fill="#B89352" />
              </svg>

              <!-- Center Content: Harmonious Twin Portraits & Regal Typography -->
              <div id="love-center-crest" class="absolute inset-0 flex flex-col items-center justify-center text-center z-10 pointer-events-none pb-4 sm:pb-6">
                
                <!-- Twin Portraits Sitting Side-by-Side with Gold Hairline Frames -->
                <div class="flex items-center justify-center gap-2.5 sm:gap-3.5 mb-1.5 sm:mb-2">
                  <!-- Groom Avatar (Zharkasi) -->
                  <div class="w-14 h-14 sm:w-18 sm:h-18 rounded-full p-0.5 border-1.5 border-[#B89352]/70 bg-white shadow-[0_4px_14px_rgba(42,52,38,0.08)] overflow-hidden">
                    <img src="/assets/vector-groom.jpg" alt={content.couple.groom.nickname} class="w-full h-full object-cover rounded-full" />
                  </div>

                  <!-- Delicate Gilded Heart Pin Clasp -->
                  <div class="flex items-center justify-center px-0.5">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="rgba(184,147,82,0.2)" stroke="#B89352" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="drop-shadow-xs">
                      <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
                    </svg>
                  </div>
                  
                  <!-- Bride Avatar (Difa) -->
                  <div class="w-14 h-14 sm:w-18 sm:h-18 rounded-full p-0.5 border-1.5 border-[#B89352]/70 bg-white shadow-[0_4px_14px_rgba(42,52,38,0.08)] overflow-hidden">
                    <img src="/assets/vector-bride.jpg" alt={content.couple.bride.nickname} class="w-full h-full object-cover rounded-full" />
                  </div>
                </div>

                <!-- Regal Typography: Zharkasi & Difa -->
                <h3 id="love-fusion-names" class="font-display text-xl sm:text-2xl text-[#2A3426] tracking-wide font-normal leading-tight">
                  {content.couple.groom.nickname} <span class="font-display italic text-[#B89352] font-normal px-1">&amp;</span> {content.couple.bride.nickname}
                </h3>

                <!-- Subtle Gilded Wedding Date -->
                <div class="text-[0.58rem] sm:text-[0.62rem] tracking-[0.34em] text-[#B89352] uppercase font-semibold mt-1">
                  26 · 12 · 2026
                </div>

              </div>

            </div>

          </div>

        </div>
      </section>

      <!-- ===================================================================
           SCENE 4: KISAH ASMARALOKA (DRAMATIC 3D CINEMATIC Z-SPACE FLY-THROUGH)
           =================================================================== -->
      <section 
        id="scene-asmaraloka" 
        class="scene-3d absolute inset-0 flex flex-col items-center justify-center px-4 py-6 text-center will-change-transform opacity-0 pointer-events-none"
        style="transform: translate3d(0, 0, -750px); transform-style: preserve-3d;"
        aria-label="Kisah Asmaraloka"
      >
        <!-- Luminous Twilight Amber Spotlight & Celestial Aura -->
        <div class="absolute inset-0 pointer-events-none flex items-center justify-center overflow-hidden">
          <div id="asmaraloka-ambient-halo" class="w-[520px] h-[520px] sm:w-[720px] sm:h-[720px] rounded-full bg-[radial-gradient(circle,rgba(212,175,55,0.25)_0%,rgba(238,175,115,0.16)_35%,rgba(74,93,67,0.03)_65%,transparent_85%)] blur-3xl opacity-80 pointer-events-none transition-all duration-700"></div>
        </div>

        <div class="max-w-xl md:max-w-2xl lg:max-w-3xl w-full mx-auto flex flex-col items-center justify-center my-auto relative z-10 px-4 sm:px-6">
          
          <!-- Asmaraloka Header -->
          <div id="asmaraloka-header" class="flex flex-col items-center mb-6 sm:mb-10 will-change-transform">
            <span class="text-[0.62rem] sm:text-[0.68rem] tracking-[0.4em] text-[#B89352] uppercase font-semibold mb-1.5">
              KISAH PERJALANAN CINTA
            </span>
            <div class="flex items-center justify-center gap-3">
              <span class="h-[1px] w-10 sm:w-20 bg-gradient-to-r from-transparent via-[#B89352] to-[#B89352]"></span>
              <span class="text-[#B89352] text-xs">❦</span>
              <h2 class="font-display italic text-3xl sm:text-4xl md:text-5xl text-[#2A3426] tracking-wide font-normal">
                Asmaraloka
              </h2>
              <span class="text-[#B89352] text-xs">❦</span>
              <span class="h-[1px] w-10 sm:w-20 bg-gradient-to-l from-transparent via-[#B89352] to-[#B89352]"></span>
            </div>
            <p class="text-[0.58rem] sm:text-[0.65rem] text-[#7E8F77] font-light tracking-[0.28em] uppercase mt-2">
              TIGA BABAK MENUJU SATU MUARA
            </p>
          </div>

          <!-- Stanza 3D Cinema Stage (Perspective Space for Continuous Camera Dolly) -->
          <div 
            id="asmaraloka-theater" 
            class="relative w-full flex items-center justify-center min-h-[220px] sm:min-h-[260px]"
            style="perspective: 1200px; transform-style: preserve-3d;"
          >
            
            <!-- BABAK 1: AWAL CERITA -->
            <div 
              id="stanza-1" 
              class="stanza-card absolute inset-x-0 top-1/2 -translate-y-1/2 flex flex-col items-center justify-center text-center will-change-transform"
              style="transform-style: preserve-3d;"
            >
              <!-- Fine Editorial Roman Chapter Marker (NO PILL!) -->
              <div class="flex items-center justify-center gap-2.5 mb-3 sm:mb-4">
                <span class="w-8 sm:w-14 h-[1px] bg-gradient-to-r from-transparent to-[#B89352]/60"></span>
                <span class="text-[0.58rem] sm:text-[0.65rem] tracking-[0.34em] text-[#B89352] uppercase font-semibold">
                  BABAK I &bull; AWAL CERITA
                </span>
                <span class="w-8 sm:w-14 h-[1px] bg-gradient-to-l from-transparent to-[#B89352]/60"></span>
              </div>

              <!-- Romantic Poetry Verse -->
              <blockquote class="font-display italic text-lg sm:text-2xl md:text-3xl text-[#2A3426] leading-relaxed sm:leading-loose max-w-xl mx-auto px-2">
                &ldquo;Tidak semua awal perlu diceritakan panjang, karena yang bertahan akan selalu menemukan jalannya. Bukan karena semuanya sempurna, melainkan karena kami terus belajar untuk tumbuh bersama.&rdquo;
              </blockquote>

              <div class="mt-4 flex items-center justify-center gap-2 opacity-50">
                <span class="w-10 h-[1px] bg-[#B89352]/40"></span>
                <span class="text-[0.55rem] text-[#B89352]">❧</span>
                <span class="w-10 h-[1px] bg-[#B89352]/40"></span>
              </div>
            </div>

            <!-- BABAK 2: TITIK TEMU -->
            <div 
              id="stanza-2" 
              class="stanza-card absolute inset-x-0 top-1/2 -translate-y-1/2 flex flex-col items-center justify-center text-center will-change-transform opacity-0 pointer-events-none"
              style="transform-style: preserve-3d;"
            >
              <!-- Fine Editorial Roman Chapter Marker (NO PILL!) -->
              <div class="flex items-center justify-center gap-2.5 mb-3 sm:mb-4">
                <span class="w-8 sm:w-14 h-[1px] bg-gradient-to-r from-transparent to-[#B89352]/60"></span>
                <span class="text-[0.58rem] sm:text-[0.65rem] tracking-[0.34em] text-[#B89352] uppercase font-semibold">
                  BABAK II &bull; TITIK TEMU
                </span>
                <span class="w-8 sm:w-14 h-[1px] bg-gradient-to-l from-transparent to-[#B89352]/60"></span>
              </div>

              <!-- Romantic Poetry Verse -->
              <blockquote class="font-display italic text-lg sm:text-2xl md:text-3xl text-[#2A3426] leading-relaxed sm:leading-loose max-w-xl mx-auto px-2">
                &ldquo;Kami percaya, tidak ada pertemuan yang benar-benar kebetulan. Ada doa yang diam-diam dikabulkan, ada langkah yang diarahkan tanpa kita sadari. Dan Allah SWT, dengan cara-Nya yang paling tenang, menuntun kami sampai di titik ini.&rdquo;
              </blockquote>

              <div class="mt-4 flex items-center justify-center gap-2 opacity-50">
                <span class="w-10 h-[1px] bg-[#B89352]/40"></span>
                <span class="text-[0.55rem] text-[#B89352]">❧</span>
                <span class="w-10 h-[1px] bg-[#B89352]/40"></span>
              </div>
            </div>

            <!-- BABAK 3: SATU MUARA -->
            <div 
              id="stanza-3" 
              class="stanza-card absolute inset-x-0 top-1/2 -translate-y-1/2 flex flex-col items-center justify-center text-center will-change-transform opacity-0 pointer-events-none"
              style="transform-style: preserve-3d;"
            >
              <!-- Fine Editorial Roman Chapter Marker (NO PILL!) -->
              <div class="flex items-center justify-center gap-2.5 mb-3 sm:mb-4">
                <span class="w-8 sm:w-14 h-[1px] bg-gradient-to-r from-transparent to-[#B89352]/60"></span>
                <span class="text-[0.58rem] sm:text-[0.65rem] tracking-[0.34em] text-[#B89352] uppercase font-semibold">
                  BABAK III &bull; SATU MUARA
                </span>
                <span class="w-8 sm:w-14 h-[1px] bg-gradient-to-l from-transparent to-[#B89352]/60"></span>
              </div>

              <!-- Romantic Poetry Verse -->
              <blockquote class="font-display italic text-lg sm:text-2xl md:text-3xl text-[#2A3426] leading-relaxed sm:leading-loose max-w-xl mx-auto px-2">
                &ldquo;Hingga pada waktunya, segala yang telah kami lewati bermuara pada satu keputusan yang sama. Dengan penuh syukur, kami memilih untuk saling menetap dalam ikatan yang diridhai oleh-Nya. Semoga perjalanan ini selalu diliputi ketenangan dan dipelihara dalam kebaikan yang panjang.&rdquo;
              </blockquote>

              <div class="mt-4 flex items-center justify-center gap-2 opacity-50">
                <span class="w-10 h-[1px] bg-[#B89352]/40"></span>
                <span class="text-[0.55rem] text-[#B89352]">❧</span>
                <span class="w-10 h-[1px] bg-[#B89352]/40"></span>
              </div>
            </div>

          </div>

        </div>
      </section>

    </div>

  </div>

</div>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  function init3DTunnel() {
    const container = document.getElementById('cinematic-tunnel-container');
    const viewport = document.getElementById('cinematic-viewport');

    const sceneHero = document.getElementById('scene-hero');
    const sceneVerse = document.getElementById('scene-verse');
    const sceneCouple = document.getElementById('scene-couple');
    const sceneAsmaraloka = document.getElementById('scene-asmaraloka');

    // Pre-fill name from URL parameter
    const urlParams = new URLSearchParams(window.location.search);
    const rawTo = urlParams.get('to');
    if (rawTo) {
      try {
        const decoded = decodeURIComponent(rawTo.replace(/\+/g, ' ')).replace(/<[^>]*>/g, '').trim().substring(0, 50);
        const heroGuest = document.getElementById('hero-guest-name');
        if (heroGuest && decoded) heroGuest.textContent = decoded;
      } catch (e) {}
    }

    if (!container || !viewport || !sceneHero || !sceneVerse || !sceneCouple || !sceneAsmaraloka) return;

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReducedMotion) {
      [sceneVerse, sceneCouple, sceneAsmaraloka].forEach(scene => {
        if (scene) {
          scene.style.opacity = '1';
          scene.style.transform = 'none';
          scene.style.position = 'relative';
          scene.style.pointerEvents = 'auto';
        }
      });
      if (sceneAsmaraloka) {
        sceneAsmaraloka.querySelectorAll('.stanza-card').forEach(s => {
          (s as HTMLElement).style.opacity = '1';
          (s as HTMLElement).style.position = 'relative';
          (s as HTMLElement).style.transform = 'none';
          (s as HTMLElement).style.pointerEvents = 'auto';
        });
      }
      return;
    }

    // Set initial 3D transforms via GSAP
    gsap.set(sceneHero, { z: 0, scale: 1, opacity: 1, filter: 'blur(0px)', pointerEvents: 'auto' });
    gsap.set(sceneVerse, { z: -750, scale: 0.6, opacity: 0, filter: 'blur(10px)', pointerEvents: 'none' });
    gsap.set(sceneCouple, { z: -750, scale: 0.6, opacity: 0, pointerEvents: 'none' });
    gsap.set(sceneAsmaraloka, { z: -750, scale: 0.6, opacity: 0, filter: 'blur(10px)', pointerEvents: 'none' });

    const heroTop = document.getElementById('hero-top-block');
    const heroArch = document.getElementById('hero-arch-block');
    const heroBottom = document.getElementById('hero-bottom-block');
    const verseArchCard = document.getElementById('verse-arch-card');
    const verseBismillah = document.getElementById('verse-bismillah');
    const verseContent = document.getElementById('verse-content-block');
    const verseGreeting = document.getElementById('verse-greeting');
    const coupleHeader = document.getElementById('couple-header-block');
    const groomProfile = document.getElementById('couple-groom-profile');
    const brideProfile = document.getElementById('couple-bride-profile');
    const coupleGroomAvatar = document.getElementById('couple-groom-avatar');
    const coupleBrideAvatar = document.getElementById('couple-bride-avatar');
    const coupleGroomDetails = document.getElementById('couple-groom-details');
    const coupleBrideDetails = document.getElementById('couple-bride-details');
    const coupleCenterLink = document.getElementById('couple-center-link');
    const coupleMergeSpark = document.getElementById('couple-merge-spark');
    const loveFusion = document.getElementById('couple-love-fusion');
    const loveHeartSvg = document.getElementById('love-heart-svg');
    const loveFusionNames = document.getElementById('love-fusion-names');

    const asmaralokaHeader = document.getElementById('asmaraloka-header');
    const asmaralokaHalo = document.getElementById('asmaraloka-ambient-halo');
    const stanza1 = document.getElementById('stanza-1');
    const stanza2 = document.getElementById('stanza-2');
    const stanza3 = document.getElementById('stanza-3');

    // Initialize stanzas initial 3D positions in Z-space
    if (stanza1) gsap.set(stanza1, { z: 0, scale: 1, opacity: 1, filter: 'blur(0px)', pointerEvents: 'auto' });
    if (stanza2) gsap.set(stanza2, { z: -350, scale: 0.75, opacity: 0, filter: 'blur(12px)', pointerEvents: 'none' });
    if (stanza3) gsap.set(stanza3, { z: -350, scale: 0.75, opacity: 0, filter: 'blur(12px)', pointerEvents: 'none' });

    const pip1 = document.getElementById('pip-1');
    const pip2 = document.getElementById('pip-2');
    const pip3 = document.getElementById('pip-3');
    const pip4 = document.getElementById('pip-4');
    const chapterRail = document.getElementById('tunnel-chapter-rail');

    function setActivePip(activeNum: number) {
      const pips = [pip1, pip2, pip3, pip4];
      pips.forEach((pip, idx) => {
        if (!pip) return;
        const num = idx + 1;
        const dot = pip.querySelector('.pip-dot');
        const label = pip.querySelector('.pip-label');
        if (num === activeNum) {
          pip.style.opacity = '1';
          if (dot) {
            dot.className = 'w-2 h-2 rounded-full bg-[#B89352] shadow-[0_0_10px_rgba(184,147,82,0.7)] pip-dot scale-110';
          }
          if (label) {
            label.className = 'text-[0.52rem] font-mono tracking-widest text-[#B89352] font-semibold pip-label';
          }
        } else {
          pip.style.opacity = '0.35';
          if (dot) {
            dot.className = 'w-1.5 h-1.5 rounded-full bg-[#7E8F77] pip-dot scale-100';
          }
          if (label) {
            label.className = 'text-[0.52rem] font-mono tracking-widest text-[#7E8F77] pip-label';
          }
        }
      });
    }

    // GSAP Pinned Timeline with Multi-Plane Spatial Choreography
    const tl = gsap.timeline({
      scrollTrigger: {
        trigger: container,
        pin: viewport,
        start: 'top top',
        end: 'bottom bottom',
        scrub: 1.2,
        anticipatePin: 1,
        onUpdate: (self) => {
          if (chapterRail) {
            chapterRail.style.opacity = self.progress > 0.92 ? '0' : '0.9';
          }
          if (self.progress < 0.22) {
            setActivePip(1);
          } else if (self.progress < 0.46) {
            setActivePip(2);
          } else if (self.progress < 0.70) {
            setActivePip(3);
          } else {
            setActivePip(4);
          }
        }
      }
    });

    // =========================================================================
    // STEP 1: HERO SCENE PORTAL SEPARATION & FLY-THROUGH (0.00 -> 0.22)
    // Symmetrical portal parting: top rises, arch zooms, bottom descends
    // =========================================================================
    if (heroTop) {
      tl.to(heroTop, {
        y: -70,
        opacity: 0,
        duration: 0.20,
        ease: 'power1.inOut'
      }, 0);
    }
    if (heroArch) {
      tl.to(heroArch, {
        scale: 1.25,
        opacity: 0,
        filter: 'blur(5px)',
        duration: 0.20,
        ease: 'power1.inOut'
      }, 0.02);
    }
    if (heroBottom) {
      tl.to(heroBottom, {
        y: 50,
        opacity: 0,
        duration: 0.18,
        ease: 'power1.inOut'
      }, 0);
    }
    tl.to(sceneHero, {
      z: 450,
      duration: 0.22,
      ease: 'power1.inOut',
      onComplete: () => {
        if (sceneHero) sceneHero.style.pointerEvents = 'none';
      },
      onReverseComplete: () => {
        if (sceneHero) sceneHero.style.pointerEvents = 'auto';
      }
    }, 0);

    // =========================================================================
    // STEP 2: VERSE SCENE GLIDES FORWARD & READING PLATEAU (0.22 -> 0.70)
    // Royal Mihrab Cathedral Archway lands with calm majesty (No collision!)
    // =========================================================================
    tl.to(sceneVerse, {
      z: 0,
      scale: 1,
      opacity: 1,
      filter: 'blur(0px)',
      duration: 0.22,
      ease: 'power2.out',
      onStart: () => {
        if (sceneVerse) sceneVerse.style.pointerEvents = 'auto';
      }
    }, 0.22);

    if (verseArchCard) {
      tl.fromTo(verseArchCard,
        { scale: 0.90, y: 25, opacity: 0 },
        { scale: 1, y: 0, opacity: 1, duration: 0.22, ease: 'power2.out' },
        0.24
      );
    }
    if (verseBismillah) {
      tl.fromTo(verseBismillah, 
        { y: -15, opacity: 0 },
        { y: 0, opacity: 1, duration: 0.18, ease: 'power2.out' },
        0.26
      );
    }
    if (verseContent) {
      tl.fromTo(verseContent,
        { opacity: 0, y: 10 },
        { opacity: 1, y: 0, duration: 0.20, ease: 'power2.out' },
        0.28
      );
    }
    if (verseGreeting) {
      tl.fromTo(verseGreeting,
        { opacity: 0, y: 12 },
        { opacity: 1, y: 0, duration: 0.18, ease: 'power2.out' },
        0.32
      );
    }

    // Comfortable reading plateau for Ayat Suci (0.44 -> 0.58)
    tl.to(sceneVerse, { z: 0, duration: 0.14 }, 0.44);

    // Verse scene ascends & flies past camera in 3D Z-space (0.58 -> 0.70)
    tl.to(sceneVerse, {
      z: 480,
      scale: 1.25,
      opacity: 0,
      filter: 'blur(8px)',
      y: -40,
      duration: 0.12,
      ease: 'power1.in',
      onComplete: () => {
        if (sceneVerse) sceneVerse.style.pointerEvents = 'none';
      }
    }, 0.58);

    // =========================================================================
    // STEP 3: KEDUA MEMPELAI ARRIVAL & GENEROUS READING PLATEAU (0.68 -> 1.25)
    // Both profiles glide in with spacious breathing room and romantic quotes!
    // =========================================================================
    tl.to(sceneCouple, {
      z: 0,
      scale: 1,
      opacity: 1,
      filter: 'blur(0px)',
      duration: 0.20,
      ease: 'power2.out',
      onStart: () => {
        if (sceneCouple) sceneCouple.style.pointerEvents = 'auto';
      }
    }, 0.68);

    if (coupleHeader) {
      tl.fromTo(coupleHeader,
        { y: -25, opacity: 0 },
        { y: 0, opacity: 1, duration: 0.18, ease: 'power2.out' },
        0.70
      );
    }

    if (groomProfile) {
      tl.fromTo(groomProfile,
        { x: -30, opacity: 0 },
        { x: 0, opacity: 1, duration: 0.22, ease: 'power2.out' },
        0.70
      );
    }

    if (brideProfile) {
      tl.fromTo(brideProfile,
        { x: 30, opacity: 0 },
        { x: 0, opacity: 1, duration: 0.22, ease: 'power2.out' },
        0.70
      );
    }

    // READING PLATEAU (0.88 -> 1.16): Calm, steady, and readable
    tl.to(sceneCouple, { z: 0, duration: 0.28 }, 0.88);

    // =========================================================================
    // STEP 4: "MELEBUR JADI SATU" CONVERGENCE & ROYAL LOVE CREST (1.16 -> 1.68)
    // 1. Text info fades away cleanly, leaving only the two floating avatars
    // 2. Avatars glide inward toward each other into the center
    // 3. Golden spark flares at collision point as they merge
    // 4. Haute-couture calligraphic gold heart blooms around the united couple
    // 5. Majestic reading plateau for Zharkasi & Difa crest
    // 6. Crest diffuses smoothly into Scene 4 (Asmaraloka)
    // =========================================================================
    
    // 1. Hide header, center ampersand, and text details below avatars
    const fadeOutTexts = [coupleHeader, coupleGroomDetails, coupleBrideDetails, coupleCenterLink].filter(Boolean);
    if (fadeOutTexts.length) {
      tl.to(fadeOutTexts, {
        y: -12,
        opacity: 0,
        duration: 0.10,
        ease: 'power2.in'
      }, 1.16);
    }

    // 2. The two avatars glide inward toward each other to merge ("melebur jadi satu")
    if (coupleGroomAvatar && coupleBrideAvatar) {
      tl.to(coupleGroomAvatar, {
        x: 60,
        scale: 0.94,
        duration: 0.14,
        ease: 'power2.inOut'
      }, 1.20);

      tl.to(coupleBrideAvatar, {
        x: -60,
        scale: 0.94,
        duration: 0.14,
        ease: 'power2.inOut'
      }, 1.20);
    }

    // 3. Golden collision spark flares at meeting point
    if (coupleMergeSpark) {
      tl.fromTo(coupleMergeSpark,
        { scale: 0.3, opacity: 0 },
        { scale: 1.2, opacity: 0.9, duration: 0.08, ease: 'power2.out' },
        1.28
      );
      tl.to(coupleMergeSpark, {
        scale: 1.6,
        opacity: 0,
        duration: 0.08,
        ease: 'power1.out'
      }, 1.36);
    }

    // 4. Stylized Calligraphic Love Heart Crest blooms right out from the fusion point!
    if (loveFusion) {
      tl.fromTo(loveFusion,
        { opacity: 0, scale: 0.82 },
        { opacity: 1, scale: 1.0, duration: 0.13, ease: 'power2.out' },
        1.32
      );

      // Smooth crossfade: outward gliding avatars dissolve as the docked heart avatars emerge
      if (coupleGroomAvatar && coupleBrideAvatar) {
        tl.to([coupleGroomAvatar, coupleBrideAvatar], {
          opacity: 0,
          duration: 0.06,
          ease: 'power1.out'
        }, 1.33);
      }

      // Pulse / glow on the luxury gold heart
      if (loveHeartSvg) {
        tl.fromTo(loveHeartSvg,
          { scale: 0.88, filter: 'drop-shadow(0 0 16px rgba(216,186,122,0.6))' },
          { scale: 1.0, filter: 'drop-shadow(0 4px 22px rgba(184,147,82,0.25))', duration: 0.14, ease: 'power2.out' },
          1.33
        );
      }

      // Names "Zharkasi & Difa" float up softly
      if (loveFusionNames) {
        tl.fromTo(loveFusionNames,
          { opacity: 0, y: 10 },
          { opacity: 1, y: 0, duration: 0.12, ease: 'power2.out' },
          1.36
        );
      }

      // 5. Stable reading plateau for the Love Heart Crest
      tl.to(loveFusion, {
        scale: 1.01,
        duration: 0.16,
        ease: 'none'
      }, 1.44);

      // 6. Heart gently diffuses into Asmaraloka
      tl.to(loveFusion, {
        scale: 1.08,
        opacity: 0,
        filter: 'blur(4px)',
        duration: 0.08,
        ease: 'power1.out'
      }, 1.60);
    }

    // Scene 3 completes smoothly to hand off to Scene 4
    tl.to(sceneCouple, {
      opacity: 0,
      duration: 0.06,
      ease: 'power1.out',
      onComplete: () => {
        if (sceneCouple) sceneCouple.style.pointerEvents = 'none';
      }
    }, 1.66);

    // =========================================================================
    // STEP 5: SCENE 4 — KISAH ASMARALOKA 3D CONTINUOUS FLY-THROUGH (1.68 -> 3.02)
    // Saling meluncur melewati kamera dalam ruang 3D (Z-space depth dolly)
    // =========================================================================
    tl.to(sceneAsmaraloka, {
      z: 0,
      scale: 1,
      opacity: 1,
      filter: 'blur(0px)',
      duration: 0.22,
      ease: 'power2.out',
      onStart: () => {
        if (sceneAsmaraloka) sceneAsmaraloka.style.pointerEvents = 'auto';
      }
    }, 1.68);

    if (asmaralokaHeader) {
      tl.fromTo(asmaralokaHeader,
        { y: -30, opacity: 0 },
        { y: 0, opacity: 1, duration: 0.20, ease: 'power2.out' },
        1.70
      );
    }

    if (asmaralokaHalo) {
      tl.fromTo(asmaralokaHalo,
        { scale: 0.80, opacity: 0 },
        { scale: 1, opacity: 0.85, duration: 0.25, ease: 'power2.out' },
        1.70
      );
    }

    // BABAK 1: READING PLATEAU (1.88 -> 2.15)
    tl.to(sceneAsmaraloka, { z: 0, duration: 0.27 }, 1.88);

    // TRANSITION 1 -> 2: BABAK 1 FLIES PAST CAMERA & BABAK 2 EMERGES (2.15 -> 2.32)
    if (stanza1 && stanza2) {
      // Stanza 1 rushes forward past the camera in 3D into memory
      tl.to(stanza1, {
        z: 420,
        scale: 1.35,
        opacity: 0,
        filter: 'blur(16px)',
        duration: 0.16,
        ease: 'power2.in',
        onComplete: () => {
          if (stanza1) stanza1.style.pointerEvents = 'none';
        }
      }, 2.15);

      // Stanza 2 glides in from the deep golden background to focal plane
      tl.fromTo(stanza2,
        { z: -350, scale: 0.75, opacity: 0, filter: 'blur(12px)' },
        { 
          z: 0, 
          scale: 1.0, 
          opacity: 1, 
          filter: 'blur(0px)', 
          duration: 0.20, 
          ease: 'power2.out',
          onStart: () => {
            if (stanza2) stanza2.style.pointerEvents = 'auto';
          }
        },
        2.18
      );

      if (asmaralokaHalo) {
        tl.to(asmaralokaHalo, {
          scale: 1.15,
          opacity: 0.95,
          duration: 0.20
        }, 2.18);
      }
    }

    // BABAK 2: READING PLATEAU (2.32 -> 2.58)
    tl.to(sceneAsmaraloka, { z: 0, duration: 0.26 }, 2.32);

    // TRANSITION 2 -> 3: BABAK 2 FLIES PAST CAMERA & BABAK 3 EMERGES (2.58 -> 2.75)
    if (stanza2 && stanza3) {
      // Stanza 2 rushes forward past the camera in 3D
      tl.to(stanza2, {
        z: 420,
        scale: 1.35,
        opacity: 0,
        filter: 'blur(16px)',
        duration: 0.16,
        ease: 'power2.in',
        onComplete: () => {
          if (stanza2) stanza2.style.pointerEvents = 'none';
        }
      }, 2.58);

      // Stanza 3 glides forward into radiant emotional clarity
      tl.fromTo(stanza3,
        { z: -350, scale: 0.75, opacity: 0, filter: 'blur(12px)' },
        { 
          z: 0, 
          scale: 1.02, 
          opacity: 1, 
          filter: 'blur(0px)', 
          duration: 0.20, 
          ease: 'power2.out',
          onStart: () => {
            if (stanza3) stanza3.style.pointerEvents = 'auto';
          }
        },
        2.61
      );

      if (asmaralokaHalo) {
        tl.to(asmaralokaHalo, {
          scale: 1.30,
          opacity: 1.0,
          duration: 0.20
        }, 2.61);
      }
    }

    // BABAK 3: CLIMAX SACRED VOW READING PLATEAU (2.75 -> 2.92)
    tl.to(sceneAsmaraloka, { z: 0, duration: 0.17 }, 2.75);

    // Climax Ascend & Section Transition to UnifiedEvent (2.92 -> 3.05)
    tl.to(sceneAsmaraloka, {
      y: -60,
      scale: 1.08,
      opacity: 0,
      filter: 'blur(8px)',
      duration: 0.13,
      ease: 'power1.in',
      onComplete: () => {
        if (sceneAsmaraloka) sceneAsmaraloka.style.pointerEvents = 'none';
      }
    }, 2.92);

    // Ensure ScrollTrigger recalculates after invitation envelope is unboxed
    window.addEventListener('invitationOpened', () => {
      setTimeout(() => {
        ScrollTrigger.refresh();
      }, 150);
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init3DTunnel);
  } else {
    init3DTunnel();
  }
</script>
