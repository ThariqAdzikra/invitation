                  </div>
                </div>

                <!-- Middle: Poetry Verse in Luxurious Editorial Italic -->
                <blockquote class="font-display italic text-xs sm:text-base md:text-[1.05rem] text-[#2A3426] leading-relaxed my-auto px-1 sm:px-2 relative z-10 pt-2">
                  &ldquo;Tidak semua awal perlu diceritakan panjang, karena yang bertahan akan selalu menemukan jalannya. Bukan karena semuanya sempurna, melainkan karena kami terus belajar untuk tumbuh bersama.&rdquo;
                </blockquote>

                <!-- Bottom: Delicate Botanical Divider & Gilded Star -->
                <div class="flex items-center justify-center gap-2 relative z-10 mt-1 opacity-70">
                  <span class="w-8 sm:w-12 h-[1px] bg-gradient-to-r from-transparent to-[#B89352]"></span>
                  <span class="text-[#B89352] text-[0.55rem] sm:text-xs">✦</span>
                  <span class="w-8 sm:w-12 h-[1px] bg-gradient-to-l from-transparent to-[#B89352]"></span>
                </div>
              </article>

              <!-- BABAK 2: TITIK TEMU (Floating Linen Stele with Mirrored Botanical Corners) -->
              <article 
                id="stanza-2" 
                class="stele-card stanza-card flex-shrink-0 w-[84vw] max-w-[340px] sm:max-w-[400px] md:max-w-[440px] min-h-[270px] sm:min-h-[300px] rounded-2xl border border-[#B89352]/45 bg-gradient-to-b from-[#FFFDF9] via-[#FAF8F5] to-[#F7F3EC] shadow-[0_16px_44px_rgba(42,52,38,0.08),0_2px_12px_rgba(184,147,82,0.12)] p-5 sm:p-7 pt-6 sm:pt-7 pb-5 sm:pb-6 flex flex-col justify-between items-center text-center relative will-change-transform cursor-pointer select-none transition-shadow duration-300"
                aria-label="Babak II: Titik Temu"
              >
                <!-- Inset Classical Dashed Arch Hairline -->
                <div class="absolute inset-2 sm:inset-2.5 rounded-xl border border-dashed border-[#B89352]/25 pointer-events-none"></div>

                <!-- Authentic Forest Olive & Emerald Sage Botanical Ginkgo Corners (Mirrored for artistic rhythm) -->
                <FloralCorner position="top-right" size={60} className="absolute -top-1 -right-1 opacity-85 pointer-events-none block drop-shadow-xs" />
                <FloralCorner position="bottom-left" size={60} className="absolute -bottom-1 -left-1 opacity-85 pointer-events-none block drop-shadow-xs" />

                <!-- Top: Roman Chapter Header Pill -->
                <div class="flex flex-col items-center relative z-10">
                  <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#FAF8F5]/90 border border-[#B89352]/30 shadow-xs">
                    <span class="w-1.5 h-1.5 rounded-full bg-[#B89352]"></span>
                    <span class="text-[0.52rem] sm:text-[0.58rem] tracking-[0.28em] text-[#B89352] uppercase font-semibold">
                      BABAK II &bull; TITIK TEMU
                    </span>
                    <span class="w-1.5 h-1.5 rounded-full bg-[#B89352]"></span>
                  </div>
                </div>

                <!-- Middle: Poetry Verse in Luxurious Editorial Italic -->
                <blockquote class="font-display italic text-xs sm:text-base md:text-[1.05rem] text-[#2A3426] leading-relaxed my-auto px-1 sm:px-2 relative z-10 pt-2">
                  &ldquo;Kami percaya, tidak ada pertemuan yang benar-benar kebetulan. Ada doa yang diam-diam dikabulkan, ada langkah yang diarahkan tanpa kita sadari. Dan Allah SWT, dengan cara-Nya yang paling tenang, menuntun kami sampai di titik ini.&rdquo;
                </blockquote>

                <!-- Bottom: Delicate Botanical Divider & Gilded Star -->
                <div class="flex items-center justify-center gap-2 relative z-10 mt-1 opacity-70">
                  <span class="w-8 sm:w-12 h-[1px] bg-gradient-to-r from-transparent to-[#B89352]"></span>
                  <span class="text-[#B89352] text-[0.55rem] sm:text-xs">✦</span>
                  <span class="w-8 sm:w-12 h-[1px] bg-gradient-to-l from-transparent to-[#B89352]"></span>
                </div>
              </article>

              <!-- BABAK 3: SATU MUARA (Floating Linen Stele with Sacred Climax Botanical Corners) -->
              <article 
                id="stanza-3" 
                class="stele-card stanza-card flex-shrink-0 w-[84vw] max-w-[340px] sm:max-w-[400px] md:max-w-[440px] min-h-[270px] sm:min-h-[300px] rounded-2xl border border-[#B89352]/45 bg-gradient-to-b from-[#FFFDF9] via-[#FAF8F5] to-[#F7F3EC] shadow-[0_16px_44px_rgba(42,52,38,0.08),0_2px_12px_rgba(184,147,82,0.12)] p-5 sm:p-7 pt-6 sm:pt-7 pb-5 sm:pb-6 flex flex-col justify-between items-center text-center relative will-change-transform cursor-pointer select-none transition-shadow duration-300"
                aria-label="Babak III: Satu Muara"
              >
                <!-- Inset Classical Dashed Arch Hairline -->
                <div class="absolute inset-2 sm:inset-2.5 rounded-xl border border-dashed border-[#B89352]/25 pointer-events-none"></div>

                <!-- Authentic Forest Olive & Emerald Sage Botanical Ginkgo Corners -->
                <FloralCorner position="top-left" size={60} className="absolute -top-1 -left-1 opacity-85 pointer-events-none block drop-shadow-xs" />
                <FloralCorner position="bottom-right" size={60} className="absolute -bottom-1 -right-1 opacity-85 pointer-events-none block drop-shadow-xs" />

                <!-- Top: Roman Chapter Header Pill -->
                <div class="flex flex-col items-center relative z-10">
                  <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#FAF8F5]/90 border border-[#B89352]/30 shadow-xs">
                    <span class="w-1.5 h-1.5 rounded-full bg-[#B89352]"></span>
                    <span class="text-[0.52rem] sm:text-[0.58rem] tracking-[0.28em] text-[#B89352] uppercase font-semibold">
                      BABAK III &bull; SATU MUARA
                    </span>
                    <span class="w-1.5 h-1.5 rounded-full bg-[#B89352]"></span>
                  </div>
                </div>

                <!-- Middle: Poetry Verse in Luxurious Editorial Italic -->
                <blockquote class="font-display italic text-xs sm:text-base md:text-[1.05rem] text-[#2A3426] leading-relaxed my-auto px-1 sm:px-2 relative z-10 pt-2">
                  &ldquo;Hingga pada waktunya, segala yang telah kami lewati bermuara pada satu keputusan yang sama. Dengan penuh syukur, kami memilih untuk saling menetap dalam ikatan yang diridhai oleh-Nya. Semoga perjalanan ini selalu diliputi ketenangan dan dipelihara dalam kebaikan yang panjang.&rdquo;
                </blockquote>

                <!-- Bottom: Delicate Botanical Divider & Gilded Star -->
                <div class="flex items-center justify-center gap-2 relative z-10 mt-1 opacity-70">
                  <span class="w-8 sm:w-12 h-[1px] bg-gradient-to-r from-transparent to-[#B89352]"></span>
                  <span class="text-[#B89352] text-[0.55rem] sm:text-xs">✦</span>
                  <span class="w-8 sm:w-12 h-[1px] bg-gradient-to-l from-transparent to-[#B89352]"></span>
                </div>
              </article>

            </div>
          </div>

        </div>
      </section>

    </div>

  </div>

</div>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  function init3DTunnel() {
    const container = document.getElementById('cinematic-tunnel-container');
    const viewport = document.getElementById('cinematic-viewport');

    const sceneHero = document.getElementById('scene-hero');
    const sceneVerse = document.getElementById('scene-verse');
    const sceneCouple = document.getElementById('scene-couple');
    const sceneAsmaraloka = document.getElementById('scene-asmaraloka');

    // Pre-fill name from URL parameter
    const urlParams = new URLSearchParams(window.location.search);
    const rawTo = urlParams.get('to');
    if (rawTo) {
      try {
        const decoded = decodeURIComponent(rawTo.replace(/\+/g, ' ')).replace(/<[^>]*>/g, '').trim().substring(0, 50);
        const heroGuest = document.getElementById('hero-guest-name');
        if (heroGuest && decoded) heroGuest.textContent = decoded;
      } catch (e) {}
    }

    if (!container || !viewport || !sceneHero || !sceneVerse || !sceneCouple || !sceneAsmaraloka) return;

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReducedMotion) {
      [sceneVerse, sceneCouple, sceneAsmaraloka].forEach(scene => {
        if (scene) {
          scene.style.opacity = '1';
          scene.style.transform = 'none';
          scene.style.position = 'relative';
          scene.style.pointerEvents = 'auto';
        }
      });
      if (sceneAsmaraloka) {
        sceneAsmaraloka.querySelectorAll('.stanza-card').forEach(s => {
          (s as HTMLElement).style.opacity = '1';
          (s as HTMLElement).style.position = 'relative';
          (s as HTMLElement).style.transform = 'none';
          (s as HTMLElement).style.pointerEvents = 'auto';
        });
      }
      return;
    }

    // Set initial 3D transforms via GSAP (GPU-accelerated transforms and opacity only — zero CPU blur recalculations)
    gsap.set(sceneHero, { z: 0, scale: 1, opacity: 1, pointerEvents: 'auto' });
    gsap.set(sceneVerse, { z: -750, scale: 0.6, opacity: 0, pointerEvents: 'none' });
    gsap.set(sceneCouple, { z: -750, scale: 0.6, opacity: 0, pointerEvents: 'none' });
    gsap.set(sceneAsmaraloka, { z: -750, scale: 0.6, opacity: 0, pointerEvents: 'none' });

    const heroTop = document.getElementById('hero-top-block');
    const heroArch = document.getElementById('hero-arch-block');
    const heroBottom = document.getElementById('hero-bottom-block');
    const verseArchCard = document.getElementById('verse-arch-card');
    const verseBismillah = document.getElementById('verse-bismillah');
    const verseContent = document.getElementById('verse-content-block');
    const verseGreeting = document.getElementById('verse-greeting');
    const coupleHeader = document.getElementById('couple-header-block');
    const groomProfile = document.getElementById('couple-groom-profile');
    const brideProfile = document.getElementById('couple-bride-profile');
    const coupleGroomAvatar = document.getElementById('couple-groom-avatar');
    const coupleBrideAvatar = document.getElementById('couple-bride-avatar');
    const coupleGroomDetails = document.getElementById('couple-groom-details');
    const coupleBrideDetails = document.getElementById('couple-bride-details');
    const coupleCenterLink = document.getElementById('couple-center-link');
    const coupleMergeSpark = document.getElementById('couple-merge-spark');
    const loveFusion = document.getElementById('couple-love-fusion');
    const loveHeartSvg = document.getElementById('love-heart-svg');
    const loveFusionNames = document.getElementById('love-fusion-names');

    const asmaralokaHeader = document.getElementById('asmaraloka-header');
    const asmaralokaHalo = document.getElementById('asmaraloka-ambient-halo');
    const asmaralokaTheater = document.getElementById('asmaraloka-theater');
    const asmaralokaTrack = document.getElementById('asmaraloka-track');
    const stanza1 = document.getElementById('stanza-1');
    const stanza2 = document.getElementById('stanza-2');
    const stanza3 = document.getElementById('stanza-3');

    // Thematic Ornament Elements across all chapters
    const heroBracketTL = document.getElementById('hero-bracket-tl');
    const heroBracketTR = document.getElementById('hero-bracket-tr');
    const heroBracketBL = document.getElementById('hero-bracket-bl');
    const heroBracketBR = document.getElementById('hero-bracket-br');
    const heroPetalsL = [document.getElementById('hero-petal-l1'), document.getElementById('hero-petal-l2')].filter(Boolean);
    const heroPetalsR = [document.getElementById('hero-petal-r1'), document.getElementById('hero-petal-r2')].filter(Boolean);

    const verseLanternLeft = document.getElementById('verse-lantern-left');
    const verseLanternRight = document.getElementById('verse-lantern-right');
    const verseBracketTL = document.getElementById('verse-bracket-tl');
    const verseBracketTR = document.getElementById('verse-bracket-tr');
    const verseBracketBL = document.getElementById('verse-bracket-bl');
    const verseBracketBR = document.getElementById('verse-bracket-br');

    const coupleFlankLeft = document.getElementById('couple-flank-left');
    const coupleFlankRight = document.getElementById('couple-flank-right');
    const coupleRingsLeft = document.getElementById('couple-rings-left');
    const coupleRingsRight = document.getElementById('couple-rings-right');

    const asmaralokaStamp = document.getElementById('asmaraloka-stamp-tl');
    const asmaralokaQuill = document.getElementById('asmaraloka-quill-tr');
    const asmaralokaFern = document.getElementById('asmaraloka-fern-bl');
    const asmaralokaSeal = document.getElementById('asmaraloka-seal-br');

    // Initial states for thematic chapter ornaments
    if (verseLanternLeft && verseLanternRight) {
      gsap.set([verseLanternLeft, verseLanternRight], { y: -130, opacity: 0 });
    }
    const verseBrackets = [verseBracketTL, verseBracketTR, verseBracketBL, verseBracketBR].filter(Boolean);
    if (verseBrackets.length) {
      gsap.set(verseBrackets, { scale: 0.65, opacity: 0 });
    }
    if (coupleFlankLeft) gsap.set(coupleFlankLeft, { x: -80, rotation: -12, opacity: 0 });
    if (coupleFlankRight) gsap.set(coupleFlankRight, { x: 80, rotation: 12, opacity: 0 });
    const coupleRings = [coupleRingsLeft, coupleRingsRight].filter(Boolean);
    if (coupleRings.length) gsap.set(coupleRings, { scale: 0.5, opacity: 0 });

    if (asmaralokaStamp) gsap.set(asmaralokaStamp, { scale: 0.6, rotation: -25, opacity: 0 });
    if (asmaralokaQuill) gsap.set(asmaralokaQuill, { x: 40, y: -25, rotation: 22, opacity: 0 });
    const asmaralokaAccents = [asmaralokaFern, asmaralokaSeal].filter(Boolean);
    if (asmaralokaAccents.length) gsap.set(asmaralokaAccents, { scale: 0.5, opacity: 0 });

    // Dynamic horizontal travel distance calculation for panoramic tracking shot
    const getSteleDist = () => {
      if (stanza1 && stanza2) {
        const d = stanza2.offsetLeft - stanza1.offsetLeft;
        if (d > 0) return d;
      }
      const w = window.innerWidth;
      const cardW = Math.min(w * 0.84, 440);
      const gap = w < 640 ? 16 : (w < 768 ? 32 : 48);
      return cardW + gap;
    };

    // Initialize steles for Panoramic Cinematic Track (Multi-layer depth & lateral alignment)
    if (asmaralokaTrack) gsap.set(asmaralokaTrack, { x: () => getSteleDist() });
    if (stanza1) gsap.set(stanza1, { scale: 1, opacity: 1, pointerEvents: 'auto' });
    if (stanza2) gsap.set(stanza2, { scale: 0.90, opacity: 0.40, pointerEvents: 'auto' });
    if (stanza3) gsap.set(stanza3, { scale: 0.84, opacity: 0.15, pointerEvents: 'auto' });

    const pip1 = document.getElementById('pip-1');
    const pip2 = document.getElementById('pip-2');
    const pip3 = document.getElementById('pip-3');
    const pip4 = document.getElementById('pip-4');
    const chapterRail = document.getElementById('tunnel-chapter-rail');

    const pipChapter1 = document.getElementById('chapter-pip-1');
    const pipChapter2 = document.getElementById('chapter-pip-2');
    const pipChapter3 = document.getElementById('chapter-pip-3');

    function setChapterPip(activeChapter: number) {
      const pips = [pipChapter1, pipChapter2, pipChapter3];
      pips.forEach((pip, idx) => {
        if (!pip) return;
        const num = idx + 1;
        const dot = pip.querySelector('span:first-child') as HTMLElement;
        const label = pip.querySelector('span:last-child') as HTMLElement;
        if (num === activeChapter) {
          pip.style.opacity = '1';
          if (dot) {
            dot.className = 'w-1.5 h-1.5 rounded-full bg-[#B89352] shadow-[0_0_8px_rgba(184,147,82,0.6)]';
          }
          if (label) {
            label.className = 'font-serif text-[0.65rem] sm:text-xs text-[#2A3426] font-semibold tracking-widest';
          }
        } else {
          pip.style.opacity = '0.35';
          if (dot) {
            dot.className = 'w-1.5 h-1.5 rounded-full bg-[#7E8F77]';
          }
          if (label) {
            label.className = 'font-serif text-[0.65rem] sm:text-xs text-[#7E8F77] font-medium tracking-widest';
          }
        }
      });
    }

    function setActivePip(activeNum: number) {
      const pips = [pip1, pip2, pip3, pip4];
      pips.forEach((pip, idx) => {
        if (!pip) return;
        const num = idx + 1;
        const dot = pip.querySelector('.pip-dot');
        const label = pip.querySelector('.pip-label');
        if (num === activeNum) {
          pip.style.opacity = '1';
          if (dot) {
            dot.className = 'w-2 h-2 rounded-full bg-[#B89352] shadow-[0_0_10px_rgba(184,147,82,0.7)] pip-dot scale-110';
          }
          if (label) {
            label.className = 'text-[0.52rem] font-mono tracking-widest text-[#B89352] font-semibold pip-label';
          }
        } else {
          pip.style.opacity = '0.35';
          if (dot) {
            dot.className = 'w-1.5 h-1.5 rounded-full bg-[#7E8F77] pip-dot scale-100';
          }
          if (label) {
            label.className = 'text-[0.52rem] font-mono tracking-widest text-[#7E8F77] pip-label';
          }
        }
      });
    }

    // Detect touch / coarse pointer devices for responsive scrub rate
    const isTouch = window.matchMedia('(pointer: coarse)').matches || 'ontouchstart' in window;

    // GSAP Pinned Timeline with Multi-Plane Spatial Choreography
    const tl = gsap.timeline({
      scrollTrigger: {
        trigger: container,
        pin: viewport,
        start: 'top top',
        end: 'bottom bottom',
        scrub: isTouch ? 0.35 : 0.85,
        anticipatePin: 1,
        invalidateOnRefresh: true,
        onUpdate: (self) => {
          if (chapterRail) {
            chapterRail.style.opacity = self.progress > 0.92 ? '0' : '0.9';
          }
          if (self.progress < 0.22) {
            setActivePip(1);
          } else if (self.progress < 0.46) {
            setActivePip(2);
          } else if (self.progress < 0.70) {
            setActivePip(3);
          } else {
            setActivePip(4);
            const t = tl.time();
            if (t < 2.26) {
              setChapterPip(1);
            } else if (t < 2.73) {
              setChapterPip(2);
            } else {
              setChapterPip(3);
            }
          }
        }
      }
    });

    // =========================================================================
    // STEP 1: HERO SCENE PORTAL SEPARATION & FLY-THROUGH (0.00 -> 0.22)
    // Symmetrical portal parting: top rises, arch zooms, bottom descends
    // =========================================================================
    if (heroTop) {
      tl.to(heroTop, {
        y: -70,
        opacity: 0,
        duration: 0.20,
        ease: 'power1.inOut'
      }, 0);
    }
    if (heroArch) {
      tl.to(heroArch, {
        scale: 1.25,
        opacity: 0,
        duration: 0.20,
        ease: 'power1.inOut'
      }, 0.02);
    }
    if (heroBottom) {
      tl.to(heroBottom, {
        y: 50,
        opacity: 0,
        duration: 0.18,
        ease: 'power1.inOut'
      }, 0);
    }
    // Active scroll-driven animation: Archival Botanical Brackets part open and satin petals drift
    if (heroBracketTL) tl.to(heroBracketTL, { x: -65, y: -45, rotation: -14, opacity: 0, duration: 0.20, ease: 'power1.inOut' }, 0);
    if (heroBracketTR) tl.to(heroBracketTR, { x: 65, y: -45, rotation: 14, opacity: 0, duration: 0.20, ease: 'power1.inOut' }, 0);
    if (heroBracketBL) tl.to(heroBracketBL, { x: -55, y: 55, rotation: 10, opacity: 0, duration: 0.18, ease: 'power1.inOut' }, 0);
    if (heroBracketBR) tl.to(heroBracketBR, { x: 55, y: 55, rotation: -10, opacity: 0, duration: 0.18, ease: 'power1.inOut' }, 0);
    if (heroPetalsL.length) tl.to(heroPetalsL, { y: 100, rotation: 45, opacity: 0, duration: 0.20, ease: 'power1.inOut' }, 0);
    if (heroPetalsR.length) tl.to(heroPetalsR, { y: 120, rotation: -35, opacity: 0, duration: 0.20, ease: 'power1.inOut' }, 0);

    tl.to(sceneHero, {
      z: 450,
      duration: 0.22,
      ease: 'power1.inOut',
      onComplete: () => {
        if (sceneHero) sceneHero.style.pointerEvents = 'none';
      },
      onReverseComplete: () => {
        if (sceneHero) sceneHero.style.pointerEvents = 'auto';
      }
    }, 0);

    // =========================================================================
    // STEP 2: VERSE SCENE GLIDES FORWARD & READING PLATEAU (0.22 -> 0.70)
    // Royal Mihrab Cathedral Archway lands with calm majesty (No collision!)
    // =========================================================================
    tl.to(sceneVerse, {
      z: 0,
      scale: 1,
      opacity: 1,
      duration: 0.22,
      ease: 'power2.out',
      onStart: () => {
        if (sceneVerse) sceneVerse.style.pointerEvents = 'auto';
      }
    }, 0.22);

    // Moroccan hanging lanterns descend from heavens & Arabesque brackets frame the holy verse
    if (verseLanternLeft) tl.to(verseLanternLeft, { y: 0, opacity: 1, rotation: -2, duration: 0.22, ease: 'power2.out' }, 0.22);
    if (verseLanternRight) tl.to(verseLanternRight, { y: 0, opacity: 1, rotation: 2, duration: 0.24, ease: 'power2.out' }, 0.22);
    if (verseBrackets.length) tl.to(verseBrackets, { scale: 1, opacity: 0.85, duration: 0.20, stagger: 0.02, ease: 'back.out(1.4)' }, 0.24);

    if (verseArchCard) {
      tl.fromTo(verseArchCard,
        { scale: 0.90, y: 25, opacity: 0 },
        { scale: 1, y: 0, opacity: 1, duration: 0.22, ease: 'power2.out' },
        0.24
      );
    }
    if (verseBismillah) {
      tl.fromTo(verseBismillah, 
        { y: -15, opacity: 0 },
        { y: 0, opacity: 1, duration: 0.18, ease: 'power2.out' },
        0.26
      );
    }
    if (verseContent) {
      tl.fromTo(verseContent,
        { opacity: 0, y: 10 },
        { opacity: 1, y: 0, duration: 0.20, ease: 'power2.out' },
        0.28
      );
    }
    if (verseGreeting) {
      tl.fromTo(verseGreeting,
        { opacity: 0, y: 12 },
        { opacity: 1, y: 0, duration: 0.18, ease: 'power2.out' },
        0.32
      );
    }

    // Comfortable reading plateau for Ayat Suci (0.44 -> 0.58)
    // Subtle pendular sway on Moroccan lanterns during scroll pause
    if (verseLanternLeft) tl.to(verseLanternLeft, { rotation: 2, duration: 0.14, ease: 'sine.inOut' }, 0.44);
    if (verseLanternRight) tl.to(verseLanternRight, { rotation: -2, duration: 0.14, ease: 'sine.inOut' }, 0.44);
    tl.to(sceneVerse, { z: 0, duration: 0.14 }, 0.44);

    // Verse scene ascends & flies past camera in 3D Z-space (0.58 -> 0.70)
    if (verseLanternLeft && verseLanternRight) tl.to([verseLanternLeft, verseLanternRight], { y: -80, opacity: 0, duration: 0.12 }, 0.58);
    if (verseBrackets.length) tl.to(verseBrackets, { scale: 1.15, opacity: 0, duration: 0.12 }, 0.58);
    tl.to(sceneVerse, {
      z: 480,
      scale: 1.25,
      opacity: 0,
      y: -40,
      duration: 0.12,
      ease: 'power1.in',
      onComplete: () => {
        if (sceneVerse) sceneVerse.style.pointerEvents = 'none';
      }
    }, 0.58);

    // =========================================================================
    // STEP 3: KEDUA MEMPELAI ARRIVAL & GENEROUS READING PLATEAU (0.68 -> 1.25)
    // Both profiles glide in with spacious breathing room and romantic quotes!
    // =========================================================================
    tl.to(sceneCouple, {
      z: 0,
      scale: 1,
      opacity: 1,
      duration: 0.20,
      ease: 'power2.out',
      onStart: () => {
        if (sceneCouple) sceneCouple.style.pointerEvents = 'auto';
      }
    }, 0.68);

    // Flanks glide in from left & right margins
    if (coupleFlankLeft) tl.to(coupleFlankLeft, { x: 0, rotation: 0, opacity: 0.85, duration: 0.22, ease: 'power2.out' }, 0.68);
    if (coupleFlankRight) tl.to(coupleFlankRight, { x: 0, rotation: 0, opacity: 0.85, duration: 0.22, ease: 'power2.out' }, 0.68);
    if (coupleRings.length) tl.to(coupleRings, { scale: 1, opacity: 0.5, duration: 0.18, ease: 'power2.out' }, 0.72);

    if (coupleHeader) {
      tl.fromTo(coupleHeader,
        { y: -25, opacity: 0 },
        { y: 0, opacity: 1, duration: 0.18, ease: 'power2.out' },
        0.70
      );
    }

    if (groomProfile) {
      tl.fromTo(groomProfile,
        { x: -30, opacity: 0 },
        { x: 0, opacity: 1, duration: 0.22, ease: 'power2.out' },
        0.70
      );
    }

    if (brideProfile) {
      tl.fromTo(brideProfile,
        { x: 30, opacity: 0 },
        { x: 0, opacity: 1, duration: 0.22, ease: 'power2.out' },
        0.70
      );
    }

    // READING PLATEAU (0.88 -> 1.16): Calm, steady, and readable
    tl.to(sceneCouple, { z: 0, duration: 0.28 }, 0.88);

    // =========================================================================
    // STEP 4: "MELEBUR JADI SATU" CONVERGENCE & ROYAL LOVE CREST (1.16 -> 1.68)
    // 1. Text info fades away cleanly, leaving only the two floating avatars
    // 2. Avatars glide inward toward each other into the center
    // 3. Golden spark flares at collision point as they merge
    // 4. Haute-couture calligraphic gold heart blooms around the united couple
    // 5. Majestic reading plateau for Zharkasi & Difa crest
    // 6. Crest diffuses smoothly into Scene 4 (Asmaraloka)
    // =========================================================================
    
    // 1. Hide header, center ampersand, and text details below avatars
    const fadeOutTexts = [coupleHeader, coupleGroomDetails, coupleBrideDetails, coupleCenterLink].filter(Boolean);
    if (fadeOutTexts.length) {
      tl.to(fadeOutTexts, {
        y: -12,
        opacity: 0,
        duration: 0.10,
        ease: 'power2.in'
      }, 1.16);
    }

    // 2. The two avatars glide inward toward each other to merge ("melebur jadi satu")
    if (coupleGroomAvatar && coupleBrideAvatar) {
      tl.to(coupleGroomAvatar, {
        x: 60,
        scale: 0.94,
        duration: 0.14,
        ease: 'power2.inOut'
      }, 1.20);

      tl.to(coupleBrideAvatar, {
        x: -60,
        scale: 0.94,
        duration: 0.14,
        ease: 'power2.inOut'
      }, 1.20);
    }

    // Flanks gently bow toward the merged love crest
    if (coupleFlankLeft) tl.to(coupleFlankLeft, { x: 30, rotation: 6, duration: 0.14 }, 1.20);
    if (coupleFlankRight) tl.to(coupleFlankRight, { x: -30, rotation: -6, duration: 0.14 }, 1.20);

    // 3. Golden collision spark flares at meeting point
    if (coupleMergeSpark) {
      tl.fromTo(coupleMergeSpark,
        { scale: 0.3, opacity: 0 },
        { scale: 1.2, opacity: 0.9, duration: 0.08, ease: 'power2.out' },
        1.28
      );
      tl.to(coupleMergeSpark, {
        scale: 1.6,
        opacity: 0,
        duration: 0.08,
        ease: 'power1.out'
      }, 1.36);
    }

    // 4. Stylized Calligraphic Love Heart Crest blooms right out from the fusion point!
    if (loveFusion) {
      tl.fromTo(loveFusion,
        { opacity: 0, scale: 0.82 },
        { opacity: 1, scale: 1.0, duration: 0.13, ease: 'power2.out' },
        1.32
      );

      // Smooth crossfade: outward gliding avatars dissolve as the docked heart avatars emerge
      if (coupleGroomAvatar && coupleBrideAvatar) {
        tl.to([coupleGroomAvatar, coupleBrideAvatar], {
          opacity: 0,
          duration: 0.06,
          ease: 'power1.out'
        }, 1.33);
      }

      // Pulse / glow on the luxury gold heart (GPU scale only)
      if (loveHeartSvg) {
        tl.fromTo(loveHeartSvg,
          { scale: 0.88 },
          { scale: 1.0, duration: 0.14, ease: 'power2.out' },
          1.33
        );
      }

      // Names "Zharkasi & Difa" float up softly
      if (loveFusionNames) {
        tl.fromTo(loveFusionNames,
          { opacity: 0, y: 10 },
          { opacity: 1, y: 0, duration: 0.12, ease: 'power2.out' },
          1.36
        );
      }

      // 5. Stable reading plateau for the Love Heart Crest
      tl.to(loveFusion, {
        scale: 1.01,
        duration: 0.16,
        ease: 'none'
      }, 1.44);

      // 6. Heart gently diffuses into Asmaraloka
      tl.to(loveFusion, {
        scale: 1.08,
        opacity: 0,
        duration: 0.08,
        ease: 'power1.out'
      }, 1.60);
    }

    // Scene 3 completes smoothly to hand off to Scene 4
    if (coupleFlankLeft && coupleFlankRight) tl.to([coupleFlankLeft, coupleFlankRight], { opacity: 0, scale: 0.9, duration: 0.08 }, 1.60);
    if (coupleRings.length) tl.to(coupleRings, { opacity: 0, scale: 0.8, duration: 0.08 }, 1.60);

    tl.to(sceneCouple, {
      opacity: 0,
      duration: 0.06,
      ease: 'power1.out',
      onComplete: () => {
        if (sceneCouple) sceneCouple.style.pointerEvents = 'none';
      }
    }, 1.66);

    // =========================================================================
    // STEP 5: SCENE 4 — KISAH ASMARALOKA (PANORAMIC CINEMATIC TRACK) (1.68 -> 3.05)
    // Lateral camera tracking shot smoothly gliding across Babak I -> II -> III
    // =========================================================================
    tl.to(sceneAsmaraloka, {
      z: 0,
      scale: 1,
      opacity: 1,
      duration: 0.18,
      ease: 'power2.out',
      onStart: () => {
        if (sceneAsmaraloka) sceneAsmaraloka.style.pointerEvents = 'auto';
      }
    }, 1.68);

    // Postal stamp and feather quill land on parchment
    if (asmaralokaStamp) tl.to(asmaralokaStamp, { scale: 1, rotation: -10, opacity: 0.75, duration: 0.20, ease: 'back.out(1.5)' }, 1.68);
    if (asmaralokaQuill) tl.to(asmaralokaQuill, { x: 0, y: 0, rotation: 6, opacity: 0.85, duration: 0.20, ease: 'power2.out' }, 1.68);
    if (asmaralokaAccents.length) tl.to(asmaralokaAccents, { scale: 1, opacity: 0.6, duration: 0.20, ease: 'power2.out' }, 1.70);

    if (asmaralokaHeader) {
      tl.fromTo(asmaralokaHeader,
        { y: -24, opacity: 0 },
        { y: 0, opacity: 1, duration: 0.18, ease: 'power2.out' },
        1.70
      );
    }

    if (asmaralokaHalo) {
      tl.fromTo(asmaralokaHalo,
        { scale: 0.85, opacity: 0 },
        { 
          scale: 1, 
          opacity: 0.85, 
          background: 'radial-gradient(circle, rgba(212, 175, 55, 0.28) 0%, rgba(238, 175, 115, 0.18) 35%, rgba(74, 93, 67, 0.03) 65%, transparent 85%)',
          duration: 0.25, 
          ease: 'power2.out' 
        },
        1.70
      );
    }

    // Set Babak 1 active initially
    tl.call(() => setChapterPip(1), [], 1.80);

    // BABAK 1: READING PLATEAU (1.88 -> 2.15)
    tl.to(sceneAsmaraloka, { z: 0, duration: 0.27 }, 1.88);

    // =======================================================================
    // PANORAMIC TRACKING SHOT 1 -> 2: LATERAL CAMERA GLIDE (2.15 -> 2.38)
    // Track glides from +D to 0, centering Babak 2 with multi-layer depth
    // =======================================================================
    if (asmaralokaTrack && stanza1 && stanza2 && stanza3) {
      // 1. Panoramic track translation: +D -> 0
      tl.to(asmaralokaTrack, {
        x: 0,
        duration: 0.23,
        ease: 'power1.inOut'
      }, 2.15);

      // 2. Stele 1 glides left into periphery: scale down, soft fade
      tl.to(stanza1, {
        scale: 0.90,
        opacity: 0.40,
        duration: 0.23,
        ease: 'power1.inOut'
      }, 2.15);

      // 3. Stele 2 glides into center focus: scale up, crystal clarity & illumination
      tl.to(stanza2, {
        scale: 1.0,
        opacity: 1.0,
        duration: 0.23,
        ease: 'power1.inOut'
      }, 2.15);

      // 4. Stele 3 approaches from right: softens into near periphery
      tl.to(stanza3, {
        scale: 0.90,
        opacity: 0.40,
        duration: 0.23,
        ease: 'power1.inOut'
      }, 2.15);

      // Chapter indicator updates to Babak 2
      tl.call(() => setChapterPip(2), [], 2.26);

      // Quill flourishes and postal stamp tilts as story advances
      if (asmaralokaQuill) tl.to(asmaralokaQuill, { x: -20, y: 15, rotation: -3, duration: 0.23, ease: 'power1.inOut' }, 2.15);
      if (asmaralokaStamp) tl.to(asmaralokaStamp, { rotation: 5, duration: 0.23, ease: 'power1.inOut' }, 2.15);

      // Ambient lighting warms up to terracotta amber
      if (asmaralokaHalo) {
        tl.to(asmaralokaHalo, {
          background: 'radial-gradient(circle, rgba(238, 175, 115, 0.36) 0%, rgba(212, 175, 55, 0.20) 40%, rgba(74, 93, 67, 0.03) 70%, transparent 85%)',
          scale: 1.08,
          duration: 0.23,
          ease: 'power1.inOut'
        }, 2.15);
      }
    }

    // BABAK 2: READING PLATEAU (2.38 -> 2.62)
    tl.to(sceneAsmaraloka, { z: 0, duration: 0.24 }, 2.38);

    // =======================================================================
    // PANORAMIC TRACKING SHOT 2 -> 3: LATERAL CAMERA GLIDE (2.62 -> 2.85)
    // Track glides from 0 to -D, centering Babak 3 for the sacred climax
    // =======================================================================
    if (asmaralokaTrack && stanza1 && stanza2 && stanza3) {
      // 1. Panoramic track translation: 0 -> -D
      tl.to(asmaralokaTrack, {
        x: () => -getSteleDist(),
        duration: 0.23,
        ease: 'power1.inOut'
      }, 2.62);

      // 2. Stele 2 glides left into periphery: scale down, soft fade
      tl.to(stanza2, {
        scale: 0.90,
        opacity: 0.40,
        duration: 0.23,
        ease: 'power1.inOut'
      }, 2.62);

      // 3. Stele 3 glides into center focus: scale up, crystal clarity & illumination
      tl.to(stanza3, {
        scale: 1.0,
        opacity: 1.0,
        duration: 0.23,
        ease: 'power1.inOut'
      }, 2.62);

      // 4. Stele 1 recedes further into deep left background
      tl.to(stanza1, {
        scale: 0.84,
        opacity: 0.15,
        duration: 0.23,
        ease: 'power1.inOut'
      }, 2.62);

      // Chapter indicator updates to Babak 3
      tl.call(() => setChapterPip(3), [], 2.73);

      // Quill completes final flourish and stamp tilts to final angle
      if (asmaralokaQuill) tl.to(asmaralokaQuill, { x: -35, y: 28, rotation: -8, duration: 0.23, ease: 'power1.inOut' }, 2.62);
      if (asmaralokaStamp) tl.to(asmaralokaStamp, { rotation: -12, duration: 0.23, ease: 'power1.inOut' }, 2.62);

      // Ambient lighting deepens to sacred twilight rose-gold
      if (asmaralokaHalo) {
        tl.to(asmaralokaHalo, {
          background: 'radial-gradient(circle, rgba(226, 150, 110, 0.35) 0%, rgba(212, 175, 55, 0.24) 45%, rgba(74, 93, 67, 0.04) 75%, transparent 88%)',
          scale: 1.15,
          duration: 0.23,
          ease: 'power1.inOut'
        }, 2.62);
      }
    }

    // BABAK 3: CLIMAX SACRED VOW READING PLATEAU (2.85 -> 3.02)
    tl.to(sceneAsmaraloka, { z: 0, duration: 0.17 }, 2.85);

    // Climax Ascend & Section Transition to UnifiedEvent (3.02 -> 3.15)
    if (asmaralokaStamp) tl.to(asmaralokaStamp, { opacity: 0, y: -25, duration: 0.13 }, 3.02);
    if (asmaralokaQuill) tl.to(asmaralokaQuill, { opacity: 0, y: -25, duration: 0.13 }, 3.02);
    if (asmaralokaAccents.length) tl.to(asmaralokaAccents, { opacity: 0, y: -20, duration: 0.13 }, 3.02);

    tl.to(sceneAsmaraloka, {
      y: -50,
      opacity: 0,
      duration: 0.13,
      ease: 'power1.in',
      onComplete: () => {
        if (sceneAsmaraloka) sceneAsmaraloka.style.pointerEvents = 'none';
      }
    }, 3.02);

    // Smooth Click-to-Navigate for Chapter Pips and Steles
    const scrollToBabak = (babakNum: number) => {
      if (!tl.scrollTrigger) return;
      const targetTime = babakNum === 1 ? 1.95 : (babakNum === 2 ? 2.50 : 2.92);
      const st = tl.scrollTrigger;
      const progress = targetTime / tl.duration();
      const targetScroll = st.start + progress * (st.end - st.start);
      window.scrollTo({ top: targetScroll, behavior: 'smooth' });
    };

    if (pipChapter1) pipChapter1.addEventListener('click', () => scrollToBabak(1));
    if (pipChapter2) pipChapter2.addEventListener('click', () => scrollToBabak(2));
    if (pipChapter3) pipChapter3.addEventListener('click', () => scrollToBabak(3));

    if (stanza1) stanza1.addEventListener('click', () => scrollToBabak(1));
    if (stanza2) stanza2.addEventListener('click', () => scrollToBabak(2));
    if (stanza3) stanza3.addEventListener('click', () => scrollToBabak(3));

    // Ensure ScrollTrigger recalculates after invitation envelope is unboxed
    window.addEventListener('invitationOpened', () => {
      setTimeout(() => {
        ScrollTrigger.refresh();
      }, 150);
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init3DTunnel);
  } else {
    init3DTunnel();
  }
</script>
