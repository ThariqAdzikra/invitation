---
// Cinematic3DTunnel.astro — Elegant Symmetrical 3D Z-Space Journey (Clean & Non-Colliding)
import content from '../../data/content.json';
import FloralWreath from '../botanical/FloralWreath.astro';
import FloralFlourish from '../botanical/FloralFlourish.astro';
import FlyingDoves from '../botanical/FlyingDoves.astro';
import FloralCorner from '../botanical/FloralCorner.astro';
---

<div id="cinematic-tunnel-container" class="relative w-full min-h-[350vh] z-20">
  
  <!-- Pinned 3D Viewport Rig (Stationary Camera Perspective) -->
  <div 
    id="cinematic-viewport" 
    class="sticky top-0 h-[100svh] w-full overflow-hidden flex items-center justify-center pointer-events-auto"
    style="perspective: 1100px; perspective-origin: 50% 50%; transform-style: preserve-3d;"
  >

    <!-- Minimalist Haute-Couture 3D Story Chapter Rail (Right Side) -->
    <nav 
      id="tunnel-chapter-rail"
      class="absolute right-3 sm:right-6 top-1/2 -translate-y-1/2 z-50 flex flex-col items-center gap-2 pointer-events-none transition-all duration-500 opacity-90 select-none"
      aria-label="Indikator Bab 3D"
    >
      <div id="pip-1" class="chapter-pip flex items-center gap-1.5 transition-all duration-300">
        <span class="text-[0.52rem] font-mono tracking-widest text-[#B89352] font-semibold pip-label">01</span>
        <div class="w-2 h-2 rounded-full bg-[#B89352] shadow-[0_0_8px_rgba(184,147,82,0.6)] pip-dot scale-110"></div>
      </div>
      <div class="w-[1px] h-3 bg-[#B89352]/25"></div>
      <div id="pip-2" class="chapter-pip flex items-center gap-1.5 transition-all duration-300 opacity-35">
        <span class="text-[0.52rem] font-mono tracking-widest text-[#7E8F77] pip-label">02</span>
        <div class="w-1.5 h-1.5 rounded-full bg-[#7E8F77] pip-dot scale-100"></div>
      </div>
      <div class="w-[1px] h-3 bg-[#B89352]/25"></div>
      <div id="pip-3" class="chapter-pip flex items-center gap-1.5 transition-all duration-300 opacity-35">
        <span class="text-[0.52rem] font-mono tracking-widest text-[#7E8F77] pip-label">03</span>
        <div class="w-1.5 h-1.5 rounded-full bg-[#7E8F77] pip-dot scale-100"></div>
      </div>
    </nav>

    <!-- 3D Camera Rig: Anchored & Centered (No mouse tracking) -->
    <div 
      id="cinematic-camera-rig" 
      class="relative w-full h-full flex items-center justify-center will-change-transform"
      style="transform-style: preserve-3d;"
    >

      <!-- ===================================================================
           SCENE 1: THE ROYAL ENTRANCE & HERO (Z: 0 -> Zoom past camera)
           Spacious Classical Haute-Couture Symmetrical Layout
           =================================================================== -->
      <section 
        id="scene-hero" 
        class="scene-3d absolute inset-0 flex flex-col items-center justify-center px-4 py-6 text-center will-change-transform"
        style="transform: translate3d(0, 0, 0px); transform-style: preserve-3d;"
        aria-label="Cover Undangan Pernikahan"
      >
        <!-- Haute-Couture Botanical Corner Filigree Framing (The Royal Stationery Frame) -->
        <div id="hero-corner-frame" class="absolute inset-1 sm:inset-4 pointer-events-none z-0 overflow-hidden opacity-75 transition-opacity duration-700">
          <div class="absolute top-0 left-0">
            <FloralCorner position="top-left" size={90} className="sm:scale-125 origin-top-left" />
          </div>
          <div class="absolute top-0 right-0">
            <FloralCorner position="top-right" size={90} className="sm:scale-125 origin-top-right" />
          </div>
          <div class="absolute bottom-0 left-0">
            <FloralCorner position="bottom-left" size={90} className="sm:scale-125 origin-bottom-left" />
          </div>
          <div class="absolute bottom-0 right-0">
            <FloralCorner position="bottom-right" size={90} className="sm:scale-125 origin-bottom-right" />
          </div>
        </div>

        <div class="max-w-lg w-full mx-auto flex flex-col items-center justify-between h-[84svh] max-h-[720px] my-auto relative z-10">
          
          <!-- TOP BLOCK: Crest, Tagline, & Symmetrical Headline -->
          <div id="hero-top-block" class="flex flex-col items-center pt-1 will-change-transform">
            <!-- Monogram Crest -->
            <div class="mb-1.5">
              <FloralWreath monogram="AD" size={62} />
            </div>

            <!-- Overline -->
            <p class="text-[0.62rem] sm:text-xs tracking-[0.34em] text-[#B89352] uppercase font-semibold mb-1">
              WALIMATUL 'URS
            </p>

            <!-- Names with spacious breathing room -->
            <h1 class="font-display text-4xl sm:text-5xl md:text-6xl text-[#2A3426] font-normal tracking-tight leading-none my-1">
              {content.couple.groom.nickname} <span class="font-display italic text-[#B89352] font-normal px-1">&amp;</span> {content.couple.bride.nickname}
            </h1>

            <div class="my-1.5 opacity-75">
              <FloralFlourish width={140} height={18} />
            </div>

            <!-- Flying White Doves Carrying Olive Sprigs -->
            <div class="my-1 flex justify-center opacity-90">
              <FlyingDoves width={250} height={42} />
            </div>
          </div>

          <!-- CENTER BLOCK: Haute-Couture Vector Illustration in Roman Arch (Double Arch & Ambient Halo) -->
          <div id="hero-arch-block" class="my-auto py-1 relative will-change-transform">
            <!-- Radiant Warm Gold Halo Behind Arch -->
            <div class="absolute -inset-10 bg-[radial-gradient(ellipse_at_center,rgba(184,147,82,0.22)_0%,rgba(74,93,67,0.05)_45%,transparent_70%)] blur-2xl pointer-events-none -z-10"></div>

            <!-- Concentric Outer Architectural Hairline Arch -->
            <div class="relative p-1.5 sm:p-2 rounded-t-full border border-[#B89352]/30 bg-white/40 shadow-[0_18px_45px_rgba(42,52,38,0.1)] backdrop-blur-[0.5px]">
              
              <!-- Inner Roman Arch with Golden Edge -->
              <div 
                class="relative w-44 sm:w-52 aspect-[3/4] mx-auto rounded-t-full border border-[#B89352]/40 p-1 bg-gradient-to-b from-[#FAF8F5] via-[#FFFFFF] to-[#F3EEE5] shadow-inner interactive-foil-card overflow-hidden group"
                data-foil="true"
              >
                <div class="w-full h-full rounded-t-full overflow-hidden border border-[#566A4E]/20 relative bg-[#FAF8F5]">
                  <img 
                    src="/assets/vector-hero.jpg" 
                    alt="Ilustrasi Mempelai Arya & Dian" 
                    class="w-full h-full object-cover"
                    loading="eager"
                    fetchpriority="high"
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-[#2A3426]/15 via-transparent to-transparent pointer-events-none"></div>
                </div>
              </div>
            </div>

            <!-- Arch Base Floating Soft Shadow -->
            <div class="w-40 sm:w-48 h-2.5 bg-[#263322]/10 rounded-full blur-sm mx-auto mt-1 pointer-events-none"></div>
          </div>

          <!-- BOTTOM BLOCK: Date, Venue, & Stitched Guest Welcoming Plaque -->
          <div id="hero-bottom-block" class="flex flex-col items-center gap-1.5 pb-2 w-full will-change-transform">
            <p class="text-[0.68rem] sm:text-xs text-[#4A5D43] tracking-[0.24em] uppercase font-semibold">
              {content.event.dateFormatted} &bull; {content.event.timezone}
            </p>
            <p class="text-[0.62rem] text-[#7E8F77] font-light tracking-wider">
              {content.event.venue.name} &bull; Banda Aceh
            </p>

            <!-- Personalized Guest Welcoming Plaque (Haute-Couture Stitched Badge) -->
            <div class="mt-2 py-2 px-5 sm:px-6 rounded-xl border border-[#B89352]/40 bg-white/95 shadow-[0_4px_18px_rgba(42,52,38,0.06)] relative overflow-hidden inline-flex flex-col items-center max-w-[270px] sm:max-w-[300px]">
              <!-- Gold Stitched Inset Border -->
              <div class="absolute inset-1 border border-dashed border-[#B89352]/35 rounded-lg pointer-events-none"></div>
              
              <span class="text-[0.52rem] tracking-[0.24em] uppercase text-[#7E8F77] font-semibold mb-0.5 relative z-10">
                Kepada Yth. Bapak/Ibu/Saudara/i:
              </span>
              <span id="hero-guest-name" class="font-display text-xs sm:text-sm text-[#2A3426] font-normal relative z-10 truncate max-w-[230px]">
                Tamu Undangan Terhormat
              </span>
            </div>
          </div>

        </div>
      </section>

      <!-- ===================================================================
           SCENE 2: THE SACRED VERSE (QS AR-RUM: 21) (Z: -850 -> 0 -> Zoom past)
           =================================================================== -->
      <section 
        id="scene-verse" 
        class="scene-3d absolute inset-0 flex flex-col items-center justify-center px-4 py-6 text-center will-change-transform opacity-0 pointer-events-none"
        style="transform: translate3d(0, 0, -850px); transform-style: preserve-3d;"
        aria-label="Ayat Suci Al-Qur'an"
      >
        <div class="max-w-xl w-full mx-auto flex flex-col items-center justify-center my-auto">
          
          <!-- Sacred Bismillah -->
          <p id="verse-bismillah" class="font-arabic text-2xl sm:text-3xl text-[#3E4C38] mb-3 drop-shadow-sm will-change-transform" dir="rtl" lang="ar">
            {content.opening.bismillah}
          </p>

          <!-- Ayat Suci Card with Refined Proportions -->
          <div 
            id="verse-card"
            class="w-full bg-white/95 border border-[#566A4E]/25 rounded-2xl p-5 sm:p-8 shadow-[0_16px_40px_rgba(42,52,38,0.08)] relative overflow-hidden my-2 interactive-foil-card will-change-transform"
            data-foil="true"
          >
            <div class="absolute top-0 left-0 right-0 h-[2.5px] bg-gradient-to-r from-transparent via-[#B89352] to-transparent"></div>

            <blockquote lang="ar" dir="rtl" class="font-arabic text-lg sm:text-2xl text-[#2A3426] leading-loose max-w-lg mx-auto relative z-10">
              {content.opening.verse}
            </blockquote>

            <p class="text-[0.72rem] sm:text-xs text-[#566A4E] font-light leading-relaxed my-3 max-w-md mx-auto italic relative z-10">
              &ldquo;{content.opening.translation}&rdquo;
            </p>

            <div class="my-1.5 relative z-10 opacity-70 flex justify-center">
              <FloralFlourish width={130} height={20} />
            </div>

            <p class="text-[0.62rem] tracking-[0.25em] text-[#B89352] uppercase font-semibold mt-1 relative z-10">
              {content.opening.source}
            </p>
          </div>

          <p id="verse-greeting" class="text-xs text-[#4A5D43] mt-3 font-normal max-w-md leading-relaxed will-change-transform">
            {content.opening.greeting}
          </p>

        </div>
      </section>

      <!-- ===================================================================
           SCENE 3: KEDUA MEMPELAI (ARYA & DIAN) (Z: -850 -> 0 Crisp landing)
           =================================================================== -->
      <section 
        id="scene-couple" 
        class="scene-3d absolute inset-0 flex flex-col items-center justify-center px-4 py-6 text-center will-change-transform opacity-0 pointer-events-none"
        style="transform: translate3d(0, 0, -850px); transform-style: preserve-3d;"
        aria-label="Profil Kedua Mempelai"
      >
        <div class="max-w-2xl w-full mx-auto flex flex-col items-center justify-center my-auto">
          
          <div id="couple-header-block" class="flex flex-col items-center will-change-transform">
            <p class="text-overline tracking-[0.28em] text-[0.62rem] mb-0.5">
              KEDUA MEMPELAI
            </p>
            <h2 class="font-display text-2xl sm:text-3xl md:text-4xl text-[#2A3426] font-normal mb-1">
              Mempelai Pria &amp; Wanita
            </h2>
            <div class="my-1 flex justify-center opacity-70">
              <FloralFlourish width={140} height={20} />
            </div>
          </div>

          <!-- Dual Profiles Grid -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 sm:gap-6 w-full mt-2">
            
            <!-- Arya (Groom) -->
            <article 
              id="couple-groom-card"
              class="couple-profile-card bg-white/95 border border-[#566A4E]/20 rounded-2xl p-4 sm:p-5 flex flex-col items-center text-center shadow-[0_12px_35px_rgba(42,52,38,0.06)] relative overflow-hidden interactive-foil-card will-change-transform"
              data-foil="true"
            >
              <div class="absolute top-0 left-0 right-0 h-[2px] bg-gradient-to-r from-transparent via-[#B89352] to-transparent"></div>

              <div class="mb-2.5 relative group">
                <div class="w-22 h-22 sm:w-24 sm:h-24 rounded-full p-1 border-2 border-[#B89352]/40 bg-gradient-to-tr from-[#FAF8F5] via-[#FFFFFF] to-[#F3EEE5] shadow-md relative overflow-hidden">
                  <img 
                    src="/assets/vector-groom.jpg" 
                    alt={content.couple.groom.fullName} 
                    class="w-full h-full object-cover rounded-full"
                    loading="lazy"
                  />
                </div>
              </div>

              <p class="text-[0.55rem] tracking-[0.25em] text-[#B89352] uppercase font-semibold mb-0.5">Mempelai Pria</p>
              <h3 class="font-display text-base sm:text-lg text-[#2A3426] font-normal">
                {content.couple.groom.fullName}
              </h3>
              <p class="text-[0.65rem] text-[#566A4E] font-light max-w-xs leading-relaxed mt-0.5 mb-2">
                {content.couple.groom.parents}
              </p>

              <div class="py-1.5 px-3 rounded-lg bg-[#FAF8F5] border border-[#566A4E]/10 w-full mb-2.5">
                <p class="font-display italic text-[0.65rem] sm:text-xs text-[#3E4C38] leading-relaxed">
                  &ldquo;{content.couple.groom.quote}&rdquo;
                </p>
              </div>

              <a 
                href={`https://instagram.com/${content.couple.groom.instagram.replace('@', '')}`} 
                target="_blank" 
                rel="noopener noreferrer" 
                class="inline-flex items-center gap-1.5 text-[0.6rem] text-[#566A4E] hover:text-[#2A3426] tracking-widest uppercase font-semibold px-3 py-1 rounded-full border border-[#566A4E]/20 bg-white hover:border-[#B89352] transition-colors"
              >
                <span>{content.couple.groom.instagram}</span>
                <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6M15 3h6v6M10 14L21 3"/>
                </svg>
              </a>
            </article>

            <!-- Dian (Bride) -->
            <article 
              id="couple-bride-card"
              class="couple-profile-card bg-white/95 border border-[#566A4E]/20 rounded-2xl p-4 sm:p-5 flex flex-col items-center text-center shadow-[0_12px_35px_rgba(42,52,38,0.06)] relative overflow-hidden interactive-foil-card will-change-transform"
              data-foil="true"
            >
              <div class="absolute top-0 left-0 right-0 h-[2px] bg-gradient-to-r from-transparent via-[#B89352] to-transparent"></div>

              <div class="mb-2.5 relative group">
                <div class="w-22 h-22 sm:w-24 sm:h-24 rounded-full p-1 border-2 border-[#B89352]/40 bg-gradient-to-tr from-[#FAF8F5] via-[#FFFFFF] to-[#F3EEE5] shadow-md relative overflow-hidden">
                  <img 
                    src="/assets/vector-bride.jpg" 
                    alt={content.couple.bride.fullName} 
                    class="w-full h-full object-cover rounded-full"
                    loading="lazy"
                  />
                </div>
              </div>

              <p class="text-[0.55rem] tracking-[0.25em] text-[#B89352] uppercase font-semibold mb-0.5">Mempelai Wanita</p>
              <h3 class="font-display text-base sm:text-lg text-[#2A3426] font-normal">
                {content.couple.bride.fullName}
              </h3>
              <p class="text-[0.65rem] text-[#566A4E] font-light max-w-xs leading-relaxed mt-0.5 mb-2">
                {content.couple.bride.parents}
              </p>

              <div class="py-1.5 px-3 rounded-lg bg-[#FAF8F5] border border-[#566A4E]/10 w-full mb-2.5">
                <p class="font-display italic text-[0.65rem] sm:text-xs text-[#3E4C38] leading-relaxed">
                  &ldquo;{content.couple.bride.quote}&rdquo;
                </p>
              </div>

              <a 
                href={`https://instagram.com/${content.couple.bride.instagram.replace('@', '')}`} 
                target="_blank" 
                rel="noopener noreferrer" 
                class="inline-flex items-center gap-1.5 text-[0.6rem] text-[#566A4E] hover:text-[#2A3426] tracking-widest uppercase font-semibold px-3 py-1 rounded-full border border-[#566A4E]/20 bg-white hover:border-[#B89352] transition-colors"
              >
                <span>{content.couple.bride.instagram}</span>
                <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6M15 3h6v6M10 14L21 3"/>
                </svg>
              </a>
            </article>

          </div>

        </div>
      </section>

    </div>

    <!-- Discrete Floating Scroll Cue at Very Bottom -->
    <div id="scroll-fly-cue" class="absolute bottom-4 left-1/2 -translate-x-1/2 flex items-center gap-2 px-3.5 py-1 rounded-full bg-white/80 border border-[#566A4E]/20 text-[#4A5D43] text-[0.58rem] tracking-[0.24em] uppercase font-semibold shadow-xs pointer-events-none transition-opacity duration-300">
      <span>Scroll ke Bawah</span>
      <span class="w-1.5 h-1.5 rounded-full bg-[#B89352] animate-ping"></span>
    </div>

  </div>

</div>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  function init3DTunnel() {
    const container = document.getElementById('cinematic-tunnel-container');
    const viewport = document.getElementById('cinematic-viewport');

    const sceneHero = document.getElementById('scene-hero');
    const sceneVerse = document.getElementById('scene-verse');
    const sceneCouple = document.getElementById('scene-couple');
    const scrollCue = document.getElementById('scroll-fly-cue');

    // Pre-fill name from URL parameter
    const urlParams = new URLSearchParams(window.location.search);
    const rawTo = urlParams.get('to');
    if (rawTo) {
      try {
        const decoded = decodeURIComponent(rawTo.replace(/\+/g, ' ')).replace(/<[^>]*>/g, '').trim().substring(0, 50);
        const heroGuest = document.getElementById('hero-guest-name');
        if (heroGuest && decoded) heroGuest.textContent = decoded;
      } catch (e) {}
    }

    if (!container || !viewport || !sceneHero || !sceneVerse || !sceneCouple) return;

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReducedMotion) {
      if (sceneVerse) {
        sceneVerse.style.opacity = '1';
        sceneVerse.style.transform = 'none';
        sceneVerse.style.position = 'relative';
        sceneVerse.style.pointerEvents = 'auto';
      }
      if (sceneCouple) {
        sceneCouple.style.opacity = '1';
        sceneCouple.style.transform = 'none';
        sceneCouple.style.position = 'relative';
        sceneCouple.style.pointerEvents = 'auto';
      }
      return;
    }

    // Set initial 3D transforms via GSAP
    gsap.set(sceneHero, { z: 0, scale: 1, opacity: 1, filter: 'blur(0px)', pointerEvents: 'auto' });
    gsap.set(sceneVerse, { z: -750, scale: 0.6, opacity: 0, filter: 'blur(10px)', pointerEvents: 'none' });
    gsap.set(sceneCouple, { z: -750, scale: 0.6, opacity: 0, pointerEvents: 'none' });

    const heroTop = document.getElementById('hero-top-block');
    const heroArch = document.getElementById('hero-arch-block');
    const heroBottom = document.getElementById('hero-bottom-block');
    const heroCorners = document.getElementById('hero-corner-frame');
    const verseBismillah = document.getElementById('verse-bismillah');
    const verseCard = document.getElementById('verse-card');
    const verseGreeting = document.getElementById('verse-greeting');
    const coupleHeader = document.getElementById('couple-header-block');
    const groomCard = document.getElementById('couple-groom-card');
    const brideCard = document.getElementById('couple-bride-card');

    const pip1 = document.getElementById('pip-1');
    const pip2 = document.getElementById('pip-2');
    const pip3 = document.getElementById('pip-3');
    const chapterRail = document.getElementById('tunnel-chapter-rail');

    function setActivePip(activeNum: number) {
      const pips = [pip1, pip2, pip3];
      pips.forEach((pip, idx) => {
        if (!pip) return;
        const num = idx + 1;
        const dot = pip.querySelector('.pip-dot');
        const label = pip.querySelector('.pip-label');
        if (num === activeNum) {
          pip.style.opacity = '1';
          if (dot) {
            dot.className = 'w-2 h-2 rounded-full bg-[#B89352] shadow-[0_0_10px_rgba(184,147,82,0.7)] pip-dot scale-110';
          }
          if (label) {
            label.className = 'text-[0.52rem] font-mono tracking-widest text-[#B89352] font-semibold pip-label';
          }
        } else {
          pip.style.opacity = '0.35';
          if (dot) {
            dot.className = 'w-1.5 h-1.5 rounded-full bg-[#7E8F77] pip-dot scale-100';
          }
          if (label) {
            label.className = 'text-[0.52rem] font-mono tracking-widest text-[#7E8F77] pip-label';
          }
        }
      });
    }

    // GSAP Pinned Timeline with Multi-Plane Spatial Choreography
    const tl = gsap.timeline({
      scrollTrigger: {
        trigger: container,
        pin: viewport,
        start: 'top top',
        end: 'bottom bottom',
        scrub: 1.2,
        anticipatePin: 1,
        onUpdate: (self) => {
          if (scrollCue) {
            scrollCue.style.opacity = self.progress > 0.85 ? '0' : '1';
          }
          if (chapterRail) {
            chapterRail.style.opacity = self.progress > 0.92 ? '0' : '0.9';
          }
          if (self.progress < 0.35) {
            setActivePip(1);
          } else if (self.progress < 0.70) {
            setActivePip(2);
          } else {
            setActivePip(3);
          }
        }
      }
    });

    // =========================================================================
    // STEP 1: HERO SCENE PORTAL SEPARATION & FLY-THROUGH (0.00 -> 0.38)
    // Symmetrical portal parting: top rises, arch zooms, bottom descends
    // =========================================================================
    if (heroTop) {
      tl.to(heroTop, {
        y: -90,
        opacity: 0,
        duration: 0.32,
        ease: 'power1.inOut'
      }, 0);
    }
    if (heroCorners) {
      tl.to(heroCorners, {
        opacity: 0,
        scale: 1.08,
        duration: 0.28,
        ease: 'power1.inOut'
      }, 0);
    }
    if (heroArch) {
      tl.to(heroArch, {
        scale: 1.3,
        opacity: 0,
        filter: 'blur(6px)',
        duration: 0.36,
        ease: 'power1.inOut'
      }, 0.02);
    }
    if (heroBottom) {
      tl.to(heroBottom, {
        y: 70,
        opacity: 0,
        duration: 0.30,
        ease: 'power1.inOut'
      }, 0);
    }
    tl.to(sceneHero, {
      z: 500,
      duration: 0.36,
      ease: 'power1.inOut',
      onComplete: () => {
        if (sceneHero) sceneHero.style.pointerEvents = 'none';
      },
      onReverseComplete: () => {
        if (sceneHero) sceneHero.style.pointerEvents = 'auto';
      }
    }, 0);

    // =========================================================================
    // STEP 2: VERSE SCENE GLIDES FORWARD INTO CRISP FOCUS (0.24 -> 0.54)
    // =========================================================================
    tl.to(sceneVerse, {
      z: 0,
      scale: 1,
      opacity: 1,
      filter: 'blur(0px)',
      duration: 0.30,
      ease: 'power2.out',
      onStart: () => {
        if (sceneVerse) sceneVerse.style.pointerEvents = 'auto';
      }
    }, 0.24);

    if (verseBismillah) {
      tl.fromTo(verseBismillah, 
        { y: -25, opacity: 0 },
        { y: 0, opacity: 1, duration: 0.22, ease: 'power2.out' },
        0.30
      );
    }
    if (verseCard) {
      tl.fromTo(verseCard,
        { scale: 0.92, y: 30 },
        { scale: 1, y: 0, duration: 0.26, ease: 'power2.out' },
        0.28
      );
    }
    if (verseGreeting) {
      tl.fromTo(verseGreeting,
        { opacity: 0, y: 15 },
        { opacity: 1, y: 0, duration: 0.22, ease: 'power2.out' },
        0.34
      );
    }

    // =========================================================================
    // STEP 3: VERSE SCENE ASCENDS & CLEARS THE STAGE (0.58 -> 0.76)
    // =========================================================================
    tl.to(sceneVerse, {
      z: 450,
      scale: 1.25,
      opacity: 0,
      filter: 'blur(8px)',
      y: -60,
      duration: 0.22,
      ease: 'power1.in',
      onComplete: () => {
        if (sceneVerse) sceneVerse.style.pointerEvents = 'none';
      }
    }, 0.58);

    // =========================================================================
    // STEP 4: KEDUA MEMPELAI CONVERGENCE REVEAL (0.62 -> 0.92)
    // Arya glides from left depth, Dian glides from right depth, converging in center!
    // =========================================================================
    tl.to(sceneCouple, {
      z: 0,
      scale: 1,
      opacity: 1,
      filter: 'blur(0px)',
      duration: 0.28,
      ease: 'power2.out',
      onStart: () => {
        if (sceneCouple) sceneCouple.style.pointerEvents = 'auto';
      }
    }, 0.62);

    if (coupleHeader) {
      tl.fromTo(coupleHeader,
        { y: -25, opacity: 0 },
        { y: 0, opacity: 1, duration: 0.24, ease: 'power2.out' },
        0.64
      );
    }

    if (groomCard) {
      tl.fromTo(groomCard,
        { x: -60, z: -350, opacity: 0, scale: 0.9 },
        { x: 0, z: 0, opacity: 1, scale: 1, duration: 0.30, ease: 'power2.out' },
        0.66
      );
    }

    if (brideCard) {
      tl.fromTo(brideCard,
        { x: 60, z: -350, opacity: 0, scale: 0.9 },
        { x: 0, z: 0, opacity: 1, scale: 1, duration: 0.30, ease: 'power2.out' },
        0.66
      );
    }

    // Couple Scene rests comfortably in crisp focus until the unpin transition
    tl.to(sceneCouple, {
      z: 0,
      scale: 1,
      duration: 0.12
    }, 0.92);

    // Ensure ScrollTrigger recalculates after invitation envelope is unboxed
    window.addEventListener('invitationOpened', () => {
      setTimeout(() => {
        ScrollTrigger.refresh();
      }, 150);
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init3DTunnel);
  } else {
    init3DTunnel();
  }
</script>
