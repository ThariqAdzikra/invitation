---
// Cinematic3DTunnel.astro — Elegant Symmetrical 3D Z-Space Journey (Clean & Non-Colliding)
import content from '../../data/content.json';
import FloralWreath from '../botanical/FloralWreath.astro';
import FloralFlourish from '../botanical/FloralFlourish.astro';
import FloralCorner from '../botanical/FloralCorner.astro';
import HeroBotanicalOrnaments from '../botanical/HeroBotanicalOrnaments.astro';
import IslamicSanctuaryOrnaments from '../thematic/IslamicSanctuaryOrnaments.astro';
import VintageLoveChronicleAccents from '../thematic/VintageLoveChronicleAccents.astro';
---

<div id="cinematic-tunnel-container" class="relative w-full min-h-[620vh] z-20">
  
  <!-- Pinned 3D Viewport Rig (Stationary Camera Perspective) -->
  <div 
    id="cinematic-viewport" 
    class="sticky top-0 h-[100svh] w-full overflow-hidden flex items-center justify-center pointer-events-auto"
    style="perspective: 1100px; perspective-origin: 50% 50%; transform-style: preserve-3d;"
  >

    <!-- Minimalist Haute-Couture 3D Story Chapter Rail (Right Side) -->
    <nav 
      id="tunnel-chapter-rail"
      class="absolute right-3 sm:right-6 top-1/2 -translate-y-1/2 z-50 flex flex-col items-center gap-2 pointer-events-none transition-all duration-500 opacity-90 select-none"
      aria-label="Indikator Bab 3D"
    >
      <div id="pip-1" class="chapter-pip flex items-center gap-1.5 transition-all duration-300">
        <span class="text-[0.52rem] font-mono tracking-widest text-[#B89352] font-semibold pip-label">01</span>
        <div class="w-2 h-2 rounded-full bg-[#B89352] shadow-[0_0_8px_rgba(184,147,82,0.6)] pip-dot scale-110"></div>
      </div>
      <div class="w-[1px] h-2.5 bg-[#B89352]/25"></div>
      <div id="pip-2" class="chapter-pip flex items-center gap-1.5 transition-all duration-300 opacity-35">
        <span class="text-[0.52rem] font-mono tracking-widest text-[#7E8F77] pip-label">02</span>
        <div class="w-1.5 h-1.5 rounded-full bg-[#7E8F77] pip-dot scale-100"></div>
      </div>
      <div class="w-[1px] h-2.5 bg-[#B89352]/25"></div>
      <div id="pip-3" class="chapter-pip flex items-center gap-1.5 transition-all duration-300 opacity-35">
        <span class="text-[0.52rem] font-mono tracking-widest text-[#7E8F77] pip-label">03</span>
        <div class="w-1.5 h-1.5 rounded-full bg-[#7E8F77] pip-dot scale-100"></div>
      </div>
      <div class="w-[1px] h-2.5 bg-[#B89352]/25"></div>
      <div id="pip-4" class="chapter-pip flex items-center gap-1.5 transition-all duration-300 opacity-35">
        <span class="text-[0.52rem] font-mono tracking-widest text-[#7E8F77] pip-label">04</span>
        <div class="w-1.5 h-1.5 rounded-full bg-[#7E8F77] pip-dot scale-100"></div>
      </div>
    </nav>

    <!-- 3D Camera Rig: Anchored & Centered (No mouse tracking) -->
    <div 
      id="cinematic-camera-rig" 
      class="relative w-full h-full flex items-center justify-center will-change-transform"
      style="transform-style: preserve-3d;"
    >

      <!-- ===================================================================
           SCENE 1: THE ROYAL ENTRANCE & HERO (Z: 0 -> Zoom past camera)
           Spacious Classical Haute-Couture Symmetrical Layout
           =================================================================== -->
      <section 
        id="scene-hero" 
        class="scene-3d absolute inset-0 flex flex-col items-center justify-center px-4 py-6 text-center will-change-transform"
        style="transform: translate3d(0, 0, 0px); transform-style: preserve-3d;"
        aria-label="Cover Undangan Pernikahan"
      >
        <!-- THEMATIC SCENE 1 CORNERS: Artisan Haute-Couture Vector Botanical Canopies (100% Vector, Zero AI Slop) -->
        <HeroBotanicalOrnaments />

        <div class="max-w-lg w-full mx-auto flex flex-col items-center justify-between h-[84svh] max-h-[720px] my-auto relative z-10">
          
          <!-- TOP BLOCK: Crest, Tagline, & Symmetrical Headline -->
          <div id="hero-top-block" class="flex flex-col items-center pt-2 sm:pt-3 will-change-transform">
            <!-- Monogram Crest with Soft Gold Aura -->
            <div class="mb-2 relative">
              <div class="absolute -inset-2 rounded-full bg-[radial-gradient(circle,rgba(212,175,55,0.2)_0%,transparent_70%)] blur-sm pointer-events-none"></div>
              <FloralWreath monogram="ZD" size={54} />
            </div>

            <!-- Overline -->
            <p class="text-[0.62rem] sm:text-xs tracking-[0.38em] text-[#B89352] uppercase font-semibold mb-1">
              WALIMATUL 'URS
            </p>

            <!-- Names with spacious breathing room -->
            <h1 class="font-display text-4xl sm:text-5xl md:text-6xl text-[#2A3426] font-normal tracking-tight leading-none my-1">
              {content.couple.groom.nickname} <span class="font-display italic text-[#B89352] font-normal px-1">&amp;</span> {content.couple.bride.nickname}
            </h1>

            <!-- Whispered Minimalist Hairline Divider -->
            <div class="mt-2 mb-1 flex items-center justify-center gap-2.5 opacity-70">
              <span class="w-10 sm:w-16 h-[1px] bg-gradient-to-r from-transparent to-[#B89352]/50"></span>
              <span class="text-[0.55rem] text-[#B89352]">✦</span>
              <span class="w-10 sm:w-16 h-[1px] bg-gradient-to-l from-transparent to-[#B89352]/50"></span>
            </div>
          </div>

          <!-- CENTER BLOCK: Grand Botanical Floral Wedding Archway (Lush Pastel Watercolor Artwork) -->
          <div id="hero-arch-block" class="my-auto py-1 relative will-change-transform flex flex-col items-center justify-center">
            <!-- Ethereal Sunrise Golden Aura Blooming Naturally Behind Arch -->
            <div class="absolute -inset-10 sm:-inset-16 bg-[radial-gradient(ellipse_at_center,rgba(248,196,173,0.38)_0%,rgba(212,175,55,0.22)_40%,rgba(74,93,67,0.03)_65%,transparent_80%)] blur-2xl pointer-events-none -z-10"></div>

            <!-- Grand Floral Botanical Archway (896x1200 transparent watercolor illustration) -->
            <div class="relative w-72 sm:w-80 md:w-88 lg:w-[390px] aspect-[3/4] mx-auto flex items-center justify-center pointer-events-none select-none">
              <img 
                src="/assets/floral-hero-arch.png" 
                alt="Gerbang Lengkung Bunga Pernikahan Zharkasi & Difa" 
                class="w-full h-full object-contain filter drop-shadow-[0_16px_40px_rgba(42,52,38,0.14)] pointer-events-none select-none"
                loading="eager"
                fetchpriority="high"
              />

              <!-- Ethereal Portal Backlight Streaming Through Arch Center -->
              <div class="absolute inset-x-[28%] top-[25%] bottom-[8%] rounded-t-[100px] bg-[radial-gradient(ellipse_at_50%_40%,rgba(255,248,235,0.7)_0%,rgba(248,196,173,0.3)_50%,transparent_80%)] blur-md pointer-events-none -z-5"></div>
            </div>
          </div>

          <!-- BOTTOM BLOCK: Minimalist Editorial Date, Venue & Guest Welcoming -->
          <div id="hero-bottom-block" class="flex flex-col items-center gap-1 pb-2 sm:pb-3 w-full will-change-transform">
            <!-- Event Meta -->
            <div class="flex items-center justify-center gap-2 text-[0.62rem] sm:text-[0.7rem] text-[#4A5D43] tracking-[0.24em] uppercase font-semibold">
              <span>{content.event.dateFormatted}</span>
              <span class="text-[#B89352] text-[0.55rem]">&bull;</span>
              <span>Padang</span>
            </div>
            
            <p class="text-[0.58rem] sm:text-[0.62rem] text-[#7E8F77] font-light tracking-wider">
              {content.event.venue.name}
            </p>

            <!-- Minimalist Editorial Guest Welcoming Line (Clean, No Bulky Card) -->
            <div class="mt-2.5 flex flex-col items-center">
              <span class="text-[0.52rem] tracking-[0.3em] uppercase text-[#7E8F77] font-semibold mb-0.5">
                Kepada Yth. Bapak/Ibu/Saudara/i:
              </span>
              <div class="relative inline-flex items-center justify-center px-4 py-0.5">
                <span class="absolute left-0 top-1/2 -translate-y-1/2 w-3 h-[1px] bg-[#B89352]/40"></span>
                <span id="hero-guest-name" class="font-display italic text-sm sm:text-base text-[#2A3426] font-normal px-2 truncate max-w-[240px] sm:max-w-[320px]">
                  Tamu Undangan Terhormat
                </span>
                <span class="absolute right-0 top-1/2 -translate-y-1/2 w-3 h-[1px] bg-[#B89352]/40"></span>
              </div>
            </div>
          </div>

        </div>
      </section>

      <!-- ===================================================================
           SCENE 2: THE SACRED VERSE (QS AR-RUM: 21) (Z: -850 -> 0 -> Zoom past)
           ROYAL SACRED ARCH PORTAL (LENGKUNG MIHRAB KUBAH SUCI)
           =================================================================== -->
      <section 
        id="scene-verse" 
        class="scene-3d absolute inset-0 flex flex-col items-center justify-center px-4 py-6 text-center will-change-transform opacity-0 pointer-events-none"
        style="transform: translate3d(0, 0, -850px); transform-style: preserve-3d;"
        aria-label="Ayat Suci Al-Qur'an"
      >
        <!-- THEMATIC SCENE 2 CORNERS: Sacred Moroccan Arabesque Filigree & Glowing Qandil Lanterns -->
        <IslamicSanctuaryOrnaments />

        <div class="max-w-xl w-full mx-auto flex flex-col items-center justify-center my-auto relative">
          
          <!-- Ethereal Volumetric Golden Halo Blooming Behind the Arch -->
          <div class="absolute -inset-10 sm:-inset-16 bg-[radial-gradient(ellipse_at_center,rgba(212,175,55,0.25)_0%,rgba(184,147,82,0.12)_45%,rgba(74,93,67,0.02)_70%,transparent_85%)] blur-2xl pointer-events-none -z-10"></div>
          
          <!-- Royal Mihrab Cathedral Archway Container -->
          <div 
            id="verse-arch-card" 
            class="relative w-full max-w-md sm:max-w-lg rounded-t-[160px] sm:rounded-t-[200px] rounded-b-[28px] border-2 border-[#B89352]/40 bg-gradient-to-b from-[#FFFDF9] via-[#FAF8F5] to-[#F7F3EC] shadow-[0_20px_60px_rgba(42,52,38,0.08),0_4px_16px_rgba(184,147,82,0.12)] p-6 sm:p-9 pt-8 sm:pt-11 flex flex-col items-center text-center will-change-transform overflow-hidden"
          >
            <!-- 1. Inner Concentric Tailored Arch Inset Line -->
            <div class="absolute inset-2 sm:inset-3 rounded-t-[148px] sm:rounded-t-[188px] rounded-b-[20px] border border-[#B89352]/30 pointer-events-none"></div>
            <!-- 2. Second Fine Jewelry Dotted Contour Line -->
            <div class="absolute inset-3.5 sm:inset-5 rounded-t-[136px] sm:rounded-t-[176px] rounded-b-[14px] border border-dashed border-[#B89352]/20 pointer-events-none"></div>

            <!-- Botanical Olive Arch Garland Canopy (Top-Left & Top-Right Arch Shoulders) -->
            <div class="absolute top-1 sm:top-2 inset-x-0 h-24 sm:h-28 pointer-events-none z-15 overflow-visible flex justify-between px-2 sm:px-4">
              <!-- Left Arching Olive Branch -->
              <svg class="w-24 sm:w-32 h-20 sm:h-24 transform -rotate-12 drop-shadow-xs" viewBox="0 0 100 80" fill="none">
                <!-- Stem in Antique Gold -->
                <path d="M 95 10 C 70 12, 45 25, 20 50 C 12 60, 5 75, 2 80" stroke="#B89352" stroke-width="1.6" stroke-linecap="round" />
                <!-- Leaf Pairs in Rich Forest & Emerald Olive -->
                <path d="M 95 10 C 82 2, 68 5, 62 14 C 74 18, 88 16, 95 10 Z" fill="#445D3C" stroke="#243420" stroke-width="0.6" />
                <path d="M 95 10 Q 78 12 68 12" stroke="#EBF4E8" stroke-width="0.5" opacity="0.6" />
                <path d="M 78 14 C 68 6, 52 10, 48 20 C 58 24, 72 20, 78 14 Z" fill="#5E7C54" stroke="#2A3C26" stroke-width="0.6" />
                <path d="M 78 14 Q 62 16 54 18" stroke="#EBF4E8" stroke-width="0.5" opacity="0.6" />
                <path d="M 64 22 C 58 32, 44 38, 38 30 C 44 22, 58 18, 64 22 Z" fill="#3B4F33" stroke="#202E1B" stroke-width="0.6" />
                <path d="M 50 26 C 40 18, 28 24, 25 34 C 34 38, 46 34, 50 26 Z" fill="#6B8A61" stroke="#2A3C26" stroke-width="0.6" />
                <path d="M 36 38 C 30 48, 18 52, 14 44 C 20 36, 32 34, 36 38 Z" fill="#445D3C" stroke="#243420" stroke-width="0.6" />
                <path d="M 24 48 C 16 42, 6 48, 4 58 C 12 62, 22 56, 24 48 Z" fill="#55704A" stroke="#243420" stroke-width="0.6" />
                <circle cx="68" cy="24" r="2.2" fill="#D4AF37" />
                <circle cx="42" cy="38" r="1.8" fill="#D4AF37" />
              </svg>

              <!-- Right Arching Olive Branch -->
              <svg class="w-24 sm:w-32 h-20 sm:h-24 transform rotate-12 scale-x-[-1] drop-shadow-xs" viewBox="0 0 100 80" fill="none">
                <!-- Stem in Antique Gold -->
                <path d="M 95 10 C 70 12, 45 25, 20 50 C 12 60, 5 75, 2 80" stroke="#B89352" stroke-width="1.6" stroke-linecap="round" />
                <!-- Leaf Pairs in Rich Forest & Emerald Olive -->
                <path d="M 95 10 C 82 2, 68 5, 62 14 C 74 18, 88 16, 95 10 Z" fill="#445D3C" stroke="#243420" stroke-width="0.6" />
                <path d="M 95 10 Q 78 12 68 12" stroke="#EBF4E8" stroke-width="0.5" opacity="0.6" />
                <path d="M 78 14 C 68 6, 52 10, 48 20 C 58 24, 72 20, 78 14 Z" fill="#5E7C54" stroke="#2A3C26" stroke-width="0.6" />
                <path d="M 78 14 Q 62 16 54 18" stroke="#EBF4E8" stroke-width="0.5" opacity="0.6" />
                <path d="M 64 22 C 58 32, 44 38, 38 30 C 44 22, 58 18, 64 22 Z" fill="#3B4F33" stroke="#202E1B" stroke-width="0.6" />
                <path d="M 50 26 C 40 18, 28 24, 25 34 C 34 38, 46 34, 50 26 Z" fill="#6B8A61" stroke="#2A3C26" stroke-width="0.6" />
                <path d="M 36 38 C 30 48, 18 52, 14 44 C 20 36, 32 34, 36 38 Z" fill="#445D3C" stroke="#243420" stroke-width="0.6" />
                <path d="M 24 48 C 16 42, 6 48, 4 58 C 12 62, 22 56, 24 48 Z" fill="#55704A" stroke="#243420" stroke-width="0.6" />
                <circle cx="68" cy="24" r="2.2" fill="#D4AF37" />
                <circle cx="42" cy="38" r="1.8" fill="#D4AF37" />
              </svg>
            </div>

            <!-- Botanical Corner Ginkgo Sprigs at Lower Base (Vibrant Rich Green & Gold) -->
            <FloralCorner position="bottom-left" size={88} className="absolute -bottom-1 -left-1 opacity-90 pointer-events-none block drop-shadow-xs" />
            <FloralCorner position="bottom-right" size={88} className="absolute -bottom-1 -right-1 opacity-90 pointer-events-none block drop-shadow-xs" />

            <!-- Arch Crown: Overline & Gilded Botanical Finial -->
            <div class="flex flex-col items-center justify-center mb-2 relative z-10">
              <span class="text-overline tracking-[0.34em] text-[0.55rem] sm:text-[0.62rem] text-[#B89352] uppercase font-semibold mb-1">
                AYAT SUCI AL-QUR'AN
              </span>
              
              <!-- Royal Architectural Crown Finial with Rich Emerald & Olive Foliage -->
              <svg class="w-44 sm:w-52 h-10 sm:h-11 text-[#B89352] mb-1.5 drop-shadow-xs" viewBox="0 0 180 36" fill="none">
                <defs>
                  <linearGradient id="crownGoldGrad" x1="0%" y1="0%" x2="100%" y2="0%">
                    <stop offset="0%" stop-color="#9A7836" />
                    <stop offset="25%" stop-color="#D4AF37" />
                    <stop offset="50%" stop-color="#F0D698" />
                    <stop offset="75%" stop-color="#D4AF37" />
                    <stop offset="100%" stop-color="#9A7836" />
                  </linearGradient>
                  <linearGradient id="finialLeafDark" x1="0%" y1="0%" x2="100%" y2="100%">
                    <stop offset="0%" stop-color="#2D3E27" />
                    <stop offset="100%" stop-color="#49633F" />
                  </linearGradient>
                  <linearGradient id="finialLeafLight" x1="0%" y1="0%" x2="100%" y2="100%">
                    <stop offset="0%" stop-color="#4F6A44" />
                    <stop offset="100%" stop-color="#739467" />
                  </linearGradient>
                </defs>

                <!-- Center Star Crest (✦) -->
                <path d="M 90 4 Q 90 14 84 14 Q 90 14 90 24 Q 90 14 96 14 Q 90 14 90 4 Z" fill="url(#crownGoldGrad)" />
                <circle cx="90" cy="14" r="1.6" fill="#FAF8F5" />
                
                <!-- Left Arching Foliage Swash -->
                <path d="M 82 14 C 64 14, 46 8, 26 18 C 16 23, 6 19, 8 13 C 10 7, 20 10, 26 15" stroke="url(#crownGoldGrad)" stroke-width="1.3" stroke-linecap="round" />
                <path d="M 68 12 C 64 6, 54 7, 52 12 C 56 15, 65 15, 68 12 Z" fill="url(#finialLeafLight)" stroke="#202F1C" stroke-width="0.5" />
                <path d="M 44 12 C 37 18, 29 17, 27 12 C 31 9, 39 9, 44 12 Z" fill="url(#finialLeafDark)" stroke="#202F1C" stroke-width="0.5" />
                <path d="M 58 16 C 52 23, 42 22, 40 17 C 46 14, 54 14, 58 16 Z" fill="url(#finialLeafDark)" stroke="#202F1C" stroke-width="0.5" />
                <circle cx="26" cy="15" r="1.8" fill="#D4AF37" />
                <circle cx="58" cy="16" r="1.4" fill="#D4AF37" />

                <!-- Right Arching Foliage Swash -->
                <path d="M 98 14 C 116 14, 134 8, 154 18 C 164 23, 174 19, 172 13 C 170 7, 160 10, 154 15" stroke="url(#crownGoldGrad)" stroke-width="1.3" stroke-linecap="round" />
                <path d="M 112 12 C 116 6, 126 7, 128 12 C 124 15, 115 15, 112 12 Z" fill="url(#finialLeafLight)" stroke="#202F1C" stroke-width="0.5" />
                <path d="M 136 12 C 143 18, 151 17, 153 12 C 149 9, 141 9, 136 12 Z" fill="url(#finialLeafDark)" stroke="#202F1C" stroke-width="0.5" />
                <path d="M 122 16 C 128 23, 138 22, 140 17 C 134 14, 126 14, 122 16 Z" fill="url(#finialLeafDark)" stroke="#202F1C" stroke-width="0.5" />
                <circle cx="154" cy="15" r="1.8" fill="#D4AF37" />
                <circle cx="122" cy="16" r="1.4" fill="#D4AF37" />
              </svg>
            </div>

            <!-- Sacred Bismillah in Rich Royal Emerald-Olive -->
            <p id="verse-bismillah" class="font-arabic text-2xl sm:text-3xl text-[#2F3D2A] mb-3 sm:mb-4 drop-shadow-xs will-change-transform relative z-10" dir="rtl" lang="ar">
              {content.opening.bismillah}
            </p>

            <!-- Sacred Arabic Verse -->
            <div id="verse-content-block" class="w-full flex flex-col items-center text-center px-1 sm:px-3 will-change-transform relative z-10">
              <blockquote lang="ar" dir="rtl" class="font-arabic text-xl sm:text-2xl md:text-[1.65rem] sm:leading-[2.4] md:leading-[2.5] text-[#1E261A] leading-loose max-w-lg mx-auto drop-shadow-xs selection:bg-[#B89352]/20">
                {content.opening.verse} <span class="inline-block text-[#B89352] text-sm sm:text-base mr-1 select-none font-serif">۝</span>
              </blockquote>

              <!-- Whispered Floral Flourish Divider -->
              <div class="my-3.5 sm:my-4 flex items-center justify-center opacity-85">
                <FloralFlourish width={150} height={18} />
              </div>

              <!-- Indonesian Translation -->
              <p class="text-xs sm:text-[0.84rem] text-[#3F5237] font-light leading-relaxed max-w-md mx-auto italic font-serif px-1">
                &ldquo;{content.opening.translation}&rdquo;
              </p>

              <!-- Classical Surah Citation -->
              <div class="mt-3.5 flex items-center justify-center gap-2.5">
                <span class="w-8 sm:w-14 h-[1px] bg-gradient-to-r from-transparent to-[#B89352]/60"></span>
                <span class="font-display tracking-[0.32em] text-[0.62rem] sm:text-[0.68rem] text-[#B89352] uppercase font-semibold">
                  {content.opening.source}
                </span>
                <span class="w-8 sm:w-14 h-[1px] bg-gradient-to-l from-transparent to-[#B89352]/60"></span>
              </div>
            </div>

            <!-- Editorial Greeting Sentence (Elegantly Integrated into Pedestal) -->
            <div class="mt-4 sm:mt-5 pt-3.5 border-t border-[#B89352]/25 max-w-sm sm:max-w-md mx-auto relative z-10">
              <p id="verse-greeting" class="text-[0.65rem] sm:text-[0.72rem] text-[#6E8564] font-light leading-relaxed italic will-change-transform">
                {content.opening.greeting}
              </p>
            </div>

          </div>

        </div>
      </section>

      <!-- ===================================================================
           SCENE 3: KEDUA MEMPELAI (DIFA & ZHARKASI) (Z: -850 -> 0 Crisp landing)
           =================================================================== -->
      <section 
        id="scene-couple" 
        class="scene-3d absolute inset-0 flex flex-col items-center justify-center px-4 py-6 text-center will-change-transform opacity-0 pointer-events-none"
        style="transform: translate3d(0, 0, -850px); transform-style: preserve-3d;"
        aria-label="Profil Kedua Mempelai"
      >
        <!-- THEMATIC SCENE 3 CORNERS: Groom's Olive Branch & Bride's Blush Peony Ribbon Flanks -->
        <div class="couple-thematic-flanks absolute inset-0 pointer-events-none z-0 overflow-hidden select-none" aria-hidden="true">
          <!-- Left: Zharkasi's Masculine Olive & Laurel Flank (GSAP target: #couple-flank-left) -->
          <div id="couple-flank-left" class="absolute top-8 left-2 sm:left-6 md:left-10 lg:left-16 opacity-85 will-change-transform">
            <svg width="140" height="140" viewBox="0 0 100 100" fill="none" class="w-18 sm:w-26 md:w-32 lg:w-36 h-auto text-[#566A4E] drop-shadow-sm">
              <path d="M 10 90 C 25 70, 35 45, 55 20 C 65 10, 80 5, 95 2" stroke="#566A4E" stroke-width="1.6" stroke-linecap="round" />
              <path d="M 25 70 C 15 62, 10 50, 18 42 C 28 46, 32 58, 25 70 Z" fill="#5E7C54" />
              <path d="M 38 52 C 28 44, 25 32, 34 26 C 42 32, 44 44, 38 52 Z" fill="#445D3C" />
              <path d="M 52 35 C 44 26, 42 15, 52 10 C 60 16, 60 28, 52 35 Z" fill="#5E7C54" />
              <circle cx="28" cy="46" r="2.5" fill="#D4AF37" />
              <circle cx="44" cy="28" r="2.2" fill="#D4AF37" />
            </svg>
          </div>

          <!-- Right: Difa's Feminine Blush Peony & Flowing Ribbon Flank (GSAP target: #couple-flank-right) -->
          <div id="couple-flank-right" class="absolute top-8 right-2 sm:right-6 md:right-10 lg:right-16 opacity-85 will-change-transform scale-x-[-1]">
            <svg width="140" height="140" viewBox="0 0 100 100" fill="none" class="w-18 sm:w-26 md:w-32 lg:w-36 h-auto text-[#EAA194] drop-shadow-sm">
              <path d="M 10 90 C 25 70, 35 45, 55 20 C 65 10, 80 5, 95 2" stroke="#B89352" stroke-width="1.4" stroke-linecap="round" />
              <circle cx="25" cy="62" r="12" fill="#FFEAE6" stroke="#EAA194" stroke-width="0.8" />
              <circle cx="23" cy="60" r="7" fill="#F8C4AD" />
              <circle cx="45" cy="40" r="10" fill="#FFEAE6" stroke="#EAA194" stroke-width="0.8" />
              <circle cx="43" cy="38" r="6" fill="#F8C4AD" />
              <path d="M 25 74 C 35 85, 45 78, 55 92" stroke="#EAA194" stroke-width="1" stroke-dasharray="3 2" fill="none" />
            </svg>
          </div>

          <!-- Intertwined Gilded Wedding Ring Accent in Bottom Corners (GSAP targets: #couple-rings-left, #couple-rings-right) -->
