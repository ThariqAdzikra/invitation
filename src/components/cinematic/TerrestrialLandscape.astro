---
// TerrestrialLandscape.astro — Lembah Asri Minangkabau & Muara Danau Senja
// Continuous Multilayer Parallax Garden Stage (Mountains, Riverway, Trees & Sunset Lake)
---

<div id="terrestrial-landscape-stage" class="absolute inset-0 pointer-events-none z-0 overflow-hidden select-none" aria-hidden="true">

  <!-- =========================================================================
       LAYER 0: AUTHENTIC WATERCOLOR MINANGKABAU MOUNTAIN HORIZON
       (Bukit Barisan / Lembah Harau berkabut emas - High-Resolution Artwork)
       ========================================================================= -->
  <div 
    id="landscape-mountains-wrap" 
    class="absolute top-0 inset-x-0 h-[85vh] min-h-[520px] max-h-[880px] opacity-75 will-change-transform pointer-events-none overflow-hidden flex items-start justify-center"
  >
    <!-- Soft Mist Gradient blending into top -->
    <div class="absolute inset-0 bg-gradient-to-b from-[#FAF8F5]/0 via-[#F5EFE6]/25 to-[#FAF8F5] pointer-events-none z-10"></div>

    <img 
      src="/assets/watercolor-valley-mountains.webp" 
      alt="" 
      class="w-full max-w-6xl h-auto object-contain object-top drop-shadow-sm select-none pointer-events-none" 
      loading="eager"
      decoding="async"
    />

    <!-- Gliding Swallows (Burung Walet Minangkabau) soaring peacefully in the mountain sky -->
    <div id="landscape-swallows" class="absolute top-16 sm:top-20 left-[18%] sm:left-[26%] w-56 h-20 opacity-70 will-change-transform z-20">
      <svg class="w-full h-full" viewBox="0 0 240 80" fill="none">
        <!-- Bird 1 (Leader) -->
        <path d="M 40 25 Q 46 20 54 24 Q 48 26 44 26 Q 40 28 36 34 Q 38 27 40 25 Z" fill="#4A5D43" />
        <path d="M 54 24 Q 60 20 68 25 Q 60 26 55 26 Q 52 28 48 34 Q 50 27 54 24 Z" fill="#4A5D43" />
        
        <!-- Bird 2 (Companion, lower left) -->
        <path d="M 12 45 Q 16 41 22 44 Q 18 46 15 46 Q 12 47 9 52 Q 10 47 12 45 Z" fill="#6E8564" opacity="0.85" />
        <path d="M 22 44 Q 27 41 33 45 Q 27 46 23 46 Q 21 47 18 52 Q 19 47 22 44 Z" fill="#6E8564" opacity="0.85" />

        <!-- Bird 3 (Distant high right) -->
        <path d="M 160 12 Q 164 8 170 11 Q 166 13 163 13 Q 160 14 157 18 Q 158 14 160 12 Z" fill="#6E8564" opacity="0.75" />
        <path d="M 170 11 Q 174 8 180 12 Q 174 13 171 13 Q 169 14 166 18 Q 167 14 170 11 Z" fill="#6E8564" opacity="0.75" />
      </svg>
    </div>
  </div>

  <!-- =========================================================================
       LAYER 1: AUTHENTIC WATERCOLOR OVERHANGING BOTANICAL CANOPY
       Romantic weeping willow, olive branches, and blush roses framing the top edges
       Pushed up to gracefully frame the screen without cluttering the center card
       ========================================================================= -->
  <div 
    id="landscape-trees-wrap" 
    class="absolute -top-32 sm:-top-48 md:-top-60 lg:-top-72 inset-x-0 w-full flex justify-center opacity-85 will-change-transform pointer-events-none z-10"
  >
    <img 
      src="/assets/watercolor-overhanging-trees.webp" 
      alt="" 
      class="w-full max-w-[1500px] h-auto object-contain object-top drop-shadow-md select-none pointer-events-none" 
      loading="eager"
      decoding="async"
    />
  </div>

  <!-- =========================================================================
       LAYER 2: THE SHIMMERING SACRED RIVERWAY (Aliran Sungai Suci Lembah Asri)
       Organic meandering river flowing gracefully along the landscape margins
       past the event pavilions and opening into the sunset lake!
       ========================================================================= -->
  <div 
    id="landscape-riverway-wrap" 
    class="absolute inset-0 w-full h-full opacity-65 will-change-transform pointer-events-none z-0"
  >
    <svg class="w-full h-full" viewBox="0 0 1440 2600" fill="none" preserveAspectRatio="none">
      <defs>
        <!-- Shimmering River Stream Gradient (Jade Emerald, Mountain Spring & Golden Sunlight Caustics) -->
        <linearGradient id="riverStreamGrad" x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" stop-color="#8DB094" stop-opacity="0.35" />
          <stop offset="30%" stop-color="#E5C778" stop-opacity="0.50" />
          <stop offset="65%" stop-color="#70967C" stop-opacity="0.40" />
          <stop offset="100%" stop-color="#E28E46" stop-opacity="0.55" />
        </linearGradient>

        <linearGradient id="riverShimmerLine" x1="0%" y1="0%" x2="0%" y2="100%">
          <stop offset="0%" stop-color="#FFFFFF" stop-opacity="0.80" />
          <stop offset="50%" stop-color="#F3DE98" stop-opacity="0.75" />
          <stop offset="100%" stop-color="#FED7AA" stop-opacity="0.85" />
        </linearGradient>

        <linearGradient id="lakeWaterGrad" x1="0%" y1="0%" x2="0%" y2="100%">
          <stop offset="0%" stop-color="#D4B483" stop-opacity="0.30" />
          <stop offset="50%" stop-color="#E89B55" stop-opacity="0.48" />
          <stop offset="100%" stop-color="#C25E1A" stop-opacity="0.25" />
        </linearGradient>
      </defs>

      <!-- Main Meandering River Channel: Flows gracefully along the left landscape margin -->
      <path 
        id="river-channel"
        d="M 120 120 
           C 50 380, 180 620, 100 880 
           C 50 1140, 260 1380, 180 1620 
           C 120 1860, 480 2080, 720 2360" 
        stroke="url(#riverStreamGrad)" 
        stroke-width="48" 
        stroke-linecap="round"
        stroke-linejoin="round"
        class="filter blur-sm"
      />

      <!-- Glimmering Center River Current Line (Glittering Stream) -->
      <path 
        id="river-current-glimmer"
        d="M 120 120 
           C 50 380, 180 620, 100 880 
           C 50 1140, 260 1380, 180 1620 
           C 120 1860, 480 2080, 720 2360" 
        stroke="url(#riverShimmerLine)" 
        stroke-width="2.2" 
        stroke-linecap="round"
        stroke-dasharray="14 22"
        opacity="0.75"
      />

      <!-- Riverbank Pebbles & Delicate Water Lily Lotus Pads along margin -->
      <circle cx="140" cy="480" r="10" fill="#6A805E" opacity="0.3" />
      <circle cx="160" cy="500" r="8" fill="#8FA885" opacity="0.35" />
      <ellipse cx="145" cy="465" rx="14" ry="6" fill="#566A4E" opacity="0.25" />

      <ellipse cx="210" cy="1480" rx="16" ry="8" fill="#566A4E" opacity="0.28" />
      <circle cx="230" cy="1500" r="10" fill="#7E8F77" opacity="0.3" />

      <!-- Expanding Sunset Lake Basin at Bottom (Closing Sanctuary Basin) -->
      <path 
        d="M 0 2150 C 360 2050, 1080 2050, 1440 2150 L 1440 2600 L 0 2600 Z" 
        fill="url(#lakeWaterGrad)" 
        class="filter blur-sm"
      />

      <!-- Concentric Sunset Water Ripples on Lake Surface (Under Romantic Swans) -->
      <ellipse cx="720" cy="2360" rx="280" ry="22" stroke="#EEAF73" stroke-width="1.2" opacity="0.45" stroke-dasharray="6 8" />
      <ellipse cx="720" cy="2390" rx="380" ry="28" stroke="#D4AF37" stroke-width="1.4" opacity="0.40" stroke-dasharray="8 12" />
      <ellipse cx="720" cy="2430" rx="490" ry="36" stroke="#EEAF73" stroke-width="1.2" opacity="0.35" stroke-dasharray="10 16" />
      <ellipse cx="720" cy="2480" rx="600" ry="45" stroke="#C27838" stroke-width="1.0" opacity="0.25" stroke-dasharray="12 20" />
    </svg>
  </div>

  <!-- =========================================================================
       LAYER 3: FLANKING BOTANICAL GARDEN ACCENTS (Depth Framing)
       ========================================================================= -->
  <!-- Left Garden Foliage Spray (Upper) -->
  <div id="foliage-spray-left" class="absolute top-[22%] -left-8 sm:-left-4 w-32 sm:w-44 h-80 opacity-60 will-change-transform z-10">
    <svg class="w-full h-full" viewBox="0 0 120 280" fill="none">
      <path d="M 10 260 C 25 180, 50 120, 95 30" stroke="#7E8F77" stroke-width="1.4" stroke-dasharray="2 3" />
      <path d="M 40 180 C 15 170, 10 145, 35 150 C 50 155, 45 175, 40 180 Z" fill="#566A4E" opacity="0.7" />
      <path d="M 65 110 C 40 100, 35 75, 60 80 C 75 85, 70 105, 65 110 Z" fill="#6E8564" opacity="0.65" />
      <path d="M 85 45 C 65 35, 60 15, 80 20 C 95 25, 90 40, 85 45 Z" fill="#566A4E" opacity="0.7" />
      <circle cx="38" cy="148" r="2.2" fill="#D4AF37" opacity="0.8" />
      <circle cx="63" cy="78" r="1.8" fill="#D4AF37" opacity="0.8" />
    </svg>
  </div>

  <!-- Right Garden Foliage Spray (Mid, near Location) -->
  <div id="foliage-spray-right" class="absolute top-[54%] -right-8 sm:-right-4 w-32 sm:w-44 h-80 opacity-60 will-change-transform scale-x-[-1] z-10">
    <svg class="w-full h-full" viewBox="0 0 120 280" fill="none">
      <path d="M 10 260 C 25 180, 50 120, 95 30" stroke="#7E8F77" stroke-width="1.4" stroke-dasharray="2 3" />
      <path d="M 40 180 C 15 170, 10 145, 35 150 C 50 155, 45 175, 40 180 Z" fill="#566A4E" opacity="0.7" />
      <path d="M 65 110 C 40 100, 35 75, 60 80 C 75 85, 70 105, 65 110 Z" fill="#6E8564" opacity="0.65" />
      <path d="M 85 45 C 65 35, 60 15, 80 20 C 95 25, 90 40, 85 45 Z" fill="#566A4E" opacity="0.7" />
      <circle cx="38" cy="148" r="2.2" fill="#D4AF37" opacity="0.8" />
      <circle cx="63" cy="78" r="1.8" fill="#D4AF37" opacity="0.8" />
    </svg>
  </div>

</div>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  function initTerrestrialLandscape() {
    const stage = document.getElementById('interactive-stage');
    const mountains = document.getElementById('landscape-mountains-wrap');
    const trees = document.getElementById('landscape-trees-wrap');
    const swallows = document.getElementById('landscape-swallows');
    const riverWrap = document.getElementById('landscape-riverway-wrap');
    const riverGlimmer = document.getElementById('river-current-glimmer');
    const foliageL = document.getElementById('foliage-spray-left');
    const foliageR = document.getElementById('foliage-spray-right');

    if (!stage) return;

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReducedMotion) return;

    // 1. Mountain Ridges Parallax (Slow, majestic vertical descent)
    if (mountains) {
      gsap.to(mountains, {
        y: 100,
        ease: 'none',
        scrollTrigger: {
          trigger: stage,
          start: 'top bottom',
          end: 'bottom top',
          scrub: 1.5,
        }
      });
    }

    // 2. Overhanging Tree Canopy Gentle Breathing Parallax
    if (trees) {
      gsap.to(trees, {
        y: 40,
        scale: 1.02,
        ease: 'none',
        scrollTrigger: {
          trigger: stage,
          start: 'top 80%',
          end: 'top top',
          scrub: 1.2,
        }
      });
    }

    // 3. Swallows Soaring across the Mountain Sky
    if (swallows) {
      gsap.to(swallows, {
        x: 160,
        y: -30,
        ease: 'none',
        scrollTrigger: {
          trigger: stage,
          start: 'top 80%',
          end: 'top 20%',
          scrub: 2,
        }
      });
    }

    // 4. River Flow Motion & Shimmering Current
    if (riverGlimmer) {
      gsap.to(riverGlimmer, {
        strokeDashoffset: -320,
        duration: 8,
        repeat: -1,
        ease: 'linear',
      });
    }

    if (riverWrap) {
      gsap.to(riverWrap, {
        y: -60,
        ease: 'none',
        scrollTrigger: {
          trigger: stage,
          start: 'top bottom',
          end: 'bottom bottom',
          scrub: 1.2,
        }
      });
    }

    // 5. Botanical Foliage Gentle Wind Sway
    if (foliageL && foliageR) {
      gsap.to(foliageL, {
        rotation: 2.0,
        y: -25,
        ease: 'none',
        scrollTrigger: {
          trigger: foliageL,
          start: 'top bottom',
          end: 'bottom top',
          scrub: 1.8,
        }
      });

      gsap.to(foliageR, {
        rotation: -2.0,
        y: -25,
        ease: 'none',
        scrollTrigger: {
          trigger: foliageR,
          start: 'top bottom',
          end: 'bottom top',
          scrub: 1.8,
        }
      });
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initTerrestrialLandscape);
  } else {
    initTerrestrialLandscape();
  }
</script>
