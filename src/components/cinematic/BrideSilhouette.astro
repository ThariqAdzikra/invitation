---
// BrideSilhouette.astro — Artistic Bride Portrait Silhouette in Roman Arched Frame
interface Props {
  size?: number;
  className?: string;
}

const { size = 180, className = "" } = Astro.props;
---

<div class={`relative flex items-center justify-center select-none ${className}`} aria-hidden="true">
  <svg
    width={size}
    height={size * 1.25}
    viewBox="0 0 160 200"
    fill="none"
    class="w-full h-auto max-w-[180px] drop-shadow-[0_8px_20px_rgba(42,52,38,0.1)]"
  >
    <defs>
      <radialGradient id="bride-glow" cx="50%" cy="45%" r="60%">
        <stop offset="0%" stop-color="#FFFDF7" stop-opacity="0.95" />
        <stop offset="60%" stop-color="#F4EFE3" stop-opacity="0.9" />
        <stop offset="100%" stop-color="#E8E0CE" stop-opacity="0.85" />
      </radialGradient>

      <linearGradient id="bride-sil" x1="0%" y1="0%" x2="0%" y2="100%">
        <stop offset="0%" stop-color="#2D3B29" />
        <stop offset="100%" stop-color="#1A2217" />
      </linearGradient>

      <linearGradient id="bride-veil-grad" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" stop-color="#FFFFFF" stop-opacity="0.8" />
        <stop offset="100%" stop-color="#EAE3D3" stop-opacity="0.3" />
      </linearGradient>
    </defs>

    <!-- Arched Backplate Frame -->
    <path
      d="M 15 190 L 15 75 A 65 65 0 0 1 145 75 L 145 190 Z"
      fill="url(#bride-glow)"
      stroke="#D5CCA8"
      stroke-width="1.2"
    />
    <path
      d="M 22 186 L 22 76 A 58 58 0 0 1 138 76 L 138 186 Z"
      fill="none"
      stroke="#B89352"
      stroke-width="0.8"
      stroke-dasharray="3 2"
      opacity="0.75"
    />

    <!-- Translucent Flowing Veil (Layered Behind & Down Back) -->
    <path
      d="M 75 42 C 92 46, 120 72, 126 120 C 130 160, 132 185, 134 190 L 80 190 C 105 160, 108 115, 96 75 C 92 56, 84 48, 75 42 Z"
      fill="url(#bride-veil-grad)"
      stroke="rgba(255,255,255,0.7)"
      stroke-width="0.7"
    />

    <!-- Bride Head / Hair Bun & Tiara Profile -->
    <path
      d="M 68 52 C 72 42, 84 42, 88 50 C 91 58, 88 65, 80 70 C 78 75, 75 78, 68 80 C 64 77, 63 70, 65 64 C 62 60, 62 55, 68 52 Z"
      fill="url(#bride-sil)"
    />

    <!-- Floral Headpiece on Veil -->
    <circle cx="82" cy="46" r="2.5" fill="#FAF8F5" stroke="#B89352" stroke-width="0.8" />
    <circle cx="77" cy="48" r="1.8" fill="#B89352" />
    <circle cx="86" cy="48" r="1.8" fill="#B89352" />

    <!-- Bride Neck & Wedding Gown Shoulders -->
    <path
      d="M 68 80 C 58 90, 48 110, 44 140 C 40 168, 38 185, 37 190 L 123 190 C 122 185, 120 168, 114 140 C 108 115, 96 95, 84 82 Z"
      fill="url(#bride-sil)"
    />

    <!-- Bridal Bouquet Held at Waist -->
    <g transform="translate(62, 145)">
      <circle cx="18" cy="10" r="5.5" fill="#FAF6EE" stroke="#566A4E" stroke-width="0.8" />
      <circle cx="18" cy="10" r="2.5" fill="#B89352" />
      <circle cx="10" cy="16" r="4.5" fill="#FAF6EE" stroke="#566A4E" stroke-width="0.8" />
      <circle cx="26" cy="15" r="4.5" fill="#FAF6EE" stroke="#566A4E" stroke-width="0.8" />
      <path d="M 5 8 C 1 5, 0 1, 4 -1 C 7 1, 8 5, 5 8 Z" fill="#5E7455" />
      <path d="M 30 8 C 34 5, 35 1, 31 -1 C 28 1, 27 5, 30 8 Z" fill="#5E7455" />
      <path d="M 18 18 Q 16 32 14 36 M 20 18 Q 22 32 24 36" stroke="#B89352" stroke-width="1.2" />
    </g>

    <!-- Olive Sprig Framing Bottom -->
    <path d="M 35 185 C 55 178, 105 178, 125 185" stroke="#566A4E" stroke-width="1.2" />
    <circle cx="80" cy="180" r="2" fill="#B89352" />
  </svg>
</div>