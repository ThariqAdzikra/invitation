---
// CoupleHeroSilhouette.astro — Grand Prewedding Couple Artistic Silhouette under Botanical Arch
interface Props {
  className?: string;
  size?: number;
}

const { className = "", size = 320 } = Astro.props;
---

<div class={`relative flex items-center justify-center select-none ${className}`} aria-hidden="true">
  
  <!-- Outer Soft Halo Glow -->
  <div class="absolute inset-0 rounded-full bg-[#B89352]/15 blur-2xl pointer-events-none transform scale-90"></div>

  <!-- SVG Artwork Container -->
  <svg
    width={size}
    height={size * 1.25}
    viewBox="0 0 320 400"
    fill="none"
    class="w-full h-auto max-w-[320px] sm:max-w-[360px] drop-shadow-[0_12px_28px_rgba(42,52,38,0.14)]"
  >
    <defs>
      <!-- Warm Backlight Glow Gradient -->
      <radialGradient id="arch-glow" cx="50%" cy="45%" r="55%">
        <stop offset="0%" stop-color="#FFFDF7" stop-opacity="0.95" />
        <stop offset="60%" stop-color="#F4EFE3" stop-opacity="0.9" />
        <stop offset="100%" stop-color="#E8E0CE" stop-opacity="0.85" />
      </radialGradient>

      <!-- Silhouette Deep Olive Charcoal Gradient -->
      <linearGradient id="silhouette-grad" x1="0%" y1="0%" x2="0%" y2="100%">
        <stop offset="0%" stop-color="#2D3B29" />
        <stop offset="100%" stop-color="#1F281C" />
      </linearGradient>

      <!-- Translucent Veil Gradient -->
      <linearGradient id="veil-grad" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" stop-color="#FFFFFF" stop-opacity="0.75" />
        <stop offset="100%" stop-color="#EAE3D3" stop-opacity="0.25" />
      </linearGradient>

      <!-- Gold Accent Gradient -->
      <linearGradient id="gold-stroke" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" stop-color="#D4AF37" />
        <stop offset="100%" stop-color="#A67C2E" />
      </linearGradient>
    </defs>

    <!-- ARCHED WINDOW BACKGROUND -->
    <!-- Arched Backplate -->
    <path
      d="M 30 380 L 30 160 A 130 130 0 0 1 290 160 L 290 380 Z"
      fill="url(#arch-glow)"
      stroke="#D5CCA8"
      stroke-width="1.2"
    />

    <!-- Inner Arched Hairline Frame (Double Arch) -->
    <path
      d="M 40 375 L 40 162 A 120 120 0 0 1 280 162 L 280 375 Z"
      fill="none"
      stroke="url(#gold-stroke)"
      stroke-width="0.9"
      stroke-dasharray="4 2"
      opacity="0.7"
    />

    <!-- Sunbeam / Light Beam Lines from Center -->
    <g opacity="0.35" stroke="#B89352" stroke-width="0.6">
      <line x1="160" y1="140" x2="160" y2="40" />
      <line x1="160" y1="140" x2="220" y2="55" />
      <line x1="160" y1="140" x2="100" y2="55" />
      <line x1="160" y1="140" x2="250" y2="90" />
      <line x1="160" y1="140" x2="70" y2="90" />
    </g>

    <!-- BOTANICAL VINE CLIMBING THE ARCH -->
    <!-- Left Arch Vine -->
    <path
      d="M 30 360 C 25 280, 20 180, 80 100 C 110 60, 140 40, 160 38"
      stroke="#4A5D43"
      stroke-width="1.8"
      stroke-linecap="round"
    />
    <!-- Left Vine Leaves -->
    <path d="M 28 320 C 18 315, 18 305, 26 304 C 32 308, 32 318, 28 320 Z" fill="#5E7455" />
    <path d="M 26 270 C 16 265, 18 255, 26 254 C 31 259, 30 268, 26 270 Z" fill="#4A5C43" />
    <path d="M 32 220 C 22 212, 25 200, 34 200 C 39 207, 37 218, 32 220 Z" fill="#6E8564" />
    <path d="M 45 160 C 36 150, 42 138, 50 140 C 54 148, 51 158, 45 160 Z" fill="#5E7455" />
    <path d="M 75 105 C 68 95, 78 85, 85 88 C 88 96, 82 104, 75 105 Z" fill="#4A5C43" />
    <path d="M 115 65 C 110 55, 122 48, 128 52 C 129 60, 122 66, 115 65 Z" fill="#6E8564" />
    <circle cx="28" cy="290" r="2.2" fill="#B89352" />
    <circle cx="36" cy="185" r="2.2" fill="#B89352" />
    <circle cx="95" cy="80" r="2.2" fill="#B89352" />

    <!-- Right Arch Vine -->
    <path
      d="M 290 360 C 295 280, 300 180, 240 100 C 210 60, 180 40, 160 38"
      stroke="#4A5D43"
      stroke-width="1.8"
      stroke-linecap="round"
    />
    <!-- Right Vine Leaves -->
    <path d="M 292 320 C 302 315, 302 305, 294 304 C 288 308, 288 318, 292 320 Z" fill="#5E7455" />
    <path d="M 294 270 C 304 265, 302 255, 294 254 C 289 259, 290 268, 294 270 Z" fill="#4A5C43" />
    <path d="M 288 220 C 298 212, 295 200, 286 200 C 281 207, 283 218, 288 220 Z" fill="#6E8564" />
    <path d="M 275 160 C 284 150, 278 138, 270 140 C 266 148, 269 158, 275 160 Z" fill="#5E7455" />
    <path d="M 245 105 C 252 95, 242 85, 235 88 C 232 96, 238 104, 245 105 Z" fill="#4A5C43" />
    <path d="M 205 65 C 210 55, 198 48, 192 52 C 191 60, 198 66, 205 65 Z" fill="#6E8564" />
    <circle cx="292" cy="290" r="2.2" fill="#B89352" />
    <circle cx="284" cy="185" r="2.2" fill="#B89352" />
    <circle cx="225" cy="80" r="2.2" fill="#B89352" />

    <!-- Arch Keystone Blossom at Top Peak -->
    <g transform="translate(160, 38)">
      <circle cx="0" cy="0" r="10" fill="#FAF6EE" stroke="#B89352" stroke-width="1.2" />
      <circle cx="0" cy="0" r="4" fill="#B89352" />
      <path d="M -8 -4 C -12 -10, -6 -14, 0 -11 C 6 -14, 12 -10, 8 -4 Z" fill="#5E7455" />
    </g>

    <!-- ARTISTIC COUPLE SILHOUETTES -->

    <!-- GROOM (Left Subject) -->
    <!-- Head / Profile -->
    <path
      d="M 125 152 C 122 144, 126 132, 137 130 C 145 129, 151 135, 150 145 C 149 152, 145 156, 140 157 C 141 162, 143 168, 146 172 C 137 172, 131 168, 129 162 C 124 160, 123 155, 125 152 Z"
      fill="url(#silhouette-grad)"
    />
    <!-- Groom Hair & Forehead Line -->
    <path
      d="M 125 142 C 127 134, 135 128, 144 128 C 149 128, 153 133, 151 138 C 146 137, 136 139, 132 144 Z"
      fill="#1A2217"
    />
    <!-- Groom Necktie / Collar Accent Gold -->
    <polygon points="137,175 141,173 140,186 138,186" fill="#B89352" opacity="0.85" />
    <!-- Groom Torso / Tuxedo Jacket -->
    <path
      d="M 131 172 C 118 180, 105 198, 100 225 C 94 255, 93 310, 91 380 L 155 380 C 156 320, 158 245, 152 205 C 148 185, 142 175, 131 172 Z"
      fill="url(#silhouette-grad)"
    />
    <!-- Boutonnière Flower on Groom's Lapel -->
    <circle cx="118" cy="202" r="2.5" fill="#FAF6EE" stroke="#B89352" stroke-width="0.6" />
    <path d="M 118 205 Q 116 214 114 218" stroke="#5E7455" stroke-width="1" />

    <!-- BRIDE (Right Subject) -->
    <!-- Bride's Translucent Flowing Veil (Layered behind and over shoulder) -->
    <path
      d="M 180 135 C 195 140, 225 170, 230 230 C 235 290, 235 345, 238 380 L 175 380 C 195 340, 205 270, 195 210 C 190 175, 185 150, 180 135 Z"
      fill="url(#veil-grad)"
      stroke="rgba(255,255,255,0.6)"
      stroke-width="0.8"
    />
    <!-- Bride Head / Hair Bun & Profile looking toward groom -->
    <path
      d="M 178 142 C 182 135, 192 136, 195 144 C 197 152, 194 158, 188 162 C 186 168, 184 172, 178 175 C 174 172, 172 165, 174 158 C 171 155, 171 148, 178 142 Z"
      fill="url(#silhouette-grad)"
    />
    <!-- Floral Headpiece / Tiara on Veil -->
    <circle cx="188" cy="138" r="2.5" fill="#FAF8F5" stroke="#B89352" stroke-width="0.8" />
    <circle cx="184" cy="140" r="1.8" fill="#B89352" />
    <circle cx="192" cy="140" r="1.8" fill="#B89352" />
    <!-- Bride Gown & Slender Silhouette -->
    <path
      d="M 178 175 C 170 185, 164 205, 165 240 C 166 280, 164 330, 158 380 L 225 380 C 225 320, 220 260, 205 220 C 198 198, 188 182, 178 175 Z"
      fill="url(#silhouette-grad)"
    />
    <!-- Bridal Bouquet Held Together -->
    <g transform="translate(152, 235)">
      <!-- Bouquet Ribbon -->
      <path d="M 6 12 Q 3 24 0 28 M 8 12 Q 10 24 14 28" stroke="#B89352" stroke-width="1.2" />
      <!-- Bouquet Rosebuds -->
      <circle cx="6" cy="4" r="5" fill="#FAF6EE" stroke="#566A4E" stroke-width="0.8" />
      <circle cx="6" cy="4" r="2" fill="#B89352" />
      <circle cx="1" cy="9" r="4" fill="#FAF6EE" stroke="#566A4E" stroke-width="0.8" />
      <circle cx="12" cy="8" r="4" fill="#FAF6EE" stroke="#566A4E" stroke-width="0.8" />
      <!-- Olive Sprigs in Bouquet -->
      <path d="M -3 3 C -8 1, -10 -4, -6 -6 C -3 -3, -1 1, -3 3 Z" fill="#5E7455" />
      <path d="M 15 3 C 20 1, 22 -4, 18 -6 C 15 -3, 13 1, 15 3 Z" fill="#5E7455" />
    </g>

    <!-- Base Floral Border at Arch Foot -->
    <path d="M 30 380 L 290 380" stroke="#B89352" stroke-width="1.5" />
  </svg>

</div>