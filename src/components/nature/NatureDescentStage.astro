---
// NatureDescentStage.astro — 4-Stage Natural Descent World-Building (Langit -> Kanopi -> Sungai -> Danau Sunset)
// Multi-Plane Parallax Nature Atmosphere: Painterly Watercolor Canopy, Meandering River Stream, and Sunset Lake Finale
---

<div id="nature-descent-stage" class="absolute inset-0 pointer-events-none select-none overflow-hidden z-10" aria-hidden="true">

  <!-- =========================================================================
       STAGE 2: CANOPY & TREE BOUGHS (Puncak Alam & Kanopi Pepohonan Rindang)
       Appears at the transition boundary from Asmaraloka into UnifiedEvent
       ========================================================================= -->
  <div id="nature-canopy-layer" class="absolute top-0 inset-x-0 h-[100vh] pointer-events-none overflow-hidden will-change-transform">
    <!-- Left Tree Bough (Dahan Pohon Rindang Kiri) -->
    <div id="canopy-bough-left" class="canopy-sway-left absolute -top-8 -left-8 sm:-left-4 w-[52vw] sm:w-[38vw] lg:w-[28vw] max-w-[420px] opacity-80 will-change-transform">
      <svg viewBox="0 0 320 260" fill="none" class="w-full h-auto drop-shadow-[0_8px_24px_rgba(42,52,38,0.14)]">
        <defs>
          <linearGradient id="wood-branch-grad-left" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#322214" />
            <stop offset="45%" stop-color="#4A3420" />
            <stop offset="100%" stop-color="#6E5033" />
          </linearGradient>
          <linearGradient id="leaf-olive-deep" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#283822" />
            <stop offset="50%" stop-color="#3E5434" />
            <stop offset="100%" stop-color="#557248" />
          </linearGradient>
          <linearGradient id="leaf-sage-glow" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#465C3E" />
            <stop offset="60%" stop-color="#67845B" />
            <stop offset="100%" stop-color="#8DAA80" />
          </linearGradient>
          <linearGradient id="leaf-sun-gold" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#8E7036" />
            <stop offset="50%" stop-color="#B89352" />
            <stop offset="100%" stop-color="#E8C97A" />
          </linearGradient>
        </defs>

        <!-- Main Wood Branch Stem -->
        <path d="M -20 20 C 40 40, 110 50, 180 110 C 210 135, 230 180, 245 220" stroke="url(#wood-branch-grad-left)" stroke-width="6" stroke-linecap="round" />
        <path d="M 120 62 C 160 50, 210 55, 250 85" stroke="url(#wood-branch-grad-left)" stroke-width="3.5" stroke-linecap="round" />
        <path d="M 180 110 C 220 120, 270 145, 290 180" stroke="url(#wood-branch-grad-left)" stroke-width="2.5" stroke-linecap="round" />

        <!-- Painterly Leaf Foliage Clusters -->
        <!-- Cluster 1 (Upper Branch) -->
        <path d="M 230 75 C 210 55, 230 40, 255 50 C 265 65, 250 80, 230 75 Z" fill="url(#leaf-olive-deep)" opacity="0.9" />
        <path d="M 250 85 C 240 65, 260 50, 280 62 C 285 78, 270 92, 250 85 Z" fill="url(#leaf-sage-glow)" opacity="0.85" />
        <path d="M 215 50 C 200 35, 220 25, 235 35 C 242 48, 230 58, 215 50 Z" fill="url(#leaf-sun-gold)" opacity="0.8" />

        <!-- Cluster 2 (Mid Outer Arch) -->
        <path d="M 270 145 C 250 125, 275 110, 298 125 C 305 142, 290 158, 270 145 Z" fill="url(#leaf-olive-deep)" opacity="0.9" />
        <path d="M 290 178 C 275 160, 295 145, 315 158 C 322 172, 308 188, 290 178 Z" fill="url(#leaf-sage-glow)" opacity="0.85" />

        <!-- Cluster 3 (Terminal Branch Lower) -->
        <path d="M 225 195 C 205 180, 222 165, 240 175 C 248 190, 238 202, 225 195 Z" fill="url(#leaf-olive-deep)" opacity="0.88" />
        <path d="M 242 220 C 225 205, 245 192, 262 205 C 268 218, 256 230, 242 220 Z" fill="url(#leaf-sun-gold)" opacity="0.85" />

        <!-- Floating Golden Spores / Sun motes -->
        <circle cx="210" cy="90" r="2.2" fill="#D4AF37" opacity="0.75" />
        <circle cx="265" cy="110" r="2.5" fill="#E8C97A" opacity="0.8" />
        <circle cx="280" cy="195" r="2" fill="#D4AF37" opacity="0.7" />
      </svg>
    </div>

    <!-- Right Tree Bough (Dahan Pohon Rindang Kanan) -->
    <div id="canopy-bough-right" class="canopy-sway-right absolute -top-10 -right-8 sm:-right-4 w-[52vw] sm:w-[38vw] lg:w-[28vw] max-w-[420px] opacity-80 will-change-transform scale-x-[-1]">
      <svg viewBox="0 0 320 260" fill="none" class="w-full h-auto drop-shadow-[0_8px_24px_rgba(42,52,38,0.14)]">
        <!-- Main Wood Branch Stem -->
        <path d="M -20 20 C 40 40, 110 50, 180 110 C 210 135, 230 180, 245 220" stroke="url(#wood-branch-grad-left)" stroke-width="6" stroke-linecap="round" />
        <path d="M 120 62 C 160 50, 210 55, 250 85" stroke="url(#wood-branch-grad-left)" stroke-width="3.5" stroke-linecap="round" />
        <path d="M 180 110 C 220 120, 270 145, 290 180" stroke="url(#wood-branch-grad-left)" stroke-width="2.5" stroke-linecap="round" />

        <!-- Painterly Leaf Foliage Clusters -->
        <path d="M 230 75 C 210 55, 230 40, 255 50 C 265 65, 250 80, 230 75 Z" fill="url(#leaf-olive-deep)" opacity="0.9" />
        <path d="M 250 85 C 240 65, 260 50, 280 62 C 285 78, 270 92, 250 85 Z" fill="url(#leaf-sage-glow)" opacity="0.85" />
        <path d="M 215 50 C 200 35, 220 25, 235 35 C 242 48, 230 58, 215 50 Z" fill="url(#leaf-sun-gold)" opacity="0.8" />
        <path d="M 270 145 C 250 125, 275 110, 298 125 C 305 142, 290 158, 270 145 Z" fill="url(#leaf-olive-deep)" opacity="0.9" />
        <path d="M 290 178 C 275 160, 295 145, 315 158 C 322 172, 308 188, 290 178 Z" fill="url(#leaf-sage-glow)" opacity="0.85" />
        <path d="M 242 220 C 225 205, 245 192, 262 205 C 268 218, 256 230, 242 220 Z" fill="url(#leaf-sun-gold)" opacity="0.85" />

        <circle cx="210" cy="90" r="2.2" fill="#D4AF37" opacity="0.75" />
        <circle cx="265" cy="110" r="2.5" fill="#E8C97A" opacity="0.8" />
      </svg>
    </div>
  </div>


  <!-- =========================================================================
       STAGE 3: MEANDERING RIVER STREAM (Aliran Sungai Jernih Lembah Hijau)
       Flows alongside #events and #location, connecting mountain to lake
       ========================================================================= -->
  <div id="nature-river-layer" class="absolute top-[60vh] inset-x-0 h-[220vh] pointer-events-none overflow-hidden z-0 opacity-70 will-change-transform">
    <svg viewBox="0 0 1000 2200" fill="none" class="w-full h-full preserve-3d" preserveAspectRatio="none">
      <defs>
        <!-- River Water Shimmer Linear Gradient -->
        <linearGradient id="river-water-gradient" x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" stop-color="#D6E8D2" stop-opacity="0.35" />
          <stop offset="30%" stop-color="#B2D0B0" stop-opacity="0.45" />
          <stop offset="65%" stop-color="#D4AF37" stop-opacity="0.25" />
          <stop offset="100%" stop-color="#E4C882" stop-opacity="0.40" />
        </linearGradient>

        <linearGradient id="river-ripple-shimmer" x1="0%" y1="0%" x2="0%" y2="100%">
          <stop offset="0%" stop-color="#FFFFFF" stop-opacity="0.6" />
          <stop offset="50%" stop-color="#E8C97A" stop-opacity="0.4" />
          <stop offset="100%" stop-color="#B89352" stop-opacity="0.2" />
        </linearGradient>

        <!-- Bank Stone / Pebble Gradient -->
        <linearGradient id="stone-gray-grad" x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" stop-color="#8F9E8B" />
          <stop offset="100%" stop-color="#5E6D5B" />
        </linearGradient>
      </defs>

      <!-- Soft River Basin Bed Haze -->
      <path 
        d="M 120 0 C 180 300, 40 600, 90 900 C 140 1200, 40 1500, 160 1800 C 240 2000, 450 2150, 500 2200 L 650 2200 C 580 2100, 320 1950, 240 1750 C 140 1450, 220 1150, 180 850 C 140 550, 260 250, 200 0 Z" 
        fill="url(#river-water-gradient)" 
        filter="blur(18px)"
      />

      <!-- Main Winding Water Ribbon Stream -->
      <path 
        class="river-flowing-current"
        d="M 140 0 C 200 300, 60 600, 110 900 C 160 1200, 60 1500, 180 1800 C 260 2000, 480 2150, 500 2200" 
        stroke="url(#river-water-gradient)" 
        stroke-width="56" 
        stroke-linecap="round"
        fill="none"
      />

      <!-- Secondary Golden Water Surface Ripples (Animated Current) -->
      <path 
        class="river-flowing-ripple-1"
        d="M 130 50 C 190 330, 65 620, 115 920 C 165 1220, 65 1520, 185 1820 C 255 2010, 460 2140, 490 2190" 
        stroke="url(#river-ripple-shimmer)" 
        stroke-width="2.5" 
        stroke-dasharray="24 40" 
        fill="none" 
      />

      <path 
        class="river-flowing-ripple-2"
        d="M 150 20 C 210 300, 80 580, 125 880 C 175 1180, 75 1480, 195 1780 C 270 1980, 475 2120, 510 2180" 
        stroke="url(#river-ripple-shimmer)" 
        stroke-width="2" 
        stroke-dasharray="16 32" 
        fill="none" 
      />

      <!-- River Pebbles & Bank Foliage Accents along the Curve -->
      <g id="river-pebble-cluster-1" opacity="0.75">
        <ellipse cx="115" cy="450" rx="9" ry="6" fill="url(#stone-gray-grad)" />
        <ellipse cx="128" cy="455" rx="6" ry="4" fill="url(#stone-gray-grad)" />
        <circle cx="106" cy="445" r="2.5" fill="#B89352" />
      </g>

      <g id="river-pebble-cluster-2" opacity="0.75">
        <ellipse cx="170" cy="1150" rx="12" ry="8" fill="url(#stone-gray-grad)" />
        <ellipse cx="186" cy="1158" rx="8" ry="5" fill="url(#stone-gray-grad)" />
        <ellipse cx="158" cy="1144" rx="7" ry="5" fill="url(#stone-gray-grad)" />
        <circle cx="192" cy="1150" r="3" fill="#D4AF37" />
      </g>

      <g id="river-pebble-cluster-3" opacity="0.8">
        <ellipse cx="230" cy="1820" rx="14" ry="9" fill="url(#stone-gray-grad)" />
        <ellipse cx="248" cy="1828" rx="9" ry="6" fill="url(#stone-gray-grad)" />
        <circle cx="218" cy="1814" r="3.2" fill="#D4AF37" />
      </g>
    </svg>
  </div>


  <!-- =========================================================================
       STAGE 4: SUNSET LAKE & WATER REFLECTION (Telaga Muara Danau Senja)
       Settles serenely in #closing directly beneath the Sunset Sun & Romantic Swans
       ========================================================================= -->
  <div id="nature-lake-layer" class="absolute bottom-0 inset-x-0 h-[100vh] pointer-events-none overflow-hidden z-0 will-change-transform flex flex-col justify-end">
    
    <!-- Sunset Atmosphere Water Bloom (Golden Hour Reflection) -->
    <div class="relative w-full h-[55vh] flex flex-col items-center justify-end">
      
      <!-- Luminous Sunset Water Mirror (Terracotta Gold Water Wash) -->
      <div class="absolute inset-x-0 bottom-0 h-[48vh] bg-gradient-to-t from-[#FAF8F5] via-[#E8C97A]/22 to-transparent blur-md"></div>

      <!-- Golden Sun Pillar Reflection (Vertical Shimmering Light Column under Swans) -->
      <div id="sun-pillar-reflection" class="absolute bottom-0 w-36 sm:w-48 h-[42vh] flex flex-col items-center justify-end opacity-75">
        <!-- Vertical Shimmering Light Streaks -->
        <div class="w-full h-full bg-[radial-gradient(ellipse_at_50%_100%,rgba(238,175,115,0.45)_0%,rgba(212,175,55,0.25)_40%,transparent_75%)] filter blur-xl"></div>
        
        <!-- Animated Horizontal Sunset Ripples (Specular Golden Glints) -->
        <div class="lake-ripple-1 absolute bottom-6 w-44 sm:w-56 h-1 rounded-full bg-gradient-to-r from-transparent via-[#FFF8E7] to-transparent shadow-[0_0_8px_#D4AF37] opacity-80"></div>
        <div class="lake-ripple-2 absolute bottom-12 w-32 sm:w-40 h-0.5 rounded-full bg-gradient-to-r from-transparent via-[#E8C97A] to-transparent shadow-[0_0_6px_#D4AF37] opacity-75"></div>
        <div class="lake-ripple-1 absolute bottom-20 w-48 sm:w-64 h-1 rounded-full bg-gradient-to-r from-transparent via-[#FFF8E7] to-transparent shadow-[0_0_8px_#D4AF37] opacity-70"></div>
        <div class="lake-ripple-2 absolute bottom-28 w-28 sm:w-36 h-0.5 rounded-full bg-gradient-to-r from-transparent via-[#E8C97A] to-transparent shadow-[0_0_6px_#D4AF37] opacity-65"></div>
        <div class="lake-ripple-1 absolute bottom-36 w-20 sm:w-28 h-0.5 rounded-full bg-gradient-to-r from-transparent via-[#FFF8E7] to-transparent shadow-[0_0_6px_#D4AF37] opacity-60"></div>
      </div>

      <!-- Shoreline Foliage Silhouettes at Base Flanks (Weeping Willow / Reeds) -->
      <div class="absolute bottom-0 left-0 w-44 sm:w-60 h-40 opacity-70 pointer-events-none">
        <svg viewBox="0 0 240 160" fill="none" class="w-full h-full">
          <!-- Left Shoreline Bank -->
          <path d="M 0 160 Q 60 140 120 155 Q 180 165 240 160 L 0 160 Z" fill="#4A3420" opacity="0.35" />
          <!-- Reeds / Water Lily Leaves -->
          <path d="M 30 155 C 20 110, 45 80, 50 60" stroke="#3E5434" stroke-width="2" stroke-linecap="round" />
          <path d="M 45 158 C 40 120, 65 95, 75 75" stroke="#557248" stroke-width="2.2" stroke-linecap="round" />
          <path d="M 60 160 C 65 130, 85 110, 95 90" stroke="#3E5434" stroke-width="1.8" stroke-linecap="round" />
          <path d="M 48 60 C 40 45, 55 40, 60 55 Z" fill="#67845B" opacity="0.8" />
          <path d="M 72 75 C 65 60, 80 55, 85 70 Z" fill="#B89352" opacity="0.75" />
          <!-- Small River Rock -->
          <ellipse cx="110" cy="155" rx="14" ry="7" fill="#5E6D5B" opacity="0.6" />
        </svg>
      </div>

      <div class="absolute bottom-0 right-0 w-44 sm:w-60 h-40 opacity-70 pointer-events-none scale-x-[-1]">
        <svg viewBox="0 0 240 160" fill="none" class="w-full h-full">
          <path d="M 0 160 Q 60 140 120 155 Q 180 165 240 160 L 0 160 Z" fill="#4A3420" opacity="0.35" />
          <path d="M 30 155 C 20 110, 45 80, 50 60" stroke="#3E5434" stroke-width="2" stroke-linecap="round" />
          <path d="M 45 158 C 40 120, 65 95, 75 75" stroke="#557248" stroke-width="2.2" stroke-linecap="round" />
          <path d="M 48 60 C 40 45, 55 40, 60 55 Z" fill="#67845B" opacity="0.8" />
          <ellipse cx="110" cy="155" rx="14" ry="7" fill="#5E6D5B" opacity="0.6" />
        </svg>
      </div>

    </div>

  </div>

</div>

<style>
  /* Organic Tree Canopy Gentle Breeze Sway */
  .canopy-sway-left {
    animation: canopyBreezeLeft 12s ease-in-out infinite alternate;
    transform-origin: top left;
  }
  .canopy-sway-right {
    animation: canopyBreezeRight 14s ease-in-out infinite alternate;
    transform-origin: top right;
  }

  @keyframes canopyBreezeLeft {
    0% {
      transform: translate3d(0, 0, 0) rotate(0deg);
    }
    50% {
      transform: translate3d(8px, 6px, 0) rotate(1.2deg);
    }
    100% {
      transform: translate3d(-5px, -3px, 0) rotate(-0.8deg);
    }
  }

  @keyframes canopyBreezeRight {
    0% {
      transform: scaleX(-1) translate3d(0, 0, 0) rotate(0deg);
    }
    50% {
      transform: scaleX(-1) translate3d(7px, 5px, 0) rotate(-1.4deg);
    }
    100% {
      transform: scaleX(-1) translate3d(-6px, -4px, 0) rotate(0.9deg);
    }
  }

  /* Meandering River Continuous Dynamic Water Ripples */
  .river-flowing-ripple-1 {
    animation: riverRippleGlide 10s linear infinite;
  }
  .river-flowing-ripple-2 {
    animation: riverRippleGlide 8s linear infinite reverse;
  }

  @keyframes riverRippleGlide {
    from {
      stroke-dashoffset: 0;
    }
    to {
      stroke-dashoffset: -200;
    }
  }

  /* Sunset Lake Specular Shimmering Ripples */
  .lake-ripple-1 {
    animation: lakeShimmerA 5s ease-in-out infinite alternate;
  }
  .lake-ripple-2 {
    animation: lakeShimmerB 6s ease-in-out infinite alternate;
  }

  @keyframes lakeShimmerA {
    0%, 100% {
      transform: scaleX(0.85);
      opacity: 0.50;
    }
    50% {
      transform: scaleX(1.18);
      opacity: 0.95;
    }
  }

  @keyframes lakeShimmerB {
    0%, 100% {
      transform: scaleX(1.15);
      opacity: 0.85;
    }
    50% {
      transform: scaleX(0.80);
      opacity: 0.45;
    }
  }

  /* Respect Accessibility Reduced Motion */
  @media (prefers-reduced-motion: reduce) {
    .canopy-sway-left,
    .canopy-sway-right,
    .river-flowing-ripple-1,
    .river-flowing-ripple-2,
    .lake-ripple-1,
    .lake-ripple-2 {
      animation: none !important;
    }
  }
</style>
