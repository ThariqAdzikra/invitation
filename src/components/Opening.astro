---
import content from '../data/content.json';
import FloralDivider from './botanical/FloralDivider.astro';
import FloralCorner from './botanical/FloralCorner.astro';
import FloralBouquet from './botanical/FloralBouquet.astro';
---

<section id="opening" class="deck-section tone-opening section-flow relative px-4 text-center overflow-hidden z-20" aria-label="Kata Pembuka dan Doa">
  <div class="max-w-2xl mx-auto text-center flex flex-col items-center relative z-10">
    
    <!-- Crown Botanical Bouquet -->
    <div class="opening-divider mb-3 scale-90">
      <FloralBouquet width={220} height={55} />
    </div>

    <!-- Editorial Botanical Badge -->
    <div class="editorial-badge opening-item mb-3">
      <span>THE SACRED COVENANT</span>
    </div>

    <!-- Sacred Bismillah -->
    <p class="opening-bismillah font-arabic text-3xl sm:text-4xl text-[#3E4C38] mb-6" dir="rtl" lang="ar">
      {content.opening.bismillah}
    </p>

    <!-- Ayat Suci QS Ar-Rum 21 Card with Floral Corner Accents -->
    <div class="opening-item w-full bg-white/80 border border-[#566A4E]/20 rounded-2xl p-6 sm:p-9 shadow-sm relative overflow-hidden my-3">
      <div class="absolute top-2 left-2 pointer-events-none">
        <FloralCorner position="top-left" size={60} />
      </div>
      <div class="absolute bottom-2 right-2 pointer-events-none">
        <FloralCorner position="bottom-right" size={60} />
      </div>

      <blockquote lang="ar" dir="rtl" class="font-arabic text-xl sm:text-2xl text-[#2A3426] leading-loose max-w-xl mx-auto relative z-10">
        {content.opening.verse}
      </blockquote>

      <p class="text-xs sm:text-sm text-[#566A4E] font-light leading-relaxed my-3 max-w-lg mx-auto italic relative z-10">
        &ldquo;{content.opening.translation}&rdquo;
      </p>

      <p class="text-[0.68rem] tracking-[0.25em] text-[#B89352] uppercase font-semibold mt-3 relative z-10">
        {content.opening.source}
      </p>
    </div>

    <!-- Kata Sambutan Tulus -->
    <p class="opening-item text-xs sm:text-sm text-[#2A3426] mt-5 font-normal max-w-lg leading-relaxed">
      {content.opening.greeting}
    </p>

    <!-- Botanical Floral Divider Bottom -->
    <div class="opening-divider mt-6 scale-x-0">
      <FloralDivider width={240} height={32} />
    </div>

  </div>
</section>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  function initOpeningTrigger() {
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReducedMotion) return;

    const tl = gsap.timeline({
      scrollTrigger: {
        trigger: '#opening',
        start: 'top 80%',
        once: true
      }
    });

    // 1. Dividers expand from center
    tl.to('.opening-divider', {
      scaleX: 1,
      opacity: 1,
      duration: 0.8,
      ease: 'power3.out',
      stagger: 0.2
    });

    // 2. Bismillah blooms cleanly
    tl.fromTo(
      '.opening-bismillah',
      { opacity: 0, y: 24 },
      { opacity: 1, y: 0, duration: 1.0, ease: 'power2.out' },
      '-=0.6'
    );

    // 3. Staggered reveal of scripture & translation
    tl.fromTo(
      '.opening-item',
      { opacity: 0, y: 20 },
      { opacity: 1, y: 0, duration: 0.85, stagger: 0.1, ease: 'power3.out' },
      '-=0.5'
    );
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initOpeningTrigger);
  } else {
    initOpeningTrigger();
  }
</script>
