---
// Opening.astro — Sacred Verse & Welcoming Blessings
import content from '../data/content.json';
import FloralFlourish from './botanical/FloralFlourish.astro';
---

<section id="opening" class="deck-section section-flow relative px-4 text-center overflow-hidden z-20 pt-20 pb-20" aria-label="Kata Pembuka dan Doa">
  
  <div class="max-w-2xl mx-auto text-center flex flex-col items-center relative z-10">
    
    <!-- Sacred Bismillah -->
    <p class="opening-bismillah font-arabic text-3xl sm:text-4xl text-[#3E4C38] mb-6 drop-shadow-sm" dir="rtl" lang="ar">
      {content.opening.bismillah}
    </p>

    <!-- Ayat Suci QS Ar-Rum 21 Card -->
    <div class="opening-item w-full bg-white/95 border border-[#566A4E]/20 rounded-2xl p-6 sm:p-10 shadow-[0_12px_35px_rgba(42,52,38,0.05)] relative overflow-hidden my-3 interactive-foil-card" data-foil="true">
      <!-- Subtle top gold highlight line -->
      <div class="absolute top-0 left-0 right-0 h-[2px] bg-gradient-to-r from-transparent via-[#B89352] to-transparent"></div>

      <blockquote lang="ar" dir="rtl" class="font-arabic text-xl sm:text-2xl text-[#2A3426] leading-loose max-w-xl mx-auto relative z-10">
        {content.opening.verse}
      </blockquote>

      <p class="text-xs sm:text-sm text-[#566A4E] font-light leading-relaxed my-4 max-w-lg mx-auto italic relative z-10">
        &ldquo;{content.opening.translation}&rdquo;
      </p>

      <div class="my-2 relative z-10 opacity-70">
        <FloralFlourish width={140} height={24} />
      </div>

      <p class="text-[0.65rem] tracking-[0.25em] text-[#B89352] uppercase font-semibold mt-2 relative z-10">
        {content.opening.source}
      </p>
    </div>

    <!-- Kata Sambutan Tulus -->
    <p class="opening-item text-xs sm:text-sm text-[#4A5D43] mt-6 font-normal max-w-lg leading-relaxed">
      {content.opening.greeting}
    </p>

  </div>
</section>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  function initOpeningTrigger() {
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReducedMotion) return;

    const tl = gsap.timeline({
      scrollTrigger: {
        trigger: '#opening',
        start: 'top 80%',
        once: true
      }
    });

    tl.fromTo(
      '.opening-bismillah',
      { opacity: 0, y: 20 },
      { opacity: 1, y: 0, duration: 0.9, ease: 'power2.out' }
    );

    tl.fromTo(
      '.opening-item',
      { opacity: 0, y: 20 },
      { opacity: 1, y: 0, duration: 0.85, stagger: 0.12, ease: 'power3.out' },
      '-=0.5'
    );
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initOpeningTrigger);
  } else {
    initOpeningTrigger();
  }
</script>
