---
// InteractiveCanvas.astro — Gentle Swaying Olive Leaves & Shimmering Gold Petals Canvas
---

<canvas
  id="falling-leaves-canvas"
  class="fixed inset-0 w-full h-full pointer-events-none z-[4] opacity-90"
  aria-hidden="true"
></canvas>

<script>
  function initFallingLeavesCanvas() {
    const canvas = document.getElementById('falling-leaves-canvas') as HTMLCanvasElement | null;
    if (!canvas) return;

    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReducedMotion) return;

    let width = (canvas.width = window.innerWidth);
    let height = (canvas.height = window.innerHeight);

    window.addEventListener('resize', () => {
      width = canvas.width = window.innerWidth;
      height = canvas.height = window.innerHeight;
    });

    interface Particle {
      type: 'leaf' | 'petal';
      x: number;
      y: number;
      length: number;
      width: number;
      speedY: number;
      sway: number;
      swaySpeed: number;
      swayMagnitude: number;
      rotation: number;
      rotationSpeed: number;
      flip: number;
      flipSpeed: number;
      color: string;
      alpha: number;
    }

    const leafColors = [
      '#4A5D43', // Deep botanical olive
      '#5E7455', // Sage olive
      '#6E8564', // Soft muted eucalyptus
      '#3D4D37'  // Forest olive
    ];

    const petalColors = [
      '#B89352', // Antique gold
      '#D4AF6E', // Champagne gold
      '#E8D7B5', // Soft ivory gold
      '#C5A059'  // Warm brass gold
    ];

    const particleCount = window.innerWidth < 640 ? 20 : 34;
    const particles: Particle[] = [];

    for (let i = 0; i < particleCount; i++) {
      const isLeaf = i % 3 !== 0; // 2/3 leaves, 1/3 petals
      const length = isLeaf ? Math.random() * 10 + 14 : Math.random() * 8 + 8;
      const w = isLeaf ? length * 0.45 : length * 0.7;

      particles.push({
        type: isLeaf ? 'leaf' : 'petal',
        x: Math.random() * width,
        y: Math.random() * height,
        length,
        width: w,
        speedY: Math.random() * 0.45 + 0.35,
        sway: Math.random() * Math.PI * 2,
        swaySpeed: Math.random() * 0.018 + 0.008,
        swayMagnitude: Math.random() * 0.7 + 0.4,
        rotation: Math.random() * Math.PI * 2,
        rotationSpeed: (Math.random() - 0.5) * 0.015,
        flip: Math.random() * Math.PI * 2,
        flipSpeed: Math.random() * 0.02 + 0.01,
        color: isLeaf
          ? leafColors[Math.floor(Math.random() * leafColors.length)]
          : petalColors[Math.floor(Math.random() * petalColors.length)],
        alpha: Math.random() * 0.4 + 0.45
      });
    }

    function animate() {
      if (!ctx) return;
      ctx.clearRect(0, 0, width, height);

      for (let i = 0; i < particles.length; i++) {
        const p = particles[i];

        // Peaceful downward and swaying drift
        p.y += p.speedY;
        p.sway += p.swaySpeed;
        p.x += Math.sin(p.sway) * p.swayMagnitude;
        p.rotation += p.rotationSpeed;
        p.flip += p.flipSpeed;

        // Reset if off bottom or screen edges
        if (p.y > height + 25) {
          p.y = -25;
          p.x = Math.random() * width;
        }
        if (p.x > width + 25) p.x = -20;
        if (p.x < -25) p.x = width + 20;

        ctx.save();
        ctx.globalAlpha = p.alpha;
        ctx.translate(p.x, p.y);
        ctx.rotate(p.rotation);
        ctx.scale(Math.cos(p.flip), 1); // 3D fluttering flip

        if (p.type === 'leaf') {
          // Draw Organic Olive Leaf
          ctx.beginPath();
          ctx.moveTo(0, -p.length / 2);
          ctx.bezierCurveTo(
            p.width / 2, -p.length / 4,
            p.width / 2, p.length / 4,
            0, p.length / 2
          );
          ctx.bezierCurveTo(
            -p.width / 2, p.length / 4,
            -p.width / 2, -p.length / 4,
            0, -p.length / 2
          );
          ctx.closePath();
          ctx.fillStyle = p.color;
          ctx.fill();

          // Delicate Gold Central Vein
          ctx.beginPath();
          ctx.moveTo(0, -p.length / 2 + 2);
          ctx.lineTo(0, p.length / 2 - 2);
          ctx.strokeStyle = 'rgba(212, 175, 110, 0.45)';
          ctx.lineWidth = 0.6;
          ctx.stroke();
        } else {
          // Draw Shimmering Golden Petal
          ctx.beginPath();
          ctx.moveTo(0, -p.length / 2);
          ctx.quadraticCurveTo(p.width * 0.7, -p.length * 0.15, p.width * 0.4, p.length / 2);
          ctx.quadraticCurveTo(0, p.length * 0.7, -p.width * 0.4, p.length / 2);
          ctx.quadraticCurveTo(-p.width * 0.7, -p.length * 0.15, 0, -p.length / 2);
          ctx.closePath();
          ctx.fillStyle = p.color;
          ctx.fill();

          // Subtle glistening highlight
          ctx.beginPath();
          ctx.arc(0, -p.length * 0.15, p.width * 0.25, 0, Math.PI * 2);
          ctx.fillStyle = 'rgba(255, 255, 255, 0.35)';
          ctx.fill();
        }

        ctx.restore();
      }

      requestAnimationFrame(animate);
    }

    requestAnimationFrame(animate);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initFallingLeavesCanvas);
  } else {
    initFallingLeavesCanvas();
  }
</script>
