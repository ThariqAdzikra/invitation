---
// InteractiveCanvas.astro — Atmospheric Multi-Layer Canvas: Curved Swirling Breeze, Soft Clouds & Wind-Riding Leaves
---

<canvas
  id="ambient-interactive-canvas"
  class="fixed inset-0 w-full h-full pointer-events-none z-[4] opacity-90"
  aria-hidden="true"
></canvas>

<script>
  import { FallingLeaves } from 'falling-leaves';

  function initAmbientCanvas() {
    const canvas = document.getElementById('ambient-interactive-canvas') as HTMLCanvasElement | null;
    if (!canvas) return;

    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReducedMotion) return;

    // =========================================================================
    // LAYER 0: FALLING GINKGO LEAVES (powered by npm 'falling-leaves')
    // Background atmospheric drift: delicate fan-shaped Ginkgo leaves in gold & sage
    // Z-INDEX IS SET TO 2 (STRICTLY IN BACKGROUND, NEVER COVERS TEXT/BUTTONS)
    // =========================================================================
    try {
      const leaves = new FallingLeaves({
        shapes: ['ginkgo'],
        count: window.innerWidth < 640 ? 10 : 18,
        size: [12, 22],
        speed: [0.35, 0.85],
        wind: [-0.15, 0.45],
        sway: [0.5, 1.4],
        rotationSpeed: [-0.9, 0.9],
        opacity: 0.75,
        zIndex: 2, // Background layer: behind #main-content (z-10) and cards (z-30)
        respectReducedMotion: true,
        autoStart: true,
        colors: [
          '#D4AF37', // Radiant gold ginkgo
          '#E5C378', // Sparkling champagne gold
          '#B89352', // Luxury antique gold
          '#7E8F77', // Soft sage green
          '#566A4E', // Royal botanical olive
          '#F3DE98'  // Delicate gilded ivory sheen
        ]
      });

      (window as any).__fallingLeavesInstance = leaves;
    } catch (e) {
      console.warn('FallingLeaves init fallback:', e);
    }

    let width = (canvas.width = window.innerWidth);
    let height = (canvas.height = window.innerHeight);

    window.addEventListener('resize', () => {
      width = canvas.width = window.innerWidth;
      height = canvas.height = window.innerHeight;
    });

    // =========================================================================
    // LAYER 1: SOFT FLOATING CLOUDS (Awan Lembut di Langit Atas)
    // =========================================================================
    interface Cloud {
      x: number;
      y: number;
      radiusX: number;
      radiusY: number;
      speedX: number;
      opacity: number;
    }

    const isMobile = window.innerWidth < 768;

    const clouds: Cloud[] = isMobile
      ? [
          { x: width * 0.2, y: height * 0.08, radiusX: 180, radiusY: 55, speedX: 0.08, opacity: 0.18 },
          { x: width * 0.75, y: height * 0.12, radiusX: 200, radiusY: 60, speedX: 0.06, opacity: 0.14 }
        ]
      : [
          { x: width * 0.1, y: height * 0.08, radiusX: 230, radiusY: 70, speedX: 0.10, opacity: 0.20 },
          { x: width * 0.55, y: height * 0.14, radiusX: 290, radiusY: 85, speedX: 0.08, opacity: 0.16 },
          { x: width * 0.88, y: height * 0.06, radiusX: 200, radiusY: 60, speedX: 0.12, opacity: 0.22 },
          { x: -width * 0.2, y: height * 0.11, radiusX: 260, radiusY: 75, speedX: 0.09, opacity: 0.18 }
        ];

    // =========================================================================
    // LAYER 2: ORGANIC CURVED WIND GUSTS (Hembusan Angin Melengkung & Bergelombang)
    // =========================================================================
    interface WindGust {
      headX: number;
      baseY: number;
      speedX: number;
      length: number;
      amplitude: number;
      frequency: number;
      wavePhase: number;
      hasCurl: boolean;
      curlRadius: number;
      alpha: number;
      companionOffset: number;
    }

    const gustCount = isMobile ? 2 : 4;
    const windGusts: WindGust[] = [];

    // Helper to keep wind streams in atmospheric sky & lower ground (never clashing across center text)
    function getSafeWindY(index: number) {
      if (index % 2 === 0) {
        // High atmospheric sky stream
        return height * (0.06 + Math.random() * 0.12);
      } else {
        // Lower gentle ground breeze stream
        return height * (0.82 + Math.random() * 0.12);
      }
    }

    for (let i = 0; i < gustCount; i++) {
      windGusts.push({
        headX: (width / gustCount) * i + Math.random() * 200,
        baseY: getSafeWindY(i),
        speedX: Math.random() * 1.2 + 1.8, // Elegant, smooth breeze speed
        length: Math.random() * 140 + 260, // 260px - 400px sweeping trails
        amplitude: Math.random() * 14 + 12, // Organic wave curvature
        frequency: Math.random() * 0.008 + 0.006,
        wavePhase: Math.random() * Math.PI * 2,
        hasCurl: i % 2 === 0, // Alternating delicate loop curl
        curlRadius: Math.random() * 8 + 10,
        alpha: Math.random() * 0.10 + 0.14, // Whispered golden elegance
        companionOffset: Math.random() * 8 + 6
      });
    }

    // =========================================================================
    // LAYER 3: PASTEL BLOSSOM PETALS (Blush Rose, Peach Blossom & Sage Leaves)
    // =========================================================================
    interface Petal {
      x: number;
      y: number;
      size: number;
      color: string;
      speedY: number;
      speedX: number;
      rotation: number;
      rotSpeed: number;
      swayAmplitude: number;
      swayPhase: number;
      opacity: number;
    }

    const petalColors = [
      '#EAA194', // Blush Rose
      '#F8C4AD', // Sweet Peach
      '#F7D2CC', // Soft Peony Pink
      '#7E8F77', // Soft Sage
      '#D4AF37'  // Antique Gold Flake
    ];

    const petalCount = window.innerWidth < 640 ? 14 : 24;
    const petals: Petal[] = [];

    for (let i = 0; i < petalCount; i++) {
      petals.push({
        x: Math.random() * width,
        y: Math.random() * height,
        size: Math.random() * 6 + 7,
        color: petalColors[Math.floor(Math.random() * petalColors.length)],
        speedY: Math.random() * 0.6 + 0.5,
        speedX: Math.random() * 0.4 - 0.1,
        rotation: Math.random() * Math.PI * 2,
        rotSpeed: (Math.random() - 0.5) * 0.03,
        swayAmplitude: Math.random() * 1.5 + 0.8,
        swayPhase: Math.random() * Math.PI * 2,
        opacity: Math.random() * 0.35 + 0.45
      });
    }

    // =========================================================================
    // LAYER 4: CUTIE TAP / CLICK HEARTS & STARDUST MICRO-INTERACTION
    // Spawns delightful floating pastel hearts & stardust sparkles on every tap
    // =========================================================================
    interface SparkleHeart {
      x: number;
      y: number;
      vx: number;
      vy: number;
      size: number;
      alpha: number;
      symbol: string;
      color: string;
      rotation: number;
      rotSpeed: number;
    }

    const tapParticles: SparkleHeart[] = [];
    const tapSymbols = ['❤', '✦', '✿', '❦', '•'];
    const tapColors = ['#EAA194', '#F8C4AD', '#D4AF37', '#DE7C6E', '#FFF0ED'];

    window.addEventListener('pointerdown', (e: PointerEvent) => {
      // Don't spawn if tapping on an interactive button or input
      const target = e.target as HTMLElement;
      if (target && target.closest('button, a, input, textarea, select')) return;

      const burstCount = 6;
      for (let i = 0; i < burstCount; i++) {
        const angle = (Math.PI * 2 / burstCount) * i + (Math.random() - 0.5) * 0.6;
        const speed = Math.random() * 2.2 + 1.2;
        tapParticles.push({
          x: e.clientX,
          y: e.clientY,
          vx: Math.cos(angle) * speed,
          vy: Math.sin(angle) * speed - 2.0, // Initial upward burst
          size: Math.random() * 7 + 10,
          alpha: 1.0,
          symbol: tapSymbols[Math.floor(Math.random() * tapSymbols.length)],
          color: tapColors[Math.floor(Math.random() * tapColors.length)],
          rotation: (Math.random() - 0.5) * 0.4,
          rotSpeed: (Math.random() - 0.5) * 0.06
        });
      }
    });

    // =========================================================================
    // MAIN 60FPS RENDER & PHYSICS LOOP
    // =========================================================================
    let tick = 0;
    let scrollVelocity = 0;
    let lastScrollY = window.scrollY;

    // Track scroll momentum smoothly (works with both Lenis and native scroll)
    window.addEventListener('scroll', () => {
      const currentScrollY = window.scrollY;
      const delta = currentScrollY - lastScrollY;
      lastScrollY = currentScrollY;
      // Cap maximum momentum
      scrollVelocity = Math.max(-25, Math.min(25, delta));
    }, { passive: true });

    // Also tap directly into Lenis velocity if available for ultra-smooth inertia
    if ((window as any).__lenis) {
      (window as any).__lenis.on('scroll', (e: any) => {
        if (typeof e.velocity === 'number') {
          scrollVelocity = Math.max(-25, Math.min(25, e.velocity));
        }
      });
    }

    function render() {
      if (!ctx) return;
      ctx.clearRect(0, 0, width, height);
      tick++;

      // Gradually damp scroll velocity back to zero
      scrollVelocity *= 0.92;
      const scrollBoost = Math.abs(scrollVelocity) * 0.6;

      // -----------------------------------------------------------------------
      // 1. Draw Clouds
      // -----------------------------------------------------------------------
      for (const cloud of clouds) {
        cloud.x += cloud.speedX;
        if (cloud.x - cloud.radiusX > width) {
          cloud.x = -cloud.radiusX;
        }

        const grad = ctx.createRadialGradient(
          cloud.x, cloud.y, 0,
          cloud.x, cloud.y, cloud.radiusX
        );
        grad.addColorStop(0, `rgba(255, 255, 255, ${cloud.opacity})`);
        grad.addColorStop(0.6, `rgba(255, 255, 255, ${cloud.opacity * 0.5})`);
        grad.addColorStop(1, 'rgba(255, 255, 255, 0)');

        ctx.save();
        ctx.fillStyle = grad;
        ctx.beginPath();
        ctx.ellipse(cloud.x, cloud.y, cloud.radiusX, cloud.radiusY, 0, 0, Math.PI * 2);
        ctx.fill();
        ctx.restore();
      }

      // -----------------------------------------------------------------------
      // 2. Draw Organic Curved Wind Gusts with Graceful Sweeps & Companion Trails
      // -----------------------------------------------------------------------
      for (const gust of windGusts) {
        // Boost wind gust speed when scrolling
        gust.headX += gust.speedX + scrollBoost * 0.7;

        // Reset gust when it travels beyond right edge
        if (gust.headX - gust.length > width + 100) {
          gust.headX = -100;
          gust.baseY = getSafeWindY(Math.floor(Math.random() * 2));
          gust.speedX = Math.random() * 1.2 + 1.8;
          gust.length = Math.random() * 140 + 260;
          gust.amplitude = Math.random() * 14 + 12;
        }

        // Draw Main Curved Breeze Ribbon
        ctx.save();
        const startX = gust.headX - gust.length;
        const endX = gust.headX;

        // Golden fading gradient along wind stream
        const strokeGrad = ctx.createLinearGradient(startX, gust.baseY, endX, gust.baseY);
        strokeGrad.addColorStop(0, 'rgba(184, 147, 82, 0)');
        strokeGrad.addColorStop(0.25, `rgba(184, 147, 82, ${gust.alpha * 0.5})`);
        strokeGrad.addColorStop(0.8, `rgba(212, 175, 110, ${gust.alpha * 1.1})`);
        strokeGrad.addColorStop(1, 'rgba(184, 147, 82, 0)');

        ctx.strokeStyle = strokeGrad;
        ctx.lineWidth = 0.9;
        ctx.lineCap = 'round';
        ctx.lineJoin = 'round';

        // Sample undulating bezier path
        ctx.beginPath();
        const segments = 24;
        let headWaveY = gust.baseY;

        for (let s = 0; s <= segments; s++) {
          const ratio = s / segments;
          const px = startX + ratio * gust.length;
          
          // Organic sinusoidal wave with dual-harmonic undulation
          const wave = Math.sin(px * gust.frequency + tick * 0.02 + gust.wavePhase) * gust.amplitude
                     + Math.cos(px * gust.frequency * 0.5 + tick * 0.015) * (gust.amplitude * 0.4);
          const py = gust.baseY + wave;

          if (s === 0) {
            ctx.moveTo(px, py);
          } else {
            ctx.lineTo(px, py);
          }

          if (s === segments) {
            headWaveY = py;
          }
        }

        // Optional artistic curl at the head of the breeze
        if (gust.hasCurl) {
          const curlSteps = 12;
          for (let c = 1; c <= curlSteps; c++) {
            const angle = (c / curlSteps) * Math.PI * 1.8;
            const r = gust.curlRadius * (1 - c / curlSteps * 0.6);
            const cx = endX + Math.sin(angle) * r;
            const cy = headWaveY - (1 - Math.cos(angle)) * r;
            ctx.lineTo(cx, cy);
          }
        }

        ctx.stroke();

        // Draw Companion Whispering Line (Delicate secondary trailing curve)
        ctx.beginPath();
        ctx.strokeStyle = `rgba(184, 147, 82, ${gust.alpha * 0.4})`;
        ctx.lineWidth = 0.7;
        const compStart = startX + gust.length * 0.2;
        const compLength = gust.length * 0.65;
        const compSegments = 16;

        for (let s = 0; s <= compSegments; s++) {
          const ratio = s / compSegments;
          const px = compStart + ratio * compLength;
          const wave = Math.sin(px * gust.frequency + tick * 0.025 + gust.wavePhase + 0.8) * (gust.amplitude * 0.75)
                     + Math.cos(px * gust.frequency * 0.5 + tick * 0.02) * (gust.amplitude * 0.3);
          const py = gust.baseY + gust.companionOffset + wave;

          if (s === 0) {
            ctx.moveTo(px, py);
          } else {
            ctx.lineTo(px, py);
          }
        }
        ctx.stroke();

        ctx.restore();
      }

      // -----------------------------------------------------------------------
      // 3. Draw Fluttering Pastel Blossom Petals
      // -----------------------------------------------------------------------
      for (const petal of petals) {
        petal.y += petal.speedY + scrollBoost * 0.4;
        petal.x += petal.speedX + Math.sin(tick * 0.02 + petal.swayPhase) * petal.swayAmplitude;
        petal.rotation += petal.rotSpeed;

        if (petal.y > height + 20) {
          petal.y = -20;
          petal.x = Math.random() * width;
        }
        if (petal.x > width + 20) petal.x = -20;
        if (petal.x < -20) petal.x = width + 20;

        ctx.save();
        ctx.translate(petal.x, petal.y);
        ctx.rotate(petal.rotation);
        ctx.globalAlpha = petal.opacity;
        ctx.fillStyle = petal.color;
        
        // Draw organic curved petal teardrop / ellipse
        ctx.beginPath();
        ctx.ellipse(0, 0, petal.size, petal.size * 0.55, 0, 0, Math.PI * 2);
        ctx.fill();
        ctx.restore();
      }

      // -----------------------------------------------------------------------
      // 4. Draw Cute Floating Tap Sparkles & Hearts (Micro-Interaction)
      // -----------------------------------------------------------------------
      for (let i = tapParticles.length - 1; i >= 0; i--) {
        const p = tapParticles[i];
        p.x += p.vx;
        p.y += p.vy;
        p.vy -= 0.04; // Gentle upward floating drift
        p.vx *= 0.95; // Air drag
        p.rotation += p.rotSpeed;
        p.alpha -= 0.018;

        if (p.alpha <= 0) {
          tapParticles.splice(i, 1);
          continue;
        }

        ctx.save();
        ctx.translate(p.x, p.y);
        ctx.rotate(p.rotation);
        ctx.globalAlpha = Math.max(0, p.alpha);
        ctx.fillStyle = p.color;
        ctx.font = `${p.size}px serif`;
        ctx.textAlign = 'center';
        ctx.textBaseline = 'middle';
        ctx.fillText(p.symbol, 0, 0);
        ctx.restore();
      }

      requestAnimationFrame(render);
    }

    requestAnimationFrame(render);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAmbientCanvas);
  } else {
    initAmbientCanvas();
  }
</script>
