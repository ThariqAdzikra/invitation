---
// InteractiveCanvas.astro — Atmospheric Multi-Layer Canvas: Curved Swirling Breeze, Soft Clouds & Wind-Riding Leaves
---

<canvas
  id="ambient-interactive-canvas"
  class="fixed inset-0 w-full h-full pointer-events-none z-[4] opacity-90"
  aria-hidden="true"
></canvas>

<script>
  function initAmbientCanvas() {
    const canvas = document.getElementById('ambient-interactive-canvas') as HTMLCanvasElement | null;
    if (!canvas) return;

    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReducedMotion) return;

    let width = (canvas.width = window.innerWidth);
    let height = (canvas.height = window.innerHeight);

    window.addEventListener('resize', () => {
      width = canvas.width = window.innerWidth;
      height = canvas.height = window.innerHeight;
    });

    // =========================================================================
    // LAYER 1: SOFT FLOATING CLOUDS (Awan Lembut di Langit Atas)
    // =========================================================================
    interface Cloud {
      x: number;
      y: number;
      radiusX: number;
      radiusY: number;
      speedX: number;
      opacity: number;
    }

    const clouds: Cloud[] = [
      { x: width * 0.1, y: height * 0.08, radiusX: 230, radiusY: 70, speedX: 0.10, opacity: 0.20 },
      { x: width * 0.55, y: height * 0.14, radiusX: 290, radiusY: 85, speedX: 0.08, opacity: 0.16 },
      { x: width * 0.88, y: height * 0.06, radiusX: 200, radiusY: 60, speedX: 0.12, opacity: 0.22 },
      { x: -width * 0.2, y: height * 0.11, radiusX: 260, radiusY: 75, speedX: 0.09, opacity: 0.18 }
    ];

    // =========================================================================
    // LAYER 2: ORGANIC CURVED WIND GUSTS (Hembusan Angin Melengkung & Bergelombang)
    // =========================================================================
    interface WindGust {
      headX: number;
      baseY: number;
      speedX: number;
      length: number;
      amplitude: number;
      frequency: number;
      wavePhase: number;
      hasCurl: boolean;
      curlRadius: number;
      alpha: number;
      companionOffset: number;
    }

    const gustCount = window.innerWidth < 640 ? 3 : 4;
    const windGusts: WindGust[] = [];

    for (let i = 0; i < gustCount; i++) {
      windGusts.push({
        headX: (width / gustCount) * i + Math.random() * 200,
        baseY: height * (0.18 + (i * 0.24) + (Math.random() - 0.5) * 0.08),
        speedX: Math.random() * 1.4 + 2.0, // Brisk, visible breeze speed
        length: Math.random() * 140 + 260, // 260px - 400px sweeping trails
        amplitude: Math.random() * 18 + 16, // Organic wave curvature
        frequency: Math.random() * 0.008 + 0.006,
        wavePhase: Math.random() * Math.PI * 2,
        hasCurl: i % 2 === 0, // Alternating delicate loop curl
        curlRadius: Math.random() * 8 + 12,
        alpha: Math.random() * 0.18 + 0.22,
        companionOffset: Math.random() * 8 + 6
      });
    }

    // =========================================================================
    // LAYER 3: FALLING OLIVE LEAVES & GOLD PETALS (Daun Zaitun & Kelopak Emas)
    // =========================================================================
    interface Particle {
      type: 'leaf' | 'petal';
      x: number;
      y: number;
      vx: number;
      vy: number;
      length: number;
      width: number;
      speedY: number;
      sway: number;
      swaySpeed: number;
      swayMagnitude: number;
      rotation: number;
      rotationSpeed: number;
      flip: number;
      flipSpeed: number;
      windCatch: number;
      color: string;
      alpha: number;
    }

    const leafColors = ['#4A5D43', '#5E7455', '#6E8564', '#3E5038'];
    const petalColors = ['#B89352', '#D4AF6E', '#EAD8B5', '#C49F58'];

    const particleCount = window.innerWidth < 640 ? 22 : 36;
    const particles: Particle[] = [];

    for (let i = 0; i < particleCount; i++) {
      const isLeaf = i % 3 !== 0; // 2/3 leaves, 1/3 petals
      const length = isLeaf ? Math.random() * 10 + 13 : Math.random() * 7 + 7;
      const w = isLeaf ? length * 0.44 : length * 0.7;

      particles.push({
        type: isLeaf ? 'leaf' : 'petal',
        x: Math.random() * width,
        y: Math.random() * height,
        vx: 0,
        vy: 0,
        length,
        width: w,
        speedY: Math.random() * 0.45 + 0.35,
        sway: Math.random() * Math.PI * 2,
        swaySpeed: Math.random() * 0.016 + 0.008,
        swayMagnitude: Math.random() * 0.7 + 0.4,
        rotation: Math.random() * Math.PI * 2,
        rotationSpeed: (Math.random() - 0.5) * 0.012,
        flip: Math.random() * Math.PI * 2,
        flipSpeed: Math.random() * 0.02 + 0.01,
        windCatch: Math.random() * 0.6 + 0.8, // Sensitivity to wind
        color: isLeaf
          ? leafColors[Math.floor(Math.random() * leafColors.length)]
          : petalColors[Math.floor(Math.random() * petalColors.length)],
        alpha: Math.random() * 0.35 + 0.45
      });
    }

    // =========================================================================
    // MAIN 60FPS RENDER & PHYSICS LOOP
    // =========================================================================
    let tick = 0;
    let scrollVelocity = 0;
    let lastScrollY = window.scrollY;

    // Track scroll momentum smoothly (works with both Lenis and native scroll)
    window.addEventListener('scroll', () => {
      const currentScrollY = window.scrollY;
      const delta = currentScrollY - lastScrollY;
      lastScrollY = currentScrollY;
      // Cap maximum momentum
      scrollVelocity = Math.max(-25, Math.min(25, delta));
    }, { passive: true });

    // Also tap directly into Lenis velocity if available for ultra-smooth inertia
    if ((window as any).__lenis) {
      (window as any).__lenis.on('scroll', (e: any) => {
        if (typeof e.velocity === 'number') {
          scrollVelocity = Math.max(-25, Math.min(25, e.velocity));
        }
      });
    }

    function render() {
      if (!ctx) return;
      ctx.clearRect(0, 0, width, height);
      tick++;

      // Gradually damp scroll velocity back to zero
      scrollVelocity *= 0.92;
      const scrollBoost = Math.abs(scrollVelocity) * 0.6;

      // -----------------------------------------------------------------------
      // 1. Draw Clouds
      // -----------------------------------------------------------------------
      for (const cloud of clouds) {
        cloud.x += cloud.speedX;
        if (cloud.x - cloud.radiusX > width) {
          cloud.x = -cloud.radiusX;
        }

        const grad = ctx.createRadialGradient(
          cloud.x, cloud.y, 0,
          cloud.x, cloud.y, cloud.radiusX
        );
        grad.addColorStop(0, `rgba(255, 255, 255, ${cloud.opacity})`);
        grad.addColorStop(0.6, `rgba(255, 255, 255, ${cloud.opacity * 0.5})`);
        grad.addColorStop(1, 'rgba(255, 255, 255, 0)');

        ctx.save();
        ctx.fillStyle = grad;
        ctx.beginPath();
        ctx.ellipse(cloud.x, cloud.y, cloud.radiusX, cloud.radiusY, 0, 0, Math.PI * 2);
        ctx.fill();
        ctx.restore();
      }

      // -----------------------------------------------------------------------
      // 2. Draw Organic Curved Wind Gusts with Graceful Sweeps & Companion Trails
      // -----------------------------------------------------------------------
      for (const gust of windGusts) {
        // Boost wind gust speed when scrolling
        gust.headX += gust.speedX + scrollBoost * 0.7;

        // Reset gust when it travels beyond right edge
        if (gust.headX - gust.length > width + 100) {
          gust.headX = -100;
          gust.baseY = height * (0.15 + Math.random() * 0.7);
          gust.speedX = Math.random() * 1.4 + 2.0;
          gust.length = Math.random() * 140 + 260;
          gust.amplitude = Math.random() * 18 + 16;
        }

        // Draw Main Curved Breeze Ribbon
        ctx.save();
        const startX = gust.headX - gust.length;
        const endX = gust.headX;

        // Golden fading gradient along wind stream
        const strokeGrad = ctx.createLinearGradient(startX, gust.baseY, endX, gust.baseY);
        strokeGrad.addColorStop(0, 'rgba(184, 147, 82, 0)');
        strokeGrad.addColorStop(0.25, `rgba(184, 147, 82, ${gust.alpha * 0.5})`);
        strokeGrad.addColorStop(0.8, `rgba(212, 175, 110, ${gust.alpha * 1.1})`);
        strokeGrad.addColorStop(1, 'rgba(184, 147, 82, 0)');

        ctx.strokeStyle = strokeGrad;
        ctx.lineWidth = 1.2;
        ctx.lineCap = 'round';
        ctx.lineJoin = 'round';

        // Sample undulating bezier path
        ctx.beginPath();
        const segments = 24;
        let headWaveY = gust.baseY;

        for (let s = 0; s <= segments; s++) {
          const ratio = s / segments;
          const px = startX + ratio * gust.length;
          
          // Organic sinusoidal wave with dual-harmonic undulation
          const wave = Math.sin(px * gust.frequency + tick * 0.02 + gust.wavePhase) * gust.amplitude
                     + Math.cos(px * gust.frequency * 0.5 + tick * 0.015) * (gust.amplitude * 0.4);
          const py = gust.baseY + wave;

          if (s === 0) {
            ctx.moveTo(px, py);
          } else {
            ctx.lineTo(px, py);
          }

          if (s === segments) {
            headWaveY = py;
          }
        }

        // Optional artistic curl at the head of the breeze
        if (gust.hasCurl) {
          const curlSteps = 12;
          for (let c = 1; c <= curlSteps; c++) {
            const angle = (c / curlSteps) * Math.PI * 1.8;
            const r = gust.curlRadius * (1 - c / curlSteps * 0.6);
            const cx = endX + Math.sin(angle) * r;
            const cy = headWaveY - (1 - Math.cos(angle)) * r;
            ctx.lineTo(cx, cy);
          }
        }

        ctx.stroke();

        // Draw Companion Whispering Line (Delicate secondary trailing curve)
        ctx.beginPath();
        ctx.strokeStyle = `rgba(184, 147, 82, ${gust.alpha * 0.4})`;
        ctx.lineWidth = 0.7;
        const compStart = startX + gust.length * 0.2;
        const compLength = gust.length * 0.65;
        const compSegments = 16;

        for (let s = 0; s <= compSegments; s++) {
          const ratio = s / compSegments;
          const px = compStart + ratio * compLength;
          const wave = Math.sin(px * gust.frequency + tick * 0.025 + gust.wavePhase + 0.8) * (gust.amplitude * 0.75)
                     + Math.cos(px * gust.frequency * 0.5 + tick * 0.02) * (gust.amplitude * 0.3);
          const py = gust.baseY + gust.companionOffset + wave;

          if (s === 0) {
            ctx.moveTo(px, py);
          } else {
            ctx.lineTo(px, py);
          }
        }
        ctx.stroke();

        ctx.restore();
      }

      // -----------------------------------------------------------------------
      // 3. Falling Olive Leaves & Gold Petals (Riding the Wind Dynamics)
      // -----------------------------------------------------------------------
      for (const p of particles) {
        // Ambient background flow
        const ambientBreeze = Math.sin(tick * 0.008 + p.y * 0.003) * 0.5 + 0.35;

        // Check interaction with active wind gusts
        for (const gust of windGusts) {
          // Particle is in the horizontal corridor of the gust
          const inGustX = p.x >= (gust.headX - gust.length * 1.1) && p.x <= (gust.headX + 60);

          if (inGustX) {
            // Calculate gust's local Y position at particle's X
            const gustY = gust.baseY + Math.sin(p.x * gust.frequency + tick * 0.02 + gust.wavePhase) * gust.amplitude;
            const distY = Math.abs(p.y - gustY);

            // Within wind corridor influence (85px radius)
            if (distY < 85) {
              const influence = (1 - distY / 85);

              // 1. Particle accelerates horizontally with the wind speed!
              p.vx += influence * gust.speedX * 0.16 * p.windCatch;

              // 2. Particle undulates vertically along the wind wave slope!
              const slope = Math.cos(p.x * gust.frequency + tick * 0.02 + gust.wavePhase) * gust.amplitude * gust.frequency;
              p.vy += slope * influence * 1.2;

              // 3. Leaves flutter and spin faster when caught in the gust!
              p.rotation += p.rotationSpeed * (1 + influence * 2.8);
              p.flip += p.flipSpeed * (1 + influence * 3.0);
            }
          }
        }

        // Apply air resistance / velocity damping
        p.vx *= 0.94;
        p.vy *= 0.92;

        // Update positions with gravity, ambient breeze, dynamic wind velocities, and scroll momentum
        p.sway += p.swaySpeed;
        p.x += p.vx + Math.sin(p.sway) * p.swayMagnitude + ambientBreeze + (scrollVelocity * 0.1);
        p.y += p.speedY + p.vy + (Math.abs(scrollVelocity) * 0.22);

        p.rotation += p.rotationSpeed;
        p.flip += p.flipSpeed;

        // Wrap around bounds seamlessly
        if (p.y > height + 30) {
          p.y = -30;
          p.x = Math.random() * width;
          p.vx = 0;
          p.vy = 0;
        }
        if (p.x > width + 40) {
          p.x = -30;
        }
        if (p.x < -40) {
          p.x = width + 30;
        }

        // Render leaf / petal
        ctx.save();
        ctx.globalAlpha = p.alpha;
        ctx.translate(p.x, p.y);
        ctx.rotate(p.rotation);
        ctx.scale(Math.cos(p.flip), 1);

        if (p.type === 'leaf') {
          // Draw Organic Olive Leaf
          ctx.beginPath();
          ctx.moveTo(0, -p.length / 2);
          ctx.bezierCurveTo(
            p.width / 2, -p.length / 4,
            p.width / 2, p.length / 4,
            0, p.length / 2
          );
          ctx.bezierCurveTo(
            -p.width / 2, p.length / 4,
            -p.width / 2, -p.length / 4,
            0, -p.length / 2
          );
          ctx.closePath();
          ctx.fillStyle = p.color;
          ctx.fill();

          // Delicate Gold Central Vein
          ctx.beginPath();
          ctx.moveTo(0, -p.length / 2 + 2);
          ctx.lineTo(0, p.length / 2 - 2);
          ctx.strokeStyle = 'rgba(212, 175, 110, 0.45)';
          ctx.lineWidth = 0.6;
          ctx.stroke();
        } else {
          // Draw Golden Petal
          ctx.beginPath();
          ctx.moveTo(0, -p.length / 2);
          ctx.quadraticCurveTo(p.width * 0.7, -p.length * 0.15, p.width * 0.4, p.length / 2);
          ctx.quadraticCurveTo(0, p.length * 0.7, -p.width * 0.4, p.length / 2);
          ctx.quadraticCurveTo(-p.width * 0.7, -p.length * 0.15, 0, -p.length / 2);
          ctx.closePath();
          ctx.fillStyle = p.color;
          ctx.fill();

          // Highlight
          ctx.beginPath();
          ctx.arc(0, -p.length * 0.15, p.width * 0.25, 0, Math.PI * 2);
          ctx.fillStyle = 'rgba(255, 255, 255, 0.32)';
          ctx.fill();
        }

        ctx.restore();
      }

      requestAnimationFrame(render);
    }

    requestAnimationFrame(render);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAmbientCanvas);
  } else {
    initAmbientCanvas();
  }
</script>
