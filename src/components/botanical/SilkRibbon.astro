---
// SilkRibbon.astro — Flowing 3D Pastel Blush Silk Ribbon with Gilded Edge
interface Props {
  text?: string;
  width?: number;
  height?: number;
  className?: string;
}

const { text = "", width = 320, height = 54, className = "" } = Astro.props;
---

<div
  class={`relative inline-flex items-center justify-center select-none pointer-events-none ${className}`}
  style={`width: ${width}px; height: ${height}px;`}
  aria-hidden="true"
>
  <svg
    viewBox="0 0 320 54"
    width={width}
    height={height}
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    class="w-full h-full drop-shadow-[0_6px_16px_rgba(222,124,110,0.22)]"
  >
    <defs>
      <!-- Blush Pink Silk Gradient with Velvet Shimmer -->
      <linearGradient id="silkRibbonGrad" x1="0%" y1="0%" x2="100%" y2="0%">
        <stop offset="0%" stop-color="#EAA194" />
        <stop offset="25%" stop-color="#F7D2CC" />
        <stop offset="50%" stop-color="#FFF0ED" />
        <stop offset="75%" stop-color="#F7D2CC" />
        <stop offset="100%" stop-color="#EAA194" />
      </linearGradient>

      <!-- Ribbon Fold Shadow Gradient -->
      <linearGradient id="ribbonShadow" x1="0%" y1="0%" x2="0%" y2="100%">
        <stop offset="0%" stop-color="#C56A5C" />
        <stop offset="100%" stop-color="#9E4E42" />
      </linearGradient>

      <!-- Gilded Edge Thread -->
      <linearGradient id="goldThread" x1="0%" y1="0%" x2="100%" y2="0%">
        <stop offset="0%" stop-color="#B89352" />
        <stop offset="50%" stop-color="#FFF2CE" />
        <stop offset="100%" stop-color="#B89352" />
      </linearGradient>
    </defs>

    <!-- Left Tail Swash (Behind Main Banner) -->
    <path
      d="M 40 18 L 10 27 L 40 36 L 50 18 Z"
      fill="url(#ribbonShadow)"
    />
    <path
      d="M 10 27 L 35 12 L 55 12 L 40 36 Z"
      fill="#D98274"
      stroke="url(#goldThread)"
      stroke-width="0.8"
    />

    <!-- Right Tail Swash (Behind Main Banner) -->
    <path
      d="M 280 18 L 310 27 L 280 36 L 270 18 Z"
      fill="url(#ribbonShadow)"
    />
    <path
      d="M 310 27 L 285 12 L 265 12 L 280 36 Z"
      fill="#D98274"
      stroke="url(#goldThread)"
      stroke-width="0.8"
    />

    <!-- Main Front Silk Banner Body with Graceful Arching Undulation -->
    <path
      d="M 45 10 
         Q 160 0, 275 10 
         L 270 44 
         Q 160 34, 50 44 
         Z"
      fill="url(#silkRibbonGrad)"
      stroke="url(#goldThread)"
      stroke-width="1.2"
    />

    <!-- Top & Bottom Gilded Hem Threads -->
    <path
      d="M 46 12 Q 160 2.5, 274 12"
      stroke="#FFFFFF"
      stroke-width="0.9"
      opacity="0.8"
    />
    <path
      d="M 51 42 Q 160 32, 269 42"
      stroke="#D4AF37"
      stroke-width="0.75"
      opacity="0.7"
    />

    <!-- Optional Center Text Rendered via SVG for Crispness -->
    {text && (
      <text
        x="160"
        y="29"
        text-anchor="middle"
        font-family="'DM Sans', sans-serif"
        font-size="10"
        font-weight="600"
        letter-spacing="0.28em"
        fill="#2A3426"
      >
        {text}
      </text>
    )}
  </svg>
</div>
