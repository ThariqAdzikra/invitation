---
// RomanticSwans.astro — Pair of Symmetrical Swans Forming a Heart Shape on Water
interface Props {
  className?: string;
  size?: number;
}

const { className = "", size = 160 } = Astro.props;
---

<div class={`relative inline-flex flex-col items-center pointer-events-none select-none ${className}`} style={`width: ${size}px;`} aria-hidden="true">
  
  <svg width={size} height={Math.round(size * 0.65)} viewBox="0 0 160 104" fill="none" class="filter drop-shadow-[0_4px_12px_rgba(184,147,82,0.18)]">
    
    <!-- Water Ripple Rings at Base -->
    <ellipse cx="80" cy="92" rx="65" ry="6" stroke="#B89352" stroke-width="0.8" opacity="0.3" stroke-dasharray="3 3" />
    <ellipse cx="80" cy="94" rx="42" ry="4" stroke="#4A5D43" stroke-width="0.7" opacity="0.4" />
    <ellipse cx="80" cy="96" rx="22" ry="2.5" stroke="#B89352" stroke-width="0.6" opacity="0.5" />

    <!-- =====================================================================
         LEFT SWAN (Facing Right, Neck Curves to Center forming left half of heart)
         ===================================================================== -->
    <g class="swan-left">
      <!-- Swan Body -->
      <path 
        d="M25 82 C35 70, 52 70, 68 76 C72 78, 76 84, 72 88 C62 94, 38 94, 25 88 C20 86, 18 84, 25 82 Z" 
        fill="#FAF8F5" 
        stroke="#B89352" 
        stroke-width="1.3" 
        stroke-linejoin="round"
      />
      <!-- Wing Feathers -->
      <path d="M38 74 C48 72, 60 75, 66 80" stroke="#B89352" stroke-width="0.9" opacity="0.7" />
      <path d="M44 78 C52 77, 62 80, 68 84" stroke="#B89352" stroke-width="0.8" opacity="0.6" />
      <!-- Graceful Neck & Head (Left half of heart ♡) -->
      <path 
        d="M62 76 C55 60, 50 42, 60 26 C66 16, 75 16, 78 22 C79 24, 78 28, 75 30 C70 33, 67 46, 70 76" 
        fill="#FAF8F5" 
        stroke="#B89352" 
        stroke-width="1.3" 
        stroke-linecap="round" 
        stroke-linejoin="round"
      />
      <!-- Eye -->
      <circle cx="75" cy="24" r="1.2" fill="#2A3426" />
      <!-- Beak (Kissing at center) -->
      <path d="M78 24 L80 25 L77 27 Z" fill="#D4AF6E" stroke="#B89352" stroke-width="0.6" />
    </g>

    <!-- =====================================================================
         RIGHT SWAN (Facing Left, Neck Curves to Center forming right half of heart)
         ===================================================================== -->
    <g class="swan-right">
      <!-- Swan Body -->
      <path 
        d="M135 82 C125 70, 108 70, 92 76 C88 78, 84 84, 88 88 C98 94, 122 94, 135 88 C140 86, 142 84, 135 82 Z" 
        fill="#FAF8F5" 
        stroke="#B89352" 
        stroke-width="1.3" 
        stroke-linejoin="round"
      />
      <!-- Wing Feathers -->
      <path d="M122 74 C112 72, 100 75, 94 80" stroke="#B89352" stroke-width="0.9" opacity="0.7" />
      <path d="M116 78 C108 77, 98 80, 92 84" stroke="#B89352" stroke-width="0.8" opacity="0.6" />
      <!-- Graceful Neck & Head (Right half of heart ♡) -->
      <path 
        d="M98 76 C105 60, 110 42, 100 26 C94 16, 85 16, 82 22 C81 24, 82 28, 85 30 C90 33, 93 46, 90 76" 
        fill="#FAF8F5" 
        stroke="#B89352" 
        stroke-width="1.3" 
        stroke-linecap="round" 
        stroke-linejoin="round"
      />
      <!-- Eye -->
      <circle cx="85" cy="24" r="1.2" fill="#2A3426" />
      <!-- Beak (Kissing at center) -->
      <path d="M82 24 L80 25 L83 27 Z" fill="#D4AF6E" stroke="#B89352" stroke-width="0.6" />
    </g>

    <!-- Center Golden Love Sparkle Above Beaks -->
    <circle cx="80" cy="18" r="1.8" fill="#B89352" opacity="0.8" />
  </svg>

</div>

<style>
  .swan-left {
    transform-origin: 50px 85px;
    animation: gentleSwanBobLeft 4.5s ease-in-out infinite alternate;
  }
  .swan-right {
    transform-origin: 110px 85px;
    animation: gentleSwanBobRight 4.8s ease-in-out infinite alternate;
  }

  @keyframes gentleSwanBobLeft {
    0% { transform: translate3d(0, 0, 0) rotate(0deg); }
    100% { transform: translate3d(0, -2px, 0) rotate(-0.8deg); }
  }

  @keyframes gentleSwanBobRight {
    0% { transform: translate3d(0, 0, 0) rotate(0deg); }
    100% { transform: translate3d(0, -2px, 0) rotate(0.8deg); }
  }

  @media (prefers-reduced-motion: reduce) {
    .swan-left, .swan-right {
      animation: none !important;
    }
  }
</style>
