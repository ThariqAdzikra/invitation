---
// FloralHeroGate.astro — Grand Botanical Archway with Gilded Pillars, Pastel Peony Garland, Flying Doves & Monogram
// 100% free of human illustrations, fully SVG-rendered with high performance and zero raster fuzziness
import PastelBlossoms from './PastelBlossoms.astro';
import FlyingDoves from './FlyingDoves.astro';

interface Props {
  width?: number;
  height?: number;
  className?: string;
}

const { width = 280, height = 370, className = "" } = Astro.props;
---

<div
  class={`relative flex items-center justify-center pointer-events-none select-none ${className}`}
  style={`width: ${width}px; height: ${height}px;`}
  aria-label="Gerbang Lengkung Floral Pernikahan Zharkasi & Difa"
>
  <!-- Volumetric Sunrise Backlight Glow -->
  <div class="absolute inset-2 rounded-t-[140px] bg-[radial-gradient(ellipse_at_50%_65%,rgba(248,196,173,0.35)_0%,rgba(212,175,55,0.22)_40%,transparent_75%)] blur-xl pointer-events-none"></div>

  <!-- Flying Doves Hovering Above the Arch -->
  <div class="absolute -top-6 left-1/2 -translate-x-1/2 z-20 scale-90 sm:scale-100">
    <FlyingDoves size={130} />
  </div>

  <svg
    viewBox="0 0 280 370"
    width={width}
    height={height}
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    class="w-full h-full drop-shadow-[0_12px_32px_rgba(42,52,38,0.14)]"
  >
    <defs>
      <!-- Gilded Arch Multi-Tone Metallic Gradient -->
      <linearGradient id="gateGoldLuxe" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" stop-color="#FFF8E7" />
        <stop offset="20%" stop-color="#F2D785" />
        <stop offset="45%" stop-color="#D4AF37" />
        <stop offset="75%" stop-color="#AA822A" />
        <stop offset="100%" stop-color="#6E5018" />
      </linearGradient>

      <!-- Arch Portal Backing Gradient -->
      <linearGradient id="portalBackdrop" x1="0%" y1="0%" x2="0%" y2="100%">
        <stop offset="0%" stop-color="#FFFDF9" stop-opacity="0.9" />
        <stop offset="50%" stop-color="#FAF5EE" stop-opacity="0.75" />
        <stop offset="100%" stop-color="#F5EFE4" stop-opacity="0.9" />
      </linearGradient>

      <!-- Pillar Stone Texture Gradient -->
      <linearGradient id="pillarParchment" x1="0%" y1="0%" x2="100%" y2="0%">
        <stop offset="0%" stop-color="#FAF8F5" />
        <stop offset="50%" stop-color="#FFFFFF" />
        <stop offset="100%" stop-color="#F0EAE1" />
      </linearGradient>

      <!-- Soft Foliage Green -->
      <linearGradient id="gateLeafSage" x1="0%" y1="100%" x2="100%" y2="0%">
        <stop offset="0%" stop-color="#2D3E27" />
        <stop offset="60%" stop-color="#49633F" />
        <stop offset="100%" stop-color="#739467" />
      </linearGradient>

      <!-- Rose Blossom Gradient -->
      <radialGradient id="gateRosePink" cx="35%" cy="35%" r="65%">
        <stop offset="0%" stop-color="#FFF0ED" />
        <stop offset="40%" stop-color="#EAA194" />
        <stop offset="85%" stop-color="#DE7C6E" />
        <stop offset="100%" stop-color="#BA5648" />
      </radialGradient>

      <!-- Peach Blossom Gradient -->
      <radialGradient id="gatePeachBlossom" cx="35%" cy="35%" r="65%">
        <stop offset="0%" stop-color="#FFF5EC" />
        <stop offset="50%" stop-color="#F8C4AD" />
        <stop offset="100%" stop-color="#F2A585" />
      </radialGradient>
    </defs>

    <!-- PORTAL BACKING (Soft luminous silhouette window) -->
    <path
      d="M 40 350 L 40 140 C 40 85, 85 40, 140 40 C 195 40, 240 85, 240 140 L 240 350 Z"
      fill="url(#portalBackdrop)"
      stroke="url(#gateGoldLuxe)"
      stroke-width="1"
      stroke-dasharray="2 3"
      opacity="0.8"
    />

    <!-- Sunburst Radiance Lines from Apex inside Portal -->
    <g opacity="0.25" stroke="#B89352" stroke-width="0.8">
      <line x1="140" y1="140" x2="140" y2="45" />
      <line x1="140" y1="140" x2="80" y2="65" />
      <line x1="140" y1="140" x2="200" y2="65" />
      <line x1="140" y1="140" x2="52" y2="105" />
      <line x1="140" y1="140" x2="228" y2="105" />
    </g>

    <!-- MAIN ROMAN ARCHWAY STRUCTURE -->
    <!-- Outer Arch Frame -->
    <path
      d="M 32 355 L 32 140 C 32 80, 80 32, 140 32 C 200 32, 248 80, 248 140 L 248 355"
      stroke="url(#gateGoldLuxe)"
      stroke-width="3"
      stroke-linecap="round"
      fill="none"
    />

    <!-- Inner Arch Frame -->
    <path
      d="M 46 355 L 46 140 C 46 88, 88 46, 140 46 C 192 46, 234 88, 234 140 L 234 355"
      stroke="url(#gateGoldLuxe)"
      stroke-width="1.2"
      fill="none"
    />

    <!-- Classical Arch Finial Keystone (Apex) -->
    <path
      d="M 132 24 L 148 24 L 144 38 L 136 38 Z"
      fill="url(#gateGoldLuxe)"
      stroke="#6E5018"
      stroke-width="0.6"
    />
    <circle cx="140" cy="20" r="3" fill="url(#gateGoldLuxe)" />

    <!-- LEFT COLUMN PEDESTAL & CAPITAL -->
    <rect x="25" y="348" width="28" height="12" rx="2" fill="url(#pillarParchment)" stroke="url(#gateGoldLuxe)" stroke-width="1.2" />
    <rect x="28" y="136" width="22" height="8" rx="1.5" fill="url(#pillarParchment)" stroke="url(#gateGoldLuxe)" stroke-width="1.2" />

    <!-- RIGHT COLUMN PEDESTAL & CAPITAL -->
    <rect x="227" y="348" width="28" height="12" rx="2" fill="url(#pillarParchment)" stroke="url(#gateGoldLuxe)" stroke-width="1.2" />
    <rect x="230" y="136" width="22" height="8" rx="1.5" fill="url(#pillarParchment)" stroke="url(#gateGoldLuxe)" stroke-width="1.2" />

    <!-- CLIMBING BOTANICAL VINES & BLOSSOMS (Left Column) -->
    <!-- Winding Vine Stem -->
    <path
      d="M 39 348 C 30 310, 48 270, 36 230 C 26 190, 46 160, 38 138"
      stroke="#3D5337"
      stroke-width="1.8"
      stroke-linecap="round"
      fill="none"
    />
    <!-- Sage Leaves (Left) -->
    <path d="M 37 315 C 24 310, 26 295, 36 300 Z" fill="url(#gateLeafSage)" />
    <path d="M 40 285 C 52 280, 50 268, 41 272 Z" fill="url(#gateLeafSage)" />
    <path d="M 35 250 C 22 245, 24 230, 34 235 Z" fill="url(#gateLeafSage)" />
    <path d="M 38 210 C 50 205, 48 190, 39 198 Z" fill="url(#gateLeafSage)" />
    <path d="M 36 175 C 24 170, 26 156, 35 162 Z" fill="url(#gateLeafSage)" />

    <!-- Left Flowers Clusters -->
    <!-- Blossom 1 (Bottom) -->
    <circle cx="34" cy="305" r="7.5" fill="url(#gateRosePink)" stroke="#BA5648" stroke-width="0.6" />
    <circle cx="34" cy="305" r="3.5" fill="#FFF0ED" />
    <circle cx="43" cy="312" r="1.8" fill="#D4AF37" />

    <!-- Blossom 2 (Middle) -->
    <circle cx="42" cy="240" r="7" fill="url(#gatePeachBlossom)" stroke="#DE7C6E" stroke-width="0.6" />
    <circle cx="42" cy="240" r="3" fill="#FFF5EC" />
    <circle cx="32" cy="235" r="1.8" fill="#D4AF37" />

    <!-- Blossom 3 (Upper Column) -->
    <circle cx="36" cy="165" r="8" fill="url(#gateRosePink)" stroke="#BA5648" stroke-width="0.6" />
    <circle cx="36" cy="165" r="3.8" fill="#FFF0ED" />
    <circle cx="46" cy="160" r="2" fill="#D4AF37" />

    <!-- CLIMBING BOTANICAL VINES & BLOSSOMS (Right Column) -->
    <!-- Winding Vine Stem -->
    <path
      d="M 241 348 C 250 310, 232 270, 244 230 C 254 190, 234 160, 242 138"
      stroke="#3D5337"
      stroke-width="1.8"
      stroke-linecap="round"
      fill="none"
    />
    <!-- Sage Leaves (Right) -->
    <path d="M 243 315 C 256 310, 254 295, 244 300 Z" fill="url(#gateLeafSage)" />
    <path d="M 240 285 C 228 280, 230 268, 239 272 Z" fill="url(#gateLeafSage)" />
    <path d="M 245 250 C 258 245, 256 230, 246 235 Z" fill="url(#gateLeafSage)" />
    <path d="M 242 210 C 230 205, 232 190, 241 198 Z" fill="url(#gateLeafSage)" />
    <path d="M 244 175 C 256 170, 254 156, 245 162 Z" fill="url(#gateLeafSage)" />

    <!-- Right Flowers Clusters -->
    <!-- Blossom 1 (Bottom) -->
    <circle cx="246" cy="305" r="7.5" fill="url(#gatePeachBlossom)" stroke="#DE7C6E" stroke-width="0.6" />
    <circle cx="246" cy="305" r="3.5" fill="#FFF5EC" />
    <circle cx="237" cy="312" r="1.8" fill="#D4AF37" />

    <!-- Blossom 2 (Middle) -->
    <circle cx="238" cy="240" r="7" fill="url(#gateRosePink)" stroke="#BA5648" stroke-width="0.6" />
    <circle cx="238" cy="240" r="3" fill="#FFF0ED" />
    <circle cx="248" cy="235" r="1.8" fill="#D4AF37" />

    <!-- Blossom 3 (Upper Column) -->
    <circle cx="244" cy="165" r="8" fill="url(#gatePeachBlossom)" stroke="#DE7C6E" stroke-width="0.6" />
    <circle cx="244" cy="165" r="3.8" fill="#FFF5EC" />
    <circle cx="234" cy="160" r="2" fill="#D4AF37" />

    <!-- ARCH CROWN GARLAND (Sweeping Across the Top Arch) -->
    <!-- Foliage sprays across the top curve -->
    <path d="M 45 140 C 65 75, 110 45, 140 45 C 170 45, 215 75, 235 140" stroke="#3D5337" stroke-width="2" fill="none" />

    <!-- Top Arch Blossom Sprays -->
    <!-- Left Shoulder Blossom -->
    <circle cx="82" cy="78" r="9" fill="url(#gateRosePink)" stroke="#BA5648" stroke-width="0.7" />
    <circle cx="82" cy="78" r="4.2" fill="#FFF0ED" />
    <circle cx="72" cy="70" r="2" fill="#D4AF37" />
    <path d="M 72 88 C 60 88, 62 76, 73 80 Z" fill="url(#gateLeafSage)" />

    <!-- Left Mid Arch Blossom -->
    <circle cx="112" cy="54" r="8" fill="url(#gatePeachBlossom)" stroke="#DE7C6E" stroke-width="0.7" />
    <circle cx="112" cy="54" r="3.8" fill="#FFF5EC" />
    <path d="M 102 46 C 96 36, 108 34, 110 44 Z" fill="url(#gateLeafSage)" />

    <!-- Right Mid Arch Blossom -->
    <circle cx="168" cy="54" r="8" fill="url(#gateRosePink)" stroke="#BA5648" stroke-width="0.7" />
    <circle cx="168" cy="54" r="3.8" fill="#FFF0ED" />
    <path d="M 178 46 C 184 36, 172 34, 170 44 Z" fill="url(#gateLeafSage)" />

    <!-- Right Shoulder Blossom -->
    <circle cx="198" cy="78" r="9" fill="url(#gatePeachBlossom)" stroke="#DE7C6E" stroke-width="0.7" />
    <circle cx="198" cy="78" r="4.2" fill="#FFF5EC" />
    <circle cx="208" cy="70" r="2" fill="#D4AF37" />
    <path d="M 208 88 C 220 88, 218 76, 207 80 Z" fill="url(#gateLeafSage)" />

    <!-- CENTER SUSPENDED ROYAL MONOGRAM MEDALLION ('ZD') -->
    <g class="transform transition-transform hover:scale-105">
      <!-- Silk Suspension Ribbon from Apex -->
      <line x1="140" y1="36" x2="140" y2="76" stroke="url(#gateGoldLuxe)" stroke-width="1.4" />
      <circle cx="140" cy="76" r="2.2" fill="url(#gateGoldLuxe)" />

      <!-- Monogram Medallion Body -->
      <circle cx="140" cy="112" r="30" fill="#FAF8F5" stroke="url(#gateGoldLuxe)" stroke-width="2" filter="drop-shadow(0 4px 12px rgba(42,52,38,0.15))" />
      <circle cx="140" cy="112" r="26" fill="none" stroke="#B89352" stroke-width="0.8" stroke-dasharray="2 2" opacity="0.7" />

      <!-- Monogram 'ZD' Typography -->
      <text
        x="140"
        y="118"
        font-family="'Playfair Display', 'Cormorant Garamond', serif"
        font-size="18"
        font-style="italic"
        font-weight="600"
        fill="#2A3426"
        text-anchor="middle"
        letter-spacing="1.5"
      >ZD</text>

      <!-- Tiny Star Finial Beneath Medallion -->
      <path d="M 140 144 Q 140 148 138 148 Q 140 148 140 152 Q 140 148 142 148 Q 140 148 140 144 Z" fill="url(#gateGoldLuxe)" />
    </g>

    <!-- Bottom Botanical Ground Border -->
    <g opacity="0.85">
      <!-- Left Ground Sprig -->
      <path d="M 15 365 C 30 355, 45 358, 60 365" stroke="#3D5337" stroke-width="1.4" fill="none" />
      <circle cx="28" cy="358" r="4" fill="url(#gateRosePink)" />
      <circle cx="45" cy="358" r="3.5" fill="url(#gatePeachBlossom)" />

      <!-- Right Ground Sprig -->
      <path d="M 220 365 C 235 355, 250 358, 265 365" stroke="#3D5337" stroke-width="1.4" fill="none" />
      <circle cx="235" cy="358" r="3.5" fill="url(#gatePeachBlossom)" />
      <circle cx="252" cy="358" r="4" fill="url(#gateRosePink)" />
    </g>
  </svg>
</div>
