---
// FloralBouquet.astro — Lavish Crown Bouquet Centerpiece with Roses, Peonies, Olive Branches & Gold Berries
interface Props {
  className?: string;
  width?: number;
  height?: number;
}

const { className = "", width = 300, height = 75 } = Astro.props;
---

<div class={`flex items-center justify-center select-none pointer-events-none ${className}`} aria-hidden="true">
  <svg width={width} height={height} viewBox="0 0 300 75" fill="none" class="w-full h-auto max-w-[300px] drop-shadow-[0_2px_4px_rgba(42,52,38,0.08)]">
    
    <!-- Outer Arching Vines with Olive Leaves (Background Foliage) -->
    <path d="M110 38 C70 32, 35 20, 10 38" stroke="#4A5C43" stroke-width="1.6" stroke-linecap="round" />
    <path d="M190 38 C230 32, 265 20, 290 38" stroke="#4A5C43" stroke-width="1.6" stroke-linecap="round" />

    <!-- Left Foliage Leaves -->
    <path d="M98 33 C94 22, 82 23, 80 30 C86 35, 94 36, 98 33 Z" fill="#5E7455" />
    <path d="M72 30 C66 39, 54 37, 53 30 C60 26, 68 27, 72 30 Z" fill="#4A5C43" />
    <path d="M58 25 C53 16, 42 18, 41 25 C47 29, 55 28, 58 25 Z" fill="#718B67" />
    <path d="M38 28 C32 36, 22 34, 21 28 C27 24, 34 25, 38 28 Z" fill="#5E7455" />
    <path d="M22 34 C16 26, 8 28, 7 34 C12 37, 18 37, 22 34 Z" fill="#4A5C43" />

    <!-- Right Foliage Leaves -->
    <path d="M202 33 C206 22, 218 23, 220 30 C214 35, 206 36, 202 33 Z" fill="#5E7455" />
    <path d="M228 30 C234 39, 246 37, 247 30 C240 26, 232 27, 228 30 Z" fill="#4A5C43" />
    <path d="M242 25 C247 16, 258 18, 259 25 C253 29, 245 28, 242 25 Z" fill="#718B67" />
    <path d="M262 28 C268 36, 278 34, 279 28 C273 24, 266 25, 262 28 Z" fill="#5E7455" />
    <path d="M278 34 C284 26, 292 28, 293 34 C288 37, 282 37, 278 34 Z" fill="#4A5C43" />

    <!-- Left Side Blooming Bud -->
    <g transform="translate(82, 14)">
      <circle cx="8" cy="8" r="6" fill="#FAF6EE" stroke="#B89352" stroke-width="1.1" />
      <path d="M6 7 C8 4, 11 5, 10 9 C7 11, 5 9, 6 7 Z" fill="#E8DEC8" />
      <path d="M4 11 C3 14, 1 16, 3 17 Z" fill="#5E7455" />
      <path d="M12 11 C13 14, 15 16, 13 17 Z" fill="#5E7455" />
    </g>

    <!-- Right Side Blooming Bud -->
    <g transform="translate(202, 14)">
      <circle cx="8" cy="8" r="6" fill="#FAF6EE" stroke="#B89352" stroke-width="1.1" />
      <path d="M10 7 C8 4, 5 5, 6 9 C9 11, 11 9, 10 7 Z" fill="#E8DEC8" />
      <path d="M12 11 C13 14, 15 16, 13 17 Z" fill="#5E7455" />
      <path d="M4 11 C3 14, 1 16, 3 17 Z" fill="#5E7455" />
    </g>

    <!-- Golden Olive Berries Flanking Bouquet -->
    <circle cx="88" cy="42" r="2.5" fill="#B89352" />
    <circle cx="50" cy="20" r="2.2" fill="#B89352" />
    <circle cx="30" cy="38" r="2.2" fill="#B89352" />
    <circle cx="212" cy="42" r="2.5" fill="#B89352" />
    <circle cx="250" cy="20" r="2.2" fill="#B89352" />
    <circle cx="270" cy="38" r="2.2" fill="#B89352" />

    <!-- Center Grand Peony / Rose Blossom -->
    <!-- Center Leaves Backing -->
    <path d="M135 24 C130 14, 120 18, 122 26 Z" fill="#5E7455" />
    <path d="M165 24 C170 14, 180 18, 178 26 Z" fill="#5E7455" />
    <path d="M150 56 C155 64, 164 62, 162 55 Z" fill="#4A5C43" />
    <path d="M150 56 C145 64, 136 62, 138 55 Z" fill="#4A5C43" />

    <!-- Center Outer Petals -->
    <circle cx="150" cy="38" r="18" fill="#FAF8F2" stroke="#B89352" stroke-width="1.4" />
    
    <!-- Overlapping Petal Swirls -->
    <path d="M150 22 C156 16, 168 20, 165 29 C162 33, 154 32, 150 22 Z" fill="#FFFFFF" stroke="#566A4E" stroke-width="0.7" />
    <path d="M166 30 C174 32, 175 44, 165 47 C158 45, 157 37, 166 30 Z" fill="#FFFFFF" stroke="#566A4E" stroke-width="0.7" />
    <path d="M164 48 C166 56, 154 60, 147 54 C147 48, 156 46, 164 48 Z" fill="#FFFFFF" stroke="#566A4E" stroke-width="0.7" />
    <path d="M145 53 C136 56, 130 47, 135 41 C140 40, 144 48, 145 53 Z" fill="#FFFFFF" stroke="#566A4E" stroke-width="0.7" />
    <path d="M136 40 C128 35, 132 23, 141 26 C144 32, 139 37, 136 40 Z" fill="#FFFFFF" stroke="#566A4E" stroke-width="0.7" />

    <!-- Inner Rose Core -->
    <circle cx="150" cy="38" r="8" fill="#F4EDE0" stroke="#B89352" stroke-width="1" />
    <circle cx="150" cy="38" r="4" fill="#B89352" />
    <!-- Gold Stamen Dots -->
    <circle cx="147" cy="35" r="1.2" fill="#FAF8F5" />
    <circle cx="153" cy="36" r="1.2" fill="#FAF8F5" />
    <circle cx="150" cy="41" r="1.2" fill="#FAF8F5" />

    <!-- Delicate Lower Swash Ribbon -->
    <path d="M120 48 Q150 62 180 48" stroke="#B89352" stroke-width="0.8" stroke-dasharray="2 1.5" />
  </svg>
</div>