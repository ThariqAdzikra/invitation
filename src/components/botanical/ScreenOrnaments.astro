---
// ScreenOrnaments.astro — Royal Botanical Bridal Stationery Framing (Rame, Cutie & Aesthetic)
// Frames the viewport with high-resolution watercolor floral corner arrangements,
// double archival gold stationery hairline border, and fluttering golden butterflies.
---

<!-- 1. FULL-VIEWPORT ARCHIVAL GOLD STATIONERY FRAME -->
<div class="fixed inset-2.5 sm:inset-4 md:inset-6 pointer-events-none z-[9990] select-none" aria-hidden="true">
  <!-- Outer Gold Hairline Border -->
  <div class="absolute inset-0 rounded-2xl sm:rounded-3xl border border-[#B89352]/30 shadow-[inset_0_0_30px_rgba(184,147,82,0.05)]"></div>
  
  <!-- Inner Dashed Fine Jewelry Border -->
  <div class="absolute inset-1.5 sm:inset-2.5 rounded-xl sm:rounded-2xl border border-dashed border-[#B89352]/20"></div>

  <!-- Four Ornate Corner Fleurons -->
  <div class="absolute top-2 left-2 text-[#B89352]/60 text-[0.65rem] sm:text-xs select-none">
    <span>✦</span>
  </div>
  <div class="absolute top-2 right-2 text-[#B89352]/60 text-[0.65rem] sm:text-xs select-none">
    <span>✦</span>
  </div>
  <div class="absolute bottom-2 left-2 text-[#B89352]/60 text-[0.65rem] sm:text-xs select-none">
    <span>✦</span>
  </div>
  <div class="absolute bottom-2 right-2 text-[#B89352]/60 text-[0.65rem] sm:text-xs select-none">
    <span>✦</span>
  </div>
</div>

<!-- 2. HIGH-RESOLUTION WATERCOLOR FLORAL CORNER SUITE (Rame & Cutie) -->
<!-- Top-Left Corner Bouquet -->
<div class="fixed top-0 left-0 z-[10000] pointer-events-none select-none overflow-hidden" aria-hidden="true">
  <img
    src="/assets/floral-corner-top.png"
    alt=""
    class="w-32 sm:w-48 md:w-60 lg:w-72 h-auto filter drop-shadow-[0_8px_24px_rgba(42,52,38,0.12)] transition-transform duration-700 hover:scale-105"
    loading="eager"
  />
</div>

<!-- Top-Right Corner Bouquet (Mirrored) -->
<div class="fixed top-0 right-0 z-[10000] pointer-events-none select-none overflow-hidden" aria-hidden="true">
  <img
    src="/assets/floral-corner-top.png"
    alt=""
    class="w-32 sm:w-48 md:w-60 lg:w-72 h-auto filter drop-shadow-[0_8px_24px_rgba(42,52,38,0.12)] scale-x-[-1] transition-transform duration-700 hover:scale-105"
    loading="eager"
  />
</div>

<!-- Bottom-Left Corner Garden Bouquet -->
<div class="fixed bottom-0 left-0 z-[10000] pointer-events-none select-none overflow-hidden" aria-hidden="true">
  <img
    src="/assets/floral-corner-bottom.png"
    alt=""
    class="w-36 sm:w-52 md:w-64 lg:w-80 h-auto filter drop-shadow-[0_-6px_24px_rgba(42,52,38,0.10)] transition-transform duration-700 hover:scale-105"
    loading="eager"
  />
</div>

<!-- Bottom-Right Corner Garden Bouquet (Mirrored) -->
<div class="fixed bottom-0 right-0 z-[10000] pointer-events-none select-none overflow-hidden" aria-hidden="true">
  <img
    src="/assets/floral-corner-bottom.png"
    alt=""
    class="w-36 sm:w-52 md:w-64 lg:w-80 h-auto filter drop-shadow-[0_-6px_24px_rgba(42,52,38,0.10)] scale-x-[-1] transition-transform duration-700 hover:scale-105"
    loading="eager"
  />
</div>

<!-- 3. FLUTTERING GOLDEN BUTTERFLIES (Left & Right Flanks) -->
<div class="fixed inset-y-0 left-2 sm:left-4 md:left-8 w-12 pointer-events-none z-[9995] hidden sm:flex flex-col justify-around py-32 select-none" aria-hidden="true">
  <!-- Butterfly 1 (Upper Left) -->
  <div class="transform hover:scale-110 transition-transform duration-500 animate-pulse">
    <svg width="26" height="23" viewBox="0 0 32 28" fill="none" class="opacity-75 filter drop-shadow-xs">
      <defs>
        <linearGradient id="bfGoldLeft1" x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" stop-color="#FFF2CE" />
          <stop offset="50%" stop-color="#D4AF37" />
          <stop offset="100%" stop-color="#AA822A" />
        </linearGradient>
      </defs>
      <!-- Left Wings -->
      <path d="M 16 14 C 12 4, 2 6, 2 16 C 6 22, 14 18, 16 14 Z" fill="url(#bfGoldLeft1)" />
      <path d="M 16 14 C 12 20, 4 22, 6 26 C 10 28, 15 22, 16 14 Z" fill="#EAA194" opacity="0.8" />
      <!-- Right Wings -->
      <path d="M 16 14 C 20 4, 30 6, 30 16 C 26 22, 18 18, 16 14 Z" fill="url(#bfGoldLeft1)" />
      <path d="M 16 14 C 20 20, 28 22, 26 26 C 22 28, 17 22, 16 14 Z" fill="#EAA194" opacity="0.8" />
      <!-- Body & Antennae -->
      <line x1="16" y1="8" x2="16" y2="24" stroke="#6E5018" stroke-width="1.2" stroke-linecap="round" />
      <path d="M 16 8 Q 13 4 11 3 M 16 8 Q 19 4 21 3" stroke="#B89352" stroke-width="0.8" fill="none" />
    </svg>
  </div>

  <!-- Butterfly 2 (Lower Left) -->
  <div class="transform -rotate-12 translate-x-2 opacity-65">
    <svg width="22" height="19" viewBox="0 0 32 28" fill="none" class="filter drop-shadow-xs">
      <path d="M 16 14 C 12 5, 3 7, 3 16 C 7 21, 14 18, 16 14 Z" fill="#F8C4AD" />
      <path d="M 16 14 C 20 5, 29 7, 29 16 C 25 21, 18 18, 16 14 Z" fill="#F8C4AD" />
      <line x1="16" y1="10" x2="16" y2="22" stroke="#AA822A" stroke-width="1" stroke-linecap="round" />
    </svg>
  </div>
</div>

<div class="fixed inset-y-0 right-2 sm:right-4 md:right-8 w-12 pointer-events-none z-[9995] hidden sm:flex flex-col justify-around py-36 select-none" aria-hidden="true">
  <!-- Butterfly 3 (Upper Right) -->
  <div class="transform rotate-12 -translate-x-2 opacity-70">
    <svg width="23" height="20" viewBox="0 0 32 28" fill="none" class="filter drop-shadow-xs">
      <path d="M 16 14 C 12 5, 3 7, 3 16 C 7 21, 14 18, 16 14 Z" fill="#F8C4AD" />
      <path d="M 16 14 C 20 5, 29 7, 29 16 C 25 21, 18 18, 16 14 Z" fill="#F8C4AD" />
      <line x1="16" y1="10" x2="16" y2="22" stroke="#AA822A" stroke-width="1" stroke-linecap="round" />
    </svg>
  </div>

  <!-- Butterfly 4 (Lower Right) -->
  <div class="transform -rotate-6 hover:scale-110 transition-transform duration-500 animate-pulse">
    <svg width="25" height="22" viewBox="0 0 32 28" fill="none" class="opacity-80 filter drop-shadow-xs">
      <path d="M 16 14 C 12 4, 2 6, 2 16 C 6 22, 14 18, 16 14 Z" fill="#D4AF37" />
      <path d="M 16 14 C 20 4, 30 6, 30 16 C 26 22, 18 18, 16 14 Z" fill="#D4AF37" />
      <line x1="16" y1="8" x2="16" y2="24" stroke="#6E5018" stroke-width="1.2" stroke-linecap="round" />
    </svg>
  </div>
</div>
