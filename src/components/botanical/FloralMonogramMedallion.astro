---
// FloralMonogramMedallion.astro — Royal Botanical Monogram Medallion (100% Free of Human Avatars)
import FloralWreath from './FloralWreath.astro';

interface Props {
  initial: "Z" | "D";
  role: "groom" | "bride";
  fullName: string;
  parents: string;
  instagram: string;
  quote: string;
  size?: number;
}

const {
  initial,
  role,
  fullName,
  parents,
  instagram,
  quote,
  size = 110
} = Astro.props;

const isGroom = role === "groom";
---

<div class="flex flex-col items-center text-center will-change-transform flex-1 max-w-[210px] sm:max-w-[240px]">
  
  <!-- The Ornate Botanical Wreath Medallion -->
  <div class="relative mb-2.5 group will-change-transform">
    <!-- Ambient Halo Glow -->
    <div class="absolute -inset-3 rounded-full bg-[radial-gradient(circle,rgba(212,175,55,0.22)_0%,transparent_70%)] blur-md pointer-events-none"></div>

    <!-- The Circular Plaque with Royal Floral Wreath -->
    <div class="rounded-full p-1.5 border border-[#B89352]/40 bg-gradient-to-tr from-[#FFFDF9] via-[#FAF8F5] to-[#F7F1E6] shadow-[0_8px_24px_rgba(42,52,38,0.08)] flex items-center justify-center">
      <FloralWreath monogram={initial} size={size} />
    </div>
  </div>

  <!-- Editorial Profile Details -->
  <div class="flex flex-col items-center text-center will-change-transform">
    <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-[#FAF8F5] border border-[#B89352]/30 mb-1 shadow-2xs">
      <span class="w-1 h-1 rounded-full bg-[#B89352]"></span>
      <p class="text-[0.50rem] sm:text-[0.58rem] tracking-[0.24em] text-[#B89352] uppercase font-semibold">
        {isGroom ? "Mempelai Pria" : "Mempelai Wanita"}
      </p>
      <span class="w-1 h-1 rounded-full bg-[#B89352]"></span>
    </div>

    <h3 class="font-display text-xs sm:text-base md:text-lg text-[#2A3426] font-normal leading-snug">
      {fullName}
    </h3>

    <p class="text-[0.54rem] sm:text-[0.62rem] text-[#566A4E] font-light mt-0.5 italic">
      {parents}
    </p>

    <!-- Romantic Quote -->
    <p class="font-display italic text-[0.62rem] sm:text-[0.72rem] text-[#4A5D43] leading-relaxed mt-1.5 px-1 max-w-[210px]">
      &ldquo;{quote}&rdquo;
    </p>

    <!-- Instagram Handle Link -->
    <a 
      href={`https://instagram.com/${instagram.replace('@', '')}`} 
      target="_blank" 
      rel="noopener noreferrer" 
      class="inline-flex items-center gap-1 text-[0.50rem] sm:text-[0.58rem] text-[#7E8F77] hover:text-[#B89352] tracking-wider uppercase font-medium mt-1.5 transition-colors"
    >
      <span>{instagram}</span>
      <svg width="8" height="8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6M15 3h6v6M10 14L21 3"/>
      </svg>
    </a>
  </div>

</div>
