---
// FloralCorner.astro — Authentic Botanical Leaf Corner with Real Olive Branches & Ginkgo Leaves
interface Props {
  position?: "top-left" | "top-right" | "bottom-left" | "bottom-right";
  size?: number;
  className?: string;
}

const { position = "top-left", size = 110, className = "" } = Astro.props;

let transform = "";
if (position === "top-right") transform = "scaleX(-1)";
if (position === "bottom-left") transform = "scaleY(-1)";
if (position === "bottom-right") transform = "scale(-1, -1)";
---

<div
  class={`pointer-events-none select-none transition-transform duration-500 ${className}`}
  style={`width: ${size}px; height: ${size}px; transform: ${transform};`}
  aria-hidden="true"
>
  <svg
    width={size}
    height={size}
    viewBox="0 0 140 140"
    fill="none"
    class="w-full h-full drop-shadow-[0_2px_8px_rgba(42,52,38,0.1)]"
  >
    <!-- 1. NATURAL WOODY BOTANICAL STEMS -->
    <!-- Main Arching Branch -->
    <path
      d="M 2 2 C 16 10, 32 24, 46 44 C 58 66, 72 94, 82 124"
      stroke="#43553C"
      stroke-width="1.8"
      stroke-linecap="round"
      fill="none"
    />
    <!-- Lateral Upper Twig -->
    <path
      d="M 32 24 C 52 20, 78 22, 114 30"
      stroke="#43553C"
      stroke-width="1.4"
      stroke-linecap="round"
      fill="none"
    />
    <!-- Lateral Lower Twig -->
    <path
      d="M 58 66 C 76 62, 98 66, 116 74"
      stroke="#43553C"
      stroke-width="1.2"
      stroke-linecap="round"
      fill="none"
    />

    <!-- 2. GINKGO BILOBA FAN LEAF (Corner Base Accent) -->
    <!-- Ginkgo Petiole -->
    <path
      d="M 20 16 C 14 26, 10 38, 12 48"
      stroke="#8C703C"
      stroke-width="1.2"
      stroke-linecap="round"
      fill="none"
    />
    <!-- Ginkgo Fan Blade with Distinct Notched Margin -->
    <path
      d="M 12 48 C 4 42, -2 32, 2 20 C 6 8, 18 2, 30 4 C 40 6, 44 16, 40 26 C 34 38, 22 46, 12 48 Z"
      fill="#C4A259"
      opacity="0.92"
    />
    <!-- Ginkgo Delicate Radiating Veins -->
    <path d="M 12 48 Q 8 32 4 22" stroke="#FAF8F5" stroke-width="0.6" opacity="0.65" />
    <path d="M 12 48 Q 16 28 18 10" stroke="#FAF8F5" stroke-width="0.6" opacity="0.65" />
    <path d="M 12 48 Q 26 28 34 14" stroke="#FAF8F5" stroke-width="0.6" opacity="0.65" />

    <!-- 3. REAL LUSH OLIVE LEAVES (Upper Branch) -->
    <!-- Leaf 1 (Large Olive Leaf - Pointing Right) -->
    <g>
      <path
        d="M 48 22 C 60 8, 82 6, 96 12 C 86 24, 70 30, 48 22 Z"
        fill="#4A5F41"
      />
      <!-- Leaf Midrib Central Vein -->
      <path d="M 48 22 Q 72 16 96 12" stroke="#FAF8F5" stroke-width="0.75" stroke-linecap="round" opacity="0.65" />
    </g>

    <!-- Leaf 2 (Paired Leaf - Drooping Downward) -->
    <g>
      <path
        d="M 52 23 C 46 36, 52 52, 64 60 C 66 46, 60 32, 52 23 Z"
        fill="#5E7854"
      />
      <path d="M 52 23 Q 56 42 64 60" stroke="#FAF8F5" stroke-width="0.7" stroke-linecap="round" opacity="0.6" />
    </g>

    <!-- Leaf 3 (Mid-Upper Branch) -->
    <g>
      <path
        d="M 76 22 C 90 10, 108 12, 118 20 C 104 26, 90 28, 76 22 Z"
        fill="#3D5036"
      />
      <path d="M 76 22 Q 98 16 118 20" stroke="#FAF8F5" stroke-width="0.7" stroke-linecap="round" opacity="0.65" />
    </g>

    <!-- Leaf 4 (Tip Leaflet of Upper Branch) -->
    <g>
      <path
        d="M 104 27 C 116 23, 130 26, 136 31 C 124 36, 112 34, 104 27 Z"
        fill="#556E4D"
      />
      <path d="M 104 27 Q 120 27 136 31" stroke="#FAF8F5" stroke-width="0.6" stroke-linecap="round" opacity="0.55" />
    </g>

    <!-- 4. SECONDARY GINKGO LEAFLET (Mid-Cluster) -->
    <g>
      <path
        d="M 32 30 C 24 38, 22 48, 26 58"
        stroke="#43553C"
        stroke-width="1.1"
        fill="none"
      />
      <path
        d="M 26 58 C 16 54, 10 44, 13 34 C 16 24, 28 20, 38 24 C 44 34, 36 50, 26 58 Z"
        fill="#58704F"
        opacity="0.9"
      />
      <path d="M 26 58 Q 20 44 16 34" stroke="#FAF8F5" stroke-width="0.6" opacity="0.55" />
      <path d="M 26 58 Q 28 40 30 26" stroke="#FAF8F5" stroke-width="0.6" opacity="0.55" />
    </g>

    <!-- 5. REAL LUSH OLIVE LEAVES (Mid & Lower Main Stem) -->
    <!-- Leaf 5 (Large Olive Leaf - Arching Left) -->
    <g>
      <path
        d="M 46 44 C 36 58, 40 76, 52 86 C 56 70, 54 54, 46 44 Z"
        fill="#42573A"
      />
      <path d="M 46 44 Q 46 66 52 86" stroke="#FAF8F5" stroke-width="0.75" stroke-linecap="round" opacity="0.65" />
    </g>

    <!-- Leaf 6 (Mid Leaf - Arching Inward) -->
    <g>
      <path
        d="M 50 48 C 66 40, 86 46, 96 56 C 82 62, 64 60, 50 48 Z"
        fill="#6A8561"
      />
      <path d="M 50 48 Q 73 46 96 56" stroke="#FAF8F5" stroke-width="0.7" stroke-linecap="round" opacity="0.6" />
    </g>

    <!-- Leaf 7 (Lower Lateral Branch Leaf) -->
    <g>
      <path
        d="M 66 74 C 82 66, 104 70, 116 80 C 100 86, 82 84, 66 74 Z"
        fill="#536C4B"
      />
      <path d="M 66 74 Q 92 72 116 80" stroke="#FAF8F5" stroke-width="0.7" stroke-linecap="round" opacity="0.65" />
    </g>

    <!-- Leaf 8 (Lower Stem Hanging Leaf) -->
    <g>
      <path
        d="M 70 80 C 62 94, 66 112, 78 122 C 82 106, 80 90, 70 80 Z"
        fill="#3A4D34"
      />
      <path d="M 70 80 Q 72 102 78 122" stroke="#FAF8F5" stroke-width="0.7" stroke-linecap="round" opacity="0.65" />
    </g>

    <!-- Leaf 9 (Terminal Stem Leaflet) -->
    <g>
      <path
        d="M 82 124 C 88 135, 92 142, 94 145 C 86 140, 80 131, 82 124 Z"
        fill="#5C7554"
      />
      <path d="M 82 124 Q 88 135 94 145" stroke="#FAF8F5" stroke-width="0.5" stroke-linecap="round" opacity="0.6" />
    </g>

    <!-- 6. DELICATE OLIVE BERRIES & GOLDEN ACCENTS -->
    <!-- Berry 1 (Gold Accent on Upper Branch) -->
    <ellipse cx="54" cy="36" rx="2.8" ry="3.8" transform="rotate(25 54 36)" fill="#B89352" />
    <path d="M 52 28 Q 53 32 54 34" stroke="#43553C" stroke-width="0.8" fill="none" />

    <!-- Berry 2 (Deep Olive Berry on Mid Twig) -->
    <ellipse cx="76" cy="60" rx="2.8" ry="3.8" transform="rotate(-15 76 60)" fill="#2F3E2A" />
    <path d="M 70 65 Q 73 62 75 60" stroke="#43553C" stroke-width="0.8" fill="none" />

    <!-- Berry 3 (Gold Accent on Upper Tip) -->
    <ellipse cx="92" cy="20" rx="2.4" ry="3.2" transform="rotate(35 92 20)" fill="#B89352" />
    <path d="M 86 23 Q 89 21 91 20" stroke="#43553C" stroke-width="0.8" fill="none" />
  </svg>
</div>
