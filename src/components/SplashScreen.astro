---
// SplashScreen.astro — Haute-Couture Wedding Stationery Envelope Unboxing
// Luxury Pinterest Flat-Lay Editorial: Botanical Flat-Lay Corners, 3D Gyro Parallax Tilt, Gilded Wax Seal & Confetti Burst
import content from '../data/content.json';
import FloralWreath from './botanical/FloralWreath.astro';
import FloralFlourish from './botanical/FloralFlourish.astro';
import FloralCorner from './botanical/FloralCorner.astro';
---

<div
  id="envelope-screen"
  class="fixed inset-0 z-[9999] flex flex-col items-center justify-center p-4 sm:p-6 bg-[#FAF8F5] select-none overflow-hidden will-change-transform"
  role="dialog"
  aria-modal="true"
  aria-label="Amplop Undangan Pernikahan"
>
  <!-- Fine Linen Paper Texture & Ambient Warm Gold Spotlight -->
  <div class="absolute inset-0 pointer-events-none bg-[radial-gradient(ellipse_at_50%_45%,rgba(212,175,55,0.12)_0%,rgba(250,248,245,0.45)_50%,rgba(238,231,219,0.92)_100%)]" aria-hidden="true"></div>
  <div class="absolute inset-0 pointer-events-none opacity-30 bg-[radial-gradient(rgba(184,147,82,0.14)_1px,transparent_1px)] [background-size:24px_24px]"></div>

  <!-- FLAT-LAY ENVELOPE WATERCOLOR BOTANICAL CORNERS (Visible ONLY on envelope screen; completely dissolves when unboxed) -->
  <div class="splash-botanical-corners absolute inset-0 pointer-events-none z-10 transition-opacity duration-700 overflow-hidden">
    <div class="absolute top-0 left-0">
      <img src="/assets/floral-corner-top.png" alt="" class="w-28 sm:w-44 md:w-56 h-auto opacity-85 block" />
    </div>
    <div class="absolute top-0 right-0">
      <img src="/assets/floral-corner-top.png" alt="" class="w-28 sm:w-44 md:w-56 h-auto opacity-85 block scale-x-[-1]" />
    </div>
    <div class="absolute bottom-0 left-0">
      <img src="/assets/floral-corner-bottom.png" alt="" class="w-32 sm:w-48 md:w-60 h-auto opacity-85 block" />
    </div>
    <div class="absolute bottom-0 right-0">
      <img src="/assets/floral-corner-bottom.png" alt="" class="w-32 sm:w-48 md:w-60 h-auto opacity-85 block scale-x-[-1]" />
    </div>
  </div>

  <!-- EDITORIAL HEADER (Unopened Letter Invitation Header — No Spoilers) -->
  <div id="splash-editorial-header" class="flex flex-col items-center text-center mb-3 sm:mb-5 pointer-events-none relative z-10 transition-all duration-500">
    <!-- Small Monogram Wreath Crest -->
    <div class="mb-1 opacity-90 transform scale-90">
      <FloralWreath monogram="ZD" size={52} />
    </div>
    
    <p class="text-[0.62rem] sm:text-xs tracking-[0.38em] text-[#B89352] uppercase font-semibold mb-1">
      THE WEDDING INVITATION
    </p>
    
    <h1 class="font-display italic text-2xl sm:text-3xl md:text-4xl text-[#2A3426] font-normal tracking-wide leading-tight">
      You Are Cordially Invited
    </h1>
    
    <div class="my-1 opacity-60">
      <FloralFlourish width={110} height={16} />
    </div>
  </div>

  <!-- 3D PERSPECTIVE SCENE CONTAINER -->
  <div
    id="envelope-scene"
    class="relative w-full max-w-[460px] sm:max-w-[500px] aspect-[1.46/1] cursor-pointer will-change-transform z-20"
    style="perspective: 1600px; transform-style: preserve-3d;"
  >
    <!-- Deep Ambient Envelope Shadow on Linen Table -->
    <div
      id="envelope-shadow"
      class="absolute -inset-4 rounded-3xl bg-[#2A3426]/18 blur-2xl pointer-events-none transform translate-y-10 transition-all duration-700"
    ></div>

    <!-- MAIN PHYSICAL ENVELOPE RIG -->
    <div
      id="envelope-body"
      class="relative w-full h-full rounded-2xl overflow-visible"
      style="transform-style: preserve-3d;"
    >
      <!-- LAYER 0.1: ENVELOPE BASE COTTON PAPER & FRAME (Dissolves cleanly with envelope) -->
      <div 
        id="envelope-base-paper" 
        class="absolute inset-0 rounded-2xl bg-[#F5F0E6] border border-[#BAAD96] shadow-[0_25px_60px_rgba(42,52,38,0.18),0_4px_16px_rgba(42,52,38,0.10)] transition-opacity"
      ></div>

      <!-- LAYER 0.2: INSIDE POCKET LINING (Revealed when flap opens: Warm Cotton Stock & Shadow) -->
      <div id="envelope-lining" class="absolute inset-0 rounded-2xl overflow-hidden bg-gradient-to-b from-[#FAF7F0] via-[#F1ECE0] to-[#E3DAC9] pointer-events-none z-0 transition-opacity">
        <!-- Inner Pocket Depth Shadow -->
        <div class="absolute inset-x-0 bottom-0 h-40 bg-gradient-to-t from-[#2A3426]/18 via-[#2A3426]/05 to-transparent"></div>
      </div>

      <!-- LAYER 1: THE LETTER CARD (Tucked inside, emerges upwards, then rests serenely in center) -->
      <div
        id="envelope-card"
        class="absolute left-[3.5%] right-[3.5%] top-[4%] h-[92%] bg-[#FAF8F5] rounded-xl shadow-[0_12px_35px_rgba(42,52,38,0.14)] border border-[#B89352]/45 p-5 sm:p-7 flex flex-col items-center justify-between text-center z-10 opacity-0 pointer-events-none will-change-transform"
      >
        <!-- Double Gold Hairline Inset Frame -->
        <div class="absolute inset-2 sm:inset-3 border border-[#B89352]/35 rounded-lg pointer-events-none"></div>
        <div class="absolute inset-2.5 sm:inset-3.5 border border-[#566A4E]/20 rounded-md pointer-events-none"></div>

        <!-- Header -->
        <div class="pt-1 relative z-10">
          <p class="text-[0.52rem] sm:text-[0.6rem] text-[#B89352] uppercase tracking-[0.32em] font-semibold">
            THE WEDDING INVITATION
          </p>
          <p class="font-arabic text-base sm:text-lg text-[#3E4C38] tracking-wider mt-0.5" dir="rtl" lang="ar">
            بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ
          </p>
        </div>

        <!-- Center Couple Crest & Title -->
        <div class="my-auto flex flex-col items-center relative z-10">
          <div class="scale-85 sm:scale-95 mb-1">
            <FloralWreath monogram="ZD" size={64} />
          </div>
          <p class="text-[0.55rem] sm:text-[0.62rem] tracking-[0.3em] text-[#B89352] uppercase font-semibold mb-0.5">
            WALIMATUL 'URS
          </p>
          <h2 class="font-display text-2xl sm:text-3xl md:text-4xl text-[#2A3426] font-normal tracking-tight my-0.5">
            {content.couple.groom.nickname} <span class="italic text-[#B89352]">&amp;</span> {content.couple.bride.nickname}
          </h2>
          <FloralFlourish width={130} height={20} className="scale-85 opacity-75 mt-0.5" />
        </div>

        <!-- Meta Footer -->
        <div class="pb-1 relative z-10">
          <p class="text-[0.58rem] sm:text-[0.65rem] text-[#4A5D43] tracking-[0.24em] uppercase font-medium">
            {content.event.dateFormatted} &bull; Padang
          </p>
        </div>
      </div>

      <!-- LAYER 2: FRONT ENVELOPE SOLID POCKET WITH CRISP, PROMINENT FOLD LINES -->
      <div id="envelope-pocket" class="absolute inset-0 z-20 pointer-events-none rounded-2xl overflow-hidden transition-opacity">
        <svg viewBox="0 0 500 342" class="w-full h-full overflow-hidden rounded-2xl pointer-events-none" preserveAspectRatio="none">
          <defs>
            <!-- Left flap gradient & shadow -->
            <linearGradient id="pocket-left-grad" x1="0%" y1="0%" x2="100%" y2="100%">
              <stop offset="0%" stop-color="#F3EDE2" />
              <stop offset="100%" stop-color="#E2D8C6" />
            </linearGradient>
            <!-- Right flap gradient & shadow -->
            <linearGradient id="pocket-right-grad" x1="100%" y1="0%" x2="0%" y2="100%">
              <stop offset="0%" stop-color="#EFE9DC" />
              <stop offset="100%" stop-color="#DDD3C0" />
            </linearGradient>
            <!-- Bottom V-pocket gradient -->
            <linearGradient id="pocket-bottom-grad" x1="0%" y1="0%" x2="0%" y2="100%">
              <stop offset="0%" stop-color="#FAF7F0" />
              <stop offset="35%" stop-color="#F2ECE0" />
              <stop offset="100%" stop-color="#E6DEC9" />
            </linearGradient>
            <!-- Soft drop shadow under the bottom V pocket -->
            <filter id="bottom-pocket-shadow" x="-5%" y="-15%" width="110%" height="130%">
              <feDropShadow dx="0" dy="-4" stdDeviation="5" flood-color="#2A3426" flood-opacity="0.12" />
            </filter>
          </defs>

          <!-- Left Flap Fold -->
          <path
            d="M 0 0 L 250 171 L 0 342 Z"
            fill="url(#pocket-left-grad)"
            stroke="#BAAD96"
            stroke-width="1.3"
          />

          <!-- Right Flap Fold -->
          <path
            d="M 500 0 L 250 171 L 500 342 Z"
            fill="url(#pocket-right-grad)"
            stroke="#BAAD96"
            stroke-width="1.3"
          />

          <!-- Bottom V Pocket (Rising to center apex) -->
          <g filter="url(#bottom-pocket-shadow)">
            <path
              d="M 0 342 
                 L 245 168 
                 Q 250 164.5, 255 168 
                 L 500 342 
                 Z"
              fill="url(#pocket-bottom-grad)"
              stroke="#AFA087"
              stroke-width="1.5"
              stroke-linejoin="round"
            />
            <!-- Inner Blind Deboss Crease Hairline on Bottom Pocket -->
            <path
              d="M 14 334 
                 L 245 174 
                 Q 250 170.5, 255 174 
                 L 486 334"
              stroke="#D2C8B5"
              stroke-width="0.8"
              fill="none"
            />
          </g>
        </svg>
      </div>

      <!-- LAYER 2.5: LUXURY GUEST CALLIGRAPHY NAMEPLATE (Centered on lower pocket) -->
      <div id="envelope-nameplate" class="absolute bottom-3.5 sm:bottom-4 left-1/2 -translate-x-1/2 w-[82%] sm:w-[72%] max-w-[270px] z-25 pointer-events-none transition-opacity">
        <div class="py-2 px-3.5 rounded-xl bg-white/95 border border-[#B89352]/40 shadow-[0_4px_16px_rgba(42,52,38,0.06)] text-center relative overflow-hidden">
          <div class="absolute inset-1 border border-[#B89352]/25 rounded-lg pointer-events-none"></div>
          
          <p class="text-[0.52rem] text-[#7E8F77] uppercase tracking-[0.24em] font-semibold mb-0.5 relative z-10">
            Kepada Yth. Bapak/Ibu/Saudara/i:
          </p>
          <p id="guest-name-splash" class="font-display text-xs sm:text-sm text-[#2A3426] font-normal leading-tight truncate relative z-10">
            Tamu Undangan Terhormat
          </p>
        </div>
      </div>

      <!-- LAYER 3: 3D EURO TOP FLAP WITH CRISP OUTLINE & EMBOSSED CREASE -->
      <div
        id="envelope-top-flap-container"
        class="absolute -top-[1px] -left-[1px] -right-[1px] h-[64%] origin-top z-30 pointer-events-none"
        style="perspective: 1400px; transform-style: preserve-3d;"
      >
        <!-- The Flipping Flap Element (Swings up 180° with point facing upward into the sky) -->
        <div
          id="envelope-top-flap"
          class="w-full h-full will-change-transform filter drop-shadow-[0_10px_20px_rgba(35,46,31,0.18)]"
          style="transform-origin: top center; transform-style: preserve-3d;"
        >
          <svg viewBox="0 0 500 230" preserveAspectRatio="none" class="w-full h-full overflow-visible">
            <defs>
              <linearGradient id="envelope-flap-gradient" x1="0%" y1="0%" x2="0%" y2="100%">
                <stop offset="0%" stop-color="#FAF8F2" />
                <stop offset="55%" stop-color="#F1ECE0" />
                <stop offset="100%" stop-color="#E3DAC7" />
              </linearGradient>
            </defs>
            <!-- Deep Euro V-Flap with Rounded Outer Shoulders -->
            <path
              d="M 0 16 
                 Q 0 0, 16 0 
                 L 484 0 
                 Q 500 0, 500 16 
                 L 255 222 
                 Q 250 226, 245 222 
                 Z"
              fill="url(#envelope-flap-gradient)"
              stroke="#A39379"
              stroke-width="1.6"
              stroke-linejoin="round"
            />
            <!-- Inner Blind Deboss Crease Hairline on Top Flap -->
            <path
              d="M 16 8 
                 L 484 8 
                 M 480 16 
                 L 254 214 
                 Q 250 217.5, 246 214 
                 L 20 16"
              stroke="#C5B8A2"
              stroke-width="0.9"
              fill="none"
            />
          </svg>
        </div>
      </div>

      <!-- LAYER 3.5: SWEET PASTEL BLUSH SILK RIBBON WRAP & BOW (Binds envelope elegantly) -->
      <div
        id="envelope-ribbon-wrap"
        class="absolute top-[58%] -translate-y-1/2 inset-x-0 h-10 z-35 pointer-events-none flex items-center justify-center will-change-transform"
      >
        <!-- Horizontal Silk Satin Band with Gilded Hem Threads -->
        <div class="absolute inset-x-0 h-7 bg-gradient-to-r from-[#DE7C6E] via-[#F7D2CC] via-[#FFF0ED] via-[#F7D2CC] to-[#DE7C6E] shadow-[0_4px_12px_rgba(222,124,110,0.28)] flex flex-col justify-between overflow-hidden">
          <div class="w-full h-[1px] bg-gradient-to-r from-[#B89352]/40 via-[#FFF8E7] to-[#B89352]/40"></div>
          <div class="w-full h-[1px] bg-gradient-to-r from-[#B89352]/40 via-[#D4AF37] to-[#B89352]/40"></div>
        </div>

        <!-- Center Ribbon Bow Loops & Flowing Tails Behind Wax Seal -->
        <svg viewBox="0 0 160 80" class="w-40 h-20 -my-5 overflow-visible drop-shadow-[0_6px_14px_rgba(180,80,70,0.22)]">
          <defs>
            <linearGradient id="splashRibbonBow" x1="0%" y1="0%" x2="100%" y2="100%">
              <stop offset="0%" stop-color="#FFF0ED" />
              <stop offset="35%" stop-color="#F7D2CC" />
              <stop offset="70%" stop-color="#EAA194" />
              <stop offset="100%" stop-color="#DE7C6E" />
            </linearGradient>
            <linearGradient id="splashRibbonTail" x1="0%" y1="0%" x2="0%" y2="100%">
              <stop offset="0%" stop-color="#DE7C6E" />
              <stop offset="50%" stop-color="#EAA194" />
              <stop offset="100%" stop-color="#F8C4AD" />
            </linearGradient>
          </defs>

          <!-- Left Ribbon Tail -->
          <path d="M 75 40 Q 55 60, 42 76 L 56 70 L 68 78 Q 78 55, 80 40 Z" fill="url(#splashRibbonTail)" stroke="#B89352" stroke-width="0.6" />
          
          <!-- Right Ribbon Tail -->
          <path d="M 85 40 Q 105 60, 118 76 L 104 70 L 92 78 Q 82 55, 80 40 Z" fill="url(#splashRibbonTail)" stroke="#B89352" stroke-width="0.6" />

          <!-- Left Bow Loop -->
          <path d="M 80 40 C 45 15, 20 28, 45 48 C 65 52, 75 43, 80 40 Z" fill="url(#splashRibbonBow)" stroke="#B89352" stroke-width="0.75" />
          <path d="M 52 32 Q 40 36, 50 44" stroke="#FFFFFF" stroke-width="0.8" opacity="0.6" fill="none" />

          <!-- Right Bow Loop -->
          <path d="M 80 40 C 115 15, 140 28, 115 48 C 95 52, 85 43, 80 40 Z" fill="url(#splashRibbonBow)" stroke="#B89352" stroke-width="0.75" />
          <path d="M 108 32 Q 120 36, 110 44" stroke="#FFFFFF" stroke-width="0.8" opacity="0.6" fill="none" />
        </svg>
      </div>

      <!-- LAYER 4: PHOTOREALISTIC 3D POURED OLIVE WAX SEAL (Centered at Flap Tip) -->
      <div
        id="wax-seal-container"
        class="absolute top-[58%] left-1/2 -translate-x-1/2 -translate-y-1/2 z-40 cursor-pointer pointer-events-auto transform transition-all duration-300 hover:scale-105 active:scale-95 group"
      >
        <div class="relative flex items-center justify-center">
          <!-- Ambient Gold Glow Halo -->
          <div id="wax-seal-halo" class="absolute -inset-4 rounded-full bg-[radial-gradient(circle,rgba(212,175,55,0.32)_0%,transparent_70%)] blur-md opacity-70 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none"></div>

          <!-- Photorealistic 3D Molten Wax Seal Disc -->
          <svg width="78" height="78" viewBox="0 0 120 120" class="filter drop-shadow-[0_10px_22px_rgba(20,28,18,0.48)] drop-shadow-[0_2px_5px_rgba(20,28,18,0.38)] overflow-visible">
            <defs>
              <!-- Base Molten Wax Radial Gradient (Rich Deep Olive with Top-Left Highlight) -->
              <radialGradient id="wax-base-grad" cx="35%" cy="32%" r="70%">
                <stop offset="0%" stop-color="#587350" />
                <stop offset="28%" stop-color="#3D5337" />
                <stop offset="65%" stop-color="#283724" />
                <stop offset="100%" stop-color="#182215" />
              </radialGradient>

              <!-- Recessed Center Bed Gradient -->
              <radialGradient id="wax-bed-grad" cx="42%" cy="38%" r="65%">
                <stop offset="0%" stop-color="#3A4D33" />
                <stop offset="60%" stop-color="#273523" />
                <stop offset="100%" stop-color="#1B2518" />
              </radialGradient>

              <!-- Antique Gilded Gold Leaf Foil Gradient for Raised Embossed Monogram -->
              <linearGradient id="wax-gold-foil" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" stop-color="#FFF8E4" />
                <stop offset="25%" stop-color="#EED596" />
                <stop offset="55%" stop-color="#C5A059" />
                <stop offset="80%" stop-color="#9C7832" />
                <stop offset="100%" stop-color="#6E501C" />
              </linearGradient>

              <!-- Inner Shadow Gradient for Crater Wall -->
              <linearGradient id="wax-crater-shadow" x1="0%" y1="0%" x2="0%" y2="100%">
                <stop offset="0%" stop-color="#121A10" stop-opacity="0.9" />
                <stop offset="100%" stop-color="#121A10" stop-opacity="0.1" />
              </linearGradient>

              <!-- Glossy Specular Sheen Gradient -->
              <linearGradient id="wax-gloss-sheen" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" stop-color="#FFFFFF" stop-opacity="0.55" />
                <stop offset="40%" stop-color="#FFFFFF" stop-opacity="0.15" />
                <stop offset="100%" stop-color="#FFFFFF" stop-opacity="0" />
              </linearGradient>
            </defs>

            <!-- 1. Organic Melted Wax Outer Puddle (Natural Flowing Lobes) -->
            <path
              d="M 60 7
                 C 78 6, 92 11, 103 23
                 C 114 34, 119 49, 116 66
                 C 113 82, 104 95, 91 105
                 C 78 114, 62 118, 46 116
                 C 30 114, 17 105, 9 92
                 C 2 79, 1 63, 5 47
                 C 9 31, 19 18, 33 11
                 C 46 4, 52 7, 60 7 Z"
              fill="url(#wax-base-grad)"
              stroke="#1E281A"
              stroke-width="1.2"
            />

            <!-- 2. Tiny Satellite Melted Wax Droplets (Realism Details) -->
            <circle cx="108" cy="74" r="3.2" fill="url(#wax-base-grad)" stroke="#1E281A" stroke-width="0.6" />
            <circle cx="13" cy="38" r="2.2" fill="url(#wax-base-grad)" stroke="#1E281A" stroke-width="0.5" />

            <!-- 3. Curved Specular Glossy Lip Highlight (Top-Left Rim) -->
            <path
              d="M 32 15 C 48 8, 74 8, 94 18"
              stroke="url(#wax-gloss-sheen)"
              stroke-width="3"
              stroke-linecap="round"
              fill="none"
              opacity="0.8"
            />
            <ellipse cx="44" cy="14" rx="5" ry="2.2" fill="#FFFFFF" opacity="0.45" transform="rotate(-12 44 14)" />

            <!-- 4. Outer Displacement Ridge (Where Brass Stamp Displaced Wax) -->
            <circle cx="60" cy="60" r="42" fill="none" stroke="#68855F" stroke-width="2.2" opacity="0.75" />
            <circle cx="60" cy="60" r="40" fill="none" stroke="#141E12" stroke-width="1.8" />

            <!-- 5. Recessed Circular Stamp Bed -->
            <circle cx="60" cy="60" r="38.5" fill="url(#wax-bed-grad)" />
            <!-- Crater Top Shadow -->
            <path d="M 21.5 60 A 38.5 38.5 0 0 1 98.5 60 Z" fill="url(#wax-crater-shadow)" opacity="0.6" />

            <!-- 6. Milled Beaded Brass Ring Border (Authentic Seal Border) -->
            <circle cx="60" cy="60" r="35" fill="none" stroke="url(#wax-gold-foil)" stroke-width="1.1" stroke-dasharray="1.8 2.5" opacity="0.8" />
            <circle cx="60" cy="60" r="32" fill="none" stroke="url(#wax-gold-foil)" stroke-width="0.5" opacity="0.4" />

            <!-- 7. 3D Embossed Gilded Monogram "ZD" -->
            <!-- Emboss Cast Shadow -->
            <text
              x="61.2"
              y="66.2"
              font-family="'Cormorant Garamond', 'Playfair Display', serif"
              font-size="28"
              font-style="italic"
              font-weight="700"
              fill="#0F160D"
              text-anchor="middle"
              letter-spacing="2"
              opacity="0.9"
            >ZD</text>

            <!-- Emboss Gold Gilded Face -->
            <text
              x="60"
              y="65"
              font-family="'Cormorant Garamond', 'Playfair Display', serif"
              font-size="28"
              font-style="italic"
              font-weight="700"
              fill="url(#wax-gold-foil)"
              text-anchor="middle"
              letter-spacing="2"
            >ZD</text>

            <!-- 8. Embossed Botanical Olive Sprig Under Monogram -->
            <!-- Shadow -->
            <path
              d="M 44 76 Q 61 79 78 76"
              stroke="#0F160D"
              stroke-width="1.4"
              stroke-linecap="round"
              fill="none"
              opacity="0.8"
            />
            <circle cx="61.2" cy="78.2" r="1.5" fill="#0F160D" opacity="0.8" />

            <!-- Gold Foil Sprig -->
            <path
              d="M 43 75 Q 60 78 77 75"
              stroke="url(#wax-gold-foil)"
              stroke-width="1.3"
              stroke-linecap="round"
              fill="none"
            />
            <path
              d="M 48 72 C 46 69, 41 70, 42 74 Z
                 M 72 72 C 74 69, 79 70, 78 74 Z"
              fill="url(#wax-gold-foil)"
            />
            <circle cx="60" cy="77" r="1.4" fill="url(#wax-gold-foil)" />
          </svg>
        </div>
      </div>

    </div>
  </div>

</div>

<script>
  import gsap from 'gsap';
  import confetti from 'canvas-confetti';
  import { playWaxSealSound, playCardFlipSound } from './reactbits/SoundEffects';

  function initLuxuryEnvelope() {
    const screen = document.getElementById('envelope-screen');
    const scene = document.getElementById('envelope-scene');
    const topFlap = document.getElementById('envelope-top-flap');
    const topFlapContainer = document.getElementById('envelope-top-flap-container');
    const letterCard = document.getElementById('envelope-card');
    const waxSealContainer = document.getElementById('wax-seal-container');
    const editorialHeader = document.getElementById('splash-editorial-header');
    const guestSplash = document.getElementById('guest-name-splash');
    const envelopeBody = document.getElementById('envelope-body');
    const envelopeBasePaper = document.getElementById('envelope-base-paper');
    const envelopeShadow = document.getElementById('envelope-shadow');
    const envelopePocket = document.getElementById('envelope-pocket');
    const envelopeLining = document.getElementById('envelope-lining');
    const envelopeNameplate = document.getElementById('envelope-nameplate');
    const envelopeRibbonWrap = document.getElementById('envelope-ribbon-wrap');

    if (!screen || !scene || !topFlap || !letterCard) return;

    // Strict Scroll Containment: Ensure page is locked at (0, 0)
    window.scrollTo(0, 0);

    const urlParams = new URLSearchParams(window.location.search);

    // Fast-path for testing/previews
    if (urlParams.get('skip') === '1') {
      screen.style.display = 'none';
      document.documentElement.classList.remove('is-locked');
      document.body.classList.remove('is-locked');
      const scrollY = urlParams.get('scroll');
      if (scrollY) {
        setTimeout(() => {
          window.scrollTo(0, parseInt(scrollY, 10));
        }, 150);
      }
      return;
    }

    if ((window as any).__lenis) {
      (window as any).__lenis.stop();
      (window as any).__lenis.scrollTo(0, { immediate: true });
    }

    // Parse guest name from URL parameter ?to=
    const rawTo = urlParams.get('to');
    if (rawTo && guestSplash) {
      try {
        const decoded = decodeURIComponent(rawTo.replace(/\+/g, ' ')).replace(/<[^>]*>/g, '').trim().substring(0, 50);
        if (decoded) guestSplash.textContent = decoded;
      } catch (e) {}
    }

    let isOpened = false;

    // =========================================================================
    // CINEMATIC SEQUENTIAL UNBOXING:
    // VELVETY FLAP OPENING -> SMOOTH CARD EMERGENCE -> ENVELOPE DISSOLVES ->
    // CARD RESTS IN READING PLATEAU -> SILKY CINEMATIC CROSS-DISSOLVE TO HERO
    // =========================================================================
    function openInvitation() {
      if (isOpened) return;
      isOpened = true;

      // 1. Play tactile wax breaking sound & trigger music fade-in
      playWaxSealSound();
      window.dispatchEvent(new CustomEvent('invitationOpening'));

      const tl = gsap.timeline();

      // PHASE 1: Wax seal & silk ribbon untie & dissolve; Header and nameplate float away cleanly
      if (envelopeRibbonWrap) {
        tl.to(envelopeRibbonWrap, {
          scaleX: 1.15,
          scaleY: 0,
          opacity: 0,
          duration: 0.35,
          ease: 'power2.in'
        }, 0);
      }

      if (waxSealContainer) {
        tl.to(waxSealContainer, {
          scale: 1.25,
          opacity: 0,
          filter: 'blur(4px)',
          duration: 0.35,
          ease: 'power2.out'
        }, 0);
      }

      if (editorialHeader) {
        tl.to(editorialHeader, { opacity: 0, y: -22, duration: 0.40, ease: 'power2.out' }, 0);
      }

      if (envelopeNameplate) {
        tl.to(envelopeNameplate, { opacity: 0, y: 20, duration: 0.35, ease: 'power2.out' }, 0);
      }

      const botanicalCorners = document.querySelectorAll('.splash-botanical-corners');

      // PHASE 2: Euro flap flips open 180° in 3D (0.12s -> 0.72s)
      tl.to(topFlap, {
        rotateX: 180,
        duration: 0.60,
        ease: 'power2.inOut',
        onUpdate: function() {
          if (this.progress() > 0.40 && topFlapContainer) {
            topFlapContainer.style.zIndex = '1';
          }
        }
      }, 0.12);

      // PHASE 3: Card slides smoothly UPWARD out of the pocket (0.40s -> 1.05s)
      tl.to(letterCard, {
        opacity: 1,
        y: '-65%',
        scale: 1.02,
        duration: 0.65,
        ease: 'power2.out'
      }, 0.40);

      // AS THE CARD EMERGES: THE ENTIRE ENVELOPE BASE SINKS DOWNWARD AND DISSOLVES AWAY (0.55s -> 0.95s)
      const envelopeDissolveTargets = [
        topFlapContainer,
        envelopePocket,
        envelopeLining,
        envelopeShadow,
        envelopeBasePaper
      ].filter(Boolean);

      tl.to(envelopeDissolveTargets, {
        opacity: 0,
        y: 60,
        duration: 0.40,
        ease: 'power2.in'
      }, 0.55);

      // PHASE 4: Layer surat diposisikan di paling depan, confetti burst (1.05s)
      tl.add(() => {
        if (letterCard) {
          letterCard.style.zIndex = '50';
          gsap.set(letterCard, { z: 50 });
        }
        playCardFlipSound();

        // Blossom Burst: Sweet Romantic Blush, Peach, Sage & Gold Palette
        confetti({
          particleCount: 65,
          spread: 75,
          origin: { x: 0.5, y: 0.45 },
          colors: ['#EAA194', '#F8C4AD', '#B89352', '#FFF0ED', '#739467', '#D4AF37'],
          ticks: 140,
          gravity: 0.8,
          scalar: 1.05,
          shapes: ['circle', 'square'],
          zIndex: 999999
        });
      }, 1.05);

      // PHASE 5: Surat meluncur turun anggun ke posisi tengah membaca di kanvas yang BERSIH (1.00s -> 1.60s)
      tl.to(letterCard, {
        y: '0%',
        scale: 1.05,
        boxShadow: '0 25px 70px rgba(42, 52, 38, 0.22)',
        duration: 0.60,
        ease: 'power3.out'
      }, 1.00);

      // PHASE 6: Transition ke Halaman Utama (2.10s -> 2.80s)
      // Jeda membaca ringkas & elegan (~0.5s) agar tamu tidak menunggu lama
      // Klik layar kapan saja juga langsung memicu transisi instan
      const skipReading = () => {
        if (tl.time() >= 0.8 && tl.time() < 2.1) {
          tl.seek(2.1);
        }
      };
      screen.addEventListener('click', skipReading);

      // SILKY-SMOOTH CINEMATIC DISSOLVE KE HALAMAN UTAMA (2.10s -> 2.80s)
      // Surat mengapung lembut ke atas, sementara splash screen larut halus ke Hero di baliknya
      tl.to(scene, {
        scale: 1.08,
        y: -25,
        opacity: 0,
        duration: 0.70,
        ease: 'power2.inOut'
      }, 2.10);

      if (botanicalCorners.length) {
        tl.to(botanicalCorners, {
          opacity: 0,
          scale: 0.95,
          duration: 0.60,
          ease: 'power2.inOut'
        }, 2.15);
      }

      // Splash screen larut dengan halus menampilkan section Hero
      tl.to(screen, {
        opacity: 0,
        duration: 0.70,
        ease: 'power2.inOut'
      }, 2.15);

      // PHASE 7: Transition Complete — Enable Lenis Scroll & Clean Screen (2.85s)
      tl.add(() => {
        if (screen) screen.style.display = 'none';
        document.documentElement.classList.remove('is-locked');
        document.body.classList.remove('is-locked');
        window.scrollTo(0, 0);
        if ((window as any).__lenis) {
          (window as any).__lenis.scrollTo(0, { immediate: true });
          (window as any).__lenis.start();
        }
        window.dispatchEvent(new CustomEvent('invitationOpened'));
      }, 2.85);
    }

    // Event listeners: Klik wax seal atau amplop langsung membuka
    if (waxSealContainer) waxSealContainer.addEventListener('click', openInvitation);
    if (scene) scene.addEventListener('click', openInvitation);

    // Prevent wheel/touch from scrolling background while envelope is visible
    const onPrevent = (e: Event) => {
      if (screen && screen.style.display !== 'none') {
        e.preventDefault();
      }
    };
    window.addEventListener('wheel', onPrevent, { passive: false });
    window.addEventListener('touchmove', onPrevent, { passive: false });
    window.addEventListener('keydown', (e) => {
      if (screen && screen.style.display !== 'none' && ['Enter', ' '].includes(e.key)) {
        e.preventDefault();
        openInvitation();
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initLuxuryEnvelope);
  } else {
    initLuxuryEnvelope();
  }
</script>
