---
// SplashScreen.astro — Quiet Luxury Wedding Stationery Envelope Reveal
// Elegant single-action unboxing: Tap to open, envelope unfolds gracefully into the Hero section
import content from '../data/content.json';
import FloralWreath from './botanical/FloralWreath.astro';
import FloralFlourish from './botanical/FloralFlourish.astro';
import BotanicalStamp from './botanical/BotanicalStamp.astro';
---

<div
  id="envelope-screen"
  class="fixed inset-0 z-[9999] flex flex-col items-center justify-center p-4 sm:p-6 bg-[#FAF8F5] select-none overflow-hidden transition-opacity duration-1000 ease-[cubic-bezier(0.16,1,0.3,1)]"
  role="dialog"
  aria-modal="true"
  aria-label="Amplop Undangan Pernikahan"
>
  <!-- Fine Linen Subtle Grain -->
  <div class="absolute inset-0 pointer-events-none opacity-20 bg-[radial-gradient(#4A5D43_1px,transparent_1px)] [background-size:24px_24px]" aria-hidden="true"></div>

  <!-- 3D Perspective Scene Container -->
  <div
    id="envelope-scene"
    class="relative w-full max-w-[460px] sm:max-w-[500px] aspect-[1.42/1] my-auto cursor-pointer"
    style="perspective: 1400px;"
  >
    <!-- Envelope Ambient Shadow -->
    <div
      id="envelope-shadow"
      class="absolute -inset-3 rounded-2xl bg-[#263322]/12 blur-2xl pointer-events-none transform translate-y-8"
    ></div>

    <!-- MAIN ENVELOPE BODY -->
    <div
      id="envelope-body"
      class="relative w-full h-full rounded-2xl shadow-[0_25px_60px_rgba(42,52,38,0.18)] border border-[#D5CCBC] bg-[#EAE3D2] overflow-visible"
    >
      <!-- LAYER 0: Inside Pocket Lining -->
      <div class="absolute inset-0 rounded-2xl overflow-hidden bg-[#E2D9C6] pointer-events-none">
        <div class="absolute inset-0 opacity-10 bg-[radial-gradient(#4A5D43_1.5px,transparent_1.5px)] [background-size:16px_16px]"></div>
        <div class="absolute bottom-0 left-0 right-0 h-32 bg-gradient-to-t from-black/15 to-transparent"></div>
      </div>

      <!-- LAYER 1: THE LETTER CARD (Tucked inside, emerges upwards on open) -->
      <div
        id="envelope-card"
        class="absolute left-[3%] right-[3%] top-[4%] h-[92%] bg-[#FAF8F5] rounded-xl shadow-[0_10px_30px_rgba(42,52,38,0.12)] border border-[#B89352]/35 p-5 sm:p-6 flex flex-col items-center justify-between text-center z-10 opacity-0 pointer-events-none"
      >
        <!-- Inset Gold Hairline Frame -->
        <div class="absolute inset-2.5 sm:inset-3 border border-[#B89352]/25 rounded-lg pointer-events-none"></div>

        <!-- Card Header -->
        <div class="pt-1">
          <p class="text-[0.55rem] sm:text-[0.62rem] text-[#566A4E] uppercase tracking-[0.3em] font-semibold">
            THE WEDDING INVITATION
          </p>
          <p class="font-arabic text-base sm:text-lg text-[#3E4C38] tracking-wider mt-0.5" dir="rtl" lang="ar">
            بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ
          </p>
        </div>

        <!-- Card Center Monogram & Couple -->
        <div class="my-auto flex flex-col items-center">
          <div class="scale-80 sm:scale-90 mb-1">
            <FloralWreath monogram="AD" size={68} />
          </div>
          <p class="text-[0.58rem] sm:text-[0.62rem] tracking-[0.28em] text-[#B89352] uppercase font-semibold">
            WALIMATUL 'URS
          </p>
          <h2 class="font-display text-2xl sm:text-3xl text-[#2A3426] font-normal my-0.5 tracking-tight">
            {content.couple.groom.nickname} <span class="italic text-[#B89352]">&amp;</span> {content.couple.bride.nickname}
          </h2>
          <FloralFlourish width={140} height={22} className="scale-80 sm:scale-90" />
        </div>

        <!-- Card Footer Meta -->
        <div class="pb-1">
          <p class="text-[0.58rem] sm:text-[0.62rem] text-[#566A4E] tracking-[0.22em] uppercase font-medium">
            {content.event.dateFormatted} &bull; Banda Aceh
          </p>
        </div>
      </div>

      <!-- LAYER 2: FRONT ENVELOPE SOLID POCKET -->
      <!-- Left Triangle Fold -->
      <div
        class="absolute inset-0 bg-gradient-to-r from-[#F0EAE0] to-[#EAE3D4] z-20 pointer-events-none rounded-2xl"
        style="clip-path: polygon(0 0, 50% 50%, 0 100%);"
      ></div>

      <!-- Right Triangle Fold -->
      <div
        class="absolute inset-0 bg-gradient-to-l from-[#F0EAE0] to-[#EAE3D4] z-20 pointer-events-none rounded-2xl"
        style="clip-path: polygon(100% 0, 50% 50%, 100% 100%);"
      ></div>

      <!-- Bottom Triangle Pocket Face -->
      <div
        id="envelope-pocket-bottom"
        class="absolute inset-0 bg-gradient-to-t from-[#F7F3EB] via-[#F2ECE1] to-[#E8E1D2] z-22 pointer-events-none rounded-2xl shadow-[0_-4px_12px_rgba(42,52,38,0.04)]"
        style="clip-path: polygon(0 100%, 100% 100%, 50% 46%);"
      ></div>

      <!-- LAYER 2.5: FRONT ENVELOPE DETAILS -->
      <div id="envelope-front-decorations" class="absolute inset-0 z-25 pointer-events-none">
        <!-- Postal Stamp in Top-Right -->
        <div class="absolute top-3 right-3 sm:top-4 sm:right-4 scale-80 sm:scale-90 origin-top-right">
          <BotanicalStamp />
        </div>

        <!-- Recipient Guest Badge -->
        <div class="absolute bottom-3 sm:bottom-4 left-1/2 -translate-x-1/2 w-[85%] sm:w-[75%] max-w-[270px] py-2 px-3 rounded-xl bg-white/95 border border-[#D5CCBC] shadow-sm text-center">
          <p class="text-[0.55rem] text-[#566A4E] uppercase tracking-[0.22em] font-medium mb-0.5">
            Kepada Yth. Bapak/Ibu/Saudara/i:
          </p>
          <p id="guest-name-splash" class="font-display text-sm sm:text-base text-[#2A3426] font-normal leading-tight truncate">
            Tamu Undangan Terhormat
          </p>
        </div>
      </div>

      <!-- LAYER 3: TOP TRIANGULAR FLAP (Overlaps pocket, flips 180° upwards) -->
      <div
        id="envelope-top-flap"
        class="absolute top-0 left-0 right-0 h-[58%] origin-top z-30 rounded-t-2xl pointer-events-none"
        style="clip-path: polygon(0 0, 100% 0, 50% 100%); transform-style: preserve-3d; background: linear-gradient(to bottom, #FAF7EF, #EFE9DB);"
      >
        <div class="absolute inset-0" style="clip-path: polygon(3% 0, 97% 0, 50% 95%); border-bottom: 1px dashed rgba(184, 147, 82, 0.4);"></div>
        <div class="absolute bottom-0 left-1/2 -translate-x-1/2 w-32 h-5 bg-black/8 blur-sm rounded-full"></div>
      </div>

      <!-- LAYER 4: OLIVE WAX SEAL (Centered at flap tip) -->
      <div
        id="wax-seal-container"
        class="absolute top-[57%] left-1/2 -translate-x-1/2 -translate-y-1/2 z-40 cursor-pointer pointer-events-auto transform transition-transform duration-300 hover:scale-105 active:scale-95"
      >
        <div class="relative flex items-center justify-center">
          <!-- Organic Olive Wax Disc -->
          <div
            id="wax-seal"
            class="w-[54px] h-[54px] sm:w-[60px] sm:h-[60px] rounded-full bg-gradient-to-br from-[#4A5D43] via-[#3B4C35] to-[#243120] shadow-[0_8px_20px_rgba(36,49,32,0.35),inset_0_2px_4px_rgba(255,255,255,0.25)] border-2 border-[#5C7253] flex items-center justify-center relative overflow-hidden"
          >
            <div class="absolute inset-1 rounded-full border border-[#B89352]/35 border-dashed"></div>
            <div class="flex flex-col items-center">
              <span class="font-display text-xs sm:text-sm text-[#F4E5C7] tracking-widest pl-0.5 drop-shadow-[0_1px_2px_rgba(0,0,0,0.6)]">
                AD
              </span>
              <div class="w-3 h-[1px] bg-[#B89352]/60 mt-0.5"></div>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>

  <!-- SINGLE REFINED CTA: "Buka Undangan" -->
  <div id="envelope-prompt" class="mt-6 flex flex-col items-center gap-1.5 cursor-pointer z-50 pointer-events-auto">
    <button
      id="btn-open-envelope"
      type="button"
      class="group inline-flex items-center gap-2.5 px-6 py-2.5 rounded-full bg-[#FAF8F5] border border-[#B89352]/50 text-[#2A3426] shadow-sm hover:border-[#566A4E] hover:bg-white hover:shadow-md transition-all duration-300"
    >
      <span class="text-xs text-[#B89352] group-hover:rotate-45 transition-transform duration-300">✦</span>
      <span class="text-xs tracking-[0.25em] uppercase font-semibold text-[#3E4C38]">
        Buka Undangan
      </span>
      <span class="text-xs text-[#B89352] group-hover:rotate-45 transition-transform duration-300">✦</span>
    </button>
  </div>

</div>

<script>
  import gsap from 'gsap';
  import { playWaxSealSound, playCardFlipSound, playChimeSound } from './reactbits/SoundEffects';

  function initLuxuryEnvelope() {
    const screen = document.getElementById('envelope-screen');
    const scene = document.getElementById('envelope-scene');
    const topFlap = document.getElementById('envelope-top-flap');
    const letterCard = document.getElementById('envelope-card');
    const waxSealContainer = document.getElementById('wax-seal-container');
    const promptBtn = document.getElementById('btn-open-envelope');
    const guestSplash = document.getElementById('guest-name-splash');

    if (!screen || !topFlap || !letterCard) return;

    // Strict Scroll Containment: Ensure page is locked at (0, 0)
    window.scrollTo(0, 0);
    if ((window as any).__lenis) {
      (window as any).__lenis.stop();
      (window as any).__lenis.scrollTo(0, { immediate: true });
    }

    // Parse guest name from URL ?to=
    const urlParams = new URLSearchParams(window.location.search);
    const rawTo = urlParams.get('to');
    if (rawTo && guestSplash) {
      try {
        const decoded = decodeURIComponent(rawTo.replace(/\+/g, ' ')).replace(/<[^>]*>/g, '').trim().substring(0, 50);
        if (decoded) guestSplash.textContent = decoded;
      } catch (e) {}
    }

    let isOpened = false;

    // Single-action fluid reveal: Unboxing into Hero section
    function openInvitation() {
      if (isOpened) return;
      isOpened = true;

      playWaxSealSound();
      window.dispatchEvent(new CustomEvent('invitationOpening'));

      if ((window as any).triggerLuxuryConfetti) {
        (window as any).triggerLuxuryConfetti(window.innerWidth / 2, window.innerHeight * 0.52);
      }

      const tl = gsap.timeline({ defaults: { ease: 'power2.inOut' } });

      // 1. Wax seal lifts & fades
      if (waxSealContainer) {
        tl.to(waxSealContainer, {
          scale: 1.25,
          opacity: 0,
          duration: 0.35,
          ease: 'power2.out'
        }, 0);
      }

      // Hide CTA button
      const promptEl = document.getElementById('envelope-prompt');
      if (promptEl) {
        tl.to(promptEl, { opacity: 0, y: 10, duration: 0.25 }, 0);
      }

      // 2. Flap opens smoothly in 3D
      tl.to(topFlap, {
        rotateX: 180,
        duration: 0.65,
        onUpdate: function() {
          if (this.progress() > 0.48) {
            topFlap.style.zIndex = '5';
          }
        }
      }, 0.1);

      // 3. Card glides out smoothly
      tl.add(() => {
        playCardFlipSound();
      }, 0.45);

      tl.to(letterCard, {
        opacity: 1,
        y: '-70%',
        boxShadow: '0 20px 45px rgba(42, 52, 38, 0.2)',
        duration: 0.7,
        ease: 'power3.out'
      }, 0.45);

      // 4. Fluid dissolve & rise into the main invitation
      tl.add(() => {
        playChimeSound();
      }, 0.85);

      tl.to(scene, {
        y: -100,
        scale: 0.96,
        opacity: 0,
        duration: 0.85
      }, 0.85);

      tl.to(screen, {
        opacity: 0,
        duration: 0.85
      }, 0.9);

      // 5. Complete reveal at exact top (0, 0)
      tl.add(() => {
        screen.style.display = 'none';
        document.documentElement.classList.remove('is-locked');
        document.body.classList.remove('is-locked');
        window.scrollTo(0, 0);
        if ((window as any).__lenis) {
          (window as any).__lenis.scrollTo(0, { immediate: true });
          (window as any).__lenis.start();
        }
        window.dispatchEvent(new CustomEvent('invitationOpened'));
      }, 1.35);
    }

    // Trigger on seal click, CTA button click, or scene click
    if (waxSealContainer) waxSealContainer.addEventListener('click', openInvitation);
    if (promptBtn) promptBtn.addEventListener('click', openInvitation);
    if (scene) scene.addEventListener('click', openInvitation);

    // Prevent wheel/touch from scrolling background while envelope is visible
    const onPrevent = (e: Event) => {
      if (screen && screen.style.display !== 'none') {
        e.preventDefault();
      }
    };
    window.addEventListener('wheel', onPrevent, { passive: false });
    window.addEventListener('touchmove', onPrevent, { passive: false });
    window.addEventListener('keydown', (e) => {
      if (screen && screen.style.display !== 'none' && ['Enter', ' '].includes(e.key)) {
        e.preventDefault();
        openInvitation();
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initLuxuryEnvelope);
  } else {
    initLuxuryEnvelope();
  }
</script>