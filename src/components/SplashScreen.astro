---
// SplashScreen.astro — Haute-Couture Wedding Splashscreen
import BotanicalCrest from './BotanicalCrest.astro';
import ShinyText from './reactbits/ShinyText';
import content from '../data/content.json';
---

<div id="splashscreen" class="fixed inset-0 z-[9999] flex flex-col items-center justify-between p-4 sm:p-8 bg-navy-base transition-transform duration-1000 ease-[cubic-bezier(0.16,1,0.3,1)]" role="dialog" aria-modal="true" aria-label="Sampul Undangan Pernikahan">
  
  <!-- Subtle Ambient Glow -->
  <div class="absolute inset-0 pointer-events-none overflow-hidden">
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[320px] sm:w-[500px] h-[320px] sm:h-[500px] rounded-full bg-gold/10 blur-[90px] animate-pulse"></div>
  </div>

  <!-- Top Sacred Accent -->
  <header class="relative z-10 text-center pt-2 sm:pt-4">
    <p class="font-arabic text-xl sm:text-2xl text-gold-bright tracking-wide opacity-90" dir="rtl" lang="ar">
      بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ
    </p>
    <p class="text-[0.65rem] sm:text-xs text-gold/70 tracking-[0.3em] uppercase mt-1">
      Walimatul 'Urs
    </p>
  </header>

  <!-- Central Regal Invitation Card -->
  <main class="relative z-10 w-full max-w-md mx-auto my-auto py-2">
    <div class="relative bg-navy-surface/85 backdrop-blur-md border border-gold/30 rounded-2xl p-6 sm:p-9 text-center shadow-[0_20px_50px_rgba(0,0,0,0.6),0_0_30px_rgba(197,160,89,0.12)]">
      
      <!-- Inner Hairline Border -->
      <div class="absolute inset-2 border border-gold/15 rounded-xl pointer-events-none"></div>

      <!-- Botanical Monogram Crest -->
      <div class="relative flex justify-center mb-4">
        <div class="relative">
          <div class="absolute inset-0 rounded-full bg-gold/20 blur-md animate-pulse"></div>
          <BotanicalCrest monogram="AD" size={84} />
        </div>
      </div>

      <!-- Overline -->
      <p class="text-overline tracking-[0.25em] text-xs">
        THE WEDDING OF
      </p>

      <!-- Shimmering Couple Name -->
      <h1 class="font-display text-3xl sm:text-4xl text-pearl font-normal my-2 tracking-tight">
        <ShinyText client:load text={`${content.couple.groom.nickname} & ${content.couple.bride.nickname}`} speed={3} />
      </h1>

      <p class="text-xs text-gold-bright/90 font-light tracking-[0.18em] uppercase mb-6">
        {content.event.dateFormatted}
      </p>

      <!-- Recipient Card Box -->
      <div class="bg-navy-elevated/70 border border-gold/20 rounded-lg p-3.5 sm:p-4 my-4">
        <p class="text-[0.7rem] sm:text-xs text-pearl-muted font-light tracking-wider uppercase mb-1">
          Kepada Yth. Bapak/Ibu/Saudara/i:
        </p>
        <h2 id="splash-guest-name" class="font-display text-xl sm:text-2xl text-pearl font-normal leading-snug">
          Tamu Undangan Terhormat
        </h2>
      </div>

      <!-- Interactive Open Button with Tactile Wax Seal Styling -->
      <button
        id="btn-open-splash"
        type="button"
        class="group relative inline-flex items-center justify-center gap-2.5 w-full sm:w-auto px-8 py-3.5 mt-2 bg-gradient-to-r from-gold-soft via-gold to-gold-bright text-navy-base font-semibold text-xs tracking-[0.18em] uppercase rounded-full shadow-[0_4px_20px_rgba(197,160,89,0.35)] hover:shadow-[0_6px_28px_rgba(226,201,138,0.55)] active:scale-95 transition-all duration-300 cursor-pointer overflow-hidden"
      >
        <!-- Shimmer overlay on button -->
        <span class="absolute inset-0 w-full h-full bg-gradient-to-r from-transparent via-white/30 to-transparent -translate-x-full group-hover:translate-x-full transition-transform duration-1000 ease-out pointer-events-none"></span>

        <!-- Wax Seal / Envelope Icon -->
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="transition-transform duration-300 group-hover:scale-110">
          <rect width="20" height="16" x="2" y="4" rx="2"></rect>
          <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
        </svg>

        <span class="relative">Buka Undangan</span>
      </button>

      <p class="text-[0.65rem] text-pearl-muted tracking-wider mt-3 font-light">
        Ketuk untuk membuka lembar undangan & memutar audio
      </p>

    </div>
  </main>

  <!-- Bottom Accent -->
  <footer class="relative z-10 text-center pb-2 sm:pb-4">
    <div class="w-12 h-[1px] bg-gradient-to-r from-transparent via-gold/50 to-transparent mx-auto"></div>
  </footer>

</div>

<script>
  import { playWaxSealSound, playChimeSound } from './reactbits/SoundEffects';

  function initSplashScreen() {
    const splash = document.getElementById('splashscreen');
    const btnOpen = document.getElementById('btn-open-splash');
    const guestNameEl = document.getElementById('splash-guest-name');
    if (!splash || !btnOpen) return;

    // 1. Parse & Sanitize ?to= parameter
    const urlParams = new URLSearchParams(window.location.search);
    const rawTo = urlParams.get('to');
    let sanitizedGuestName = 'Tamu Undangan Terhormat';

    if (rawTo) {
      let decoded = '';
      try {
        decoded = decodeURIComponent(rawTo.replace(/\+/g, ' '));
      } catch (e) {
        decoded = rawTo.replace(/\+/g, ' ');
      }
      const stripped = decoded.replace(/<[^>]*>/g, '');
      const sanitized = stripped.replace(/[<>'"/\\`~^;={}[\]|]/g, '').trim().substring(0, 75);
      if (sanitized.length > 0) {
        sanitizedGuestName = sanitized;
      }
    }

    if (guestNameEl) {
      if (sanitizedGuestName.length > 26) {
        guestNameEl.style.fontSize = 'clamp(1.1rem, 3.5vw, 1.45rem)';
      }
      guestNameEl.textContent = sanitizedGuestName;
    }

    // 2. Open Invitation Action
    let opened = false;
    btnOpen.addEventListener('click', () => {
      if (opened) return;
      opened = true;
      btnOpen.setAttribute('disabled', 'true');

      // Audio feedback
      playWaxSealSound();
      setTimeout(playChimeSound, 120);

      // Trigger audio player & progress bar
      window.dispatchEvent(new CustomEvent('invitationOpening'));

      // Smooth curtain lift transition
      splash.style.transform = 'translateY(-100%)';
      splash.style.opacity = '0';

      setTimeout(() => {
        splash.style.display = 'none';
        document.body.classList.remove('is-locked');
        window.dispatchEvent(new CustomEvent('invitationOpened'));
      }, 750);
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initSplashScreen);
  } else {
    initSplashScreen();
  }
</script>
