---
// SplashScreen.astro — Fullscreen Botanical Luxury Envelope Unboxing (Warm Cream & Olive Green)
// Lavishly ornamented with Botanical Stamp, Floral Corners, Royal Wax Seal & Twinkling Sparkles
import content from '../data/content.json';
import FloralWreath from './botanical/FloralWreath.astro';
import FloralDivider from './botanical/FloralDivider.astro';
import FloralCorner from './botanical/FloralCorner.astro';
import FloralBouquet from './botanical/FloralBouquet.astro';
import FloralFlourish from './botanical/FloralFlourish.astro';
import BotanicalStamp from './botanical/BotanicalStamp.astro';
import TwinkleSparkles from './botanical/TwinkleSparkles.astro';
---

<div
  id="envelope-screen"
  class="fixed inset-0 z-[9999] flex items-center justify-center p-3 sm:p-6 bg-[#EDE9DF] cursor-pointer select-none overflow-hidden transition-all duration-1000 ease-[cubic-bezier(0.16,1,0.3,1)]"
  role="dialog"
  aria-modal="true"
  aria-label="Amplop Undangan Pernikahan"
>
  <!-- Ambient Botanical Linen Texture -->
  <div class="absolute inset-0 pointer-events-none opacity-40 bg-[radial-gradient(#566A4E_1px,transparent_1px)] [background-size:24px_24px]" aria-hidden="true"></div>

  <!-- Twinkling Gold Sparkles Background -->
  <TwinkleSparkles />

  <!-- Fullscreen Envelope Container (3D Perspective) -->
  <div
    id="envelope-body"
    class="relative w-full max-w-xl h-[94vh] sm:h-[84vh] bg-[#FAF8F3] rounded-2xl shadow-[0_30px_70px_rgba(42,52,38,0.25)] border border-[#DCD5C5] flex flex-col justify-between p-6 sm:p-10 overflow-hidden transition-transform duration-1000 ease-[cubic-bezier(0.16,1,0.3,1)]"
  >
    <!-- 4 Botanical Corner Ornaments on Envelope -->
    <div class="absolute top-2 left-2 z-20 pointer-events-none">
      <FloralCorner position="top-left" size={85} />
    </div>
    <div class="absolute top-2 right-2 z-20 pointer-events-none">
      <FloralCorner position="top-right" size={85} />
    </div>
    <div class="absolute bottom-2 left-2 z-20 pointer-events-none">
      <FloralCorner position="bottom-left" size={85} />
    </div>
    <div class="absolute bottom-2 right-2 z-20 pointer-events-none">
      <FloralCorner position="bottom-right" size={85} />
    </div>

    <!-- Vintage Botanical Postage Stamp in Top-Right Corner -->
    <div class="absolute top-5 right-5 sm:top-7 sm:right-7 z-25 pointer-events-none hidden xs:block">
      <BotanicalStamp />
    </div>

    <!-- Delicate Double Gold & Olive Border Inset -->
    <div class="absolute inset-3 sm:inset-4 border border-[#B89352]/40 rounded-xl pointer-events-none"></div>
    <div class="absolute inset-4 sm:inset-5 border border-[#566A4E]/25 rounded-lg pointer-events-none"></div>

    <!-- 3D Envelope Flap (Top Triangle) -->
    <div
      id="envelope-flap"
      class="absolute top-0 left-0 right-0 h-44 sm:h-52 bg-gradient-to-b from-[#F2EEE4] to-[#EAE4D6] border-b border-[#DCD5C5] shadow-md origin-top transition-transform duration-800 ease-[cubic-bezier(0.25,1,0.5,1)] z-30"
      style="clip-path: polygon(0 0, 100% 0, 50% 100%);"
    >
      <!-- Flap Inner Stitching Line -->
      <div class="absolute inset-0" style="clip-path: polygon(4% 0, 96% 0, 50% 93%); border-bottom: 1px dashed rgba(184, 147, 82, 0.45);"></div>
      <!-- Subtle Flap Shadow -->
      <div class="absolute bottom-0 left-1/2 -translate-x-1/2 w-32 h-6 bg-black/5 blur-sm rounded-full"></div>
    </div>

    <!-- Top Header -->
    <header class="relative z-20 text-center pt-2 sm:pt-4">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#566A4E]/10 border border-[#566A4E]/20 mb-1.5">
        <span class="text-[0.6rem] text-[#B89352]">✦</span>
        <span class="text-[0.58rem] sm:text-[0.65rem] text-[#3E4C38] tracking-[0.3em] uppercase font-semibold">
          THE WEDDING INVITATION
        </span>
        <span class="text-[0.6rem] text-[#B89352]">✦</span>
      </div>
      <p class="font-arabic text-xl sm:text-2xl text-[#3E4C38] tracking-wider mt-1 drop-shadow-sm" dir="rtl" lang="ar">
        بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ
      </p>
    </header>

    <!-- Center Monogram Crest & Couple Names with Abundant Pemanis -->
    <main class="relative z-20 flex flex-col items-center text-center my-auto py-1">
      
      <!-- Crown Bouquet Above Monogram -->
      <div class="mb-1 scale-80 sm:scale-90">
        <FloralBouquet width={200} height={50} />
      </div>

      <!-- Botanical Wreath Monogram -->
      <div class="mb-2 transform hover:scale-105 transition-transform duration-500">
        <FloralWreath monogram="AD" size={100} />
      </div>

      <p class="text-[0.65rem] sm:text-[0.7rem] tracking-[0.3em] text-[#B89352] uppercase font-semibold">
        WALIMATUL 'URS
      </p>

      <h1 class="font-display text-4xl sm:text-5xl md:text-6xl text-[#2A3426] font-normal tracking-tight my-1.5 drop-shadow-sm">
        {content.couple.groom.nickname} <span class="italic text-[#B89352] font-normal px-1">&amp;</span> {content.couple.bride.nickname}
      </h1>

      <!-- Symmetrical Calligraphic Flourish Swash -->
      <FloralFlourish width={190} height={32} className="my-1 scale-90 sm:scale-100" />

      <!-- Personalized Recipient Label on Envelope -->
      <div class="mt-3 py-2.5 px-5 sm:px-7 rounded-xl bg-white/85 border border-[#DCD5C5] max-w-xs w-full shadow-sm relative overflow-hidden">
        <!-- Gold Accent Top Bar -->
        <div class="absolute top-0 left-0 right-0 h-[2px] bg-gradient-to-r from-transparent via-[#B89352] to-transparent"></div>
        <p class="text-[0.6rem] sm:text-[0.65rem] text-[#566A4E] uppercase tracking-[0.22em] font-medium mb-0.5">
          Kepada Yth. Bapak/Ibu/Saudara/i:
        </p>
        <p id="guest-name-splash" class="font-display text-lg sm:text-xl text-[#2A3426] font-normal leading-snug">
          Tamu Undangan Terhormat
        </p>
      </div>

    </main>

    <!-- Interactive Olive Wax Seal Button & Tap Cue with Laurel Sprigs -->
    <footer class="relative z-40 flex flex-col items-center pb-2 sm:pb-4">
      
      <!-- Symmetrical Laurel Sprigs Flanking Wax Seal -->
      <div class="relative flex items-center justify-center gap-3">
        
        <!-- Left Laurel Branch -->
        <svg width="45" height="35" viewBox="0 0 50 40" fill="none" class="hidden sm:block opacity-75">
          <path d="M45 35 C30 32, 10 20, 5 5" stroke="#566A4E" stroke-width="1.2" stroke-linecap="round" />
          <path d="M38 31 C32 26, 33 20, 39 19 C42 24, 42 29, 38 31 Z" fill="#6E8564" />
          <path d="M25 24 C18 20, 20 14, 26 13 C29 18, 28 23, 25 24 Z" fill="#4A5C43" />
          <path d="M14 16 C9 12, 11 6, 17 6 C19 11, 17 15, 14 16 Z" fill="#6E8564" />
          <circle cx="34" cy="27" r="1.8" fill="#B89352" />
          <circle cx="21" cy="18" r="1.8" fill="#B89352" />
        </svg>

        <!-- 3D Olive Wax Seal with Gold Monogram -->
        <div id="wax-seal" class="relative group cursor-pointer transform transition-transform duration-300 hover:scale-108 active:scale-95">
          
          <!-- Wax Seal Outer Organic Disc -->
          <div class="w-16 h-16 sm:w-20 sm:h-20 rounded-full bg-gradient-to-br from-[#4A5D43] via-[#3B4C35] to-[#263322] shadow-[0_10px_25px_rgba(38,51,34,0.45),inset_0_2px_4px_rgba(255,255,255,0.3)] border-2 border-[#5C7253] flex items-center justify-center relative overflow-hidden">
            
            <!-- Wax Inner Rim Ring -->
            <div class="absolute inset-1.5 rounded-full border border-[#B89352]/40 border-dashed"></div>
            
            <!-- Gold Monogram Emboss -->
            <div class="flex flex-col items-center">
              <span class="font-display text-sm sm:text-base text-[#F4E5C7] tracking-widest pl-0.5 drop-shadow-[0_1px_2px_rgba(0,0,0,0.7)]">
                AD
              </span>
              <div class="w-4 h-[1px] bg-[#B89352]/70 mt-0.5"></div>
            </div>
          </div>

          <!-- Golden Pulse Aura -->
          <div class="absolute inset-0 rounded-full bg-[#B89352]/25 animate-ping pointer-events-none opacity-50"></div>
        </div>

        <!-- Right Laurel Branch -->
        <svg width="45" height="35" viewBox="0 0 50 40" fill="none" class="hidden sm:block opacity-75 transform scale-x-[-1]">
          <path d="M45 35 C30 32, 10 20, 5 5" stroke="#566A4E" stroke-width="1.2" stroke-linecap="round" />
          <path d="M38 31 C32 26, 33 20, 39 19 C42 24, 42 29, 38 31 Z" fill="#6E8564" />
          <path d="M25 24 C18 20, 20 14, 26 13 C29 18, 28 23, 25 24 Z" fill="#4A5C43" />
          <path d="M14 16 C9 12, 11 6, 17 6 C19 11, 17 15, 14 16 Z" fill="#6E8564" />
          <circle cx="34" cy="27" r="1.8" fill="#B89352" />
          <circle cx="21" cy="18" r="1.8" fill="#B89352" />
        </svg>

      </div>

      <!-- Tap Prompt with Animated Hand / Touch Cue -->
      <div class="mt-2.5 flex items-center gap-1.5 text-[#566A4E] animate-bounce">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M18 11V6a2 2 0 0 0-2-2v0a2 2 0 0 0-2 2v0"/>
          <path d="M14 10V4a2 2 0 0 0-2-2v0a2 2 0 0 0-2 2v2"/>
          <path d="M10 10.5V6a2 2 0 0 0-2-2v0a2 2 0 0 0-2 2v8"/>
          <path d="M18 8a2 2 0 1 1 4 0v6a8 8 0 0 1-8 8h-2c-2.8 0-4.5-.86-5.99-2.34l-3.6-3.6a2 2 0 0 1 2.83-2.82L7 15"/>
        </svg>
        <p class="text-[0.62rem] sm:text-[0.68rem] tracking-[0.25em] uppercase font-semibold text-[#3E4C38]">
          Buka Amplop Undangan
        </p>
      </div>

    </footer>

  </div>
</div>

<style>
  #envelope-flap {
    transform-style: preserve-3d;
    backface-visibility: hidden;
  }
  .flap-open {
    transform: rotateX(180deg);
  }
</style>

<script>
  import { playChimeSound } from './reactbits/SoundEffects';

  function initEnvelopeScreen() {
    const screen = document.getElementById('envelope-screen');
    const envelopeBody = document.getElementById('envelope-body');
    const flap = document.getElementById('envelope-flap');
    const waxSeal = document.getElementById('wax-seal');
    const guestSplash = document.getElementById('guest-name-splash');
    if (!screen) return;

    // Parse guest name from URL ?to=
    const urlParams = new URLSearchParams(window.location.search);
    const rawTo = urlParams.get('to');
    if (rawTo && guestSplash) {
      try {
        const decoded = decodeURIComponent(rawTo.replace(/\+/g, ' ')).replace(/<[^>]*>/g, '').trim().substring(0, 50);
        if (decoded) guestSplash.textContent = decoded;
      } catch (e) {}
    }

    let isOpened = false;

    function openEnvelope() {
      if (isOpened) return;
      isOpened = true;

      playChimeSound();

      // 1. 3D Flap opens upwards
      if (flap) {
        flap.classList.add('flap-open');
      }

      // 2. Wax seal gently pops
      if (waxSeal) {
        waxSeal.style.transform = 'scale(1.2)';
        waxSeal.style.opacity = '0';
        waxSeal.style.transition = 'all 0.5s ease-out';
      }

      // 3. Trigger invitationOpening event
      window.dispatchEvent(new CustomEvent('invitationOpening'));

      // 4. Envelope expands & dissolves, uncovering the invitation
      setTimeout(() => {
        if (envelopeBody) {
          envelopeBody.style.transform = 'translateY(-20px) scale(1.05)';
          envelopeBody.style.opacity = '0';
        }
        screen.style.opacity = '0';
        screen.style.pointerEvents = 'none';
      }, 500);

      // 5. Complete removal and scroll unlock
      setTimeout(() => {
        screen.style.display = 'none';
        document.body.classList.remove('is-locked');
        window.dispatchEvent(new CustomEvent('invitationOpened'));
      }, 1200);
    }

    screen.addEventListener('click', openEnvelope);
    screen.addEventListener('touchend', openEnvelope, { passive: true });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initEnvelopeScreen);
  } else {
    initEnvelopeScreen();
  }
</script>