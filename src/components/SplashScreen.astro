---
// SplashScreen.astro — Haute-Couture Wedding Stationery Envelope Unboxing
// Luxury Pinterest Flat-Lay Editorial: Editorial Header, Satin Ribbon Sash, Botanical Sprigs, Gold Stitching & Seamless Transition
import content from '../data/content.json';
import FloralWreath from './botanical/FloralWreath.astro';
import FloralFlourish from './botanical/FloralFlourish.astro';
---

<div
  id="envelope-screen"
  class="fixed inset-0 z-[9999] flex flex-col items-center justify-center p-4 sm:p-6 bg-[#FAF8F5] select-none overflow-hidden will-change-transform"
  role="dialog"
  aria-modal="true"
  aria-label="Amplop Undangan Pernikahan"
>
  <!-- Fine Paper Texture Ambient Overlay -->
  <div class="absolute inset-0 pointer-events-none opacity-25 bg-[radial-gradient(#4A5D43_1px,transparent_1px)] [background-size:20px_20px]" aria-hidden="true"></div>

  <!-- Ambient Warm Gold Vignette Spotlight -->
  <div class="absolute inset-0 pointer-events-none bg-[radial-gradient(circle_at_center,transparent_40%,rgba(74,93,67,0.04)_100%)]"></div>

  <!-- FLAT-LAY BOTANICAL ACCENTS (Resting aesthetically on the linen table around the envelope) -->
  <div id="splash-botanical-accents" class="absolute inset-0 pointer-events-none select-none z-5 overflow-hidden transition-opacity duration-500">
    
    <!-- Olive Branch: Top-Left angled across corner -->
    <svg class="absolute top-[8%] left-[4%] sm:top-[12%] sm:left-[12%] w-28 sm:w-36 h-28 sm:h-36 -rotate-12 filter drop-shadow-[0_4px_10px_rgba(42,52,38,0.08)] opacity-70" viewBox="0 0 100 100" fill="none">
      <path d="M10 90 Q40 50 85 15" stroke="#4A5D43" stroke-width="1.8" stroke-linecap="round" />
      <path d="M30 68 C22 55, 32 45, 42 55 C35 68, 30 68, 30 68 Z" fill="#5E7455" stroke="#B89352" stroke-width="0.8" />
      <path d="M48 48 C42 35, 52 26, 62 36 C54 48, 48 48, 48 48 Z" fill="#4A5D43" stroke="#B89352" stroke-width="0.8" />
      <path d="M66 32 C62 18, 74 12, 82 22 C74 33, 66 32, 66 32 Z" fill="#5E7455" stroke="#B89352" stroke-width="0.8" />
      <path d="M38 60 C50 62, 54 74, 45 80 C36 74, 38 60, 38 60 Z" fill="#6E8564" stroke="#B89352" stroke-width="0.7" />
      <path d="M58 40 C70 42, 72 54, 63 60 C54 54, 58 40, 58 40 Z" fill="#4A5D43" stroke="#B89352" stroke-width="0.7" />
      <ellipse cx="44" cy="58" rx="3.5" ry="5" fill="#2E3A2A" stroke="#B89352" stroke-width="0.6" transform="rotate(25 44 58)" />
    </svg>

    <!-- Olive Branch: Bottom-Right angled outward -->
    <svg class="absolute bottom-[8%] right-[4%] sm:bottom-[10%] sm:right-[12%] w-32 sm:w-40 h-32 sm:h-40 rotate-45 filter drop-shadow-[0_4px_10px_rgba(42,52,38,0.08)] opacity-70" viewBox="0 0 100 100" fill="none">
      <path d="M15 15 Q55 50 90 85" stroke="#4A5D43" stroke-width="1.8" stroke-linecap="round" />
      <path d="M35 32 C26 22, 36 12, 46 22 C39 33, 35 32, 35 32 Z" fill="#5E7455" stroke="#B89352" stroke-width="0.8" />
      <path d="M52 48 C46 36, 56 26, 66 36 C58 48, 52 48, 52 48 Z" fill="#4A5D43" stroke="#B89352" stroke-width="0.8" />
      <path d="M70 65 C64 52, 75 44, 84 54 C76 66, 70 65, 70 65 Z" fill="#6E8564" stroke="#B89352" stroke-width="0.8" />
      <path d="M42 40 C54 44, 56 56, 46 62 C38 55, 42 40, 42 40 Z" fill="#4A5D43" stroke="#B89352" stroke-width="0.7" />
      <path d="M60 58 C72 62, 74 74, 64 80 C56 74, 60 58, 60 58 Z" fill="#5E7455" stroke="#B89352" stroke-width="0.7" />
    </svg>

    <!-- Scattered Fallen Gold Petals & Olive Leaves -->
    <div class="absolute top-[20%] right-[16%] sm:right-[22%] w-3.5 h-5.5 rounded-full bg-gradient-to-br from-[#B89352] to-[#8C6D34] opacity-45 rotate-45 filter drop-shadow-sm"></div>
    <div class="absolute bottom-[22%] left-[14%] sm:left-[20%] w-3 h-4.5 rounded-full bg-gradient-to-br from-[#5E7455] to-[#3B4C35] opacity-55 -rotate-30 filter drop-shadow-sm"></div>
    <div class="absolute top-[45%] left-[6%] sm:left-[9%] w-3 h-4 rounded-full bg-gradient-to-br from-[#D4AF6E] to-[#B89352] opacity-40 rotate-12 filter drop-shadow-sm"></div>
    <div class="absolute bottom-[32%] right-[7%] sm:right-[11%] w-3.5 h-5 rounded-full bg-gradient-to-br from-[#4A5D43] to-[#2E3C29] opacity-50 -rotate-60 filter drop-shadow-sm"></div>

  </div>

  <!-- EDITORIAL HEADER (Pinterest Stationery Layout: Crest, Names & Date) -->
  <div id="splash-editorial-header" class="flex flex-col items-center text-center mb-4 sm:mb-6 pointer-events-none relative z-10 transition-all duration-500">
    <!-- Small Monogram Wreath Crest -->
    <div class="mb-1.5 opacity-90 transform scale-90">
      <FloralWreath monogram="AD" size={54} />
    </div>
    
    <p class="text-[0.55rem] sm:text-xs tracking-[0.38em] text-[#B89352] uppercase font-semibold mb-0.5">
      THE WEDDING OF
    </p>
    
    <h1 class="font-display text-2xl sm:text-3xl md:text-4xl text-[#2A3426] font-normal tracking-tight leading-tight">
      {content.couple.groom.nickname} <span class="font-display italic text-[#B89352] font-normal px-1">&amp;</span> {content.couple.bride.nickname}
    </h1>
    
    <p class="text-[0.6rem] sm:text-[0.68rem] text-[#566A4E] tracking-[0.24em] uppercase font-light mt-1">
      {content.event.dateFormatted} &bull; Banda Aceh
    </p>
  </div>

  <!-- 3D PERSPECTIVE SCENE CONTAINER -->
  <div
    id="envelope-scene"
    class="relative w-full max-w-[460px] sm:max-w-[500px] aspect-[1.46/1] cursor-pointer will-change-transform z-20"
    style="perspective: 1600px; transform-style: preserve-3d;"
  >
    <!-- Deep Ambient Envelope Shadow on Linen Table -->
    <div
      id="envelope-shadow"
      class="absolute -inset-4 rounded-3xl bg-[#2A3426]/18 blur-2xl pointer-events-none transform translate-y-10 transition-all duration-700"
    ></div>

    <!-- MAIN PHYSICAL ENVELOPE RIG -->
    <div
      id="envelope-body"
      class="relative w-full h-full rounded-2xl shadow-[0_25px_60px_rgba(42,52,38,0.18),0_4px_12px_rgba(42,52,38,0.08)] bg-[#F5F1E8] border border-[#D8D0BF] overflow-visible"
      style="transform-style: preserve-3d;"
    >
      <!-- LAYER 0: INSIDE POCKET LINING (Revealed when flap opens: Clean Warm Ivory Cotton Stock) -->
      <div class="absolute inset-0 rounded-2xl overflow-hidden bg-gradient-to-b from-[#FAF7F0] via-[#F2EDE2] to-[#E5DFCFC] pointer-events-none z-0">
        <!-- Delicate Inset Gold Stitching Line Inside -->
        <svg class="absolute inset-0 w-full h-full" viewBox="0 0 100 68" preserveAspectRatio="none">
          <rect x="2.5" y="2" width="95" height="64" rx="2" fill="none" stroke="#B89352" stroke-width="0.4" stroke-dasharray="1.8 1.2" opacity="0.3" />
        </svg>
        <!-- Inner Pocket Depth Shadow -->
        <div class="absolute inset-x-0 bottom-0 h-36 bg-gradient-to-t from-[#2A3426]/15 via-[#2A3426]/04 to-transparent"></div>
      </div>

      <!-- LAYER 1: THE LETTER CARD (Tucked inside, emerges upwards, then seamlessly zooms into Hero) -->
      <div
        id="envelope-card"
        class="absolute left-[3.5%] right-[3.5%] top-[4%] h-[92%] bg-[#FAF8F5] rounded-xl shadow-[0_12px_35px_rgba(42,52,38,0.14)] border border-[#B89352]/40 p-5 sm:p-7 flex flex-col items-center justify-between text-center z-10 opacity-0 pointer-events-none will-change-transform"
      >
        <!-- Double Gold Hairline Inset Frame with Stitching -->
        <div class="absolute inset-2 sm:inset-3 border border-[#B89352]/30 rounded-lg pointer-events-none"></div>
        <div class="absolute inset-2.5 sm:inset-3.5 border border-dashed border-[#566A4E]/20 rounded-md pointer-events-none"></div>

        <!-- Header -->
        <div class="pt-1 relative z-10">
          <p class="text-[0.52rem] sm:text-[0.6rem] text-[#B89352] uppercase tracking-[0.32em] font-semibold">
            THE WEDDING INVITATION
          </p>
          <p class="font-arabic text-base sm:text-lg text-[#3E4C38] tracking-wider mt-0.5" dir="rtl" lang="ar">
            بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ
          </p>
        </div>

        <!-- Center Couple Crest & Title -->
        <div class="my-auto flex flex-col items-center relative z-10">
          <div class="scale-85 sm:scale-95 mb-1">
            <FloralWreath monogram="AD" size={64} />
          </div>
          <p class="text-[0.55rem] sm:text-[0.62rem] tracking-[0.3em] text-[#B89352] uppercase font-semibold mb-0.5">
            WALIMATUL 'URS
          </p>
          <h2 class="font-display text-2xl sm:text-3xl md:text-4xl text-[#2A3426] font-normal tracking-tight my-0.5">
            {content.couple.groom.nickname} <span class="italic text-[#B89352]">&amp;</span> {content.couple.bride.nickname}
          </h2>
          <FloralFlourish width={130} height={20} className="scale-85 opacity-75 mt-0.5" />
        </div>

        <!-- Meta Footer -->
        <div class="pb-1 relative z-10">
          <p class="text-[0.58rem] sm:text-[0.65rem] text-[#4A5D43] tracking-[0.24em] uppercase font-medium">
            {content.event.dateFormatted} &bull; Banda Aceh
          </p>
        </div>
      </div>

      <!-- LAYER 2: FRONT ENVELOPE SOLID POCKET (100% Opaque Cotton Stock with Tailored Gold Stitching) -->
      <div class="absolute inset-0 z-20 pointer-events-none rounded-2xl overflow-hidden">
        
        <!-- Base Solid Pocket Background (Completely blocks anything from bleeding through) -->
        <div class="absolute inset-0 bg-[#EFEADF]"></div>

        <!-- Left Side Flap Fold -->
        <div 
          class="absolute inset-0"
          style="clip-path: polygon(0 0, 50% 50%, 0 100%); background: linear-gradient(135deg, #F3EEE4 0%, #E7E0D2 100%);"
        ></div>

        <!-- Right Side Flap Fold -->
        <div 
          class="absolute inset-0"
          style="clip-path: polygon(100% 0, 50% 50%, 100% 100%); background: linear-gradient(225deg, #F3EEE4 0%, #E7E0D2 100%);"
        ></div>

        <!-- Bottom Triangle Pocket (Rising with crisp paper crease & subtle shadow) -->
        <div 
          class="absolute inset-0 filter drop-shadow-[0_-5px_12px_rgba(42,52,38,0.07)]"
          style="clip-path: polygon(0 100%, 100% 100%, 50% 50%); background: linear-gradient(180deg, #FAF7F0 0%, #F1ECE2 50%, #E8E2D4 100%);"
        ></div>

        <!-- Bespoke Gold Stitching Lines along Seams (Pola Jahitan Rapi) -->
        <svg class="absolute inset-0 w-full h-full pointer-events-none" viewBox="0 0 100 68" preserveAspectRatio="none">
          <!-- Perimeter Stitching -->
          <rect x="2" y="1.5" width="96" height="65" rx="3" fill="none" stroke="#B89352" stroke-width="0.5" stroke-dasharray="2 1.5" opacity="0.45" />
          
          <!-- Bottom V-fold Stitching -->
          <path d="M1 67 L50 34.5 L99 67" fill="none" stroke="#B89352" stroke-width="0.7" stroke-dasharray="2 1.5" opacity="0.75" />
          
          <!-- Diagonal Side Flap Stitching -->
          <path d="M1 1 L50 34.5" fill="none" stroke="#B89352" stroke-width="0.5" stroke-dasharray="2 1.5" opacity="0.5" />
          <path d="M99 1 L50 34.5" fill="none" stroke="#B89352" stroke-width="0.5" stroke-dasharray="2 1.5" opacity="0.5" />
        </svg>

      </div>

      <!-- LAYER 2.3: VERTICAL OLIVE SATIN RIBBON SASH (Running vertically behind wax seal) -->
      <div class="absolute top-0 bottom-0 left-1/2 -translate-x-1/2 w-8 sm:w-9.5 z-23 pointer-events-none overflow-hidden shadow-sm">
        <div class="w-full h-full bg-gradient-to-r from-[#33422E] via-[#4A5D43] to-[#33422E] relative border-x border-[#B89352]/40">
          <!-- Subtle Satin Sheen Line -->
          <div class="absolute inset-y-0 left-1/2 -translate-x-1/2 w-[1.5px] bg-white/20"></div>
          <div class="absolute inset-y-0 left-1 w-[0.5px] bg-[#B89352]/35"></div>
          <div class="absolute inset-y-0 right-1 w-[0.5px] bg-[#B89352]/35"></div>
        </div>
      </div>

      <!-- LAYER 2.5: LUXURY GUEST CALLIGRAPHY NAMEPLATE (Centered on lower pocket) -->
      <div class="absolute bottom-3.5 sm:bottom-4 left-1/2 -translate-x-1/2 w-[82%] sm:w-[72%] max-w-[270px] z-25 pointer-events-none">
        <div class="py-2 px-3.5 rounded-xl bg-white/95 border border-[#B89352]/40 shadow-[0_4px_16px_rgba(42,52,38,0.06)] text-center relative overflow-hidden">
          <!-- Inset Gold Stitching Frame -->
          <div class="absolute inset-1 border border-dashed border-[#B89352]/35 rounded-lg pointer-events-none"></div>
          
          <p class="text-[0.52rem] text-[#7E8F77] uppercase tracking-[0.24em] font-semibold mb-0.5 relative z-10">
            Kepada Yth. Bapak/Ibu/Saudara/i:
          </p>
          <p id="guest-name-splash" class="font-display text-xs sm:text-sm text-[#2A3426] font-normal leading-tight truncate relative z-10">
            Tamu Undangan Terhormat
          </p>
        </div>
      </div>

      <!-- LAYER 3: 3D EURO TOP FLAP (Deep V with Gold Contour & Gold Stitching) -->
      <div
        id="envelope-top-flap-container"
        class="absolute top-0 left-0 right-0 h-[58%] origin-top z-30 pointer-events-none"
        style="transform-style: preserve-3d; perspective: 1200px;"
      >
        <!-- The Flipping Flap Element -->
        <div
          id="envelope-top-flap"
          class="relative w-full h-full origin-top will-change-transform"
          style="transform-style: preserve-3d; transform-origin: top center;"
        >
          <!-- Flap Front Face (Visible When Closed: Deep Euro V Pointing Down with Gold Stitching) -->
          <div
            class="absolute inset-0 rounded-t-2xl filter drop-shadow-[0_8px_16px_rgba(42,52,38,0.12)]"
            style="clip-path: polygon(0 0, 100% 0, 50% 100%); background: linear-gradient(180deg, #FAF7F0 0%, #F1ECE2 60%, #E7E0D0 100%); backface-visibility: hidden; -webkit-backface-visibility: hidden;"
          >
            <!-- Inset Gold Stitching Contour Line along Flap Edge -->
            <svg class="absolute inset-0 w-full h-full pointer-events-none" viewBox="0 0 100 58" preserveAspectRatio="none">
              <path d="M2.5 1 L50 55.5 L97.5 1" fill="none" stroke="#B89352" stroke-width="0.75" stroke-dasharray="2 1.5" opacity="0.8" />
              <path d="M0 0 L50 58 L100 0" fill="none" stroke="#D5CCBC" stroke-width="0.5" opacity="0.7" />
            </svg>
          </div>

          <!-- Flap Back Face (Visible When Flipped Open 180°: Clean Satin Cream with Gold Stitching) -->
          <div
            class="absolute inset-0 rounded-t-2xl overflow-hidden"
            style="clip-path: polygon(0 0, 100% 0, 50% 100%); background: linear-gradient(180deg, #F8F5EE 0%, #EDE7DB 100%); transform: rotateX(180deg); backface-visibility: hidden; -webkit-backface-visibility: hidden;"
          >
            <!-- Inset Gold Stitching on inside of flap -->
            <svg class="absolute inset-0 w-full h-full pointer-events-none" viewBox="0 0 100 58" preserveAspectRatio="none">
              <path d="M3.5 1.5 L50 55 L96.5 1.5" fill="none" stroke="#B89352" stroke-width="0.65" stroke-dasharray="2 1.5" opacity="0.6" />
            </svg>
            <div class="absolute inset-0 border-t-2 border-[#B89352]/40"></div>
          </div>
        </div>
      </div>

      <!-- LAYER 4: AUTHENTIC POURED OLIVE WAX SEAL (Centered at Flap V-Tip on top of the Satin Ribbon) -->
      <div
        id="wax-seal-container"
        class="absolute top-[50%] left-1/2 -translate-x-1/2 -translate-y-1/2 z-40 cursor-pointer pointer-events-auto transform transition-all duration-300 hover:scale-105 active:scale-95"
      >
        <div class="relative flex items-center justify-center group">
          <!-- Ambient Gold Glow Halo -->
          <div id="wax-seal-halo" class="absolute -inset-3 rounded-full bg-[#B89352]/25 blur-md opacity-60 group-hover:opacity-100 group-hover:scale-110 transition-all duration-300"></div>

          <!-- Poured Molten Wax Seal Disc (Organic 8-Lobed Shape) -->
          <svg width="60" height="60" viewBox="0 0 100 100" class="filter drop-shadow-[0_8px_18px_rgba(36,49,32,0.4)]">
            <path
              d="M50 5 
                 C62 4, 73 8, 82 17 
                 C91 26, 96 37, 95 50 
                 C94 63, 90 74, 81 83 
                 C72 92, 61 96, 48 95 
                 C35 94, 24 90, 16 80 
                 C7 71, 3 59, 5 46 
                 C7 33, 12 22, 22 14 
                 C31 6, 41 5, 50 5 Z"
              fill="url(#wax-gradient)"
              stroke="#5C7352"
              stroke-width="1.5"
            />
            
            <!-- Recessed Stamped Center Ring -->
            <circle cx="50" cy="50" r="34" fill="#3B4C35" stroke="#B89352" stroke-width="1.2" opacity="0.9" />
            <circle cx="50" cy="50" r="30" fill="none" stroke="#B89352" stroke-width="0.8" stroke-dasharray="2 1.5" opacity="0.7" />

            <!-- Embossed Monogram "AD" & Sprig -->
            <text x="50" y="55" font-family="'Cormorant Garamond', serif" font-size="22" font-style="italic" font-weight="600" fill="#F4E5C7" text-anchor="middle" letter-spacing="1">AD</text>
            <path d="M42 62 Q50 64 58 62" stroke="#B89352" stroke-width="1" fill="none" stroke-linecap="round" />
            <circle cx="50" cy="63" r="1" fill="#B89352" />

            <!-- Wax Gradient Definitions -->
            <defs>
              <linearGradient id="wax-gradient" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" stop-color="#556C4D" />
                <stop offset="45%" stop-color="#40533A" />
                <stop offset="85%" stop-color="#2E3C29" />
                <stop offset="100%" stop-color="#232E1F" />
              </linearGradient>
            </defs>
          </svg>
        </div>
      </div>

    </div>
  </div>

</div>

<script>
  import gsap from 'gsap';
  import { playWaxSealSound, playCardFlipSound, playChimeSound } from './reactbits/SoundEffects';

  function initLuxuryEnvelope() {
    const screen = document.getElementById('envelope-screen');
    const scene = document.getElementById('envelope-scene');
    const topFlap = document.getElementById('envelope-top-flap');
    const topFlapContainer = document.getElementById('envelope-top-flap-container');
    const letterCard = document.getElementById('envelope-card');
    const waxSealContainer = document.getElementById('wax-seal-container');
    const promptBtn = document.getElementById('btn-open-envelope');
    const promptContainer = document.getElementById('envelope-prompt');
    const editorialHeader = document.getElementById('splash-editorial-header');
    const botanicalAccents = document.getElementById('splash-botanical-accents');
    const guestSplash = document.getElementById('guest-name-splash');

    if (!screen || !scene || !topFlap || !letterCard) return;

    // Strict Scroll Containment: Ensure page is locked at (0, 0)
    window.scrollTo(0, 0);
    if ((window as any).__lenis) {
      (window as any).__lenis.stop();
      (window as any).__lenis.scrollTo(0, { immediate: true });
    }

    // Parse guest name from URL parameter ?to=
    const urlParams = new URLSearchParams(window.location.search);
    const rawTo = urlParams.get('to');
    if (rawTo && guestSplash) {
      try {
        const decoded = decodeURIComponent(rawTo.replace(/\+/g, ' ')).replace(/<[^>]*>/g, '').trim().substring(0, 50);
        if (decoded) guestSplash.textContent = decoded;
      } catch (e) {}
    }

    let isOpened = false;

    // =========================================================================
    // CINEMATIC SEQUENTIAL UNBOXING: FLAP OPENS -> CARD EMERGES FULLY -> SMOOTH TRANSITION
    // =========================================================================
    function openInvitation() {
      if (isOpened) return;
      isOpened = true;

      // 1. Play tactile wax breaking sound & trigger music fade-in
      playWaxSealSound();
      window.dispatchEvent(new CustomEvent('invitationOpening'));

      const tl = gsap.timeline();

      // PHASE 1: Wax seal lifts with soft gold halo & dissolves; Header and surrounding accents fade softly
      if (waxSealContainer) {
        tl.to(waxSealContainer, {
          scale: 1.2,
          y: -10,
          opacity: 0,
          duration: 0.35,
          ease: 'power2.out'
        }, 0);
      }

      if (promptContainer) {
        tl.to(promptContainer, { opacity: 0, y: 10, duration: 0.28 }, 0);
      }

      if (editorialHeader) {
        tl.to(editorialHeader, { opacity: 0, y: -16, duration: 0.45, ease: 'power2.inOut' }, 0);
      }

      if (botanicalAccents) {
        tl.to(botanicalAccents, { opacity: 0, duration: 0.5, ease: 'power2.inOut' }, 0);
      }

      // PHASE 2: Euro flap flips open 180° in 3D (0.2s -> 0.95s)
      tl.to(topFlap, {
        rotateX: 180,
        duration: 0.75,
        ease: 'power2.inOut',
        onUpdate: function() {
          // Adjust zIndex halfway so open flap stays behind the letter card
          if (this.progress() > 0.48 && topFlapContainer) {
            topFlapContainer.style.zIndex = '5';
          }
        }
      }, 0.2);

      // PHASE 3: Surat keluar PENUH dari dalam amplop (0.95s -> 1.85s)
      tl.add(() => {
        playCardFlipSound();
        if ((window as any).triggerLuxuryConfetti) {
          (window as any).triggerLuxuryConfetti(window.innerWidth / 2, window.innerHeight * 0.45);
        }
      }, 0.95);

      // Card glides straight up out of the pocket
      tl.to(letterCard, {
        opacity: 1,
        y: '-78%',
        boxShadow: '0 28px 65px rgba(42, 52, 38, 0.25)',
        duration: 0.85,
        ease: 'power3.out'
      }, 0.95);

      // Bring card to front (zIndex 35) once it clears the pocket, then let it settle majestically
      tl.add(() => {
        if (letterCard) letterCard.style.zIndex = '35';
      }, 1.6);

      tl.to(letterCard, {
        y: '-55%',
        duration: 0.45,
        ease: 'power2.out'
      }, 1.6);

      // PHASE 4: PAUSE & APPRECIATE (1.85s -> 2.45s) — Surat tampil utuh di depan layar!

      // PHASE 5: BARU TRANSISI HALUS KE HALAMAN UTAMA (2.45s -> 3.35s)
      tl.add(() => {
        playChimeSound();
      }, 2.45);

      // Camera smoothly zooms in directly onto the letter card
      tl.to(scene, {
        scale: 2.1,
        y: 40,
        duration: 0.9,
        ease: 'power2.inOut'
      }, 2.45);

      // Envelope body fades away smoothly
      const envelopeBody = document.getElementById('envelope-body');
      if (envelopeBody) {
        tl.to(envelopeBody, {
          opacity: 0,
          duration: 0.7,
          ease: 'power2.inOut'
        }, 2.5);
      }

      // Splash screen dissolves smoothly into the waiting Hero section directly underneath
      tl.to(screen, {
        opacity: 0,
        duration: 0.8,
        ease: 'power2.inOut'
      }, 2.65);

      // PHASE 6: Transition Complete — Enable Lenis Scroll & Clean Screen
      tl.add(() => {
        if (screen) screen.style.display = 'none';
        document.documentElement.classList.remove('is-locked');
        document.body.classList.remove('is-locked');
        window.scrollTo(0, 0);
        if ((window as any).__lenis) {
          (window as any).__lenis.scrollTo(0, { immediate: true });
          (window as any).__lenis.start();
        }
        window.dispatchEvent(new CustomEvent('invitationOpened'));
      }, 3.45);
    }

    // Event listeners
    if (waxSealContainer) waxSealContainer.addEventListener('click', openInvitation);
    if (promptBtn) promptBtn.addEventListener('click', openInvitation);
    if (scene) scene.addEventListener('click', openInvitation);

    // Prevent wheel/touch from scrolling background while envelope is visible
    const onPrevent = (e: Event) => {
      if (screen && screen.style.display !== 'none') {
        e.preventDefault();
      }
    };
    window.addEventListener('wheel', onPrevent, { passive: false });
    window.addEventListener('touchmove', onPrevent, { passive: false });
    window.addEventListener('keydown', (e) => {
      if (screen && screen.style.display !== 'none' && ['Enter', ' '].includes(e.key)) {
        e.preventDefault();
        openInvitation();
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initLuxuryEnvelope);
  } else {
    initLuxuryEnvelope();
  }
</script>
