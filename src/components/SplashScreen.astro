---
// SplashScreen.astro — Cinematic Auto-Intro Splashscreen (No Card / No Box)
import BotanicalCrest from './BotanicalCrest.astro';
import ShinyText from './reactbits/ShinyText';
import content from '../data/content.json';
---

<div
  id="splashscreen"
  class="fixed inset-0 z-[9999] flex flex-col items-center justify-between p-6 sm:p-12 bg-navy-base cursor-pointer select-none overflow-hidden transition-all duration-1000 ease-[cubic-bezier(0.16,1,0.3,1)]"
  role="dialog"
  aria-modal="true"
  aria-label="Animasi Pembuka Undangan"
>
  <!-- Ambient Atmospheric Glowing Orbs -->
  <div class="absolute inset-0 pointer-events-none overflow-hidden" aria-hidden="true">
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[340px] sm:w-[600px] h-[340px] sm:h-[600px] rounded-full bg-gold/10 blur-[100px] animate-pulse"></div>
  </div>

  <!-- Top Accent: Bismillah -->
  <header class="relative z-10 text-center pt-4 sm:pt-6 opacity-0 animate-[fadeIn_1s_ease-out_0.2s_forwards]">
    <p class="font-arabic text-xl sm:text-2xl text-gold-bright tracking-wider" dir="rtl" lang="ar">
      بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ
    </p>
    <p class="text-[0.68rem] sm:text-xs text-gold/70 tracking-[0.35em] uppercase mt-1 font-light">
      Walimatul 'Urs
    </p>
  </header>

  <!-- Central Majestic Crest & Monogram Composition -->
  <main class="relative z-10 text-center flex flex-col items-center my-auto">
    
    <!-- Botanical Monogram Crest with Radiant Halo -->
    <div class="relative mb-6 opacity-0 animate-[fadeInScale_1.1s_cubic-bezier(0.16,1,0.3,1)_0.4s_forwards]">
      <div class="absolute inset-0 rounded-full bg-gold/25 blur-xl animate-pulse"></div>
      <BotanicalCrest monogram="AD" size={96} />
    </div>

    <!-- Sacred Overline -->
    <div class="opacity-0 animate-[fadeIn_1s_ease-out_0.7s_forwards]">
      <p class="text-overline tracking-[0.3em] text-xs">
        THE WEDDING OF
      </p>
    </div>

    <!-- Shimmering Names -->
    <div class="opacity-0 animate-[fadeInUp_1.2s_cubic-bezier(0.16,1,0.3,1)_0.9s_forwards] my-2">
      <h1 class="font-display text-4xl sm:text-6xl md:text-7xl text-pearl font-normal tracking-tight">
        <ShinyText client:load text={`${content.couple.groom.nickname} & ${content.couple.bride.nickname}`} speed={2.8} />
      </h1>
    </div>

    <!-- Date Preview -->
    <div class="opacity-0 animate-[fadeIn_1s_ease-out_1.2s_forwards] mt-2">
      <p class="text-xs sm:text-sm text-gold-bright/90 font-light tracking-[0.25em] uppercase">
        {content.event.dateFormatted} &bull; BANDA ACEH
      </p>
    </div>

  </main>

  <!-- Bottom Indicator: 2.5s Cinematic Progress Line -->
  <footer class="relative z-10 w-full max-w-xs mx-auto text-center pb-4 sm:pb-6 opacity-0 animate-[fadeIn_1s_ease-out_1.4s_forwards]">
    <div class="w-full h-[2px] bg-navy-surface rounded-full overflow-hidden border border-gold/20 mb-2.5">
      <div id="intro-progress-bar" class="h-full bg-gradient-to-r from-gold-soft via-gold to-gold-bright rounded-full w-0 transition-all duration-[2400ms] ease-out"></div>
    </div>
    <p class="text-[0.62rem] sm:text-[0.68rem] text-pearl-muted/80 tracking-[0.2em] uppercase font-light">
      Sentuh di mana saja untuk langsung masuk
    </p>
  </footer>

</div>

<style>
  @keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }
  @keyframes fadeInScale {
    from { opacity: 0; transform: scale(0.85); }
    to { opacity: 1; transform: scale(1); }
  }
  @keyframes fadeInUp {
    from { opacity: 0; transform: translateY(18px); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>

<script>
  import { playChimeSound } from './reactbits/SoundEffects';

  function initSplashScreen() {
    const splash = document.getElementById('splashscreen');
    const progressBar = document.getElementById('intro-progress-bar');
    if (!splash) return;

    // Start loading bar animation
    requestAnimationFrame(() => {
      if (progressBar) {
        progressBar.style.width = '100%';
      }
    });

    let isDismissed = false;

    function dismissSplash() {
      if (isDismissed) return;
      isDismissed = true;

      playChimeSound();

      // Trigger audio player & progress bar
      window.dispatchEvent(new CustomEvent('invitationOpening'));

      // Luxury vertical curtain wipe
      splash.style.transform = 'translateY(-100%)';
      splash.style.opacity = '0';

      setTimeout(() => {
        splash.style.display = 'none';
        document.body.classList.remove('is-locked');
        window.dispatchEvent(new CustomEvent('invitationOpened'));
      }, 750);
    }

    // Auto-transition after 2.5 seconds
    const autoTimer = setTimeout(dismissSplash, 2500);

    // Allow user to tap/click anywhere to enter immediately
    splash.addEventListener('click', () => {
      clearTimeout(autoTimer);
      dismissSplash();
    });

    // Touch support
    splash.addEventListener('touchend', () => {
      clearTimeout(autoTimer);
      dismissSplash();
    }, { passive: true });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initSplashScreen);
  } else {
    initSplashScreen();
  }
</script>
