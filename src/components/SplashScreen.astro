---
// SplashScreen.astro — Haute-Couture Wedding Stationery Envelope Unboxing
// Luxury Pinterest Flat-Lay Editorial: Botanical Flat-Lay Corners, 3D Gyro Parallax Tilt, Gilded Wax Seal & Confetti Burst
import content from '../data/content.json';
import FloralWreath from './botanical/FloralWreath.astro';
import FloralFlourish from './botanical/FloralFlourish.astro';
import FloralCorner from './botanical/FloralCorner.astro';
---

<div
  id="envelope-screen"
  class="fixed inset-0 z-[9999] flex flex-col items-center justify-center p-4 sm:p-6 bg-[#FAF8F5] select-none overflow-hidden will-change-transform"
  role="dialog"
  aria-modal="true"
  aria-label="Amplop Undangan Pernikahan"
>
  <!-- Fine Linen Paper Texture & Ambient Warm Gold Spotlight -->
  <div class="absolute inset-0 pointer-events-none bg-[radial-gradient(ellipse_at_50%_45%,rgba(212,175,55,0.12)_0%,rgba(250,248,245,0.45)_50%,rgba(238,231,219,0.92)_100%)]" aria-hidden="true"></div>
  <div class="absolute inset-0 pointer-events-none opacity-30 bg-[radial-gradient(rgba(184,147,82,0.14)_1px,transparent_1px)] [background-size:24px_24px]"></div>

  <!-- HAUTE-COUTURE BOTANICAL FLAT-LAY CORNERS (Authentic Olive & Ginkgo Leaf Sprigs) -->
  <div class="splash-botanical-corners absolute inset-0 pointer-events-none z-10 transition-opacity duration-700 overflow-hidden">
    <div class="absolute -top-1 -left-1 sm:top-0 sm:left-0 opacity-90 transform scale-90 sm:scale-100">
      <FloralCorner position="top-left" size={130} />
    </div>
    <div class="absolute -top-1 -right-1 sm:top-0 sm:right-0 opacity-90 transform scale-90 sm:scale-100">
      <FloralCorner position="top-right" size={130} />
    </div>
    <div class="absolute -bottom-1 -left-1 sm:bottom-0 sm:left-0 opacity-80 transform scale-90 sm:scale-100">
      <FloralCorner position="bottom-left" size={120} />
    </div>
    <div class="absolute -bottom-1 -right-1 sm:bottom-0 sm:right-0 opacity-80 transform scale-90 sm:scale-100">
      <FloralCorner position="bottom-right" size={120} />
    </div>
  </div>

  <!-- EDITORIAL HEADER (Unopened Letter Invitation Header — No Spoilers) -->
  <div id="splash-editorial-header" class="flex flex-col items-center text-center mb-3 sm:mb-5 pointer-events-none relative z-10 transition-all duration-500">
    <!-- Small Monogram Wreath Crest -->
    <div class="mb-1 opacity-90 transform scale-90">
      <FloralWreath monogram="ZD" size={52} />
    </div>
    
    <p class="text-[0.62rem] sm:text-xs tracking-[0.38em] text-[#B89352] uppercase font-semibold mb-1">
      THE WEDDING INVITATION
    </p>
    
    <h1 class="font-display italic text-2xl sm:text-3xl md:text-4xl text-[#2A3426] font-normal tracking-wide leading-tight">
      You Are Cordially Invited
    </h1>
    
    <div class="my-1 opacity-60">
      <FloralFlourish width={110} height={16} />
    </div>
  </div>

  <!-- 3D PERSPECTIVE SCENE CONTAINER -->
  <div
    id="envelope-scene"
    class="relative w-full max-w-[460px] sm:max-w-[500px] aspect-[1.46/1] cursor-pointer will-change-transform z-20"
    style="perspective: 1600px; transform-style: preserve-3d;"
  >
    <!-- Deep Ambient Envelope Shadow on Linen Table -->
    <div
      id="envelope-shadow"
      class="absolute -inset-4 rounded-3xl bg-[#2A3426]/18 blur-2xl pointer-events-none transform translate-y-10 transition-all duration-700"
    ></div>

    <!-- MAIN PHYSICAL ENVELOPE RIG -->
    <div
      id="envelope-body"
      class="relative w-full h-full rounded-2xl shadow-[0_25px_60px_rgba(42,52,38,0.18),0_4px_12px_rgba(42,52,38,0.08)] bg-[#F5F1E8] border-x border-b border-[#D8D0BF] overflow-visible"
      style="transform-style: preserve-3d;"
    >
      <!-- LAYER 0: INSIDE POCKET LINING (Revealed when flap opens: Clean Warm Ivory Cotton Stock) -->
      <div id="envelope-lining" class="absolute inset-0 rounded-2xl overflow-hidden bg-gradient-to-b from-[#FAF7F0] via-[#F2EDE2] to-[#E5DFCF] pointer-events-none z-0 transition-opacity">
        <!-- Inner Pocket Depth Shadow -->
        <div class="absolute inset-x-0 bottom-0 h-36 bg-gradient-to-t from-[#2A3426]/15 via-[#2A3426]/04 to-transparent"></div>
      </div>

      <!-- LAYER 1: THE LETTER CARD (Tucked inside, emerges upwards, then seamlessly zooms into Hero) -->
      <div
        id="envelope-card"
        class="absolute left-[3.5%] right-[3.5%] top-[4%] h-[92%] bg-[#FAF8F5] rounded-xl shadow-[0_12px_35px_rgba(42,52,38,0.14)] border border-[#B89352]/40 p-5 sm:p-7 flex flex-col items-center justify-between text-center z-10 opacity-0 pointer-events-none will-change-transform"
      >
        <!-- Double Gold Hairline Inset Frame (Clean, No Disruptive Dashed Lines) -->
        <div class="absolute inset-2 sm:inset-3 border border-[#B89352]/30 rounded-lg pointer-events-none"></div>
        <div class="absolute inset-2.5 sm:inset-3.5 border border-[#566A4E]/15 rounded-md pointer-events-none"></div>

        <!-- Header -->
        <div class="pt-1 relative z-10">
          <p class="text-[0.52rem] sm:text-[0.6rem] text-[#B89352] uppercase tracking-[0.32em] font-semibold">
            THE WEDDING INVITATION
          </p>
          <p class="font-arabic text-base sm:text-lg text-[#3E4C38] tracking-wider mt-0.5" dir="rtl" lang="ar">
            بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ
          </p>
        </div>

        <!-- Center Couple Crest & Title -->
        <div class="my-auto flex flex-col items-center relative z-10">
          <div class="scale-85 sm:scale-95 mb-1">
            <FloralWreath monogram="ZD" size={64} />
          </div>
          <p class="text-[0.55rem] sm:text-[0.62rem] tracking-[0.3em] text-[#B89352] uppercase font-semibold mb-0.5">
            WALIMATUL 'URS
          </p>
          <h2 class="font-display text-2xl sm:text-3xl md:text-4xl text-[#2A3426] font-normal tracking-tight my-0.5">
            {content.couple.groom.nickname} <span class="italic text-[#B89352]">&amp;</span> {content.couple.bride.nickname}
          </h2>
          <FloralFlourish width={130} height={20} className="scale-85 opacity-75 mt-0.5" />
        </div>

        <!-- Meta Footer -->
        <div class="pb-1 relative z-10">
          <p class="text-[0.58rem] sm:text-[0.65rem] text-[#4A5D43] tracking-[0.24em] uppercase font-medium">
            {content.event.dateFormatted} &bull; Padang
          </p>
        </div>
      </div>

      <!-- LAYER 2: FRONT ENVELOPE SOLID POCKET (100% Opaque Cotton Stock - Clean Folds, Zero Dashed Lines) -->
      <div id="envelope-pocket" class="absolute inset-0 z-20 pointer-events-none rounded-2xl overflow-hidden transition-opacity">
        
        <!-- Left Side Flap Fold -->
        <div 
          class="absolute inset-0"
          style="clip-path: polygon(0 0, 50% 50%, 0 100%); background: linear-gradient(135deg, #F3EEE4 0%, #E7E0D2 100%);"
        ></div>

        <!-- Right Side Flap Fold -->
        <div 
          class="absolute inset-0"
          style="clip-path: polygon(100% 0, 50% 50%, 100% 100%); background: linear-gradient(225deg, #F3EEE4 0%, #E7E0D2 100%);"
        ></div>

        <!-- Bottom Triangle Pocket (Rising with crisp paper crease & subtle shadow) -->
        <div 
          class="absolute inset-0 filter drop-shadow-[0_-5px_12px_rgba(42,52,38,0.07)]"
          style="clip-path: polygon(0 100%, 100% 100%, 50% 50%); background: linear-gradient(180deg, #FAF7F0 0%, #F1ECE2 50%, #E8E2D4 100%);"
        ></div>

      </div>

      <!-- LAYER 2.5: LUXURY GUEST CALLIGRAPHY NAMEPLATE (Centered on lower pocket) -->
      <div id="envelope-nameplate" class="absolute bottom-3.5 sm:bottom-4 left-1/2 -translate-x-1/2 w-[82%] sm:w-[72%] max-w-[270px] z-25 pointer-events-none transition-opacity">
        <div class="py-2 px-3.5 rounded-xl bg-white/95 border border-[#B89352]/40 shadow-[0_4px_16px_rgba(42,52,38,0.06)] text-center relative overflow-hidden">
          <div class="absolute inset-1 border border-[#B89352]/25 rounded-lg pointer-events-none"></div>
          
          <p class="text-[0.52rem] text-[#7E8F77] uppercase tracking-[0.24em] font-semibold mb-0.5 relative z-10">
            Kepada Yth. Bapak/Ibu/Saudara/i:
          </p>
          <p id="guest-name-splash" class="font-display text-xs sm:text-sm text-[#2A3426] font-normal leading-tight truncate relative z-10">
            Tamu Undangan Terhormat
          </p>
        </div>
      </div>

      <!-- LAYER 3: 3D EURO TOP FLAP (Unified Curved Paper Crease, Matching Rounded Corners) -->
      <div
        id="envelope-top-flap-container"
        class="absolute -top-[1px] -left-[1px] -right-[1px] h-[56%] origin-top z-30 pointer-events-none"
        style="perspective: 1200px; transform-style: preserve-3d;"
      >
        <!-- The Flipping Flap Element (Swings up 180° with point facing upward into the sky) -->
        <div
          id="envelope-top-flap"
          class="w-full h-full will-change-transform filter drop-shadow-[0_8px_14px_rgba(42,52,38,0.12)]"
          style="transform-origin: top center; transform-style: preserve-3d;"
        >
          <svg viewBox="0 0 100 56" preserveAspectRatio="none" class="w-full h-full overflow-visible">
            <defs>
              <linearGradient id="envelope-flap-gradient" x1="0%" y1="0%" x2="0%" y2="100%">
                <stop offset="0%" stop-color="#FAF7F0" />
                <stop offset="55%" stop-color="#F2EDE2" />
                <stop offset="100%" stop-color="#E8E2D4" />
              </linearGradient>
            </defs>
            <path
              d="M 0 5 
                 Q 0 0, 3.2 0 
                 L 96.8 0 
                 Q 100 0, 100 5 
                 L 51.2 55.2 
                 Q 50 56, 48.8 55.2 
                 Z"
              fill="url(#envelope-flap-gradient)"
              stroke="#D5CCBC"
              stroke-width="0.35"
              stroke-linejoin="round"
            />
          </svg>
        </div>
      </div>

      <!-- LAYER 4: AUTHENTIC POURED OLIVE WAX SEAL (Centered at Flap V-Tip) -->
      <div
        id="wax-seal-container"
        class="absolute top-[50%] left-1/2 -translate-x-1/2 -translate-y-1/2 z-40 cursor-pointer pointer-events-auto transform transition-transform duration-200 active:scale-95"
      >
        <div class="relative flex items-center justify-center group">
          <!-- Ambient Gold Glow Halo -->
          <div id="wax-seal-halo" class="absolute -inset-3 rounded-full bg-[#B89352]/25 blur-md opacity-60 group-hover:opacity-100 transition-opacity duration-300"></div>

          <!-- Poured Molten Wax Seal Disc (Organic 8-Lobed Shape) -->
          <svg width="60" height="60" viewBox="0 0 100 100" class="filter drop-shadow-[0_8px_18px_rgba(36,49,32,0.4)]">
            <path
              d="M50 5 
                 C62 4, 73 8, 82 17 
                 C91 26, 96 37, 95 50 
                 C94 63, 90 74, 81 83 
                 C72 92, 61 96, 48 95 
                 C35 94, 24 90, 16 80 
                 C7 71, 3 59, 5 46 
                 C7 33, 12 22, 22 14 
                 C31 6, 41 5, 50 5 Z"
              fill="url(#wax-gradient)"
              stroke="#5C7352"
              stroke-width="1.5"
            />
            
            <!-- Recessed Stamped Center Ring -->
            <circle cx="50" cy="50" r="34" fill="#3B4C35" stroke="#B89352" stroke-width="1.2" opacity="0.9" />
            <circle cx="50" cy="50" r="30" fill="none" stroke="#B89352" stroke-width="0.7" opacity="0.5" />

            <!-- Embossed Monogram "ZD" & Sprig -->
            <text x="50" y="55" font-family="'Cormorant Garamond', serif" font-size="22" font-style="italic" font-weight="600" fill="#F4E5C7" text-anchor="middle" letter-spacing="1">ZD</text>
            <path d="M42 62 Q50 64 58 62" stroke="#B89352" stroke-width="1" fill="none" stroke-linecap="round" />
            <circle cx="50" cy="63" r="1" fill="#B89352" />

            <!-- Wax Gradient Definitions -->
            <defs>
              <linearGradient id="wax-gradient" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" stop-color="#556C4D" />
                <stop offset="45%" stop-color="#40533A" />
                <stop offset="85%" stop-color="#2E3C29" />
                <stop offset="100%" stop-color="#232E1F" />
              </linearGradient>
            </defs>
          </svg>
        </div>
      </div>

    </div>
  </div>

</div>

<script>
  import gsap from 'gsap';
  import confetti from 'canvas-confetti';
  import { playWaxSealSound, playCardFlipSound } from './reactbits/SoundEffects';

  function initLuxuryEnvelope() {
    const screen = document.getElementById('envelope-screen');
    const scene = document.getElementById('envelope-scene');
    const topFlap = document.getElementById('envelope-top-flap');
    const topFlapContainer = document.getElementById('envelope-top-flap-container');
    const letterCard = document.getElementById('envelope-card');
    const waxSealContainer = document.getElementById('wax-seal-container');
    const editorialHeader = document.getElementById('splash-editorial-header');
    const guestSplash = document.getElementById('guest-name-splash');
    const envelopeBody = document.getElementById('envelope-body');
    const envelopeShadow = document.getElementById('envelope-shadow');
    const envelopePocket = document.getElementById('envelope-pocket');
    const envelopeLining = document.getElementById('envelope-lining');
    const envelopeNameplate = document.getElementById('envelope-nameplate');

    if (!screen || !scene || !topFlap || !letterCard) return;

    // Strict Scroll Containment: Ensure page is locked at (0, 0)
    window.scrollTo(0, 0);
    if ((window as any).__lenis) {
      (window as any).__lenis.stop();
      (window as any).__lenis.scrollTo(0, { immediate: true });
    }

    // Parse guest name from URL parameter ?to=
    const urlParams = new URLSearchParams(window.location.search);
    const rawTo = urlParams.get('to');
    if (rawTo && guestSplash) {
      try {
        const decoded = decodeURIComponent(rawTo.replace(/\+/g, ' ')).replace(/<[^>]*>/g, '').trim().substring(0, 50);
        if (decoded) guestSplash.textContent = decoded;
      } catch (e) {}
    }

    let isOpened = false;

    // =========================================================================
    // CINEMATIC SEQUENTIAL UNBOXING:
    // VELVETY FLAP OPENING -> SMOOTH CARD EMERGENCE -> ENVELOPE DISSOLVES ->
    // CARD RESTS IN READING PLATEAU -> SILKY CINEMATIC CROSS-DISSOLVE TO HERO
    // =========================================================================
    function openInvitation() {
      if (isOpened) return;
      isOpened = true;

      // 1. Play tactile wax breaking sound & trigger music fade-in
      playWaxSealSound();
      window.dispatchEvent(new CustomEvent('invitationOpening'));

      const tl = gsap.timeline();

      // PHASE 1: Wax seal lifts & dissolves softly; Header and nameplate float away
      if (waxSealContainer) {
        tl.to(waxSealContainer, {
          scale: 1.15,
          y: -8,
          opacity: 0,
          duration: 0.35,
          ease: 'power2.out'
        }, 0);
      }

      if (editorialHeader) {
        tl.to(editorialHeader, { opacity: 0, y: -16, duration: 0.60, ease: 'power2.out' }, 0.05);
      }

      if (envelopeNameplate) {
        tl.to(envelopeNameplate, { opacity: 0, y: 16, duration: 0.50, ease: 'power2.out' }, 0.05);
      }

      const botanicalCorners = document.querySelectorAll('.splash-botanical-corners');

      // PHASE 2: Euro flap flips open 180° in 3D with authentic paper inertia (0.20s -> 1.15s)
      tl.to(topFlap, {
        rotateX: 180,
        duration: 0.95,
        ease: 'power2.inOut',
        onUpdate: function() {
          if (this.progress() > 0.45 && topFlapContainer) {
            topFlapContainer.style.zIndex = '2';
          }
        }
      }, 0.20);

      // PHASE 3: Surat ditarik meluncur anggun keluar dari saku amplop (0.65s -> 1.75s)
      tl.to(letterCard, {
        opacity: 1,
        y: '-92%',
        scale: 1.02,
        duration: 1.10,
        ease: 'power3.out'
      }, 0.65);

      // AS THE CARD EMERGES: FADE OUT AND DISSOLVE THE ENVELOPE BASE (ZERO COLLISION)
      // All envelope parts sink down softly and melt into the background (1.15s -> 1.85s)
      const envelopeDissolveTargets = [
        topFlapContainer,
        envelopePocket,
        envelopeLining,
        envelopeShadow,
        envelopeBody
      ].filter(Boolean);

      tl.to(envelopeDissolveTargets, {
        opacity: 0,
        y: 40,
        duration: 0.70,
        ease: 'power2.out'
      }, 1.15);

      // 1.75s: Layer surat diposisikan di paling depan & semburan kelopak emas confetti
      tl.add(() => {
        if (letterCard) {
          letterCard.style.zIndex = '50';
          gsap.set(letterCard, { z: 50 });
        }
        playCardFlipSound();

        // Haute-Couture Gold Leaf, Olive & Ivory Confetti Burst
        confetti({
          particleCount: 55,
          spread: 75,
          origin: { x: 0.5, y: 0.42 },
          colors: ['#B89352', '#D4AF6E', '#F4E5C7', '#566A4E', '#3E4C38', '#FFFFFF'],
          ticks: 200,
          gravity: 0.75,
          scalar: 1.15,
          shapes: ['circle', 'square'],
          zIndex: 999999
        });

        setTimeout(() => {
          confetti({
            particleCount: 28,
            angle: 60,
            spread: 55,
            origin: { x: 0.35, y: 0.42 },
            colors: ['#D4AF6E', '#B89352', '#FAF8F5'],
            gravity: 0.65,
            scalar: 0.95,
            zIndex: 999999
          });
          confetti({
            particleCount: 28,
            angle: 120,
            spread: 55,
            origin: { x: 0.65, y: 0.42 },
            colors: ['#D4AF6E', '#566A4E', '#FAF8F5'],
            gravity: 0.65,
            scalar: 0.95,
            zIndex: 999999
          });
        }, 180);
      }, 1.75);

      // PHASE 4: Surat meluncur turun anggun ke posisi tengah membaca di kanvas yang BERSIH (1.80s -> 2.85s)
      tl.to(letterCard, {
        y: '0%',
        scale: 1.05,
        boxShadow: '0 25px 70px rgba(42, 52, 38, 0.20)',
        duration: 1.05,
        ease: 'power3.out'
      }, 1.80);

      // PHASE 5: Reading Plateau yang tenang & nyaman (2.85s -> 4.80s)
      // Memberikan waktu bagi tamu untuk membaca isi kartu undangan dengan tenang
      // User juga dapat mengetuk layar kapan saja pada fase ini untuk langsung melanjutkan
      const skipReading = () => {
        if (tl.time() >= 2.5 && tl.time() < 4.8) {
          tl.seek(4.8);
        }
      };
      screen.addEventListener('click', skipReading, { once: true });

      // PHASE 6: SILKY-SMOOTH CINEMATIC DISSOLVE KE HALAMAN UTAMA (4.80s -> 6.00s)
      // Surat mengapung lembut ke atas, sementara splash screen larut halus ke Hero di baliknya
      tl.to(scene, {
        scale: 1.10,
        y: -30,
        opacity: 0,
        duration: 1.20,
        ease: 'power2.inOut'
      }, 4.80);

      if (botanicalCorners.length) {
        tl.to(botanicalCorners, {
          opacity: 0,
          scale: 0.95,
          duration: 0.90,
          ease: 'power2.inOut'
        }, 4.90);
      }

      // Splash screen larut dengan halus menampilkan section Hero
      tl.to(screen, {
        opacity: 0,
        duration: 1.10,
        ease: 'power2.inOut'
      }, 4.90);

      // PHASE 7: Transition Complete — Enable Lenis Scroll & Clean Screen (6.05s)
      tl.add(() => {
        if (screen) screen.style.display = 'none';
        document.documentElement.classList.remove('is-locked');
        document.body.classList.remove('is-locked');
        window.scrollTo(0, 0);
        if ((window as any).__lenis) {
          (window as any).__lenis.scrollTo(0, { immediate: true });
          (window as any).__lenis.start();
        }
        window.dispatchEvent(new CustomEvent('invitationOpened'));
      }, 6.05);
    }

    // Event listeners: Klik wax seal atau amplop langsung membuka
    if (waxSealContainer) waxSealContainer.addEventListener('click', openInvitation);
    if (scene) scene.addEventListener('click', openInvitation);

    // Prevent wheel/touch from scrolling background while envelope is visible
    const onPrevent = (e: Event) => {
      if (screen && screen.style.display !== 'none') {
        e.preventDefault();
      }
    };
    window.addEventListener('wheel', onPrevent, { passive: false });
    window.addEventListener('touchmove', onPrevent, { passive: false });
    window.addEventListener('keydown', (e) => {
      if (screen && screen.style.display !== 'none' && ['Enter', ' '].includes(e.key)) {
        e.preventDefault();
        openInvitation();
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initLuxuryEnvelope);
  } else {
    initLuxuryEnvelope();
  }
</script>
