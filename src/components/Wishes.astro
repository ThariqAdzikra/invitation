---
// Wishes.astro — Interactive Digital Wishes via WhatsApp
import FiligreeDivider from './FiligreeDivider.astro';
import ShinyText from './reactbits/ShinyText';
---

<section id="wishes" class="section-flow relative px-4 text-center" aria-label="Kirim Doa dan Ucapan">
  <div class="max-w-xl mx-auto w-full">
    
    <FiligreeDivider className="mb-4" />

    <p class="text-overline">
      <ShinyText client:visible text="DOA & RESTU" speed={4} />
    </p>
    
    <h2 class="font-display text-2xl sm:text-3xl md:text-4xl text-pearl font-normal mt-1 mb-3">
      Kirimkan Doa &amp; Ucapan
    </h2>

    <p class="text-xs sm:text-sm text-pearl-muted font-light leading-relaxed max-w-md mx-auto mb-8">
      Doa restu dari Bapak/Ibu/Saudara/i sekalian merupakan anugerah terindah dan kebahagiaan terbesar bagi awal perjalanan ibadah kami.
    </p>

    <!-- Interactive Wishes Card -->
    <div class="bg-navy-surface border border-gold/25 rounded-xl p-6 sm:p-8 shadow-xl relative overflow-hidden">
      
      <!-- Subtle Corner Gold Flakes -->
      <div class="absolute top-0 right-0 w-16 h-16 bg-gold/5 rounded-bl-full pointer-events-none"></div>

      <div class="flex flex-col items-center gap-4">
        
        <!-- WhatsApp Icon Badge -->
        <div class="w-14 h-14 rounded-full border border-gold/40 bg-gold/10 flex items-center justify-center text-gold-bright shadow-[0_0_15px_rgba(197,160,89,0.25)]">
          <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
          </svg>
        </div>

        <div>
          <h3 class="font-display text-lg sm:text-xl text-pearl font-normal mb-1">
            Sampaikan Doa Terbaik Anda
          </h3>
          <p class="text-xs text-pearl-muted font-light max-w-sm">
            Klik tombol di bawah untuk mengirim pesan ucapan selamat yang telah disiapkan secara personal via WhatsApp.
          </p>
        </div>

        <!-- Interactive Button -->
        <a
          id="btn-send-wishes-wa"
          href="#"
          target="_blank"
          rel="noopener noreferrer"
          class="btn-gold-solid mt-2 inline-flex items-center gap-2"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
          </svg>
          <span>Kirim Ucapan via WhatsApp</span>
        </a>

      </div>

    </div>

    <FiligreeDivider className="mt-8" />

  </div>
</section>

<script>
  import { playChimeSound } from './reactbits/SoundEffects';

  function initWishes() {
    const btnWa = document.getElementById('btn-send-wishes-wa');
    if (!btnWa) return;

    // Get guest name from URL if available
    const urlParams = new URLSearchParams(window.location.search);
    const rawTo = urlParams.get('to');
    let sender = 'Tamu Undangan';

    if (rawTo) {
      try {
        const decoded = decodeURIComponent(rawTo.replace(/\+/g, ' ')).replace(/<[^>]*>/g, '').trim();
        if (decoded) sender = decoded;
      } catch (e) {}
    }

    const message = encodeURIComponent(
      `Halo Arya & Dian! Selamat atas pernikahan kalian. Semoga menjadi keluarga yang sakinah, mawaddah, dan warahmah, serta selalu dalam lindungan Allah SWT. Aamiin.\n\n— Dari: ${sender}`
    );

    // Number to bride/groom WhatsApp
    btnWa.setAttribute('href', `https://wa.me/6281269000000?text=${message}`);

    btnWa.addEventListener('click', () => {
      playChimeSound();
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initWishes);
  } else {
    initWishes();
  }
</script>
