---
// Wishes.astro — Interactive VIP Guest Pass, RSVP & Digital Wishes with Reactions
import FloralFlourish from './botanical/FloralFlourish.astro';
---

<section id="wishes" class="deck-section section-flow relative px-4 text-center overflow-hidden z-30 pt-20 pb-24" aria-label="Konfirmasi Kehadiran & Doa Restu">
  
  <div class="max-w-xl mx-auto w-full relative z-10 wishes-content">
    
    <p class="text-overline tracking-[0.28em]">
      KONFIRMASI &amp; DOA
    </p>
    
    <div class="kinetic-heading-mask my-1">
      <h2 class="font-display text-3xl sm:text-4xl text-[#2A3426] font-normal kinetic-heading-line">
        Doa Restu &amp; Kehadiran
      </h2>
    </div>

    <div class="flex justify-center my-2 opacity-70">
      <FloralFlourish width={160} height={24} />
    </div>

    <p class="text-xs sm:text-sm text-[#566A4E] font-light leading-relaxed max-w-md mx-auto mb-8">
      Merupakan suatu kehormatan bagi kami apabila Bapak/Ibu/Saudara/i berkenan mengonfirmasi kehadiran serta memberikan doa restu.
    </p>

    <!-- Interactive VIP Guest Pass / Live Ticket Preview -->
    <div 
      class="mb-6 bg-gradient-to-br from-[#FAF8F5] via-[#FFFFFF] to-[#F3EEE5] border border-[#B89352]/35 rounded-2xl p-5 sm:p-6 relative overflow-hidden shadow-[0_8px_30px_rgba(42,52,38,0.06)] text-left interactive-foil-card"
      data-foil="true"
    >
      <!-- Gold Foil Ribbon Top Bar -->
      <div class="absolute top-0 left-0 right-0 h-[2.5px] bg-gradient-to-r from-transparent via-[#B89352] to-transparent"></div>
      
      <!-- Watermark Monogram -->
      <span class="absolute -right-3 -bottom-5 font-display italic text-7xl text-[#B89352]/08 pointer-events-none select-none">D&amp;Z</span>

      <!-- Ticket Header -->
      <div class="flex items-center justify-between border-b border-dashed border-[#B89352]/30 pb-3 mb-4">
        <div class="flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-[#B89352] animate-ping"></span>
          <span class="text-[0.62rem] uppercase tracking-[0.24em] text-[#B89352] font-semibold">VIP GUEST INVITATION PASS</span>
        </div>
        <span class="text-[0.58rem] font-mono tracking-widest text-[#566A4E]/80 uppercase bg-[#B89352]/10 px-2 py-0.5 rounded">NO. #DZ-2026-VIP</span>
      </div>

      <!-- Ticket Body -->
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
        <div>
          <span class="text-[0.55rem] tracking-[0.22em] uppercase text-[#7E8F77] font-semibold block">Tamu Terhormat</span>
          <h3 id="ticket-guest-name" class="font-display text-xl sm:text-2xl text-[#2A3426] font-normal tracking-wide transition-all duration-200">
            Tamu Undangan
          </h3>
          <p class="text-[0.68rem] text-[#566A4E] mt-0.5 flex items-center gap-1.5">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-[#B89352]">
              <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
              <line x1="16" y1="2" x2="16" y2="6"></line>
              <line x1="8" y1="2" x2="8" y2="6"></line>
              <line x1="3" y1="10" x2="21" y2="10"></line>
            </svg>
            Sabtu, 26 Desember 2026 • Komp. PLN Koto Baru, Padang
          </p>
        </div>

        <!-- Badges on right side -->
        <div class="flex sm:flex-col items-start sm:items-end gap-1.5 self-start sm:self-center">
          <span id="ticket-guest-status" class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[0.62rem] font-semibold bg-[#4A5D43]/15 text-[#4A5D43] border border-[#4A5D43]/20">
            ✓ InsyaAllah Hadir
          </span>
          <span id="ticket-guest-pax" class="text-[0.62rem] text-[#7E8F77] font-medium tracking-wide">
            1 Tamu Terdaftar
          </span>
        </div>
      </div>

      <!-- Ticket Action Strip -->
      <div class="mt-4 pt-3 border-t border-dashed border-[#B89352]/25 flex items-center justify-between">
        <span class="text-[0.58rem] text-[#7E8F77] italic">Tunjukkan pass ini saat registrasi di venue</span>
        <button
          type="button"
          id="btn-copy-ticket"
          class="inline-flex items-center gap-1.5 text-[0.62rem] text-[#B89352] hover:text-[#4A5D43] uppercase tracking-wider font-semibold transition-colors cursor-pointer"
        >
          <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
            <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
          </svg>
          <span>Simpan Data Tiket</span>
        </button>
      </div>
    </div>

    <!-- RSVP & Wishes Form Card -->
    <div 
      class="bg-white/95 border border-[#566A4E]/20 rounded-2xl p-6 sm:p-9 relative overflow-hidden shadow-[0_12px_35px_rgba(42,52,38,0.05)] text-left interactive-foil-card"
      data-foil="true"
    >
      <div class="absolute top-0 left-0 right-0 h-[2px] bg-gradient-to-r from-transparent via-[#B89352] to-transparent"></div>
      
      <form id="rsvp-form" class="flex flex-col gap-4">
        
        <!-- Input Nama -->
        <div>
          <label for="rsvp-name" class="block text-[0.62rem] tracking-[0.2em] uppercase font-semibold text-[#566A4E] mb-1.5">
            Nama Lengkap
          </label>
          <input
            type="text"
            id="rsvp-name"
            required
            placeholder="Tuliskan nama Anda"
            class="w-full px-4 py-2.5 rounded-xl border border-[#566A4E]/25 bg-[#FAF8F5] text-xs text-[#2A3426] placeholder-[#7E8F77]/60 focus:outline-none focus:border-[#4A5D43] focus:bg-white transition-all"
          />
        </div>

        <!-- Pilihan Kehadiran -->
        <div>
          <label class="block text-[0.62rem] tracking-[0.2em] uppercase font-semibold text-[#566A4E] mb-1.5">
            Konfirmasi Kehadiran
          </label>
          <div class="grid grid-cols-2 gap-2.5">
            <label class="relative flex items-center justify-center gap-2 p-2.5 rounded-xl border border-[#566A4E]/20 bg-[#FAF8F5] cursor-pointer hover:border-[#4A5D43] transition-all has-[:checked]:border-[#4A5D43] has-[:checked]:bg-[#4A5D43]/10">
              <input type="radio" name="attendance" value="Hadir" checked class="accent-[#4A5D43]" />
              <span class="text-xs font-medium text-[#2A3426]">InsyaAllah Hadir</span>
            </label>
            <label class="relative flex items-center justify-center gap-2 p-2.5 rounded-xl border border-[#566A4E]/20 bg-[#FAF8F5] cursor-pointer hover:border-[#4A5D43] transition-all has-[:checked]:border-[#4A5D43] has-[:checked]:bg-[#4A5D43]/10">
              <input type="radio" name="attendance" value="Berhalangan Hadir" class="accent-[#4A5D43]" />
              <span class="text-xs font-medium text-[#2A3426]">Berhalangan</span>
            </label>
          </div>
        </div>

        <!-- Jumlah Tamu -->
        <div id="pax-container">
          <label for="rsvp-pax" class="block text-[0.62rem] tracking-[0.2em] uppercase font-semibold text-[#566A4E] mb-1.5">
            Jumlah Tamu
          </label>
          <select
            id="rsvp-pax"
            class="w-full px-4 py-2.5 rounded-xl border border-[#566A4E]/25 bg-[#FAF8F5] text-xs text-[#2A3426] focus:outline-none focus:border-[#4A5D43] focus:bg-white transition-all cursor-pointer"
          >
            <option value="1 Orang">1 Orang</option>
            <option value="2 Orang">2 Orang</option>
          </select>
        </div>

        <!-- Pesan Doa & Ucapan -->
        <div>
          <label for="rsvp-message" class="block text-[0.62rem] tracking-[0.2em] uppercase font-semibold text-[#566A4E] mb-1.5">
            Doa &amp; Ucapan Selamat
          </label>
          <textarea
            id="rsvp-message"
            rows="3"
            placeholder="Tuliskan doa restu untuk kedua mempelai..."
            class="w-full px-4 py-2.5 rounded-xl border border-[#566A4E]/25 bg-[#FAF8F5] text-xs text-[#2A3426] placeholder-[#7E8F77]/60 focus:outline-none focus:border-[#4A5D43] focus:bg-white transition-all resize-none"
          ></textarea>
        </div>

        <!-- Tombol Kirim WhatsApp -->
        <button
          type="submit"
          class="w-full mt-2 inline-flex items-center justify-center gap-2.5 px-6 py-3 rounded-full text-xs uppercase tracking-widest font-semibold bg-[#4A5D43] text-white hover:bg-[#384833] transition-all cursor-pointer shadow-sm active:scale-98"
        >
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
          </svg>
          <span>Kirim Konfirmasi via WhatsApp</span>
        </button>

      </form>

    </div>

    <!-- Live Wishes & Guestbook Stream with Interactive Reactions -->
    <div class="mt-10 text-left">
      <div class="flex items-center justify-between mb-4 px-1">
        <h4 class="text-xs uppercase tracking-[0.2em] font-semibold text-[#566A4E] flex items-center gap-2">
          <span>Ucapan Doa Restu</span>
          <span id="wishes-count-badge" class="px-2 py-0.5 rounded-full text-[0.6rem] bg-[#B89352]/15 text-[#B89352] font-mono">3</span>
        </h4>
        <span class="text-[0.62rem] text-[#7E8F77] italic">Terkirim langsung</span>
      </div>

      <div id="wishes-stream" class="flex flex-col gap-3 max-h-96 overflow-y-auto pr-1">
        <!-- Rendered via JS -->
      </div>
    </div>

  </div>
</section>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { playChimeSound } from './reactbits/SoundEffects';

  gsap.registerPlugin(ScrollTrigger);

  interface WishEntry {
    id: string;
    name: string;
    attendance: string;
    message: string;
    date: string;
    aamiinCount: number;
    loveCount: number;
    isUser?: boolean;
  }

  const defaultWishes: WishEntry[] = [
    {
      id: "w-1",
      name: "Dimas Pratama & Keluarga",
      attendance: "Hadir (2 Orang)",
      message: "Barakallahu lakuma wa baraka 'alaikuma wa jama'a bainakuma fii khoir. Selamat menempuh hidup baru Difa & Zharkasi! Semoga selalu rukun, bahagia, dan penuh berkah sampai kakek nenek.",
      date: "Kemarin",
      aamiinCount: 14,
      loveCount: 9
    },
    {
      id: "w-2",
      name: "Rania Amanda, S.Ds.",
      attendance: "Hadir (1 Orang)",
      message: "Selamat berbahagia Difa sahabatku tercinta & Zharkasi! MasyaAllah terharu sekali akhirnya kalian berlabuh di pelaminan. Semoga rumah tangganya senantiasa dilimpahi sakinah mawaddah warahmah.",
      date: "2 hari lalu",
      aamiinCount: 21,
      loveCount: 16
    },
    {
      id: "w-3",
      name: "Fikri Kurniawan",
      attendance: "Hadir (1 Orang)",
      message: "Selamat bro Zharkasi & Difa! Lancar lancar sampai hari H nanti. InsyaAllah hadir merayakan hari bahagia kalian berdua!",
      date: "3 hari lalu",
      aamiinCount: 8,
      loveCount: 5
    }
  ];

  function initWishesSection() {
    const form = document.getElementById('rsvp-form') as HTMLFormElement | null;
    const nameInput = document.getElementById('rsvp-name') as HTMLInputElement | null;
    const messageInput = document.getElementById('rsvp-message') as HTMLTextAreaElement | null;
    const paxSelect = document.getElementById('rsvp-pax') as HTMLSelectElement | null;
    const paxContainer = document.getElementById('pax-container');

    const ticketName = document.getElementById('ticket-guest-name');
    const ticketStatus = document.getElementById('ticket-guest-status');
    const ticketPax = document.getElementById('ticket-guest-pax');
    const streamContainer = document.getElementById('wishes-stream');
    const countBadge = document.getElementById('wishes-count-badge');
    const btnCopyTicket = document.getElementById('btn-copy-ticket');

    // Load persisted local wishes
    let savedWishes: WishEntry[] = [];
    try {
      const stored = localStorage.getItem('wedding_user_wishes');
      if (stored) {
        savedWishes = JSON.parse(stored);
      }
    } catch (e) {}

    function renderWishes() {
      if (!streamContainer) return;
      const allWishes = [...savedWishes, ...defaultWishes];
      if (countBadge) countBadge.textContent = allWishes.length.toString();

      streamContainer.innerHTML = allWishes.map((w) => `
        <div class="bg-white/80 border border-[#566A4E]/15 rounded-xl p-4 shadow-[0_2px_10px_rgba(42,52,38,0.03)] transition-all">
          <div class="flex items-center justify-between gap-2 mb-1.5">
            <div class="flex items-center gap-2">
              <span class="font-medium text-xs text-[#2A3426]">${escapeHtml(w.name)}</span>
              ${w.isUser ? '<span class="px-1.5 py-0.2 rounded text-[0.55rem] uppercase font-bold bg-[#B89352] text-white">Anda</span>' : ''}
            </div>
            <span class="text-[0.6rem] text-[#7E8F77]">${w.date}</span>
          </div>
          <div class="inline-block px-2 py-0.5 rounded text-[0.58rem] font-medium ${w.attendance.includes('Hadir') ? 'bg-[#4A5D43]/10 text-[#4A5D43]' : 'bg-[#7E8F77]/15 text-[#7E8F77]'} mb-2">
            ${escapeHtml(w.attendance)}
          </div>
          <p class="text-xs text-[#566A4E] leading-relaxed font-light mb-3">
            "${escapeHtml(w.message)}"
          </p>
          
          <!-- Interactive Reactions Strip -->
          <div class="flex items-center gap-2 pt-2 border-t border-[#566A4E]/10">
            <button 
              type="button" 
              class="btn-react inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[0.62rem] font-medium border border-[#566A4E]/20 bg-[#FAF8F5] hover:bg-white text-[#566A4E] transition-all cursor-pointer active:scale-95"
              data-id="${w.id}"
              data-type="aamiin"
            >
              <span>🤲 Aamiin</span>
              <span class="font-mono text-[#B89352]">${w.aamiinCount}</span>
            </button>

            <button 
              type="button" 
              class="btn-react inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[0.62rem] font-medium border border-[#566A4E]/20 bg-[#FAF8F5] hover:bg-white text-[#566A4E] transition-all cursor-pointer active:scale-95"
              data-id="${w.id}"
              data-type="love"
            >
              <span>❤️ Selamat</span>
              <span class="font-mono text-[#B89352]">${w.loveCount}</span>
            </button>
          </div>
        </div>
      `).join('');

      // Attach reaction click handlers
      streamContainer.querySelectorAll<HTMLButtonElement>('.btn-react').forEach((btn) => {
        btn.addEventListener('click', () => {
          playChimeSound();
          const countSpan = btn.querySelector('.font-mono');
          if (countSpan) {
            const current = parseInt(countSpan.textContent || '0', 10);
            countSpan.textContent = (current + 1).toString();
          }
          btn.classList.add('border-[#B89352]', 'bg-[#B89352]/10');
          if (typeof (window as any).triggerLuxuryConfetti === 'function') {
            const rect = btn.getBoundingClientRect();
            (window as any).triggerLuxuryConfetti(rect.left + rect.width / 2, rect.top);
          }
        }, { once: true });
      });
    }

    function escapeHtml(str: string): string {
      const div = document.createElement('div');
      div.textContent = str;
      return div.innerHTML;
    }

    // Dynamic Live Preview Binding
    function updateLiveTicket() {
      const nameVal = nameInput?.value.trim();
      if (ticketName) {
        ticketName.textContent = nameVal ? nameVal : 'Tamu Undangan';
      }

      const checkedAttendance = (document.querySelector('input[name="attendance"]:checked') as HTMLInputElement)?.value;
      const paxVal = paxSelect?.value || '1 Orang';

      if (ticketStatus) {
        if (checkedAttendance === 'Berhalangan Hadir') {
          ticketStatus.textContent = '✕ Berhalangan';
          ticketStatus.className = 'inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[0.62rem] font-semibold bg-[#7E8F77]/20 text-[#7E8F77] border border-[#7E8F77]/30';
        } else {
          ticketStatus.textContent = '✓ InsyaAllah Hadir';
          ticketStatus.className = 'inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[0.62rem] font-semibold bg-[#4A5D43]/15 text-[#4A5D43] border border-[#4A5D43]/20';
        }
      }

      if (ticketPax) {
        if (checkedAttendance === 'Berhalangan Hadir') {
          ticketPax.textContent = 'Doa dari Jauh';
        } else {
          ticketPax.textContent = paxVal === '2 Orang' ? '2 Tamu Terdaftar' : '1 Tamu Terdaftar';
        }
      }
    }

    // Pre-fill name from ?to= URL parameter if available
    const urlParams = new URLSearchParams(window.location.search);
    const rawTo = urlParams.get('to');
    if (rawTo && nameInput) {
      try {
        const decoded = decodeURIComponent(rawTo.replace(/\+/g, ' ')).replace(/<[^>]*>/g, '').trim().substring(0, 50);
        if (decoded) {
          nameInput.value = decoded;
        }
      } catch (e) {}
    }

    // Initialise live ticket state
    updateLiveTicket();
    renderWishes();

    nameInput?.addEventListener('input', updateLiveTicket);
    paxSelect?.addEventListener('change', updateLiveTicket);

    // Save ticket action
    if (btnCopyTicket) {
      btnCopyTicket.addEventListener('click', () => {
        playChimeSound();
        const currentName = ticketName?.textContent || 'Tamu Undangan';
        const ticketSummary = `VIP GUEST PASS #DZ-2026-VIP\nTamu: ${currentName}\nAcara: The Wedding of Difa & Zharkasi\nTanggal: Sabtu, 26 Desember 2026\nLokasi: Komp. PLN No. 8C, Koto Baru, Padang`;
        navigator.clipboard.writeText(ticketSummary).then(() => {
          if (typeof (window as any).showLuxuryToast === 'function') {
            (window as any).showLuxuryToast('Rincian Tiket VIP berhasil disalin!');
          }
          if (typeof (window as any).triggerLuxuryConfetti === 'function') {
            const rect = btnCopyTicket.getBoundingClientRect();
            (window as any).triggerLuxuryConfetti(rect.left + rect.width / 2, rect.top);
          }
        });
      });
    }

    // Toggle pax container if attendance is 'Berhalangan'
    const attendanceRadios = document.querySelectorAll<HTMLInputElement>('input[name="attendance"]');
    attendanceRadios.forEach((r) => {
      r.addEventListener('change', () => {
        if (paxContainer) {
          paxContainer.style.display = r.value === 'Berhalangan Hadir' ? 'none' : 'block';
        }
        updateLiveTicket();
      });
    });

    if (form) {
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        playChimeSound();

        const name = nameInput?.value.trim() || 'Tamu Undangan';
        const attendance = (document.querySelector('input[name="attendance"]:checked') as HTMLInputElement)?.value || 'Hadir';
        const pax = paxSelect?.value || '1 Orang';
        const customMessage = messageInput?.value.trim() || 'Semoga menjadi keluarga sakinah, mawaddah, warahmah. Aamiin yaa Rabbal \'aalamiin.';

        // Add to local wishes stream
        const newWish: WishEntry = {
          id: `w-${Date.now()}`,
          name,
          attendance: attendance === 'Hadir' ? `Hadir (${pax})` : 'Berhalangan Hadir',
          message: customMessage,
          date: 'Baru saja',
          aamiinCount: 1,
          loveCount: 1,
          isUser: true
        };

        savedWishes.unshift(newWish);
        try {
          localStorage.setItem('wedding_user_wishes', JSON.stringify(savedWishes));
        } catch (err) {}

        renderWishes();

        // Trigger confetti celebration & luxury toast
        if (typeof (window as any).triggerLuxuryConfetti === 'function') {
          const rect = form.getBoundingClientRect();
          (window as any).triggerLuxuryConfetti(rect.left + rect.width / 2, rect.top + 80);
        }

        if (typeof (window as any).showLuxuryToast === 'function') {
          (window as any).showLuxuryToast('Terima kasih! Doa & konfirmasi Anda telah tercatat.');
        }

        // WhatsApp redirection
        const defaultPhone = '6281234567890';
        let waText = `Assalamu'alaikum Warahmatullahi Wabarakatuh.\n\nHalo Difa & Zharkasi, saya *${name}* ingin mengonfirmasi:\n`;
        if (attendance === 'Hadir') {
          waText += `Status: *InsyaAllah Hadir (${pax})*\n\n`;
        } else {
          waText += `Status: *Mohon maaf, berhalangan hadir*\n\n`;
        }
        waText += `Ucapan & Doa:\n"${customMessage}"`;

        const encoded = encodeURIComponent(waText);
        setTimeout(() => {
          window.open(`https://wa.me/${defaultPhone}?text=${encoded}`, '_blank');
        }, 600);
      });
    }

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!prefersReducedMotion) {
      gsap.fromTo(
        '.wishes-content',
        { opacity: 0, y: 25 },
        {
          opacity: 1,
          y: 0,
          duration: 0.8,
          ease: 'power3.out',
          scrollTrigger: {
            trigger: '#wishes',
            start: 'top 80%',
            once: true
          }
        }
      );
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initWishesSection);
  } else {
    initWishesSection();
  }
</script>
