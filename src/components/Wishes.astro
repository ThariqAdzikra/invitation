---
// Wishes.astro — Interactive RSVP & Digital Wishes via WhatsApp
import FloralFlourish from './botanical/FloralFlourish.astro';
---

<section id="wishes" class="deck-section section-flow relative px-4 text-center overflow-hidden z-70 pt-20 pb-24" aria-label="Kirim Doa dan Ucapan">
  
  <div class="max-w-xl mx-auto w-full relative z-10 wishes-content">
    
    <p class="text-overline tracking-[0.28em]">
      KONFIRMASI &amp; DOA
    </p>
    
    <h2 class="font-display text-3xl sm:text-4xl text-[#2A3426] font-normal mt-1 mb-2">
      Doa Restu &amp; Kehadiran
    </h2>

    <div class="flex justify-center my-2 opacity-70">
      <FloralFlourish width={160} height={24} />
    </div>

    <p class="text-xs sm:text-sm text-[#566A4E] font-light leading-relaxed max-w-md mx-auto mb-8">
      Merupakan suatu kehormatan bagi kami apabila Bapak/Ibu/Saudara/i berkenan mengonfirmasi kehadiran serta memberikan doa restu.
    </p>

    <!-- RSVP & Wishes Form Card -->
    <div class="bg-white/95 border border-[#566A4E]/20 rounded-2xl p-6 sm:p-9 relative overflow-hidden shadow-[0_12px_35px_rgba(42,52,38,0.05)] text-left">
      <div class="absolute top-0 left-0 right-0 h-[2px] bg-gradient-to-r from-transparent via-[#B89352] to-transparent"></div>
      
      <form id="rsvp-form" class="flex flex-col gap-4">
        
        <!-- Input Nama -->
        <div>
          <label for="rsvp-name" class="block text-[0.62rem] tracking-[0.2em] uppercase font-semibold text-[#566A4E] mb-1.5">
            Nama Lengkap
          </label>
          <input
            type="text"
            id="rsvp-name"
            required
            placeholder="Tuliskan nama Anda"
            class="w-full px-4 py-2.5 rounded-xl border border-[#566A4E]/25 bg-[#FAF8F5] text-xs text-[#2A3426] placeholder-[#7E8F77]/60 focus:outline-none focus:border-[#4A5D43] focus:bg-white transition-all"
          />
        </div>

        <!-- Pilihan Kehadiran -->
        <div>
          <label class="block text-[0.62rem] tracking-[0.2em] uppercase font-semibold text-[#566A4E] mb-1.5">
            Konfirmasi Kehadiran
          </label>
          <div class="grid grid-cols-2 gap-2.5">
            <label class="relative flex items-center justify-center gap-2 p-2.5 rounded-xl border border-[#566A4E]/20 bg-[#FAF8F5] cursor-pointer hover:border-[#4A5D43] transition-all has-[:checked]:border-[#4A5D43] has-[:checked]:bg-[#4A5D43]/10">
              <input type="radio" name="attendance" value="Hadir" checked class="accent-[#4A5D43]" />
              <span class="text-xs font-medium text-[#2A3426]">InsyaAllah Hadir</span>
            </label>
            <label class="relative flex items-center justify-center gap-2 p-2.5 rounded-xl border border-[#566A4E]/20 bg-[#FAF8F5] cursor-pointer hover:border-[#4A5D43] transition-all has-[:checked]:border-[#4A5D43] has-[:checked]:bg-[#4A5D43]/10">
              <input type="radio" name="attendance" value="Berhalangan Hadir" class="accent-[#4A5D43]" />
              <span class="text-xs font-medium text-[#2A3426]">Berhalangan</span>
            </label>
          </div>
        </div>

        <!-- Jumlah Tamu -->
        <div id="pax-container">
          <label for="rsvp-pax" class="block text-[0.62rem] tracking-[0.2em] uppercase font-semibold text-[#566A4E] mb-1.5">
            Jumlah Tamu
          </label>
          <select
            id="rsvp-pax"
            class="w-full px-4 py-2.5 rounded-xl border border-[#566A4E]/25 bg-[#FAF8F5] text-xs text-[#2A3426] focus:outline-none focus:border-[#4A5D43] focus:bg-white transition-all cursor-pointer"
          >
            <option value="1 Orang">1 Orang</option>
            <option value="2 Orang">2 Orang</option>
          </select>
        </div>

        <!-- Pesan Doa & Ucapan -->
        <div>
          <label for="rsvp-message" class="block text-[0.62rem] tracking-[0.2em] uppercase font-semibold text-[#566A4E] mb-1.5">
            Doa &amp; Ucapan Selamat
          </label>
          <textarea
            id="rsvp-message"
            rows="3"
            placeholder="Tuliskan doa restu untuk kedua mempelai..."
            class="w-full px-4 py-2.5 rounded-xl border border-[#566A4E]/25 bg-[#FAF8F5] text-xs text-[#2A3426] placeholder-[#7E8F77]/60 focus:outline-none focus:border-[#4A5D43] focus:bg-white transition-all resize-none"
          ></textarea>
        </div>

        <!-- Tombol Kirim WhatsApp -->
        <button
          type="submit"
          class="w-full mt-2 inline-flex items-center justify-center gap-2.5 px-6 py-3 rounded-full text-xs uppercase tracking-widest font-semibold bg-[#4A5D43] text-white hover:bg-[#384833] transition-all cursor-pointer shadow-sm active:scale-98"
        >
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
          </svg>
          <span>Kirim Konfirmasi via WhatsApp</span>
        </button>

      </form>

    </div>

  </div>
</section>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { playChimeSound } from './reactbits/SoundEffects';

  gsap.registerPlugin(ScrollTrigger);

  function initWishesForm() {
    const form = document.getElementById('rsvp-form') as HTMLFormElement | null;
    const nameInput = document.getElementById('rsvp-name') as HTMLInputElement | null;
    const messageInput = document.getElementById('rsvp-message') as HTMLTextAreaElement | null;
    const paxSelect = document.getElementById('rsvp-pax') as HTMLSelectElement | null;
    const paxContainer = document.getElementById('pax-container');

    // Pre-fill name from ?to= URL parameter if available
    const urlParams = new URLSearchParams(window.location.search);
    const rawTo = urlParams.get('to');
    if (rawTo && nameInput) {
      try {
        const decoded = decodeURIComponent(rawTo.replace(/\+/g, ' ')).replace(/<[^>]*>/g, '').trim().substring(0, 50);
        if (decoded) nameInput.value = decoded;
      } catch (e) {}
    }

    // Toggle pax container if attendance is 'Berhalangan'
    const attendanceRadios = document.querySelectorAll<HTMLInputElement>('input[name="attendance"]');
    attendanceRadios.forEach((r) => {
      r.addEventListener('change', () => {
        if (paxContainer) {
          paxContainer.style.display = r.value === 'Berhalangan Hadir' ? 'none' : 'block';
        }
      });
    });

    if (form) {
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        playChimeSound();

        const name = nameInput?.value.trim() || 'Tamu Undangan';
        const attendance = (document.querySelector('input[name="attendance"]:checked') as HTMLInputElement)?.value || 'Hadir';
        const pax = paxSelect?.value || '1 Orang';
        const customMessage = messageInput?.value.trim() || 'Semoga menjadi keluarga sakinah, mawaddah, warahmah. Aamiin yaa Rabbal \'aalamiin.';

        const defaultPhone = '6281234567890';
        let waText = `Assalamu'alaikum Warahmatullahi Wabarakatuh.\n\nHalo Arya & Dian, saya *${name}* ingin mengonfirmasi:\n`;
        if (attendance === 'Hadir') {
          waText += `Status: *InsyaAllah Hadir (${pax})*\n\n`;
        } else {
          waText += `Status: *Mohon maaf, berhalangan hadir*\n\n`;
        }
        waText += `Ucapan & Doa:\n"${customMessage}"`;

        const encoded = encodeURIComponent(waText);
        window.open(`https://wa.me/${defaultPhone}?text=${encoded}`, '_blank');
      });
    }

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!prefersReducedMotion) {
      gsap.fromTo(
        '.wishes-content',
        { opacity: 0, y: 25 },
        {
          opacity: 1,
          y: 0,
          duration: 0.8,
          ease: 'power3.out',
          scrollTrigger: {
            trigger: '#wishes',
            start: 'top 80%',
            once: true
          }
        }
      );
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initWishesForm);
  } else {
    initWishesForm();
  }
</script>
