---
// Wishes.astro — Botanical Digital Wishes via WhatsApp (Cream & Olive Green)
import FloralDivider from './botanical/FloralDivider.astro';
---

<section id="wishes" class="deck-section tone-wishes section-flow relative px-4 text-center overflow-hidden z-70" aria-label="Kirim Doa dan Ucapan">
  <div class="max-w-xl mx-auto w-full relative z-10 wishes-content">
    
    <div class="mb-5">
      <FloralDivider width={220} height={30} />
    </div>

    <div class="editorial-badge mb-2">
      <span>THE BENEDICTION</span>
    </div>

    <p class="text-overline tracking-[0.25em]">
      DOA &amp; RESTU
    </p>
    
    <h2 class="font-display text-2xl sm:text-3xl md:text-4xl text-[#2A3426] font-normal mt-1 mb-3">
      Kirimkan Doa &amp; Ucapan
    </h2>

    <p class="text-xs sm:text-sm text-[#566A4E] font-light leading-relaxed max-w-md mx-auto mb-8">
      Doa restu dari Bapak/Ibu/Saudara/i sekalian merupakan anugerah terindah dan kebahagiaan terbesar bagi awal perjalanan ibadah kami.
    </p>

    <!-- Botanical Linen Wishes Card -->
    <div class="bg-white border border-[#566A4E]/25 rounded-xl p-6 sm:p-8 relative overflow-hidden shadow-[0_12px_36px_rgba(42,52,38,0.07)] hover:border-[#566A4E] transition-colors duration-300">
      
      <div class="flex flex-col items-center gap-4 relative z-10">
        
        <!-- WhatsApp Minimalist Badge (Olive) -->
        <div class="w-12 h-12 rounded-full border border-[#566A4E]/30 bg-[#FAF8F3] flex items-center justify-center text-[#566A4E]">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
          </svg>
        </div>

        <div>
          <h3 class="font-display text-lg sm:text-xl text-[#2A3426] font-normal mb-1">
            Sampaikan Doa Terbaik Anda
          </h3>
          <p class="text-xs text-[#566A4E] font-light max-w-sm">
            Klik tombol di bawah untuk mengirim pesan ucapan selamat via WhatsApp.
          </p>
        </div>

        <!-- Interactive Button -->
        <a
          id="btn-send-wishes-wa"
          href="#"
          target="_blank"
          rel="noopener noreferrer"
          class="btn-gold-solid mt-2 inline-flex items-center gap-2.5"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
          </svg>
          <span>Kirim Ucapan via WhatsApp</span>
        </a>

      </div>

    </div>

    <div class="mt-8">
      <FloralDivider width={220} height={30} />
    </div>

  </div>
</section>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { playChimeSound } from './reactbits/SoundEffects';

  gsap.registerPlugin(ScrollTrigger);

  function initWishes() {
    const btnWa = document.getElementById('btn-send-wishes-wa');
    if (!btnWa) return;

    // Get guest name from URL if available
    const urlParams = new URLSearchParams(window.location.search);
    const rawTo = urlParams.get('to');
    let sender = 'Tamu Undangan';

    if (rawTo) {
      try {
        const decoded = decodeURIComponent(rawTo.replace(/\+/g, ' ')).replace(/<[^>]*>/g, '').trim();
        if (decoded) sender = decoded;
      } catch (e) {}
    }

    const message = encodeURIComponent(
      `Halo Arya & Dian! Selamat atas pernikahan kalian. Semoga menjadi keluarga yang sakinah, mawaddah, dan warahmah, serta selalu dalam lindungan Allah SWT. Aamiin.\n\n— Dari: ${sender}`
    );

    // Number to bride/groom WhatsApp
    btnWa.setAttribute('href', `https://wa.me/6281269000000?text=${message}`);

    btnWa.addEventListener('click', () => {
      playChimeSound();
    });

    // Scroll reveal
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!prefersReducedMotion) {
      gsap.fromTo(
        '.wishes-content',
        { opacity: 0, y: 30 },
        {
          opacity: 1,
          y: 0,
          duration: 0.9,
          ease: 'power3.out',
          scrollTrigger: {
            trigger: '#wishes',
            start: 'top 80%',
            once: true
          }
        }
      );
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initWishes);
  } else {
    initWishes();
  }
</script>
