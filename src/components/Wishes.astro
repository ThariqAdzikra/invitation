---
// Wishes.astro — Botanical Digital Wishes via WhatsApp (Warm Cream & Olive Green)
// Audited for Zero Collisions: Safe corner clearances, generous button tap target
import FloralDivider from './botanical/FloralDivider.astro';
import FloralCorner from './botanical/FloralCorner.astro';
import FloralBouquet from './botanical/FloralBouquet.astro';
import FloralFlourish from './botanical/FloralFlourish.astro';
import TwinkleSparkles from './botanical/TwinkleSparkles.astro';
import SceneTitleCard from './cinematic/SceneTitleCard.astro';
---

<section id="wishes" class="deck-section tone-wishes section-flow relative px-4 text-center overflow-hidden z-70 pt-16 pb-20" aria-label="Kirim Doa dan Ucapan">
  
  <TwinkleSparkles />

  <div class="max-w-xl mx-auto w-full relative z-10 wishes-content">
    
    <div class="mb-2 scale-90">
      <FloralBouquet width={240} height={60} />
    </div>

    <!-- Cinematic Scene Indicator Badge -->
    <div class="mb-3">
      <SceneTitleCard act="ACT VII" title="THE BENEDICTION" scene="SCENE 07" />
    </div>

    <p class="text-overline tracking-[0.25em]">
      DOA &amp; RESTU
    </p>
    
    <h2 class="font-display text-2xl sm:text-3xl md:text-4xl text-[#2A3426] font-normal mt-1 mb-2">
      Kirimkan Doa &amp; Ucapan
    </h2>

    <div class="flex justify-center my-1.5">
      <FloralFlourish width={170} height={28} />
    </div>

    <p class="text-xs sm:text-sm text-[#566A4E] font-light leading-relaxed max-w-md mx-auto mb-6">
      Doa restu dari Bapak/Ibu/Saudara/i sekalian merupakan anugerah terindah dan kebahagiaan terbesar bagi awal perjalanan ibadah kami.
    </p>

    <!-- Botanical Linen Wishes Card with 4 Corner Flourishes & Inset Frame -->
    <div class="bg-white/95 border border-[#566A4E]/25 rounded-2xl p-6 sm:p-9 relative overflow-hidden shadow-[0_14px_40px_rgba(42,52,38,0.08)] hover:border-[#566A4E] transition-colors duration-300">
      
      <!-- Inset Gold Hairline Frame -->
      <div class="absolute inset-2.5 sm:inset-3 border border-[#B89352]/30 rounded-xl pointer-events-none"></div>

      <!-- 4 Floral Corners (Scaled to 45px for safe clearances) -->
      <div class="absolute top-2 left-2 pointer-events-none opacity-45">
        <FloralCorner position="top-left" size={45} />
      </div>
      <div class="absolute top-2 right-2 pointer-events-none opacity-45">
        <FloralCorner position="top-right" size={45} />
      </div>
      <div class="absolute bottom-2 left-2 pointer-events-none opacity-45">
        <FloralCorner position="bottom-left" size={45} />
      </div>
      <div class="absolute bottom-2 right-2 pointer-events-none opacity-45">
        <FloralCorner position="bottom-right" size={45} />
      </div>
      
      <div class="flex flex-col items-center gap-4 relative z-10 py-1">
        
        <!-- WhatsApp Minimalist Badge (Olive) -->
        <div class="w-12 h-12 rounded-full border border-[#566A4E]/30 bg-[#FAF8F3] flex items-center justify-center text-[#566A4E] shadow-sm">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
          </svg>
        </div>

        <div>
          <h3 class="font-display text-lg sm:text-xl text-[#2A3426] font-normal mb-1">
            Sampaikan Doa Terbaik Anda
          </h3>
          <p class="text-xs text-[#566A4E] font-light max-w-sm">
            Klik tombol di bawah untuk mengirim pesan ucapan selamat via WhatsApp.
          </p>
        </div>

        <!-- Interactive Button -->
        <a
          id="btn-send-wishes-wa"
          href="#"
          target="_blank"
          rel="noopener noreferrer"
          class="btn-gold-solid mt-2 inline-flex items-center gap-2.5 shadow-sm"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
          </svg>
          <span>Kirim Ucapan via WhatsApp</span>
        </a>

      </div>

    </div>

    <div class="mt-8">
      <FloralDivider width={240} height={32} />
    </div>

  </div>
</section>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { playChimeSound } from './reactbits/SoundEffects';

  gsap.registerPlugin(ScrollTrigger);

  function initWishes() {
    const btnWa = document.getElementById('btn-send-wishes-wa');
    if (!btnWa) return;

    // Get guest name from URL if available
    const urlParams = new URLSearchParams(window.location.search);
    const rawTo = urlParams.get('to');
    let sender = 'Tamu Undangan';

    if (rawTo) {
      try {
        const decoded = decodeURIComponent(rawTo.replace(/\+/g, ' ')).replace(/<[^>]*>/g, '').trim().substring(0, 50);
        if (decoded) sender = decoded;
      } catch (e) {}
    }

    const defaultPhone = '6281234567890';
    const message = encodeURIComponent(
      `Halo Arya & Dian! Saya ${sender}, mengucapkan selamat atas pernikahannya. Semoga menjadi keluarga sakinah, mawaddah, warahmah. Aamiin.`
    );

    btnWa.setAttribute('href', `https://wa.me/${defaultPhone}?text=${message}`);

    btnWa.addEventListener('click', () => {
      playChimeSound();
    });

    // Reveal Animation
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!prefersReducedMotion) {
      gsap.fromTo(
        '.wishes-content',
        { opacity: 0, y: 30 },
        {
          opacity: 1,
          y: 0,
          duration: 0.9,
          ease: 'power3.out',
          scrollTrigger: {
            trigger: '#wishes',
            start: 'top 80%',
            once: true
          }
        }
      );
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initWishes);
  } else {
    initWishes();
  }
</script>