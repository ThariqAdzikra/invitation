---
interface Props {
  className?: string;
}

const { className = "" } = Astro.props;
---

<div class={`flex items-center justify-center my-6 gap-2 text-gold/80 ${className}`} aria-hidden="true">
  <div class="w-12 sm:w-24 h-[1px] bg-gradient-to-r from-transparent via-gold/60 to-gold"></div>
  
  <!-- Central 8-Point Starlight Motif -->
  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" class="stroke-current stroke-[1.2] drop-shadow-[0_0_8px_rgba(226,201,138,0.5)]">
    <path d="M12 2L14 9L21 12L14 15L12 22L10 15L3 12L10 9L12 2Z"/>
    <circle cx="12" cy="12" r="1.8" fill="var(--color-accent-gold-bright)"/>
  </svg>
  
  <div class="w-12 sm:w-24 h-[1px] bg-gradient-to-l from-transparent via-gold/60 to-gold"></div>
</div>
