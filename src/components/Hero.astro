---
// Hero.astro — Editorial Wedding Hero with Roman Arch Prewedding Portrait
import content from '../data/content.json';
import FloralWreath from './botanical/FloralWreath.astro';
import FloralFlourish from './botanical/FloralFlourish.astro';
---

<section id="hero" class="deck-section section-hero relative px-4 text-center overflow-hidden z-10 pt-16 pb-24" aria-label="Informasi Utama Pernikahan">
  
  <div class="relative z-10 max-w-2xl w-full mx-auto flex flex-col items-center">
    
    <!-- Royal Monogram Crest -->
    <div class="hero-crest mb-3 transform hover:scale-105 transition-transform duration-500 opacity-0">
      <FloralWreath monogram="AD" size={80} />
    </div>

    <!-- Sacred Tagline -->
    <p class="hero-tagline text-[0.62rem] sm:text-xs tracking-[0.32em] text-[#B89352] uppercase font-semibold mb-2 opacity-0">
      WALIMATUL 'URS
    </p>

    <!-- Couple Headline -->
    <div class="overflow-hidden my-1">
      <h1 id="hero-headline" class="font-display text-4xl sm:text-6xl md:text-7xl text-[#2A3426] font-normal tracking-tight leading-tight translate-y-[110%] opacity-0 transition-transform duration-1000 ease-[cubic-bezier(0.16,1,0.3,1)]">
        {content.couple.groom.nickname} <span class="font-display italic text-[#B89352] font-normal px-2">&amp;</span> {content.couple.bride.nickname}
      </h1>
    </div>

    <!-- Symmetrical Calligraphic Swash -->
    <div class="mb-6 mt-1 opacity-80">
      <FloralFlourish width={160} height={24} />
    </div>

    <!-- EDITORIAL PREWEDDING PORTRAIT (Roman Arch Frame with Gentle Ken Burns Zoom) -->
    <div id="hero-silhouette-container" class="my-3 relative opacity-0 transform transition-transform duration-700">
      <div class="relative w-[260px] sm:w-[300px] md:w-[320px] rounded-t-[130px] sm:rounded-t-[150px] md:rounded-t-[160px] rounded-b-2xl p-1.5 sm:p-2 bg-gradient-to-b from-[#B89352]/40 via-[#EDE8DC] to-[#566A4E]/30 shadow-[0_20px_50px_rgba(42,52,38,0.14)]">
        <div class="w-full aspect-[3/4] rounded-t-[125px] sm:rounded-t-[145px] md:rounded-t-[155px] rounded-b-xl overflow-hidden relative border border-[#FAF8F5]/90 bg-[#EDE8DC]">
          <img 
            id="hero-silhouette-inner"
            src="/assets/prewedding-hero.jpg" 
            alt="Foto Prewedding Arya & Dian" 
            class="w-full h-full object-cover object-center will-change-transform scale-100 transition-transform duration-700" 
            loading="eager"
            width="640"
            height="853"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-[#263322]/35 via-transparent to-transparent pointer-events-none"></div>
          <div class="absolute inset-1.5 rounded-t-[120px] sm:rounded-t-[140px] md:rounded-t-[150px] rounded-b-lg border border-white/35 pointer-events-none"></div>
        </div>
      </div>
      <div class="w-44 h-3 bg-[#263322]/10 rounded-full blur-md mx-auto mt-2 pointer-events-none"></div>
    </div>

    <!-- Date & Venue -->
    <div class="hero-meta mt-4 flex flex-col items-center gap-1 opacity-0">
      <p class="text-xs sm:text-sm text-[#4A5D43] tracking-[0.25em] uppercase font-semibold">
        {content.event.dateFormatted} &bull; {content.event.timezone}
      </p>
      <p class="text-xs text-[#7E8F77] font-light tracking-wider">
        {content.event.venue.name} &bull; Banda Aceh
      </p>
    </div>

    <!-- Personalized Guest Welcoming Card -->
    <div class="hero-guest mt-8 py-4 px-6 sm:px-8 rounded-xl border border-[#566A4E]/20 bg-white/95 max-w-sm w-full mx-auto opacity-0 shadow-[0_10px_30px_rgba(42,52,38,0.06)] relative overflow-hidden text-center">
      <div class="absolute top-0 left-0 right-0 h-[2px] bg-gradient-to-r from-transparent via-[#B89352] to-transparent"></div>
      
      <p class="text-[0.58rem] sm:text-[0.62rem] text-[#566A4E] font-medium tracking-[0.22em] uppercase mb-1">
        Kepada Yth. Bapak/Ibu/Saudara/i:
      </p>
      <h2 id="guest-name-hero" class="font-display text-lg sm:text-xl text-[#2A3426] font-normal leading-snug">
        Tamu Undangan Terhormat
      </h2>
    </div>

    <!-- Minimal Scroll Indicator -->
    <div class="hero-scroll mt-12 flex flex-col items-center gap-2 opacity-0">
      <span class="text-[0.6rem] tracking-[0.3em] uppercase text-[#566A4E] font-medium">GULIR KE BAWAH</span>
      <div class="w-[1px] h-6 bg-gradient-to-b from-[#566A4E] to-transparent"></div>
    </div>

  </div>
</section>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  function initHero() {
    const guestNameEl = document.getElementById('guest-name-hero');
    const headline = document.getElementById('hero-headline');
    const crest = document.querySelector('.hero-crest');
    const tagline = document.querySelector('.hero-tagline');
    const silhouette = document.getElementById('hero-silhouette-container');
    const silhouetteInner = document.getElementById('hero-silhouette-inner');
    const meta = document.querySelector('.hero-meta');
    const guest = document.querySelector('.hero-guest');
    const scrollCue = document.querySelector('.hero-scroll');

    // Parse & sanitize ?to= parameter
    const urlParams = new URLSearchParams(window.location.search);
    const rawTo = urlParams.get('to');
    if (rawTo && guestNameEl) {
      try {
        const decoded = decodeURIComponent(rawTo.replace(/\+/g, ' ')).replace(/<[^>]*>/g, '').trim().substring(0, 50);
        if (decoded) guestNameEl.textContent = decoded;
      } catch (e) {}
    }

    // Play reveal animation on invitationOpened event
    function revealHero() {
      const tl = gsap.timeline({ defaults: { ease: 'power3.out' } });

      tl.to(crest, { opacity: 1, scale: 1, duration: 0.9 })
        .to(tagline, { opacity: 1, y: 0, duration: 0.6 }, '-=0.5')
        .to(headline, { opacity: 1, y: 0, duration: 1.0, ease: 'power4.out' }, '-=0.3')
        .to(silhouette, { opacity: 1, scale: 1, duration: 1.1, ease: 'power3.out' }, '-=0.5')
        .to(meta, { opacity: 1, y: 0, duration: 0.8 }, '-=0.4')
        .to(guest, { opacity: 1, y: 0, duration: 0.8 }, '-=0.3')
        .to(scrollCue, { opacity: 1, y: 0, duration: 0.8 }, '-=0.2');

      // Subtle Ken Burns Scroll Parallax Zoom
      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!prefersReducedMotion && silhouetteInner) {
        gsap.to(silhouetteInner, {
          scale: 1.12,
          y: -12,
          ease: 'none',
          scrollTrigger: {
            trigger: '#hero',
            start: 'top top',
            end: 'bottom top',
            scrub: 1.2
          }
        });
      }
    }

    window.addEventListener('invitationOpened', revealHero, { once: true });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHero);
  } else {
    initHero();
  }
</script>
