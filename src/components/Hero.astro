---
// Hero.astro — Cinematic Hero Section with Authentic Editorial Prewedding Portrait & Ken Burns Parallax Zoom
// Audited for Zero Collisions: Clean vertical cadence, balanced negative space, responsive corner scaling
import content from '../data/content.json';
import FloralWreath from './botanical/FloralWreath.astro';
import FloralDivider from './botanical/FloralDivider.astro';
import FloralCorner from './botanical/FloralCorner.astro';
import FloralFlourish from './botanical/FloralFlourish.astro';
import TwinkleSparkles from './botanical/TwinkleSparkles.astro';
import SceneTitleCard from './cinematic/SceneTitleCard.astro';
---

<section id="hero" class="deck-section tone-hero section-hero relative px-4 text-center overflow-hidden z-10 pt-12 pb-20" aria-label="Informasi Utama Pernikahan">
  
  <!-- Twinkling Gold Sparkles Background -->
  <TwinkleSparkles />

  <!-- Botanical Corner Floral Ornaments in 4 Corners (Responsive sizes to avoid colliding with text) -->
  <div class="absolute top-2 left-2 sm:top-6 sm:left-6 pointer-events-none opacity-60">
    <FloralCorner position="top-left" size={80} />
  </div>
  <div class="absolute top-2 right-2 sm:top-6 sm:right-6 pointer-events-none opacity-60">
    <FloralCorner position="top-right" size={80} />
  </div>
  <div class="absolute bottom-2 left-2 sm:bottom-6 sm:left-6 pointer-events-none opacity-60">
    <FloralCorner position="bottom-left" size={75} />
  </div>
  <div class="absolute bottom-2 right-2 sm:bottom-6 sm:right-6 pointer-events-none opacity-60">
    <FloralCorner position="bottom-right" size={75} />
  </div>

  <!-- Subtle Parallax Watermark Monogram (Safely behind content) -->
  <div class="watermark-monogram ornament-parallax pointer-events-none select-none text-[#566A4E] opacity-20" aria-hidden="true">&amp;</div>

  <div class="relative z-10 max-w-3xl w-full mx-auto flex flex-col items-center">
    
    <!-- Cinematic Scene Indicator Badge -->
    <div class="hero-badge mb-4 opacity-0">
      <SceneTitleCard act="ACT I" title="THE UNION" scene="SCENE 01" />
    </div>

    <!-- Royal Botanical Olive & Floral Crest -->
    <div class="hero-crest mb-2 transform hover:scale-105 transition-transform duration-500 opacity-0">
      <FloralWreath monogram="AD" size={88} />
    </div>

    <!-- Grand Movie Title Headline with Staggered Reveal -->
    <div class="overflow-hidden my-2 sm:my-3">
      <h1 id="hero-headline" class="font-display text-4xl sm:text-6xl md:text-7xl lg:text-8xl text-[#2A3426] font-normal tracking-tight leading-tight translate-y-[110%] opacity-0 transition-transform duration-1000 ease-[cubic-bezier(0.16,1,0.3,1)]">
        {content.couple.groom.nickname} <span class="font-display italic text-[#B89352] font-normal px-1 sm:px-3">&amp;</span> {content.couple.bride.nickname}
      </h1>
    </div>

    <!-- Symmetrical Calligraphic Flourish Swash -->
    <div class="mb-5 mt-1">
      <FloralFlourish width={200} height={32} />
    </div>

    <!-- CINEMATIC EDITORIAL PREWEDDING PORTRAIT (Roman Arch Frame with Ken Burns Parallax Zoom) -->
    <div id="hero-silhouette-container" class="my-4 relative opacity-0 transform transition-transform duration-700">
      <div class="relative w-[260px] sm:w-[310px] md:w-[330px] rounded-t-[130px] sm:rounded-t-[155px] md:rounded-t-[165px] rounded-b-2xl p-1.5 sm:p-2 bg-gradient-to-b from-[#B89352]/50 via-[#EDE8DC] to-[#566A4E]/40 shadow-[0_20px_50px_rgba(42,52,38,0.18)]">
        <div class="w-full aspect-[3/4] rounded-t-[125px] sm:rounded-t-[150px] md:rounded-t-[160px] rounded-b-xl overflow-hidden relative border border-[#FAF8F5]/90 bg-[#EDE8DC]">
          <img 
            id="hero-silhouette-inner"
            src="/assets/prewedding-hero.jpg" 
            alt="Foto Prewedding Arya & Dian" 
            class="w-full h-full object-cover object-center will-change-transform scale-100 transition-transform duration-700" 
            loading="eager"
            width="640"
            height="853"
          />
          <!-- Warm editorial cinema gradient overlay -->
          <div class="absolute inset-0 bg-gradient-to-t from-[#263322]/40 via-transparent to-[#FAF8F5]/10 pointer-events-none"></div>
          <!-- Inset hairline border -->
          <div class="absolute inset-1.5 rounded-t-[120px] sm:rounded-t-[145px] md:rounded-t-[155px] rounded-b-lg border border-white/40 pointer-events-none"></div>
        </div>
      </div>
      <!-- Soft Ground Shadow -->
      <div class="w-48 h-3.5 bg-[#263322]/15 rounded-full blur-md mx-auto mt-2 pointer-events-none"></div>
    </div>

    <!-- Botanical Olive & Floral Divider -->
    <div class="hero-divider my-4 scale-x-0 opacity-0 transition-all duration-700 ease-out">
      <FloralDivider width={240} height={30} />
    </div>

    <!-- Tanggal & Venue -->
    <div class="hero-meta mt-1 flex flex-col items-center gap-1.5 opacity-0">
      <p class="text-xs sm:text-sm text-[#566A4E] tracking-[0.25em] uppercase font-semibold">
        {content.event.dateFormatted} &bull; {content.event.timezone}
      </p>
      <p class="text-xs sm:text-sm text-[#7E8F77] font-light tracking-wider">
        {content.event.venue.name} &bull; Banda Aceh
      </p>
    </div>

    <!-- Personalized Guest Welcoming Card (Botanical Linen) with Corner Ornaments -->
    <div class="hero-guest mt-8 py-4 sm:py-5 px-6 sm:px-8 rounded-xl border border-[#566A4E]/25 bg-white/95 max-w-sm w-full mx-auto opacity-0 shadow-[0_12px_36px_rgba(42,52,38,0.08)] relative overflow-hidden">
      <!-- Top Gold Line -->
      <div class="absolute top-0 left-0 right-0 h-[2px] bg-gradient-to-r from-transparent via-[#B89352] to-transparent"></div>
      
      <!-- Mini Floral Corners on Guest Card -->
      <div class="absolute top-1 left-1 pointer-events-none opacity-40">
        <FloralCorner position="top-left" size={32} />
      </div>
      <div class="absolute bottom-1 right-1 pointer-events-none opacity-40">
        <FloralCorner position="bottom-right" size={32} />
      </div>

      <p class="text-[0.62rem] sm:text-[0.68rem] text-[#566A4E] font-medium tracking-[0.22em] uppercase mb-1">
        Kepada Yth. Bapak/Ibu/Saudara/i:
      </p>
      <h2 id="guest-name-hero" class="font-display text-lg sm:text-xl text-[#2A3426] font-normal leading-snug">
        Tamu Undangan Terhormat
      </h2>
    </div>

    <!-- Botanical Scroll Cue -->
    <div class="hero-scroll mt-10 sm:mt-12 flex flex-col items-center gap-2 opacity-0">
      <span class="text-[0.62rem] tracking-[0.3em] uppercase text-[#566A4E] font-medium">GULIR KE BAWAH</span>
      <div class="w-[1.5px] h-7 bg-gradient-to-b from-[#566A4E] to-transparent animate-pulse"></div>
    </div>

  </div>
</section>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  function initHero() {
    const guestNameEl = document.getElementById('guest-name-hero');
    const headline = document.getElementById('hero-headline');
    const crest = document.querySelector('.hero-crest');
    const badge = document.querySelector('.hero-badge');
    const silhouette = document.getElementById('hero-silhouette-container');
    const silhouetteInner = document.getElementById('hero-silhouette-inner');
    const divider = document.querySelector('.hero-divider');
    const meta = document.querySelector('.hero-meta');
    const guest = document.querySelector('.hero-guest');
    const scrollCue = document.querySelector('.hero-scroll');

    // Parse & sanitize ?to= parameter
    const urlParams = new URLSearchParams(window.location.search);
    const rawTo = urlParams.get('to');
    if (rawTo && guestNameEl) {
      try {
        const decoded = decodeURIComponent(rawTo.replace(/\+/g, ' ')).replace(/<[^>]*>/g, '').trim().substring(0, 50);
        if (decoded) guestNameEl.textContent = decoded;
      } catch (e) {}
    }

    // Play reveal animation on invitationOpened event
    function revealHero() {
      const tl = gsap.timeline({ defaults: { ease: 'power3.out' } });

      tl.to(crest, { opacity: 1, scale: 1, duration: 1 })
        .to(badge, { opacity: 1, y: 0, duration: 0.6 }, '-=0.5')
        .to(headline, { opacity: 1, y: 0, duration: 1.1, ease: 'power4.out' }, '-=0.3')
        .to(silhouette, { opacity: 1, scale: 1, duration: 1.2, ease: 'power3.out' }, '-=0.6')
        .to(divider, { opacity: 1, scaleX: 1, duration: 0.8 }, '-=0.5')
        .to(meta, { opacity: 1, y: 0, duration: 0.8 }, '-=0.4')
        .to(guest, { opacity: 1, y: 0, duration: 0.9 }, '-=0.3')
        .to(scrollCue, { opacity: 1, y: 0, duration: 0.8 }, '-=0.2');

      // Ken Burns Scroll Parallax Slow Zoom on Silhouette
      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!prefersReducedMotion && silhouetteInner) {
        gsap.to(silhouetteInner, {
          scale: 1.16,
          y: -20,
          ease: 'none',
          scrollTrigger: {
            trigger: '#hero',
            start: 'top top',
            end: 'bottom top',
            scrub: 1.2
          }
        });
      }
    }

    window.addEventListener('invitationOpened', revealHero, { once: true });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHero);
  } else {
    initHero();
  }
</script>