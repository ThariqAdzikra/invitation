---
import content from '../data/content.json';
---

<section id="hero" class="section-hero relative px-4 text-center overflow-hidden" aria-label="Informasi Utama Pernikahan">
  
  <!-- Subtle Parallax Watermark Monogram -->
  <div class="watermark-monogram ornament-parallax pointer-events-none select-none" aria-hidden="true">&amp;</div>

  <div class="relative z-10 max-w-3xl w-full mx-auto flex flex-col items-center">
    
    <!-- Minimalist Hairline Monogram Crest -->
    <div class="hero-crest w-14 h-14 rounded-full border border-gold/30 flex items-center justify-center mb-4 opacity-0">
      <span class="font-display text-base text-gold tracking-widest pl-0.5">AD</span>
    </div>

    <!-- Editorial Scene Tag -->
    <div class="hero-badge editorial-badge opacity-0">
      <span>THE WEDDING OF</span>
    </div>

    <!-- Perfectly Balanced Headline with Overflow Mask Reveal -->
    <div class="overflow-hidden my-3 sm:my-5">
      <h1 id="hero-headline" class="font-display text-4xl sm:text-6xl md:text-7xl lg:text-8xl text-pearl font-normal tracking-tight leading-tight translate-y-[110%] opacity-0 transition-transform duration-1000 ease-[cubic-bezier(0.16,1,0.3,1)]">
        {content.couple.groom.nickname} <span class="font-display italic text-gold font-normal px-1 sm:px-3">&amp;</span> {content.couple.bride.nickname}
      </h1>
    </div>

    <!-- 1px Minimalist Hairline Divider -->
    <div class="hero-divider w-12 h-[1px] bg-gold/40 my-3 scale-x-0 opacity-0 transition-all duration-700 ease-out"></div>

    <!-- Tanggal & Venue -->
    <div class="hero-meta mt-2 flex flex-col items-center gap-1.5 opacity-0">
      <p class="text-xs sm:text-sm text-gold-bright tracking-[0.25em] uppercase font-light">
        {content.event.dateFormatted} &bull; {content.event.timezone}
      </p>
      <p class="text-xs sm:text-sm text-pearl-muted font-light tracking-wider">
        {content.event.venue.name} &bull; Banda Aceh
      </p>
    </div>

    <!-- Minimalist Guest Welcoming Card -->
    <div class="hero-guest mt-8 py-5 px-6 sm:px-8 rounded border border-gold/20 bg-navy-surface/60 max-w-sm w-full mx-auto opacity-0 shadow-lg">
      <p class="text-[0.65rem] sm:text-[0.7rem] text-pearl-muted font-light tracking-[0.22em] uppercase mb-1.5">
        Kepada Yth. Bapak/Ibu/Saudara/i:
      </p>
      <h2 id="guest-name-hero" class="font-display text-xl sm:text-2xl text-pearl font-normal leading-snug">
        Tamu Undangan Terhormat
      </h2>
    </div>

    <!-- Minimalist Scroll Cue -->
    <div class="hero-scroll mt-12 flex flex-col items-center gap-2 opacity-0">
      <span class="text-[0.62rem] tracking-[0.3em] uppercase text-gold/70">GULIR</span>
      <div class="w-[1px] h-6 bg-gradient-to-b from-gold/60 to-transparent animate-pulse"></div>
    </div>

  </div>
</section>

<script>
  import gsap from 'gsap';

  function initHero() {
    const guestNameEl = document.getElementById('guest-name-hero');
    const headline = document.getElementById('hero-headline');
    const crest = document.querySelector('.hero-crest');
    const badge = document.querySelector('.hero-badge');
    const divider = document.querySelector('.hero-divider');
    const meta = document.querySelector('.hero-meta');
    const guest = document.querySelector('.hero-guest');
    const scrollCue = document.querySelector('.hero-scroll');

    // Parse & sanitize ?to= parameter
    const urlParams = new URLSearchParams(window.location.search);
    const rawTo = urlParams.get('to');
    let sanitizedGuestName = 'Tamu Undangan Terhormat';

    if (rawTo) {
      let decoded = '';
      try {
        decoded = decodeURIComponent(rawTo.replace(/\+/g, ' '));
      } catch (e) {
        decoded = rawTo.replace(/\+/g, ' ');
      }
      const stripped = decoded.replace(/<[^>]*>/g, '');
      const sanitized = stripped.replace(/[<>'"/\\`~^;={}[\]|]/g, '').trim().substring(0, 75);
      if (sanitized.length > 0) {
        sanitizedGuestName = sanitized;
      }
    }

    if (guestNameEl) {
      if (sanitizedGuestName.length > 26) {
        guestNameEl.style.fontSize = 'clamp(1.15rem, 3.5vw, 1.5rem)';
      }
      guestNameEl.textContent = sanitizedGuestName;
    }

    function animateHeroEntrance() {
      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (prefersReducedMotion) {
        if (headline) { headline.style.transform = 'none'; headline.style.opacity = '1'; }
        if (crest) (crest as HTMLElement).style.opacity = '1';
        if (badge) (badge as HTMLElement).style.opacity = '1';
        if (divider) { (divider as HTMLElement).style.opacity = '1'; (divider as HTMLElement).style.transform = 'none'; }
        if (meta) (meta as HTMLElement).style.opacity = '1';
        if (guest) (guest as HTMLElement).style.opacity = '1';
        if (scrollCue) (scrollCue as HTMLElement).style.opacity = '1';
        return;
      }

      const tl = gsap.timeline({ delay: 0.2 });

      // Crest & Badge
      tl.to([crest, badge], {
        opacity: 1,
        y: 0,
        duration: 0.8,
        stagger: 0.1,
        ease: 'power3.out'
      });

      // Headline rising out of overflow mask
      tl.to(headline, {
        y: 0,
        opacity: 1,
        duration: 1.1,
        ease: 'power3.out'
      }, '-=0.5');

      // Hairline divider expanding
      tl.to(divider, {
        scaleX: 1,
        opacity: 0.6,
        duration: 0.8,
        ease: 'power2.out'
      }, '-=0.7');

      // Meta & Guest card
      tl.to([meta, guest], {
        opacity: 1,
        y: 0,
        duration: 0.9,
        stagger: 0.15,
        ease: 'power3.out'
      }, '-=0.5');

      // Scroll cue
      tl.to(scrollCue, {
        opacity: 0.7,
        duration: 0.8,
        ease: 'power2.out'
      }, '-=0.3');
    }

    // Trigger on invitationOpening
    window.addEventListener('invitationOpening', animateHeroEntrance);

    // If splashscreen is already bypassed (e.g. on direct dev visit)
    if (!document.body.classList.contains('is-locked')) {
      animateHeroEntrance();
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHero);
  } else {
    initHero();
  }
</script>
