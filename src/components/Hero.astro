---
// Hero.astro — Cinematic Hero Section with Artistic Prewedding Couple Silhouette & Ken Burns Parallax Zoom
import content from '../data/content.json';
import FloralWreath from './botanical/FloralWreath.astro';
import FloralDivider from './botanical/FloralDivider.astro';
import FloralCorner from './botanical/FloralCorner.astro';
import FloralBouquet from './botanical/FloralBouquet.astro';
import FloralFlourish from './botanical/FloralFlourish.astro';
import TwinkleSparkles from './botanical/TwinkleSparkles.astro';
import SceneTitleCard from './cinematic/SceneTitleCard.astro';
import CoupleHeroSilhouette from './cinematic/CoupleHeroSilhouette.astro';
---

<section id="hero" class="deck-section tone-hero section-hero relative px-4 text-center overflow-hidden z-10 pt-10 pb-16" aria-label="Informasi Utama Pernikahan">
  
  <!-- Twinkling Gold Sparkles Background -->
  <TwinkleSparkles />

  <!-- Botanical Corner Floral Ornaments in 4 Corners -->
  <div class="absolute top-4 left-4 sm:top-8 sm:left-8 pointer-events-none">
    <FloralCorner position="top-left" size={110} />
  </div>
  <div class="absolute top-4 right-4 sm:top-8 sm:right-8 pointer-events-none">
    <FloralCorner position="top-right" size={110} />
  </div>
  <div class="absolute bottom-4 left-4 sm:bottom-8 sm:left-8 pointer-events-none">
    <FloralCorner position="bottom-left" size={90} />
  </div>
  <div class="absolute bottom-4 right-4 sm:bottom-8 sm:right-8 pointer-events-none">
    <FloralCorner position="bottom-right" size={90} />
  </div>

  <!-- Subtle Parallax Watermark Monogram -->
  <div class="watermark-monogram ornament-parallax pointer-events-none select-none text-[#566A4E]" aria-hidden="true">&amp;</div>

  <div class="relative z-10 max-w-3xl w-full mx-auto flex flex-col items-center">
    
    <!-- Cinematic Scene Indicator Badge -->
    <div class="hero-badge mb-3 opacity-0">
      <SceneTitleCard act="ACT I" title="THE UNION" scene="SCENE 01" />
    </div>

    <!-- Royal Botanical Olive & Floral Crest -->
    <div class="hero-crest mb-2 transform hover:scale-105 transition-transform duration-500 opacity-0">
      <FloralWreath monogram="AD" size={95} />
    </div>

    <!-- Crown Bouquet -->
    <div class="my-1 scale-90 sm:scale-100">
      <FloralBouquet width={240} height={55} />
    </div>

    <!-- Grand Movie Title Headline with Staggered Reveal -->
    <div class="overflow-hidden my-1 sm:my-2">
      <h1 id="hero-headline" class="font-display text-4xl sm:text-6xl md:text-7xl lg:text-8xl text-[#2A3426] font-normal tracking-tight leading-tight translate-y-[110%] opacity-0 transition-transform duration-1000 ease-[cubic-bezier(0.16,1,0.3,1)]">
        {content.couple.groom.nickname} <span class="font-display italic text-[#B89352] font-normal px-1 sm:px-3">&amp;</span> {content.couple.bride.nickname}
      </h1>
    </div>

    <!-- Symmetrical Calligraphic Flourish Swash -->
    <div class="my-1">
      <FloralFlourish width={210} height={35} />
    </div>

    <!-- ARTISTIC PREWEDDING COUPLE SILHOUETTE (With Ken Burns Scroll Parallax Zoom) -->
    <div id="hero-silhouette-container" class="my-4 relative opacity-0 transform transition-transform duration-700">
      <div id="hero-silhouette-inner" class="will-change-transform">
        <CoupleHeroSilhouette size={310} />
      </div>
      <!-- Soft Cinematic Ground Shadow -->
      <div class="w-48 h-5 bg-[#263322]/15 rounded-full blur-md mx-auto -mt-2 pointer-events-none"></div>
    </div>

    <!-- Botanical Olive & Floral Divider -->
    <div class="hero-divider my-2 scale-x-0 opacity-0 transition-all duration-700 ease-out">
      <FloralDivider width={260} height={34} />
    </div>

    <!-- Tanggal & Venue -->
    <div class="hero-meta mt-1 flex flex-col items-center gap-1.5 opacity-0">
      <p class="text-xs sm:text-sm text-[#566A4E] tracking-[0.25em] uppercase font-semibold">
        {content.event.dateFormatted} &bull; {content.event.timezone}
      </p>
      <p class="text-xs sm:text-sm text-[#7E8F77] font-light tracking-wider">
        {content.event.venue.name} &bull; Banda Aceh
      </p>
    </div>

    <!-- Personalized Guest Welcoming Card (Botanical Linen) with Corner Ornaments -->
    <div class="hero-guest mt-8 py-5 px-6 sm:px-8 rounded-xl border border-[#566A4E]/25 bg-white/95 max-w-sm w-full mx-auto opacity-0 shadow-[0_12px_36px_rgba(42,52,38,0.08)] relative overflow-hidden">
      <!-- Top Gold Line -->
      <div class="absolute top-0 left-0 right-0 h-[2px] bg-gradient-to-r from-transparent via-[#B89352] to-transparent"></div>
      
      <!-- Mini Floral Corners on Guest Card -->
      <div class="absolute top-1 left-1 pointer-events-none opacity-40">
        <FloralCorner position="top-left" size={35} />
      </div>
      <div class="absolute bottom-1 right-1 pointer-events-none opacity-40">
        <FloralCorner position="bottom-right" size={35} />
      </div>

      <p class="text-[0.65rem] sm:text-[0.7rem] text-[#566A4E] font-medium tracking-[0.22em] uppercase mb-1.5">
        Kepada Yth. Bapak/Ibu/Saudara/i:
      </p>
      <h2 id="guest-name-hero" class="font-display text-xl sm:text-2xl text-[#2A3426] font-normal leading-snug">
        Tamu Undangan Terhormat
      </h2>
    </div>

    <!-- Botanical Scroll Cue -->
    <div class="hero-scroll mt-10 sm:mt-12 flex flex-col items-center gap-2 opacity-0">
      <span class="text-[0.62rem] tracking-[0.3em] uppercase text-[#566A4E] font-medium">GULIR KE BAWAH</span>
      <div class="w-[1.5px] h-7 bg-gradient-to-b from-[#566A4E] to-transparent animate-pulse"></div>
    </div>

  </div>
</section>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  function initHero() {
    const guestNameEl = document.getElementById('guest-name-hero');
    const headline = document.getElementById('hero-headline');
    const crest = document.querySelector('.hero-crest');
    const badge = document.querySelector('.hero-badge');
    const silhouette = document.getElementById('hero-silhouette-container');
    const silhouetteInner = document.getElementById('hero-silhouette-inner');
    const divider = document.querySelector('.hero-divider');
    const meta = document.querySelector('.hero-meta');
    const guest = document.querySelector('.hero-guest');
    const scrollCue = document.querySelector('.hero-scroll');

    // Parse & sanitize ?to= parameter
    const urlParams = new URLSearchParams(window.location.search);
    const rawTo = urlParams.get('to');
    if (rawTo && guestNameEl) {
      try {
        const decoded = decodeURIComponent(rawTo.replace(/\+/g, ' ')).replace(/<[^>]*>/g, '').trim().substring(0, 50);
        if (decoded) guestNameEl.textContent = decoded;
      } catch (e) {}
    }

    // Play reveal animation on invitationOpened event
    function revealHero() {
      const tl = gsap.timeline({ defaults: { ease: 'power3.out' } });

      tl.to(crest, { opacity: 1, scale: 1, duration: 1 })
        .to(badge, { opacity: 1, y: 0, duration: 0.6 }, '-=0.5')
        .to(headline, { opacity: 1, y: 0, duration: 1.1, ease: 'power4.out' }, '-=0.3')
        .to(silhouette, { opacity: 1, scale: 1, duration: 1.2, ease: 'power3.out' }, '-=0.6')
        .to(divider, { opacity: 1, scaleX: 1, duration: 0.8 }, '-=0.5')
        .to(meta, { opacity: 1, y: 0, duration: 0.8 }, '-=0.4')
        .to(guest, { opacity: 1, y: 0, duration: 0.9 }, '-=0.3')
        .to(scrollCue, { opacity: 1, y: 0, duration: 0.8 }, '-=0.2');

      // Ken Burns Scroll Parallax Slow Zoom on Silhouette
      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!prefersReducedMotion && silhouetteInner) {
        gsap.to(silhouetteInner, {
          scale: 1.18,
          y: -25,
          ease: 'none',
          scrollTrigger: {
            trigger: '#hero',
            start: 'top top',
            end: 'bottom top',
            scrub: 1.2
          }
        });
      }
    }

    window.addEventListener('invitationOpened', revealHero, { once: true });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHero);
  } else {
    initHero();
  }
</script>