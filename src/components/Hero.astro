---
import content from '../data/content.json';
import ShinyText from './reactbits/ShinyText';
import BotanicalCrest from './BotanicalCrest.astro';
import FiligreeDivider from './FiligreeDivider.astro';
---

<section id="hero" class="section-slide relative px-4 overflow-hidden" aria-label="Informasi Utama Pernikahan">
  
  <!-- Subtle Parallax Watermark Monogram -->
  <div class="watermark-monogram ornament-parallax" aria-hidden="true">&amp;</div>

  <div class="relative z-10 max-w-4xl w-full mx-auto text-center flex flex-col items-center">
  <div class="relative z-10 max-w-4xl w-full mx-auto text-center flex flex-col items-center my-auto">
    
    <div class="mb-8">
    <!-- Royal Botanical Crest -->
    <div class="mb-4">
      <BotanicalCrest monogram="AD" size={82} />
    </div>

    <div>
      <p class="text-overline tracking-[0.25em]">
        <ShinyText client:visible text="PERNIKAHAN KAMI" speed={3.5} />
      </p>
    </div>

    <!-- Asymmetrical Editorial Magazine Typography -->
    <div class="w-full my-6 flex flex-col gap-2 md:gap-4">
    <div class="w-full my-4 flex flex-col gap-2 md:gap-4">
      
      <!-- Baris 1: Nama Pria (Left-Aligned di container) -->
      <div class="hero-line text-left md:pl-8">
      <div class="hero-line text-left md:pl-10">
        <div class="hero-text-inner">
          <h2 class="font-display text-4xl sm:text-6xl md:text-7xl lg:text-8xl text-pearl font-normal tracking-tight">
            {content.couple.groom.nickname}
          </h2>
        </div>
      </div>

      <!-- Baris 2: Simbol & (Center-Aligned) -->
      <div class="hero-line text-center my-1">
      <div class="hero-line text-center my-0.5">
        <div class="hero-text-inner">
          <span class="font-display italic text-3xl sm:text-5xl md:text-6xl text-gold">
            &amp;
          </span>
        </div>
      </div>

      <!-- Baris 3: Nama Wanita (Right-Aligned di container) -->
      <div class="hero-line text-right md:pr-8">
      <div class="hero-line text-right md:pr-10">
        <div class="hero-text-inner">
          <h2 class="font-display text-4xl sm:text-6xl md:text-7xl lg:text-8xl text-pearl font-normal tracking-tight">
            {content.couple.bride.nickname}
          </h2>
        </div>
      </div>

    </div>

    <!-- Ornate Filigree Divider -->
    <FiligreeDivider className="my-2" />

    <!-- Tanggal & Venue Preview -->
    <div class="mt-8 flex flex-col items-center gap-1.5">
    <div class="mt-2 flex flex-col items-center gap-1.5">
      <div class="hero-line">
        <div class="hero-text-inner">
          <p class="text-sm md:text-base text-gold-bright tracking-[0.2em] uppercase font-light">
            {content.event.dateFormatted} &bull; {content.event.timezone}
          </p>
        </div>
      </div>
      <div class="hero-line">
        <div class="hero-text-inner">
          <p class="text-xs md:text-sm text-pearl-muted font-light tracking-wide">
            {content.event.venue.name}
          </p>
        </div>
      </div>
    </div>

  </div>

  <!-- Scroll Prompt -->
  <a href="#opening" class="scroll-prompt" aria-label="Gulir ke bagian ayat">
    <span>Gulir</span>
    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M7 13l5 5 5-5M7 6l5 5 5-5"/>
    </svg>
  </a>
</section>

<script>
  import gsap from 'gsap';

  function playHeroReveal() {
    const heroInners = document.querySelectorAll('.hero-text-inner');
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (prefersReducedMotion) {
      heroInners.forEach((el) => {
        (el as HTMLElement).style.transform = 'none';
        (el as HTMLElement).style.opacity = '1';
      });
      return;
    }

    gsap.to(heroInners, {
      y: '0%',
      opacity: 1,
      duration: 0.9,
      stagger: 0.12,
      ease: 'expo.out',
      clearProps: 'willChange'
    });
  }

  // Listen for cover unboxing completion
  window.addEventListener('invitationOpening', () => {
    setTimeout(playHeroReveal, 450);
  });
</script>
