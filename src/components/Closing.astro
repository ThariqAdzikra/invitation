---
import content from '../data/content.json';
import FloralWreath from './botanical/FloralWreath.astro';
import FloralDivider from './botanical/FloralDivider.astro';
import FloralBouquet from './botanical/FloralBouquet.astro';
import FloralCorner from './botanical/FloralCorner.astro';
---

<section id="closing" class="deck-section tone-closing section-flow relative px-4 text-center pb-24 overflow-hidden z-80" aria-label="Penutup Undangan">
  
  <!-- Bottom Botanical Corner Accents -->
  <div class="absolute bottom-4 left-4 sm:bottom-8 sm:left-8 pointer-events-none">
    <FloralCorner position="bottom-left" size={80} />
  </div>
  <div class="absolute bottom-4 right-4 sm:bottom-8 sm:right-8 pointer-events-none">
    <FloralCorner position="bottom-right" size={80} />
  </div>

  <div class="max-w-xl mx-auto flex flex-col items-center w-full relative z-10 closing-content">
    
    <div class="mb-3">
      <FloralWreath monogram="AD" size={90} />
    </div>

    <div class="editorial-badge mb-3">
      <span>EPILOGUE</span>
    </div>

    <div class="mb-3 scale-90">
      <FloralBouquet width={200} height={50} />
    </div>

    <p class="text-sm md:text-base text-[#566A4E] font-light leading-relaxed mb-6 max-w-md">
      Merupakan suatu kehormatan dan kebahagiaan bagi kami apabila Bapak/Ibu/Saudara/i berkenan hadir untuk memberikan doa restu kepada kami.
    </p>

    <p class="text-[0.68rem] tracking-[0.25em] text-[#B89352] uppercase font-semibold mb-2">Hormat Kami yang Berbahagia</p>
    
    <h2 class="font-display text-3xl sm:text-4xl md:text-5xl text-[#2A3426] font-normal mb-8 tracking-tight">
      {content.couple.groom.nickname} <span class="font-display italic text-[#B89352] font-normal px-1">&amp;</span> {content.couple.bride.nickname}
    </h2>

    <div class="mb-10">
      <FloralDivider width={220} height={30} />
    </div>

    <footer class="w-full pt-6 border-t border-[#566A4E]/20">
      <p class="text-[0.62rem] md:text-xs text-[#7E8F77] tracking-[0.25em] uppercase font-medium">
        &copy; 2026 &bull; Undangan Pernikahan Digital &bull; {content.couple.groom.nickname} &amp; {content.couple.bride.nickname}
      </p>
    </footer>

  </div>
</section>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  function initClosing() {
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReducedMotion) return;

    gsap.fromTo(
      '.closing-content',
      { opacity: 0, y: 30 },
      {
        opacity: 1,
        y: 0,
        duration: 0.9,
        ease: 'power3.out',
        scrollTrigger: {
          trigger: '#closing',
          start: 'top 82%',
          once: true
        }
      }
    );
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initClosing);
  } else {
    initClosing();
  }
</script>
