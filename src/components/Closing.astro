---
// Closing.astro — Grand Finale, Words of Gratitude & Invitation Sharing
import content from '../data/content.json';
import RomanticSwans from './botanical/RomanticSwans.astro';
---

<section id="closing" class="deck-section section-flow relative text-center pb-24 overflow-hidden z-30 pt-12 sm:pt-16" aria-label="Penutup Undangan">
  
  <!-- FULL-BLEED SEAMLESS SUNSET HORIZON (TRUE 100vw EDGE-TO-EDGE, NO BOUNDARIES) -->
  <div id="sunset-scenery-stage" class="w-full relative min-h-[460px] sm:min-h-[540px] flex flex-col justify-end items-center my-2 overflow-visible">
    
    <!-- Ambient Golden Hour Radial Flare behind horizon -->
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_50%_55%,rgba(245,175,70,0.32)_0%,rgba(220,135,50,0.14)_45%,transparent_75%)] pointer-events-none -z-10"></div>

    <!-- LAYER 1: Full-Bleed Distant & Mid Rolling Hills (SVG Edge-to-Edge) -->
    <svg class="absolute bottom-0 left-0 right-0 w-full h-48 sm:h-64 pointer-events-none z-10" viewBox="0 0 1440 320" preserveAspectRatio="none" fill="none">
      <!-- Distant Ridge with Golden Rim -->
      <path d="M0 190 Q360 110 720 155 T1440 120 L1440 320 L0 320 Z" fill="url(#distant-ridge-grad)" opacity="0.65" />
      
      <!-- Mid-distance Warm Olive Rolling Hills -->
      <path d="M0 220 Q420 160 840 200 T1440 170 L1440 320 L0 320 Z" fill="url(#mid-ridge-grad)" opacity="0.88" />
      
      <!-- Foreground Lush Meadow Slope where Difa & Zharkasi stand -->
      <path d="M0 255 Q520 205 1020 240 T1440 225 L1440 320 L0 320 Z" fill="url(#fore-ridge-grad)" />

      <!-- Gradient Definitions matching Haute-Couture Olive & Gold -->
      <defs>
        <linearGradient id="distant-ridge-grad" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="#C59B4B" />
          <stop offset="100%" stop-color="#556C4D" />
        </linearGradient>
        <linearGradient id="mid-ridge-grad" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="#556C4D" />
          <stop offset="100%" stop-color="#384833" />
        </linearGradient>
        <linearGradient id="fore-ridge-grad" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="#384833" />
          <stop offset="100%" stop-color="#232E1F" />
        </linearGradient>
      </defs>
    </svg>

    <!-- GOLDEN MIST: Atmospheric Radial Sheen at the Foot of the Ridge -->
    <div class="absolute bottom-4 left-1/2 -translate-x-1/2 w-full max-w-4xl h-36 bg-[radial-gradient(ellipse_at_center,rgba(255,215,120,0.42)_0%,rgba(240,165,70,0.22)_40%,transparent_75%)] blur-2xl pointer-events-none z-15"></div>

    <!-- LAYER 2: Transparent Cutout Couple (Enlarged 1.4x, Standing Majestic at Sunset) -->
    <div class="relative z-20 w-72 sm:w-88 md:w-[420px] max-w-[90vw] pb-1 sm:pb-2 filter drop-shadow-[0_16px_36px_rgba(20,30,15,0.42)] drop-shadow-[0_0_28px_rgba(245,175,70,0.25)]">
      <img 
        src="/assets/vector-couple-cutout.png" 
        alt="Difa & Zharkasi Berdiri Bersama Menatap Senja" 
        class="w-full h-auto object-contain select-none pointer-events-none"
        loading="lazy"
      />
    </div>

    <!-- Subtle Grounding Horizon Sheen under the Couple -->
    <div class="w-64 sm:w-80 h-3 bg-[#1A2317]/25 rounded-full blur-md mx-auto -mt-2 z-22 pointer-events-none"></div>

    <!-- Seamless Gradient Mask to Ground (Blends Smoothly to Cream Background) -->
    <div class="absolute bottom-0 left-0 right-0 h-16 bg-gradient-to-b from-transparent via-[#FAF8F5]/40 to-[#FAF8F5] pointer-events-none z-25"></div>
  </div>

  <!-- CLOSING CONTENT (Centered & Padded) -->
  <div class="max-w-2xl sm:max-w-3xl mx-auto px-4 flex flex-col items-center w-full relative z-10 closing-content">

    <!-- Romantic Quote Below Landscape -->
    <div class="my-4 text-center max-w-lg mx-auto relative z-30">
      <div class="inline-flex items-center justify-center gap-2 mb-1.5 opacity-70">
        <span class="h-[1px] w-8 bg-[#B89352]"></span>
        <span class="text-[#B89352] text-xs">❦</span>
        <span class="h-[1px] w-8 bg-[#B89352]"></span>
      </div>
      <p class="font-display italic text-[#2A3426] text-base sm:text-lg md:text-xl tracking-wide">
        &ldquo;Melangkah bersama, menyempurnakan separuh agama&rdquo;
      </p>
    </div>

    <!-- Heartfelt Closing Words -->
    <p class="text-xs sm:text-sm md:text-base text-[#4A5D43] font-light leading-relaxed my-5 max-w-lg mx-auto">
      Merupakan suatu kehormatan dan kebahagiaan bagi kami apabila Bapak/Ibu/Saudara/i berkenan hadir untuk memberikan doa restu kepada kami.
    </p>

    <!-- Romantic Swans Emblem (Symbolizing Eternal Devotion & Monogamy) -->
    <div class="my-4 flex justify-center">
      <RomanticSwans size={150} />
    </div>

    <!-- Family Closing Sign-off -->
    <div class="my-4">
      <p class="text-[0.62rem] tracking-[0.28em] text-[#B89352] uppercase font-semibold mb-2">Hormat Kami yang Berbahagia</p>
      
      <h2 class="font-display text-3xl sm:text-4xl md:text-5xl text-[#2A3426] font-normal tracking-tight">
        {content.couple.bride.nickname} <span class="font-display italic text-[#B89352] font-normal px-1">&amp;</span> {content.couple.groom.nickname}
      </h2>

      <p class="text-xs text-[#7E8F77] font-light mt-1 italic">
        Beserta Keluarga Besar Kedua Mempelai
      </p>
    </div>

    <!-- Interactive Actions: Bagikan Undangan & Kembali ke Atas -->
    <div class="mt-6 mb-12 flex flex-wrap items-center justify-center gap-3">
      
      <!-- WhatsApp Share Button -->
      <button
        type="button"
        id="btn-share-invitation"
        class="inline-flex items-center gap-2 px-6 py-2.5 rounded-full text-xs uppercase tracking-widest font-semibold bg-[#4A5D43] text-white hover:bg-[#384833] transition-all cursor-pointer shadow-sm active:scale-95"
      >
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"></path>
          <polyline points="16 6 12 2 8 6"></polyline>
          <line x1="12" y1="2" x2="12" y2="15"></line>
        </svg>
        <span>Bagikan Undangan</span>
      </button>

      <!-- Back to Top Button -->
      <button
        type="button"
        id="btn-back-to-top"
        class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full border border-[#566A4E]/30 text-xs uppercase tracking-widest font-semibold text-[#4A5D43] bg-white/90 hover:bg-[#FAF8F5] hover:border-[#4A5D43] transition-all cursor-pointer shadow-sm active:scale-95"
      >
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M18 15l-6-6-6 6"/>
        </svg>
        <span>Kembali ke Awal</span>
      </button>

    </div>

    <!-- End Title Credits Footer -->
    <footer class="w-full pt-8 border-t border-[#566A4E]/15 text-center">
      <div class="w-8 h-8 rounded-full border border-[#B89352]/30 flex items-center justify-center mx-auto mb-2 text-[#B89352] text-xs font-serif italic">
        DZ
      </div>
      <p class="text-[0.62rem] tracking-[0.3em] uppercase text-[#B89352] font-mono mb-1">
        THE WEDDING OF DIFA &amp; ZHARKASI &bull; 2026
      </p>
      <p class="text-[0.62rem] md:text-xs text-[#7E8F77] tracking-[0.2em] uppercase font-medium">
        Terima Kasih atas Doa &amp; Restu Anda &bull; Padang
      </p>
    </footer>

  </div>
</section>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { playChimeSound } from './reactbits/SoundEffects';

  gsap.registerPlugin(ScrollTrigger);

  function initClosing() {
    const backToTopBtn = document.getElementById('btn-back-to-top');
    const shareBtn = document.getElementById('btn-share-invitation');

    if (backToTopBtn) {
      backToTopBtn.addEventListener('click', () => {
        playChimeSound();
        if ((window as any).__lenis) {
          (window as any).__lenis.scrollTo(0, { duration: 1.6 });
        } else {
          window.scrollTo({ top: 0, behavior: 'smooth' });
        }
      });
    }

    if (shareBtn) {
      shareBtn.addEventListener('click', () => {
        playChimeSound();
        const title = 'Undangan Pernikahan Difa & Zharkasi';
        const url = window.location.href;
        const text = `Assalamu'alaikum Wr. Wb.\n\nTanpa mengurangi rasa hormat, kami mengundang Bapak/Ibu/Saudara/i untuk menghadiri pernikahan kami, Difa Auliya Syahmi & Muhammad Zharkasi:\n\n${url}\n\nMerupakan suatu kehormatan dan kebahagiaan bagi kami apabila Bapak/Ibu/Saudara/i berkenan hadir dan memberikan doa restu.`;

        if (navigator.share) {
          navigator.share({
            title: title,
            text: text,
            url: url
          }).catch(() => {});
        } else {
          const encoded = encodeURIComponent(text);
          window.open(`https://wa.me/?text=${encoded}`, '_blank');
        }

        if (typeof (window as any).triggerLuxuryConfetti === 'function') {
          const rect = shareBtn.getBoundingClientRect();
          (window as any).triggerLuxuryConfetti(rect.left + rect.width / 2, rect.top);
        }
      });
    }

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!prefersReducedMotion) {
      const closingTl = gsap.timeline({
        scrollTrigger: {
          trigger: '#closing',
          start: 'top 78%',
          once: true
        }
      });

      closingTl.fromTo(
        '#closing .group',
        { opacity: 0, y: 40, scale: 0.96 },
        { opacity: 1, y: 0, scale: 1, duration: 0.9, ease: 'power3.out' }
      );

      closingTl.fromTo(
        '#closing p, #closing .my-4',
        { opacity: 0, y: 20 },
        { opacity: 1, y: 0, duration: 0.7, stagger: 0.12, ease: 'power2.out' },
        '-=0.4'
      );
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initClosing);
  } else {
    initClosing();
  }
</script>
