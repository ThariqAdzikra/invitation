---
// Closing.astro — Grand Finale, Words of Gratitude & Developer Credit
import content from '../data/content.json';
import RomanticSwans from './botanical/RomanticSwans.astro';
---

<section 
  id="closing" 
  class="deck-section relative px-4 text-center min-h-[100vh] flex flex-col justify-center items-center pt-20 sm:pt-28 pb-16 sm:pb-20 z-30" 
  aria-label="Penutup Undangan"
>

  <!-- THEMATIC ATMOSPHERIC ACCENT: WARM GOLDEN SUNSET HALO & DUSK EMBERS -->
  <div class="absolute inset-0 pointer-events-none flex items-center justify-center overflow-hidden z-0">
    <!-- Volumetric Twilight Amber Bloom -->
    <div class="w-[500px] h-[500px] sm:w-[650px] sm:h-[650px] rounded-full bg-[radial-gradient(circle,rgba(238,175,115,0.28)_0%,rgba(212,175,55,0.14)_40%,transparent_75%)] blur-3xl opacity-80 pointer-events-none"></div>
    
    <!-- Floating Twilight Stardust Particles -->
    <div class="closing-stardust absolute top-[20%] left-[16%] w-1.5 h-1.5 rounded-full bg-[#E8C97A] shadow-[0_0_8px_#D4AF37] opacity-60"></div>
    <div class="closing-stardust absolute top-[28%] right-[18%] w-2 h-2 rounded-full bg-[#E8C97A] shadow-[0_0_10px_#D4AF37] opacity-65"></div>
    <div class="closing-stardust absolute top-[55%] left-[22%] w-1.5 h-1.5 rounded-full bg-[#D4AF37] opacity-50"></div>
    <div class="closing-stardust absolute top-[62%] right-[20%] w-2 h-2 rounded-full bg-[#E8C97A] shadow-[0_0_8px_#D4AF37] opacity-55"></div>
  </div>
  
  <!-- CLOSING CONTENT (Centered & Balanced with Breathing Room) -->
  <div class="max-w-2xl sm:max-w-3xl mx-auto flex flex-col items-center w-full relative z-10 closing-content my-auto will-change-transform">

    <!-- Romantic Quote -->
    <div class="mb-3 sm:mb-4 text-center max-w-lg mx-auto relative z-30">
      <div class="inline-flex items-center justify-center gap-2 mb-2 opacity-70">
        <span class="h-[1px] w-8 bg-[#B89352]"></span>
        <span class="text-[#B89352] text-xs">❦</span>
        <span class="h-[1px] w-8 bg-[#B89352]"></span>
      </div>
      <p class="font-display italic text-[#2A3426] text-base sm:text-lg md:text-xl tracking-wide">
        &ldquo;Melangkah bersama, menyempurnakan separuh agama&rdquo;
      </p>
    </div>

    <!-- Heartfelt Closing Words -->
    <p class="text-xs sm:text-sm md:text-base text-[#4A5D43] font-light leading-relaxed mb-4 sm:mb-6 max-w-md mx-auto">
      Merupakan suatu kehormatan dan kebahagiaan bagi kami apabila Bapak/Ibu/Saudara/i berkenan hadir untuk memberikan doa restu kepada kami.
    </p>

    <!-- Romantic Swans Emblem (Centered in Warm Golden Sunset Aura) -->
    <div class="my-2 sm:my-3 flex justify-center transform transition-transform hover:scale-105 duration-500 relative">
      <div class="absolute inset-0 bg-[radial-gradient(circle,rgba(212,175,55,0.25)_0%,transparent_70%)] blur-xl pointer-events-none"></div>
      <RomanticSwans size={150} />
    </div>

    <!-- Family Closing Sign-off -->
    <div class="my-3 sm:my-4">
      <p class="text-[0.62rem] tracking-[0.28em] text-[#B89352] uppercase font-semibold mb-2">
        Hormat Kami yang Berbahagia
      </p>
      
      <h2 class="font-display text-3xl sm:text-4xl md:text-5xl text-[#2A3426] font-normal tracking-tight">
        {content.couple.groom.nickname} <span class="font-display italic text-[#B89352] font-normal px-1">&amp;</span> {content.couple.bride.nickname}
      </h2>

      <p class="text-xs text-[#7E8F77] font-light mt-1.5 italic">
        Beserta Keluarga Besar Kedua Mempelai
      </p>
    </div>

    <!-- Earthly Sanctuary Floral Bed at Base (Romantic Flowerbed Finale) -->
    <div class="w-full max-w-xl sm:max-w-2xl mx-auto my-2 sm:my-3 pointer-events-none select-none opacity-90 [mask-image:linear-gradient(to_right,transparent,black_12%,black_88%,transparent)]">
      <img src="/assets/floral-bottom-bed.png" alt="" class="w-full h-auto object-contain object-bottom drop-shadow-sm" loading="lazy" decoding="async" />
    </div>

    <!-- Single Action: Kembali ke Awal (Tailored Rounded-XL) -->
    <div class="mt-4 sm:mt-5 mb-6 sm:mb-8 flex justify-center">
      <button
        type="button"
        id="btn-back-to-top"
        class="inline-flex items-center justify-center gap-2 px-6 py-2.5 sm:px-7 sm:py-3 rounded-xl text-xs uppercase tracking-widest font-semibold bg-[#4A5D43] text-[#FAF8F5] hover:bg-[#384833] transition-all cursor-pointer shadow-[0_4px_14px_rgba(74,93,67,0.22)] active:scale-95 border border-[#4A5D43] group"
      >
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="group-hover:-translate-y-0.5 transition-transform">
          <path d="M18 15l-6-6-6 6"/>
        </svg>
        <span>Kembali ke Awal</span>
      </button>
    </div>

    <!-- Luxury End Title & Developer Credits Footer -->
    <footer class="w-full pt-6 sm:pt-8 border-t border-[#B89352]/25 text-center">
      <!-- Monogram Seal -->
      <div class="w-8 h-8 rounded-full border border-[#B89352]/40 bg-white/70 backdrop-blur-xs flex items-center justify-center mx-auto mb-2 text-[#B89352] text-[11px] font-serif italic shadow-xs">
        ZD
      </div>
      
      <p class="text-[0.62rem] sm:text-[0.68rem] tracking-[0.28em] uppercase text-[#B89352] font-semibold mb-1">
        THE WEDDING OF ZHARKASI &amp; DIFA &bull; 2026
      </p>
      <p class="text-[0.62rem] sm:text-xs text-[#7E8F77] tracking-[0.16em] uppercase font-light mb-4">
        Terima Kasih atas Doa &amp; Restu Anda &bull; Padang
      </p>

      <!-- Developer Credits Pill -->
      <div class="inline-flex flex-wrap items-center justify-center gap-2 px-4 py-2 rounded-xl bg-white/60 backdrop-blur-md border border-[#B89352]/30 shadow-2xs text-xs text-[#566A4E]">
        <span class="text-[0.62rem] sm:text-[0.66rem] uppercase tracking-wider font-semibold text-[#B89352]">
          Developed by
        </span>
        <span class="font-medium text-[#2A3426]">Thariq Adzikra</span>
        <span class="text-[#B89352]/40 select-none">•</span>
        
        <!-- Instagram Link -->
        <a 
          href="https://instagram.com/thrqdz_" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="inline-flex items-center gap-1 text-[#4A5D43] hover:text-[#B89352] font-medium transition-colors hover:underline group"
          title="Instagram @thrqdz_"
        >
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="group-hover:scale-110 transition-transform">
            <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
            <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
            <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
          </svg>
          <span>@thrqdz_</span>
        </a>

        <span class="text-[#B89352]/40 select-none">•</span>

        <!-- GitHub Link -->
        <a 
          href="https://github.com/ThariqAdzikra" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="inline-flex items-center gap-1 text-[#4A5D43] hover:text-[#B89352] font-medium transition-colors hover:underline group"
          title="GitHub ThariqAdzikra"
        >
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="group-hover:scale-110 transition-transform">
            <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path>
          </svg>
          <span>GitHub</span>
        </a>
      </div>
    </footer>

  </div>
</section>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { playChimeSound } from './reactbits/SoundEffects';

  gsap.registerPlugin(ScrollTrigger);

  function initClosing() {
    const backToTopBtn = document.getElementById('btn-back-to-top');

    if (backToTopBtn) {
      backToTopBtn.addEventListener('click', () => {
        playChimeSound();
        if ((window as any).__lenis) {
          (window as any).__lenis.scrollTo(0, { duration: 1.6 });
        } else {
          window.scrollTo({ top: 0, behavior: 'smooth' });
        }
      });
    }

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!prefersReducedMotion) {
      const closingTl = gsap.timeline({
        scrollTrigger: {
          trigger: '#closing',
          start: 'top 78%',
          once: true
        }
      });

      closingTl.fromTo(
        '#closing p, #closing .my-3, #closing .my-4',
        { opacity: 0, y: 20 },
        { opacity: 1, y: 0, duration: 0.7, stagger: 0.12, ease: 'power2.out' }
      );
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initClosing);
  } else {
    initClosing();
  }
</script>
