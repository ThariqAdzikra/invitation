---
import content from '../data/content.json';
import FloralWreath from './botanical/FloralWreath.astro';
import FloralDivider from './botanical/FloralDivider.astro';
import FloralCorner from './botanical/FloralCorner.astro';
import FloralFlourish from './botanical/FloralFlourish.astro';
import TwinkleSparkles from './botanical/TwinkleSparkles.astro';
import SceneTitleCard from './cinematic/SceneTitleCard.astro';
import ClosingSilhouette from './cinematic/ClosingSilhouette.astro';
---

<section id="closing" class="deck-section tone-closing section-flow relative px-4 text-center pb-24 overflow-hidden z-80 pt-16" aria-label="Penutup Undangan">
  
  <TwinkleSparkles />

  <!-- Botanical Corner Accents in 4 Corners (Safe 75px) -->
  <div class="absolute top-2 left-2 sm:top-6 sm:left-6 pointer-events-none opacity-50">
    <FloralCorner position="top-left" size={75} />
  </div>
  <div class="absolute top-2 right-2 sm:top-6 sm:right-6 pointer-events-none opacity-50">
    <FloralCorner position="top-right" size={75} />
  </div>
  <div class="absolute bottom-2 left-2 sm:bottom-6 sm:left-6 pointer-events-none opacity-50">
    <FloralCorner position="bottom-left" size={75} />
  </div>
  <div class="absolute bottom-2 right-2 sm:bottom-6 sm:right-6 pointer-events-none opacity-50">
    <FloralCorner position="bottom-right" size={75} />
  </div>

  <div class="max-w-xl mx-auto flex flex-col items-center w-full relative z-10 closing-content">
    
    <!-- Cinematic Finale Scene Badge -->
    <div class="mb-4">
      <SceneTitleCard act="EPILOGUE" title="FOREVER AFTER" scene="FINALE" />
    </div>

    <!-- ROMANTIC FINALE SILHOUETTE (Couple Holding Hands under Celestial Stars) -->
    <div class="my-3 transform hover:scale-105 transition-transform duration-500">
      <ClosingSilhouette size={240} />
    </div>

    <p class="text-sm md:text-base text-[#566A4E] font-light leading-relaxed my-4 max-w-md">
      Merupakan suatu kehormatan dan kebahagiaan bagi kami apabila Bapak/Ibu/Saudara/i berkenan hadir untuk memberikan doa restu kepada kami.
    </p>

    <div class="my-1.5">
      <FloralFlourish width={170} height={28} />
    </div>

    <p class="text-[0.68rem] tracking-[0.25em] text-[#B89352] uppercase font-semibold mb-2">Hormat Kami yang Berbahagia</p>
    
    <h2 class="font-display text-3xl sm:text-4xl md:text-5xl text-[#2A3426] font-normal mb-4 tracking-tight">
      {content.couple.groom.nickname} <span class="font-display italic text-[#B89352] font-normal px-1">&amp;</span> {content.couple.bride.nickname}
    </h2>

    <div class="mb-8">
      <FloralDivider width={240} height={32} />
    </div>

    <!-- End Title Credits Footer -->
    <footer class="w-full pt-6 border-t border-[#566A4E]/20">
      <p class="text-[0.6rem] tracking-[0.3em] uppercase text-[#B89352] font-mono mb-1">
        THE WEDDING OF ARYA &amp; DIAN &bull; 2026
      </p>
      <p class="text-[0.62rem] md:text-xs text-[#7E8F77] tracking-[0.2em] uppercase font-medium">
        Terima Kasih atas Doa &amp; Restu Anda &bull; Banda Aceh
      </p>
    </footer>

  </div>
</section>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  function initClosing() {
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReducedMotion) return;

    gsap.fromTo(
      '.closing-content',
      { opacity: 0, y: 30 },
      {
        opacity: 1,
        y: 0,
        duration: 0.9,
        ease: 'power3.out',
        scrollTrigger: {
          trigger: '#closing',
          start: 'top 82%',
          once: true
        }
      }
    );
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initClosing);
  } else {
    initClosing();
  }
</script>