---
// Closing.astro — Grand Finale, Words of Gratitude & Invitation Sharing
import content from '../data/content.json';
import RomanticSwans from './botanical/RomanticSwans.astro';
---

<section id="closing" class="deck-section section-flow relative px-4 text-center pb-24 overflow-hidden z-80 pt-20" aria-label="Penutup Undangan">
  
  <div class="max-w-xl mx-auto flex flex-col items-center w-full relative z-10 closing-content">
    
    <!-- ROMANTIC FINALE VECTOR (Arya & Dian Holding Hands at Sunset) -->
    <div class="my-6 w-full max-w-md mx-auto group">
      <div class="rounded-3xl p-2 sm:p-2.5 border border-[#B89352]/40 bg-gradient-to-b from-[#FAF8F5] via-[#FFFFFF] to-[#F3EEE5] shadow-[0_16px_45px_rgba(42,52,38,0.1)] overflow-hidden interactive-foil-card" data-foil="true">
        <div class="rounded-2xl overflow-hidden aspect-[16/9] relative border border-[#566A4E]/15">
          <img 
            src="/assets/vector-closing.jpg" 
            alt="Ilustrasi Arya & Dian Menatap Masa Depan" 
            class="w-full h-full object-cover"
            loading="lazy"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-[#2A3426]/25 via-transparent to-transparent pointer-events-none"></div>
          
          <!-- Romantic Overlay Quote -->
          <div class="absolute bottom-3 left-3 right-3 text-center pointer-events-none">
            <p class="font-display italic text-white/95 text-xs sm:text-sm drop-shadow-md tracking-wide">
              &ldquo;Melangkah bersama, menyempurnakan separuh agama&rdquo;
            </p>
          </div>
        </div>
      </div>
      <div class="w-52 h-3 bg-[#263322]/10 rounded-full blur-md mx-auto -mt-1 pointer-events-none"></div>
    </div>

    <!-- Heartfelt Closing Words -->
    <p class="text-xs sm:text-sm md:text-base text-[#4A5D43] font-light leading-relaxed my-4 max-w-md">
      Merupakan suatu kehormatan dan kebahagiaan bagi kami apabila Bapak/Ibu/Saudara/i berkenan hadir untuk memberikan doa restu kepada kami.
    </p>

    <!-- Romantic Swans Emblem (Symbolizing Eternal Devotion & Monogamy) -->
    <div class="my-4 flex justify-center">
      <RomanticSwans size={150} />
    </div>

    <!-- Family Closing Sign-off -->
    <div class="my-4">
      <p class="text-[0.62rem] tracking-[0.28em] text-[#B89352] uppercase font-semibold mb-2">Hormat Kami yang Berbahagia</p>
      
      <h2 class="font-display text-3xl sm:text-4xl md:text-5xl text-[#2A3426] font-normal tracking-tight">
        {content.couple.groom.nickname} <span class="font-display italic text-[#B89352] font-normal px-1">&amp;</span> {content.couple.bride.nickname}
      </h2>

      <p class="text-xs text-[#7E8F77] font-light mt-1 italic">
        Beserta Keluarga Besar Kedua Mempelai
      </p>
    </div>

    <!-- Interactive Actions: Bagikan Undangan & Kembali ke Atas -->
    <div class="mt-6 mb-12 flex flex-wrap items-center justify-center gap-3">
      
      <!-- WhatsApp Share Button -->
      <button
        type="button"
        id="btn-share-invitation"
        class="inline-flex items-center gap-2 px-6 py-2.5 rounded-full text-xs uppercase tracking-widest font-semibold bg-[#4A5D43] text-white hover:bg-[#384833] transition-all cursor-pointer shadow-sm active:scale-95"
      >
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"></path>
          <polyline points="16 6 12 2 8 6"></polyline>
          <line x1="12" y1="2" x2="12" y2="15"></line>
        </svg>
        <span>Bagikan Undangan</span>
      </button>

      <!-- Back to Top Button -->
      <button
        type="button"
        id="btn-back-to-top"
        class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full border border-[#566A4E]/30 text-xs uppercase tracking-widest font-semibold text-[#4A5D43] bg-white/90 hover:bg-[#FAF8F5] hover:border-[#4A5D43] transition-all cursor-pointer shadow-sm active:scale-95"
      >
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M18 15l-6-6-6 6"/>
        </svg>
        <span>Kembali ke Awal</span>
      </button>

    </div>

    <!-- End Title Credits Footer -->
    <footer class="w-full pt-8 border-t border-[#566A4E]/15 text-center">
      <div class="w-8 h-8 rounded-full border border-[#B89352]/30 flex items-center justify-center mx-auto mb-2 text-[#B89352] text-xs font-serif italic">
        AD
      </div>
      <p class="text-[0.62rem] tracking-[0.3em] uppercase text-[#B89352] font-mono mb-1">
        THE WEDDING OF ARYA &amp; DIAN &bull; 2026
      </p>
      <p class="text-[0.62rem] md:text-xs text-[#7E8F77] tracking-[0.2em] uppercase font-medium">
        Terima Kasih atas Doa &amp; Restu Anda &bull; Banda Aceh
      </p>
    </footer>

  </div>
</section>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { playChimeSound } from './reactbits/SoundEffects';

  gsap.registerPlugin(ScrollTrigger);

  function initClosing() {
    const backToTopBtn = document.getElementById('btn-back-to-top');
    const shareBtn = document.getElementById('btn-share-invitation');

    if (backToTopBtn) {
      backToTopBtn.addEventListener('click', () => {
        playChimeSound();
        if ((window as any).__lenis) {
          (window as any).__lenis.scrollTo(0, { duration: 1.6 });
        } else {
          window.scrollTo({ top: 0, behavior: 'smooth' });
        }
      });
    }

    if (shareBtn) {
      shareBtn.addEventListener('click', () => {
        playChimeSound();
        const title = 'Undangan Pernikahan Arya & Dian';
        const url = window.location.href;
        const text = `Assalamu'alaikum Wr. Wb.\n\nTanpa mengurangi rasa hormat, kami mengundang Bapak/Ibu/Saudara/i untuk menghadiri pernikahan kami, Arya Wirayudha & Dian Paramitha:\n\n${url}\n\nMerupakan suatu kehormatan dan kebahagiaan bagi kami apabila Bapak/Ibu/Saudara/i berkenan hadir dan memberikan doa restu.`;

        if (navigator.share) {
          navigator.share({
            title: title,
            text: text,
            url: url
          }).catch(() => {});
        } else {
          const encoded = encodeURIComponent(text);
          window.open(`https://wa.me/?text=${encoded}`, '_blank');
        }

        if (typeof (window as any).triggerLuxuryConfetti === 'function') {
          const rect = shareBtn.getBoundingClientRect();
          (window as any).triggerLuxuryConfetti(rect.left + rect.width / 2, rect.top);
        }
      });
    }

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!prefersReducedMotion) {
      gsap.fromTo(
        '.closing-content',
        { opacity: 0, y: 25 },
        {
          opacity: 1,
          y: 0,
          duration: 0.9,
          ease: 'power3.out',
          scrollTrigger: {
            trigger: '#closing',
            start: 'top 82%',
            once: true
          }
        }
      );
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initClosing);
  } else {
    initClosing();
  }
</script>
