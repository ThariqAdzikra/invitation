---
// Closing.astro — Grand Finale & Words of Gratitude
import content from '../data/content.json';
import FloralFlourish from './botanical/FloralFlourish.astro';
---

<section id="closing" class="deck-section section-flow relative px-4 text-center pb-24 overflow-hidden z-80 pt-20" aria-label="Penutup Undangan">
  
  <div class="max-w-xl mx-auto flex flex-col items-center w-full relative z-10 closing-content">
    
    <!-- ROMANTIC FINALE VECTOR (Arya & Dian Holding Hands at Sunset) -->
    <div class="my-6 w-full max-w-md mx-auto group">
      <div class="rounded-2xl p-2 border border-[#B89352]/40 bg-gradient-to-b from-[#FAF8F5] via-[#FFFFFF] to-[#F3EEE5] shadow-[0_16px_40px_rgba(42,52,38,0.08)] overflow-hidden interactive-foil-card" data-foil="true">
        <div class="rounded-xl overflow-hidden aspect-[16/9] relative border border-[#566A4E]/15">
          <img 
            src="/assets/vector-closing.jpg" 
            alt="Ilustrasi Arya & Dian Menatap Masa Depan" 
            class="w-full h-full object-cover transform group-hover:scale-104 transition-transform duration-700 ease-out"
            loading="lazy"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-[#2A3426]/20 via-transparent to-transparent pointer-events-none"></div>
        </div>
      </div>
      <div class="w-48 h-3 bg-[#263322]/10 rounded-full blur-md mx-auto -mt-1 pointer-events-none"></div>
    </div>

    <p class="text-xs sm:text-sm md:text-base text-[#4A5D43] font-light leading-relaxed my-5 max-w-md">
      Merupakan suatu kehormatan dan kebahagiaan bagi kami apabila Bapak/Ibu/Saudara/i berkenan hadir untuk memberikan doa restu kepada kami.
    </p>

    <div class="my-2 opacity-70">
      <FloralFlourish width={160} height={24} />
    </div>

    <p class="text-[0.62rem] tracking-[0.28em] text-[#B89352] uppercase font-semibold mb-2">Hormat Kami yang Berbahagia</p>
    
    <h2 class="font-display text-3xl sm:text-4xl md:text-5xl text-[#2A3426] font-normal mb-6 tracking-tight">
      {content.couple.groom.nickname} <span class="font-display italic text-[#B89352] font-normal px-1">&amp;</span> {content.couple.bride.nickname}
    </h2>

    <!-- Back to Top Button -->
    <button
      type="button"
      id="btn-back-to-top"
      class="mb-10 inline-flex items-center gap-2 px-5 py-2 rounded-full border border-[#566A4E]/25 text-[0.65rem] tracking-[0.25em] uppercase font-semibold text-[#4A5D43] bg-white/90 hover:bg-white hover:border-[#4A5D43] transition-all cursor-pointer shadow-sm active:scale-95"
    >
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M18 15l-6-6-6 6"/>
      </svg>
      <span>Kembali ke Atas</span>
    </button>

    <!-- End Title Credits Footer -->
    <footer class="w-full pt-6 border-t border-[#566A4E]/15">
      <p class="text-[0.62rem] tracking-[0.3em] uppercase text-[#B89352] font-mono mb-1">
        THE WEDDING OF ARYA &amp; DIAN &bull; 2026
      </p>
      <p class="text-[0.62rem] md:text-xs text-[#7E8F77] tracking-[0.2em] uppercase font-medium">
        Terima Kasih atas Doa &amp; Restu Anda &bull; Banda Aceh
      </p>
    </footer>

  </div>
</section>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  function initClosing() {
    const backToTopBtn = document.getElementById('btn-back-to-top');
    if (backToTopBtn) {
      backToTopBtn.addEventListener('click', () => {
        if ((window as any).__lenis) {
          (window as any).__lenis.scrollTo(0, { duration: 1.5 });
        } else {
          window.scrollTo({ top: 0, behavior: 'smooth' });
        }
      });
    }

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReducedMotion) return;

    gsap.fromTo(
      '.closing-content',
      { opacity: 0, y: 25 },
      {
        opacity: 1,
        y: 0,
        duration: 0.9,
        ease: 'power3.out',
        scrollTrigger: {
          trigger: '#closing',
          start: 'top 82%',
          once: true
        }
      }
    );
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initClosing);
  } else {
    initClosing();
  }
</script>
